+			["REPLIED", 4],
+			["QUALIFIED", 3],
+			["APPOINTMENT", 2],
+			["HELD", 1],
+		]);
+		expect(portal.funnel[1]?.pctOfReceived).toBe(83.3);
+		expect(portal.afterFratex).toMatchObject({
+			totalLeads: 6,
+			qualifiedLeads: 3,
+			appointmentsBooked: 2,
+			conversionRatePct: 50,
+			appointmentRatePct: 33.3,
+			projectedCommission: null,
+			hoursSavedPerWeek: null,
+		});
+		expect(portal.beforeFratex).toBeNull();
+	});
+
+	it("measures response speed, trend, projects, sources, budgets and messages", async () => {
+		const portal = await service.getPortalStats(portalOwner, {
+			agencyId: portalAgency,
