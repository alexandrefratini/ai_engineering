+	);
+	await seedLead("eve", {
+		agencyId: agencyA,
+		clientId: clientLuc,
+		status: "QUALIFIED",
+		createdAt: ago(40 * DAY),
+		firstContactedAt: new Date(now - 40 * DAY + 10 * MIN),
+	});
+	await seedLead("fred", {
+		agencyId: agencyA,
+		clientId: clientMarie,
+		status: "NEW",
+		createdAt: ago(MIN),
+	});
+	await seedLead(
+		"gina",
+		{
+			agencyId: agencyA,
+			clientId: clientMarie,
