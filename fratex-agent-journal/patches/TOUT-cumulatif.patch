+				{list}
+			</aside>
+			<section
+				aria-label="Conversation"
+				className={cn("flex min-h-0 min-w-0 flex-col", !selected && "hidden md:flex")}
+			>
+				{children}
+			</section>
+		</div>
+	);
+}
+
+export function InboxPlaceholder({ title, description }: { title: string; description?: string }) {
+	return (
+		<div className={cn("flex flex-1 flex-col items-center justify-center gap-1 p-6 text-center", REVEAL)}>
+			<Icon icon={Chat} className="mb-1 size-5 text-muted-foreground" />
+			<p className="text-sm font-medium">{title}</p>
