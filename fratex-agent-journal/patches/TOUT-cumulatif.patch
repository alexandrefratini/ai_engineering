+import { WORKSPACE_ROLES } from "@crm/auth";
+import { z } from "zod";
+import { TEAM } from "./team-config";
+
+export const teamFilterEnum = z.enum(TEAM.filters);
+
+export const teamListInput = z.object({
+	search: z.string().trim().max(TEAM.searchMaxLength).optional(),
+	filter: teamFilterEnum.default("ALL"),
+});
+
+export const teamMemberInput = z.object({ userId: z.string().min(1) });
+
+const agencyRoleOutput = z.object({
+	agencyId: z.string(),
+	agencyName: z.string(),
+	role: z.string(),
+	clientName: z.string().nullable(),
+});
+
+export const teamMemberRowOutput = z.object({
+	id: z.string(),
+	name: z.string(),
+	email: z.string(),
+	image: z.string().nullable(),
+	workspaceRole: z.enum(WORKSPACE_ROLES),
+	agencyRoles: z.array(agencyRoleOutput),
+	online: z.boolean(),
+	lastSeenAt: z.string().nullable(),
+	lastSeenLabel: z.string().nullable(),
+	joinedAt: z.string(),
+	openTasks: z.number(),
+	overdueTasks: z.number(),
+	actions: z.number(),
+	lastActionAt: z.string().nullable(),
+	isViewer: z.boolean(),
+});
+
+export const teamListOutput = z.object({
+	rows: z.array(teamMemberRowOutput),
+	canViewEveryone: z.boolean(),
+	windowDays: z.number(),
+	summary: z.object({
+		members: z.number(),
+		online: z.number(),
+		overdueTasks: z.number(),
+		actions: z.number(),
+	}),
+});
+
+export const teamTaskOutput = z.object({
+	id: z.string(),
+	subject: z.string(),
+	dueAt: z.string().nullable(),
+	completedAt: z.string().nullable(),
+	overdue: z.boolean(),
+	recordType: z.enum(["contact", "company", "deal"]).nullable(),
+	recordName: z.string().nullable(),
+});
+
+export const teamTimelineItemOutput = z.object({
+	id: z.string(),
+	at: z.string(),
+	kind: z.enum(TEAM.timelineKinds),
+	activityType: z.string().nullable(),
+	title: z.string(),
+	detail: z.string().nullable(),
+	leadId: z.string().nullable(),
+	agencyId: z.string().nullable(),
+	targetId: z.string().nullable(),
+});
+
+export const teamMemberOutput = z.object({
+	member: teamMemberRowOutput,
+	canViewEveryone: z.boolean(),
+	windowDays: z.number(),
+	stats: z.object({
+		leadsFollowed: z.number().nullable(),
+		notes: z.number(),
+		activities: z.number(),
+		sms: z.number(),
+		openTasks: z.number(),
+		overdueTasks: z.number(),
+		doneTasks: z.number(),
+		supportOpen: z.number(),
+		conversations: z.number(),
+	}),
+	tasks: z.array(teamTaskOutput),
+	timeline: z.array(teamTimelineItemOutput),
+});
+
+export type TeamListInput = z.infer<typeof teamListInput>;
+export type TeamMemberRow = z.infer<typeof teamMemberRowOutput>;
+export type TeamMemberDetail = z.infer<typeof teamMemberOutput>;
