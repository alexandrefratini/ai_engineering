new file mode 100644
index 0000000..2f55301
--- /dev/null
+++ b/apps/app/app/(app)/[slug]/account/page.tsx
@@ -0,0 +1,52 @@
+import type { Metadata } from "next";
+import { Suspense } from "react";
+import {
+	PageShell,
+	PageShellContent,
+	PageShellDescription,
+	PageShellHeader,
+	PageShellHeading,
+	PageShellLoading,
+	PageShellTitle,
+} from "@/components/page-shell";
+import { PAGE_HELP } from "@/lib/page-help";
+import { requireSession, signInAccounts } from "@/lib/session";
+import { AccountView } from "./account-view";
+
+export const metadata: Metadata = {
+	title: "Mon compte",
+};
+
+export default function AccountPage() {
+	return (
+		<PageShell>
+			<PageShellHeader>
+				<PageShellHeading>
+					<PageShellTitle info={PAGE_HELP.account}>Mon compte</PageShellTitle>
+					<PageShellDescription>
+						Votre profil, votre connexion, vos appareils et votre affichage.
+					</PageShellDescription>
+				</PageShellHeading>
+			</PageShellHeader>
+
+			<PageShellContent>
+				<Suspense fallback={<PageShellLoading />}>
+					<Account />
+				</Suspense>
+			</PageShellContent>
+		</PageShell>
+	);
+}
+
+async function Account() {
+	const { user, session } = await requireSession();
+	const accounts = await signInAccounts(user.id);
+
+	return (
+		<AccountView
+			user={{ name: user.name, email: user.email, image: user.image ?? null }}
+			providers={accounts.map((account) => account.providerId)}
+			currentSessionId={session.id}
+		/>
+	);
+}
