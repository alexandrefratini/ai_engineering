+import { TRANSLATION } from "@/lib/translation-config";
+
+const COOKIE_PATTERN = new RegExp(
+	`(?:^|;\\s*)${TRANSLATION.cookie}=/${TRANSLATION.pageLanguage}/([A-Za-z-]+)`,
+);
+
+export function activeLanguage(cookieHeader: string): string | null {
+	const code = COOKIE_PATTERN.exec(cookieHeader)?.[1];
+	return code &&
+		TRANSLATION.languages.some((language) => language.code === code)
+		? code
+		: null;
+}
+
+export function translationCookies(
+	code: string | null,
+	hostname: string,
+): string[] {
+	const value = code ? `/${TRANSLATION.pageLanguage}/${code}` : "";
+	const expiry = code ? "" : "; expires=Thu, 01 Jan 1970 00:00:00 GMT";
+	const base = `${TRANSLATION.cookie}=${value}; path=/${expiry}`;
+	return hostname.includes(".")
+		? [base, `${base}; domain=.${hostname}`, `${base}; domain=${hostname}`]
+		: [base];
+}
+
+export function languageLabel(code: string): string {
+	return (
+		TRANSLATION.languages.find((language) => language.code === code)?.label ??
+		code
+	);
+}
