@@ -0,0 +1,113 @@
+"use client";
+
+import ChevronDown from "@carbon/icons-react/es/ChevronDown";
+import {
+	Collapsible,
+	CollapsibleContent,
+	CollapsibleTrigger,
+} from "@crm/ui/components/collapsible";
+import { DotMatrix } from "@crm/ui/components/dot-matrix";
+import { Icon } from "@crm/ui/components/icon";
+import { Shimmer } from "@crm/ui/components/shimmer";
+import { IndicatorDot } from "@crm/ui/components/status-indicator";
+import { cn } from "@crm/ui/lib/utils";
+import type * as React from "react";
+
+export type ToolState = "pending" | "done" | "error";
+
+function ToolStateDot({ state }: { state: ToolState }) {
+	return (
+		<span
+			data-slot="tool-state"
+			data-state={state}
+			className="flex h-5 w-3.5 shrink-0 items-center justify-center"
+		>
+			{state === "pending" ? (
+				<DotMatrix decorative />
+			) : (
+				<IndicatorDot tone={state === "error" ? "warning" : "primary"} />
+			)}
+		</span>
+	);
+}
+
+function Tool({
+	className,
+	...props
+}: React.ComponentProps<typeof Collapsible>) {
+	return (
+		<Collapsible
+			data-slot="tool"
+			className={cn("flex min-w-0 flex-col gap-1", className)}
+			{...props}
+		/>
+	);
+}
+
+function ToolHeader({
+	label,
+	state,
+	expandable = true,
+	className,
+}: {
+	label: string;
+	state: ToolState;
+	expandable?: boolean;
+	className?: string;
+}) {
+	const content = (
+		<>
+			<ToolStateDot state={state} />
+			{state === "pending" ? (
+				<Shimmer className="min-w-0 text-left">{label}</Shimmer>
+			) : (
+				<span className="min-w-0 wrap-break-word">{label}</span>
+			)}
+		</>
+	);
+
+	if (!expandable) {
+		return (
+			<div
+				data-slot="tool-header"
+				className={cn("flex min-w-0 items-start gap-2 text-sm", className)}
+			>
+				{content}
+			</div>
+		);
+	}
+
+	return (
+		<CollapsibleTrigger
+			data-slot="tool-header"
+			className={cn(
+				"group/tool flex w-fit min-w-0 max-w-full items-start gap-2 rounded-md text-left text-sm outline-none focus-visible:ring-2 focus-visible:ring-ring/60",
+				className,
+			)}
+		>
+			{content}
+			<Icon
+				icon={ChevronDown}
+				className="mt-1 size-3.5 shrink-0 text-muted-foreground transition-transform group-data-[state=open]/tool:rotate-180 motion-reduce:transition-none"
+			/>
+		</CollapsibleTrigger>
+	);
+}
+
+function ToolContent({
+	className,
+	...props
+}: React.ComponentProps<typeof CollapsibleContent>) {
+	return (
+		<CollapsibleContent
+			data-slot="tool-content"
+			className={cn(
+				"flex min-w-0 flex-col gap-2 pl-[22px] data-[state=open]:fade-in-0 data-[state=open]:animate-in motion-reduce:animate-none",
+				className,
+			)}
+			{...props}
+		/>
+	);
+}
+
+export { Tool, ToolContent, ToolHeader };
