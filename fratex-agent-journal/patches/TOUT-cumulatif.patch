new file mode 100644
index 0000000..51bb01a
--- /dev/null
+++ b/packages/ui/src/components/team-member-detail.tsx
@@ -0,0 +1,249 @@
+"use client";
+
+import Chat from "@carbon/icons-react/es/Chat";
+import Document from "@carbon/icons-react/es/Document";
+import Help from "@carbon/icons-react/es/Help";
+import Information from "@carbon/icons-react/es/Information";
+import Task from "@carbon/icons-react/es/Task";
+import Time from "@carbon/icons-react/es/Time";
+import type { ReactNode } from "react";
+import { cn } from "../lib/utils";
+import { EmptyState } from "./empty-state";
+import { type CarbonIcon, Icon } from "./icon";
+import { AccountFacts, type AccountRow } from "./account-panel";
+
+export type TimelineKind = "LEAD_NOTE" | "ACTIVITY" | "SMS" | "SUPPORT" | "ASSISTANT";
+
+export type TimelineEntry = {
+	id: string;
+	at: string;
+	kind: TimelineKind;
+	kindLabel: string;
+	title: string;
+	detail: string | null;
+	href: string | null;
+};
+
+export type TaskEntry = {
+	id: string;
+	subject: string;
+	dueAt: string | null;
+	completedAt: string | null;
+	overdue: boolean;
+	recordName: string | null;
+};
+
+const KIND_ICONS: Record<TimelineKind, CarbonIcon> = {
+	LEAD_NOTE: Document,
+	ACTIVITY: Time,
+	SMS: Chat,
+	SUPPORT: Help,
+	ASSISTANT: Information,
+};
+
+export function MemberTimeline({
+	items,
+	renderLink,
+	renderTime,
+	empty,
+}: {
+	items: TimelineEntry[];
+	renderLink: (href: string, children: ReactNode) => ReactNode;
+	renderTime: (iso: string) => ReactNode;
+	empty: { title: string; description: string };
+}) {
+	if (items.length === 0)
+		return (
+			<EmptyState
+				compact
+				icon={Time}
+				title={empty.title}
+				description={empty.description}
+			/>
+		);
+
+	return (
+		<ol className="-my-1 flex flex-col divide-y">
+			{items.map((item) => {
+				const body = (
+					<span className="flex items-start gap-3 py-3">
+						<span
+							aria-hidden="true"
+							className="mt-0.5 grid size-7 shrink-0 place-items-center rounded-full bg-muted text-muted-foreground"
+						>
+							<Icon icon={KIND_ICONS[item.kind]} className="size-4" />
+						</span>
+						<span className="flex min-w-0 flex-1 flex-col gap-0.5">
+							<span className="flex flex-wrap items-baseline gap-x-2">
+								<span translate="no" className="min-w-0 break-words text-sm font-medium">
+									{item.title}
+								</span>
+								<span className="text-xs text-muted-foreground">{item.kindLabel}</span>
+							</span>
+							{item.detail && (
+								<span translate="no" className="line-clamp-2 text-xs text-muted-foreground">
+									{item.detail}
+								</span>
+							)}
+						</span>
+						<span className="shrink-0 pt-0.5 text-xs text-muted-foreground">
+							{renderTime(item.at)}
+						</span>
+					</span>
+				);
+				return (
+					<li key={item.id}>
+						{item.href ? renderLink(item.href, body) : body}
+					</li>
+				);
+			})}
+		</ol>
+	);
+}
+
+function TaskGroup({
+	title,
+	tasks,
+	renderTime,
+	tone,
+}: {
+	title: string;
+	tasks: TaskEntry[];
+	renderTime: (iso: string) => ReactNode;
+	tone?: "alert" | "done";
+}) {
+	if (tasks.length === 0) return null;
+	return (
+		<section className="flex flex-col gap-1">
+			<h3
+				className={cn(
+					"text-xs font-medium text-muted-foreground",
+					tone === "alert" && "text-destructive",
+				)}
+			>
+				{title} · {tasks.length}
+			</h3>
+			<ul className="flex flex-col divide-y">
+				{tasks.map((task) => (
+					<li key={task.id} className="flex items-start gap-3 py-2.5 text-sm">
+						<span
+							aria-hidden="true"
+							className={cn(
+								"mt-1.5 size-2 shrink-0 rounded-full",
+								task.completedAt
+									? "bg-success"
+									: task.overdue
+										? "bg-destructive"
+										: "bg-foreground/40",
+							)}
+						/>
+						<span className="flex min-w-0 flex-1 flex-col">
+							<span translate="no" className={cn("break-words", task.completedAt && "text-muted-foreground line-through")}>
+								{task.subject}
+							</span>
+							{task.recordName && (
+								<span translate="no" className="truncate text-xs text-muted-foreground">
+									{task.recordName}
+								</span>
+							)}
+						</span>
+						<span className="shrink-0 text-xs text-muted-foreground">
+							{task.completedAt
+								? renderTime(task.completedAt)
+								: task.dueAt
+									? renderTime(task.dueAt)
+									: null}
+						</span>
+					</li>
+				))}
+			</ul>
+		</section>
+	);
+}
+
+export function MemberTasks({
+	tasks,
+	renderTime,
+	labels,
+}: {
+	tasks: TaskEntry[];
+	renderTime: (iso: string) => ReactNode;
+	labels: {
+		overdue: string;
+		open: string;
+		done: string;
+		emptyTitle: string;
+		emptyDescription: string;
+	};
+}) {
+	if (tasks.length === 0)
+		return (
+			<EmptyState
+				compact
+				icon={Task}
+				title={labels.emptyTitle}
+				description={labels.emptyDescription}
+			/>
+		);
+	const overdue = tasks.filter((task) => !task.completedAt && task.overdue);
+	const open = tasks.filter((task) => !task.completedAt && !task.overdue);
+	const done = tasks.filter((task) => task.completedAt);
+
+	return (
+		<div className="flex flex-col gap-4">
+			<TaskGroup title={labels.overdue} tasks={overdue} renderTime={renderTime} tone="alert" />
+			<TaskGroup title={labels.open} tasks={open} renderTime={renderTime} />
+			<TaskGroup title={labels.done} tasks={done} renderTime={renderTime} tone="done" />
+		</div>
+	);
+}
+
+export type MemberAccessAgency = {
+	agencyId: string;
+	agencyName: string;
+	roleLabel: string;
+	clientName: string | null;
+};
+
+export function MemberAccess({
+	rows,
+	agencies,
+	agenciesTitle,
+	noAgencies,
+}: {
+	rows: AccountRow[];
+	agencies: MemberAccessAgency[];
+	agenciesTitle: string;
+	noAgencies: string;
+}) {
+	return (
+		<div className="flex flex-col gap-5">
+			<AccountFacts rows={rows} />
+			<section className="flex flex-col gap-1">
+				<h3 className="text-xs font-medium text-muted-foreground">{agenciesTitle}</h3>
+				{agencies.length === 0 ? (
+					<p className="py-2 text-sm text-muted-foreground">{noAgencies}</p>
+				) : (
+					<ul className="flex flex-col divide-y">
+						{agencies.map((agency) => (
+							<li key={agency.agencyId} className="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-0.5 py-2.5 text-sm">
+								<span translate="no" className="font-medium">
+									{agency.agencyName}
+								</span>
+								<span className="text-xs text-muted-foreground">
+									{agency.roleLabel}
+									{agency.clientName && (
+										<span translate="no">
+											{" · "}
+											{agency.clientName}
+										</span>
+									)}
+								</span>
+							</li>
+						))}
+					</ul>
+				)}
+			</section>
+		</div>
+	);
+}
