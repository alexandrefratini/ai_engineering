+"use client";
+
+import { useEffect, useState } from "react";
+import { REAL_ESTATE } from "./workspace-config";
+
+export function useNow(): Date {
+	const [now, setNow] = useState(() => new Date());
+	useEffect(() => {
+		const timer = setInterval(() => setNow(new Date()), REAL_ESTATE.clockMs);
+		return () => clearInterval(timer);
+	}, []);
+	return now;
+}
