+"use client";
+
+import { AgencyControl, type useAgency } from "./use-agency";
+
+export function AgencySlot({ scope }: { scope: ReturnType<typeof useAgency> }) {
+	const agencies = scope.query.data?.agencies;
+	if (agencies?.length === 1) return null;
+	if (agencies && agencies.length > 1)
+		return (
+			<div className="w-full sm:w-56">
+				<AgencyControl scope={scope} />
+			</div>
+		);
+	return <AgencyControl scope={scope} />;
+}
