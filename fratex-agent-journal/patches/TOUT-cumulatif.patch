+	eventType: string;
+	occurredAt: string;
+};
+
+export type LeadProfileAppointment = {
+	id: string;
+	title: string;
+	startTime: string;
+	status: string;
+	clientName: string;
+	description?: string | null;
+};
+
+export type AppointmentOutcome = "CONFIRMED" | "COMPLETED" | "NO_SHOW" | "CANCELLED";
+
+export type NewAppointment = {
+	title: string;
+	startTime: string;
+	durationMinutes: number;
+	location?: string;
+};
+
+export type LeadProfileMessage = {
+	id: string;
+	sender: "LEAD" | "AI_SDR" | "HUMAN_AGENT" | "SYSTEM";
+	content: string;
+	sentAt: string;
+	status: string;
+};
+
+const SENDER_LABELS: Record<LeadProfileMessage["sender"], string> = {
+	LEAD: "Prospect",
+	AI_SDR: "Assistant IA",
+	HUMAN_AGENT: "Courtier",
+	SYSTEM: "Système",
+};
+
+const SENDER_DOT: Record<LeadProfileMessage["sender"], string> = {
+	LEAD: "bg-foreground",
+	AI_SDR: "bg-primary",
+	HUMAN_AGENT: "bg-primary/50",
+	SYSTEM: "bg-muted-foreground/40",
+};
+
+const FAILED_MESSAGE_STATUSES = new Set(["FAILED", "REFUSED", "CANCELLED"]);
+
+const UPCOMING_STATUSES = new Set(["SCHEDULED", "CONFIRMED", "RESCHEDULED"]);
+
+type CriterionField = (typeof QUALIFICATION_CRITERIA)[number]["field"];
+
+function criterionValue(lead: LeadProfileLead, field: CriterionField): string | null {
+	if (field === "intent") return lead.intent === "UNKNOWN" ? null : labelOf(INTENT_LABELS, lead.intent);
+	if (field === "budget") return formatBudget(lead.budgetMin, lead.budgetMax);
+	return lead[field];
+}
+
+function evidenceFor(evidence: LeadProfileEvidence[], field: CriterionField) {
+	const matches = evidence.filter((item) =>
+		field === "budget" ? item.field === "budgetMin" || item.field === "budgetMax" : item.field === field,
+	);
+	return [...new Set(matches.map((item) => item.quote))];
+}
+
+function minutesBetween(start: string, end: string) {
+	return (new Date(end).getTime() - new Date(start).getTime()) / 60000;
+}
+
+function plural(count: number, one: string, many: string) {
+	return `${count} ${count > 1 ? many : one}`;
+}
+
+function listingHost(url: string) {
+	try {
+		return new URL(url).hostname.replace(/^www\./, "");
+	} catch {
+		return url;
+	}
+}
+
+function Muted({ children }: { children: ReactNode }) {
+	return <span className="text-sm text-muted-foreground">{children}</span>;
+}
+
+function Dot({ className }: { className: string }) {
+	return <span aria-hidden="true" className={cn("size-2 shrink-0 rounded-full", className)} />;
+}
+
+export function LeadPanel({
+	title,
+	description,
+	action,
+	index = 0,
+	children,
+}: {
+	title: string;
+	description?: string;
+	action?: ReactNode;
+	index?: number;
+	children: ReactNode;
+}) {
+	return (
+		<Card className={REVEAL} style={staggerStyle(index)}>
+			<CardHeader>
+				<CardTitle>{title}</CardTitle>
+				{description && <CardDescription>{description}</CardDescription>}
+				{action && <CardAction>{action}</CardAction>}
+			</CardHeader>
+			<CardContent>{children}</CardContent>
+		</Card>
+	);
+}
+
+function Facts({ items }: { items: { label: string; value: ReactNode }[] }) {
+	return (
+		<dl className="grid grid-cols-[8rem_minmax(0,1fr)] gap-x-4 gap-y-2 text-sm">
+			{items.map((item) => (
+				<div key={item.label} className="contents">
+					<dt className="text-muted-foreground">{item.label}</dt>
+					<dd className="min-w-0 break-words">{item.value}</dd>
+				</div>
+			))}
+		</dl>
+	);
+}
+
+export function LeadProfileHeader({ lead, actions }: { lead: LeadProfileLead; actions: ReactNode }) {
+	const offJourney = OFF_JOURNEY_LABELS[lead.status];
+	return (
+		<header className={cn("flex flex-col gap-4 rounded-lg border bg-card p-4", REVEAL)}>
+			<div className="flex flex-col gap-3 md:flex-row md:items-center md:justify-between">
+				<div className="flex min-w-0 items-center gap-3">
+					<ScoreRing value={lead.score} label="Score de qualification" />
+					<div className="flex min-w-0 flex-col gap-1">
+						<div className="flex min-w-0 flex-wrap items-center gap-2">
+							<h2 className="truncate text-lg font-medium tracking-tight">
+								{lead.firstName} {lead.lastName ?? ""}
+							</h2>
+							<LeadStatusBadge status={lead.status} />
+							<Badge variant="outline">{labelOf(INTENT_LABELS, lead.intent)}</Badge>
+							{lead.automationPausedAt && (
+								<span className="flex items-center gap-1.5 text-xs text-muted-foreground">
+									<Dot className="bg-muted-foreground/50" />
+									IA en pause
+								</span>
+							)}
+						</div>
+						<div className="flex flex-wrap gap-x-3 gap-y-0.5 text-sm text-muted-foreground">
+							<a className="transition-colors hover:text-foreground" href={`tel:${lead.phone}`}>
+								{formatPhone(lead.phone)}
+							</a>
+							{lead.email && (
+								<a className="truncate transition-colors hover:text-foreground" href={`mailto:${lead.email}`}>
+									{lead.email}
+								</a>
+							)}
+							<span>{lead.clientName ?? "Courtier non assigné"}</span>
+						</div>
+					</div>
+				</div>
+				<div className="flex flex-wrap items-center gap-2">{actions}</div>
+			</div>
+			<LeadJourney steps={[...LEAD_JOURNEY]} current={lead.status} aside={offJourney} />
