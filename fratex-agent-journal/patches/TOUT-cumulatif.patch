@@ -0,0 +1,35 @@
+"use client";
+
+import type { MouseEvent } from "react";
+import { formatPhone } from "../lib/real-estate";
+import { cn } from "../lib/utils";
+
+export function ContactLink({
+	kind,
+	value,
+	className,
+	label,
+}: {
+	kind: "phone" | "email";
+	value: string;
+	className?: string;
+	label?: string;
+}) {
+	const phone = kind === "phone";
+	const stop = (event: MouseEvent) => event.stopPropagation();
+	return (
+		<a
+			href={phone ? `tel:${value}` : `mailto:${value}`}
+			onClick={stop}
+			title={phone ? "Appeler" : "Écrire un courriel"}
+			translate="no"
+			className={cn(
+				"rounded-xs underline-offset-4 outline-none transition-colors hover:text-foreground hover:underline focus-visible:ring-2 focus-visible:ring-ring/60",
+				phone && "tabular-nums",
+				className,
+			)}
+		>
+			{label ?? (phone ? formatPhone(value) : value)}
+		</a>
+	);
+}
