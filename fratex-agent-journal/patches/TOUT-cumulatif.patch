+
+export function pagesFor(audience: NavAudience): NavPage[] {
+	return audience === "staff"
+		? NAV_PAGES
+		: NAV_PAGES.filter((page) => !page.staffOnly);
+}
+
+export function matchPages(
+	query: string,
+	audience: NavAudience = "staff",
+): NavPage[] {
+	const pages = pagesFor(audience);
+	const needle = normalizeSearch(query);
+	if (!needle) return pages;
+	return pages.filter((page) =>
+		[page.label, page.group, ...page.keywords].some((text) =>
+			normalizeSearch(text).includes(needle),
+		),
+	);
+}
+
+export function presenceLabel(segments: string[]): string {
+	const visible = segments.filter((segment) => !HIDDEN_SEGMENTS.has(segment));
+	if (visible.length === 0) return "Accueil";
+	const leadIndex = visible.indexOf("leads");
+	const leadSegment = visible[leadIndex + 1];
+	if (leadIndex >= 0 && leadSegment && leadSegment !== "new")
+		return "Fiche d'un prospect";
+	const known = [...visible]
+		.reverse()
+		.map((segment) => SEGMENT_LABELS[segment])
+		.find(Boolean);
+	return known ?? "Fratex";
+}
