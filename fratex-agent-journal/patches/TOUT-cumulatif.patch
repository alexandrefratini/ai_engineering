diff --git a/apps/app/components/agent-builder/chat-markdown.tsx b/apps/app/components/agent-builder/chat-markdown.tsx
new file mode 100644
index 0000000..bb88bdb
--- /dev/null
+++ b/apps/app/components/agent-builder/chat-markdown.tsx
@@ -0,0 +1,43 @@
+"use client";
+
+import { Markdown } from "@crm/ui/components/markdown";
+import Link from "next/link";
+import type { ComponentProps } from "react";
+import { workspaceMarkdown } from "@/lib/agent-prospect-results";
+import { useWorkspaceSlug } from "@/lib/use-workspace-url";
+
+const LINK_CLASS = "wrap-anywhere font-medium text-primary underline";
+
+function ChatLink({ href, children }: ComponentProps<"a">) {
+	if (href?.startsWith("/") && !href.startsWith("//")) {
+		return (
+			<Link href={href} className={LINK_CLASS}>
+				{children}
+			</Link>
+		);
+	}
+
+	return (
+		<a href={href} target="_blank" rel="noreferrer" className={LINK_CLASS}>
+			{children}
+		</a>
+	);
+}
+
+const COMPONENTS = { a: ChatLink };
+
+export function ChatMarkdown({
+	children,
+	className,
+}: {
+	children: string;
+	className?: string;
+}) {
+	const slug = useWorkspaceSlug();
+
+	return (
+		<Markdown className={className} components={COMPONENTS}>
+			{workspaceMarkdown(children, slug)}
+		</Markdown>
+	);
+}
