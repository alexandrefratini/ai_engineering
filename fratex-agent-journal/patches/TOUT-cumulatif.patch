diff --git a/apps/app/components/app-breadcrumb.tsx b/apps/app/components/app-breadcrumb.tsx
new file mode 100644
index 0000000..315157c
--- /dev/null
+++ b/apps/app/components/app-breadcrumb.tsx
@@ -0,0 +1,68 @@
+"use client";
+
+import {
+	type BreadcrumbCrumb,
+	BreadcrumbTrail,
+} from "@crm/ui/components/breadcrumb";
+import { useQuery } from "@tanstack/react-query";
+import Link from "next/link";
+import { usePathname, useSearchParams } from "next/navigation";
+import { HIDDEN_SEGMENTS, SEGMENT_LABELS } from "@/lib/navigation";
+import { useTRPC } from "@/lib/trpc/client";
+import { useWorkspaceUrl } from "@/lib/use-workspace-url";
+
+const UNKNOWN_SEGMENT = "Détail";
+const LEAD_FALLBACK = "Fiche prospect";
+const MEMBER_FALLBACK = "Membre";
+
+export function AppBreadcrumb({ rootLabel }: { rootLabel: string }) {
+	const trpc = useTRPC();
+	const href = useWorkspaceUrl();
+	const pathname = usePathname();
+	const search = useSearchParams();
+	const segments = pathname.split("/").filter(Boolean).slice(1);
+	const leadIndex = segments.indexOf("leads");
+	const leadSegment = leadIndex >= 0 ? segments[leadIndex + 1] : undefined;
+	const leadId =
+		leadSegment && !SEGMENT_LABELS[leadSegment] ? leadSegment : null;
+	const lead = useQuery(
+		trpc.realEstate.byId.queryOptions(
+			{ agencyId: search.get("agencyId") || undefined, id: leadId ?? "" },
+			{ enabled: Boolean(leadId) },
+		),
+	);
+	const teamIndex = segments.indexOf("team");
+	const memberSegment = teamIndex >= 0 ? segments[teamIndex + 1] : undefined;
+	const memberId =
+		memberSegment && !SEGMENT_LABELS[memberSegment] ? memberSegment : null;
+	const member = useQuery(
+		trpc.team.member.queryOptions(
+			{ userId: memberId ?? "" },
+			{ enabled: Boolean(memberId) },
+		),
+	);
+	const crumbs: BreadcrumbCrumb[] = [];
+	segments.forEach((segment, index) => {
+		if (HIDDEN_SEGMENTS.has(segment)) return;
+		const path = `/${segments.slice(0, index + 1).join("/")}`;
+		const known = SEGMENT_LABELS[segment];
+		const label =
+			known ??
+			(segment === leadId
+				? lead.data
+					? `${lead.data.lead.firstName} ${lead.data.lead.lastName ?? ""}`.trim()
+					: LEAD_FALLBACK
+				: segment === memberId
+					? (member.data?.member.name ?? MEMBER_FALLBACK)
+					: UNKNOWN_SEGMENT);
+		crumbs.push({ label, href: href(path) });
+	});
+
+	return (
+		<BreadcrumbTrail
+			root={{ label: rootLabel, href: href() }}
+			crumbs={crumbs}
+			renderLink={(crumb) => <Link href={crumb.href}>{crumb.label}</Link>}
+		/>
+	);
+}
