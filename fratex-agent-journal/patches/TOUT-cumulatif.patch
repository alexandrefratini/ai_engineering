+import { afterAll, beforeAll, describe, expect, it } from "bun:test";
+import { randomUUID } from "node:crypto";
+import { db } from "@crm/db";
+import { PresenceService } from "../src/presence/presence.service";
+import { PRESENCE } from "../src/presence/presence-config";
+
+const suffix = randomUUID();
+const organization = `presence-org-${suffix}`;
+const elsewhere = `presence-elsewhere-org-${suffix}`;
+const active = `presence-active-${suffix}`;
+const idle = `presence-idle-${suffix}`;
+const outsider = `presence-outsider-${suffix}`;
+const foreign = `presence-foreign-${suffix}`;
+const service = new PresenceService(db);
+
+beforeAll(async () => {
+	await db.user.createMany({
+		data: [active, idle, outsider, foreign].map((id) => ({
+			id,
+			name: id,
+			email: `${id}@example.test`,
+			lastSeenAt: new Date(Date.now() - 2 * PRESENCE.onlineWindowMs),
+		})),
+	});
+	await db.organization.createMany({
+		data: [
+			{ id: organization, name: "Presence", slug: organization },
+			{ id: elsewhere, name: "Ailleurs", slug: elsewhere },
+		].map((item) => ({ ...item, createdAt: new Date() })),
+	});
+	await db.member.createMany({
+		data: [
+			{ userId: active, organizationId: organization },
+			{ userId: idle, organizationId: organization },
+			{ userId: foreign, organizationId: elsewhere },
+		].map((item) => ({
+			...item,
+			id: `${item.userId}-member`,
+			createdAt: new Date(),
+		})),
+	});
+});
+
+afterAll(async () => {
+	await db.organization.deleteMany({
+		where: { id: { in: [organization, elsewhere] } },
+	});
+	await db.user.deleteMany({
+		where: { id: { in: [active, idle, outsider, foreign] } },
+	});
+});
+
+describe("team presence", () => {
+	it("marks a member online after a heartbeat and shows the page they are on", async () => {
+		await service.heartbeat(active, {
+			path: "/real-estate/inbox",
+			label: "Boîte de réception",
+		});
+		await service.heartbeat(foreign);
+		const team = await service.team(active);
+		const byId = new Map(team.members.map((member) => [member.id, member]));
+
+		expect(byId.get(active)?.online).toBe(true);
+		expect(byId.get(active)?.isSelf).toBe(true);
+		expect(byId.get(active)?.page).toEqual({
+			path: "/real-estate/inbox",
+			label: "Boîte de réception",
+		});
+		expect(byId.get(idle)?.online).toBe(false);
+		expect(byId.get(idle)?.page).toBeNull();
+		expect(team.onlineCount).toBe(1);
+	});
+
+	it("never lists people from other organizations or without one", async () => {
+		const team = await service.team(active);
+		const ids = team.members.map((member) => member.id);
+
+		expect(ids).not.toContain(outsider);
+		expect(ids).not.toContain(foreign);
+		expect(
+			(await service.team(foreign)).members.map((member) => member.id),
+		).toEqual([foreign]);
+	});
+
+	it("keeps the last page when a heartbeat carries none", async () => {
+		await service.heartbeat(active);
+		const row = await db.user.findUniqueOrThrow({ where: { id: active } });
+
+		expect(row.lastSeenPath).toBe("/real-estate/inbox");
+		expect(row.lastSeenLabel).toBe("Boîte de réception");
+	});
+});
