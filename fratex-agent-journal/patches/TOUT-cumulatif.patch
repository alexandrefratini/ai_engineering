@@ -0,0 +1,131 @@
+import type { Db } from "@crm/db";
+import { googleAuthorizationResponse } from "@crm/validation/real-estate";
+import type { z } from "zod";
+import {
+	type CalendarConnectState,
+	readCalendarState,
+	signCalendarState,
+} from "./calendar-state";
+import { REAL_ESTATE } from "./real-estate-config";
+
+export type CalendarConnectFailure =
+	| "config"
+	| "expired"
+	| "realtor"
+	| "google"
+	| "scope";
+
+export type CalendarConnectResult =
+	| { ok: true }
+	| { ok: false; reason: CalendarConnectFailure };
+
+const failure = (reason: CalendarConnectFailure) =>
+	({ ok: false, reason }) as const;
+
+export function googleCredentials() {
+	const clientId = process.env.GOOGLE_CLIENT_ID?.trim();
+	const clientSecret = process.env.GOOGLE_CLIENT_SECRET?.trim();
+	return clientId && clientSecret ? { clientId, clientSecret } : null;
+}
+
+export function calendarOAuthAvailable() {
+	return Boolean(googleCredentials() && process.env.BETTER_AUTH_SECRET);
+}
+
+export function calendarRedirectUri() {
+	return `${process.env.API_URL ?? "http://localhost:3001"}${REAL_ESTATE.calendar.callbackPath}`;
+}
+
+export function buildCalendarConnectLink(
+	input: Pick<
+		CalendarConnectState,
+		"agencyId" | "clientId" | "hours" | "slotDuration"
+	>,
+) {
+	const google = googleCredentials();
+	const secret = process.env.BETTER_AUTH_SECRET;
+	if (!google || !secret) return { url: null, expiresAt: null };
+	const expiresAt = Date.now() + REAL_ESTATE.calendar.linkTtlMs;
+	const state = signCalendarState({ ...input, expiresAt }, secret);
+	const url = new URL(REAL_ESTATE.calendar.authorizeUrl);
+	url.search = new URLSearchParams({
+		client_id: google.clientId,
+		redirect_uri: calendarRedirectUri(),
+		response_type: "code",
+		access_type: "offline",
+		prompt: "consent",
+		include_granted_scopes: "true",
+		scope: REAL_ESTATE.calendar.scopes.join(" "),
+		state,
+	}).toString();
+	return {
+		url: url.toString(),
+		expiresAt: new Date(expiresAt).toISOString(),
+	};
+}
+
+async function exchangeAuthorizationCode(
+	google: { clientId: string; clientSecret: string },
+	code: string,
+): Promise<z.infer<typeof googleAuthorizationResponse> | null> {
+	try {
+		const response = await fetch(REAL_ESTATE.calendar.tokenUrl, {
+			method: "POST",
+			body: new URLSearchParams({
+				client_id: google.clientId,
+				client_secret: google.clientSecret,
+				code,
+				grant_type: "authorization_code",
+				redirect_uri: calendarRedirectUri(),
+			}),
+			signal: AbortSignal.timeout(REAL_ESTATE.calendar.timeoutMs),
+		});
+		if (!response.ok) return null;
+		const parsed = googleAuthorizationResponse.safeParse(await response.json());
+		return parsed.success ? parsed.data : null;
+	} catch {
+		return null;
+	}
+}
+
+export async function completeCalendarConnect(
+	db: Db,
+	code: string,
+	token: string,
+): Promise<CalendarConnectResult> {
+	const google = googleCredentials();
+	const secret = process.env.BETTER_AUTH_SECRET;
+	if (!google || !secret) return failure("config");
+	const state = readCalendarState(token, secret, Date.now());
+	if (!state) return failure("expired");
+	const client = await db.client.findFirst({
+		where: { agencyId: state.agencyId, id: state.clientId },
+		select: { id: true },
+	});
+	if (!client) return failure("realtor");
+	const tokens = await exchangeAuthorizationCode(google, code);
+	if (!tokens) return failure("google");
+	const granted = tokens.scope.split(" ");
+	if (
+		tokens.scope &&
+		!REAL_ESTATE.calendar.scopes.every((item) => granted.includes(item))
+	)
+		return failure("scope");
+	const data = {
+		agencyId: state.agencyId,
+		clientId: state.clientId,
+		provider: "google",
+		calendarId: REAL_ESTATE.calendar.calendarId,
+		accessToken: tokens.access_token,
+		refreshToken: tokens.refresh_token,
+		tokenExpiry: new Date(Date.now() + tokens.expires_in * 1000),
+		workingHours: state.hours,
+		slotDuration: state.slotDuration,
+	};
+	await db.realtorCalendar.upsert({
+		where: { clientId: state.clientId },
+		create: data,
+		update: data,
+	});
+	return { ok: true };
+}
