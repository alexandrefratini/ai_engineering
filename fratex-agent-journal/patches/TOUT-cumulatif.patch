+import { afterAll, beforeAll, describe, expect, it } from "bun:test";
+import { randomUUID } from "node:crypto";
+import { WORKSPACE_ID } from "@crm/auth";
+import { db } from "@crm/db";
+import { SupportService } from "../src/support/support.service";
+import { SUPPORT } from "../src/support/support-config";
+
+const suffix = randomUUID();
+const owner = `support-owner-${suffix}`;
+const member = `support-member-${suffix}`;
+const service = new SupportService(db);
+
+beforeAll(async () => {
+	await db.user.createMany({
+		data: [owner, member].map((id) => ({
+			id,
+			name: id,
+			email: `${id}@example.test`,
+		})),
+	});
+	await db.organization.upsert({
+		where: { id: WORKSPACE_ID },
+		update: {},
+		create: {
+			id: WORKSPACE_ID,
+			name: "Support",
+			slug: WORKSPACE_ID,
+			createdAt: new Date(),
+		},
+	});
+	await db.member.createMany({
+		data: [
+			{ userId: owner, role: "owner" },
+			{ userId: member, role: "member" },
+		].map((item) => ({
+			...item,
+			id: `${item.userId}-member`,
+			organizationId: WORKSPACE_ID,
+			createdAt: new Date(),
+		})),
+	});
+});
+
+afterAll(async () => {
+	await db.member.deleteMany({ where: { userId: { in: [owner, member] } } });
+	await db.user.deleteMany({ where: { id: { in: [owner, member] } } });
+});
+
+describe("support requests", () => {
+	it("stores a request with a subject taken from the first line", async () => {
+		const row = await service.create(member, {
+			kind: "PROBLEM",
+			message: `${"Le SMS ne part pas ".repeat(10)}\nDeuxième ligne`,
+			pagePath: "/real-estate/inbox",
+			viewport: "390x844",
+		});
+
+		expect(row.status).toBe("OPEN");
+		expect(row.subject.length).toBeLessThanOrEqual(SUPPORT.subjectMaxLength);
+		expect(row.subject.endsWith("…")).toBe(true);
+		expect(row.pagePath).toBe("/real-estate/inbox");
+		expect(row.author).toBeNull();
+	});
+
+	it("shows a member only their own requests and no triage rights", async () => {
+		await service.create(owner, {
+			kind: "IDEA",
+			message: "Ajouter un export des rendez-vous",
+		});
+		const mine = await service.mine(member);
+
+		expect(mine.canTriage).toBe(false);
+		expect(mine.rows.length).toBeGreaterThan(0);
+		expect(mine.rows.every((row) => row.author === null)).toBe(true);
+		expect(
+			mine.rows.some((row) => row.subject.includes("export des rendez-vous")),
+		).toBe(false);
+	});
+
+	it("limits how many requests one person can send per hour", async () => {
+		const spammer = `support-spam-${suffix}`;
+		await db.user.create({
+			data: { id: spammer, name: spammer, email: `${spammer}@example.test` },
+		});
+		for (let index = 0; index < SUPPORT.hourlyLimit; index += 1)
+			await service.create(spammer, {
+				kind: "QUESTION",
+				message: `Question numéro ${index} sur le portail`,
+			});
+
+		await expect(
+			service.create(spammer, {
+				kind: "QUESTION",
+				message: "Une question de trop sur le portail",
+			}),
+		).rejects.toThrow();
+		await db.user.delete({ where: { id: spammer } });
+	});
+
+	it("lets only an owner or admin read and triage the team requests", async () => {
+		await expect(service.team(member)).rejects.toThrow();
+		const team = await service.team(owner);
+		const target = team.rows.find((row) => row.author?.name === member);
+
+		expect(target).toBeDefined();
+		if (!target) return;
+		const updated = await service.setStatus(owner, {
+			id: target.id,
+			status: "RESOLVED",
+		});
+
+		expect(updated.status).toBe("RESOLVED");
+		await expect(
+			service.setStatus(member, { id: target.id, status: "OPEN" }),
+		).rejects.toThrow();
+	});
+});
