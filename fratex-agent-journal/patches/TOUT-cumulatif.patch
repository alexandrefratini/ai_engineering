+"use client";
+
+import { Button } from "@crm/ui/components/button";
+import {
+	RealEstateHome,
+	type RealEstateHomeData,
+} from "@crm/ui/components/real-estate-home";
+import {
+	WorkspaceLoading,
+	WorkspaceNotice,
+} from "@crm/ui/components/real-estate-workspace";
+import { useQuery } from "@tanstack/react-query";
+import Link from "next/link";
+import { useRouter } from "next/navigation";
+import { useQueryState } from "nuqs";
+import { SEARCH_PARAM } from "@/lib/search-param-keys";
+import { useTRPC } from "@/lib/trpc/client";
+import { useWorkspaceUrl } from "@/lib/use-workspace-url";
+import { overviewParsers } from "./overview-search-params";
+import { AgencySlot } from "./real-estate/agency-slot";
+import { useAgency } from "./real-estate/use-agency";
+import { REAL_ESTATE } from "./real-estate/workspace-config";
+
+export function RealEstateHomeView() {
+	const trpc = useTRPC();
+	const router = useRouter();
+	const href = useWorkspaceUrl();
+	const agency = useAgency();
+	const [scope] = useQueryState(
+		SEARCH_PARAM.overview.scope,
+		overviewParsers[SEARCH_PARAM.overview.scope],
+	);
+	const query = useQuery(
+		trpc.realEstate.home.queryOptions(
+			{ agencyId: agency.agencyId, scope },
+			{
+				enabled: Boolean(agency.agencyId),
+				refetchInterval: REAL_ESTATE.pollingMs,
+				placeholderData: (previous) => previous,
+			},
+		),
+	);
+	const agencyQuery = `agencyId=${agency.agencyId}`;
+	const data: RealEstateHomeData | undefined = query.data && {
+		...query.data,
+		toDo: query.data.toDo.map((item) => ({
+			...item,
+			at: new Date(item.at).toISOString(),
+		})),
+		appointments: query.data.appointments.map((item) => ({
+			...item,
+			startTime: new Date(item.startTime).toISOString(),
+		})),
+	};
+
+	return (
+		<div className="flex flex-col gap-4">
+			<AgencySlot scope={agency} />
+			{agency.agencyId &&
+				(query.error ? (
+					<WorkspaceNotice
+						title="Accueil indisponible"
+						error={query.error.message}
+						onRetry={() => {
+							void query.refetch();
+						}}
+					/>
+				) : !data ? (
+					<WorkspaceLoading />
+				) : (
+					<>
+						{query.data?.scope.notice && (
+							<p className="text-sm text-muted-foreground">
+								{query.data.scope.notice}
+							</p>
+						)}
+						<RealEstateHome
+							data={data}
+							onOpenLead={(leadId) =>
+								router.push(href(`/real-estate/leads/${leadId}?${agencyQuery}`))
+							}
+							onOpenStage={(status) =>
+								router.push(
+									href(`/real-estate/leads?${agencyQuery}&status=${status}`),
+								)
+							}
+							inboxLink={
+								<Button asChild variant="ghost" size="sm">
+									<Link href={href(`/real-estate/inbox?${agencyQuery}`)}>
+										Boîte de réception
+									</Link>
+								</Button>
+							}
+							pipelineLink={
+								<Button asChild variant="ghost" size="sm">
+									<Link href={href(`/real-estate/pipeline?${agencyQuery}`)}>
+										Voir le pipeline
+									</Link>
+								</Button>
+							}
+						/>
+					</>
+				))}
+		</div>
+	);
+}
