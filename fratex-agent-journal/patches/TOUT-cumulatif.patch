+"use client";
+
+import ArrowLeft from "@carbon/icons-react/es/ArrowLeft";
+import Group from "@carbon/icons-react/es/Group";
+import { Button } from "@crm/ui/components/button";
+import { ContactLink } from "@crm/ui/components/contact-link";
+import { EmptyState } from "@crm/ui/components/empty-state";
+import { Icon } from "@crm/ui/components/icon";
+import { Panel } from "@crm/ui/components/panel";
+import { MetricGrid, MetricTile } from "@crm/ui/components/real-estate-visuals";
+import {
+	Tabs,
+	TabsContent,
+	TabsList,
+	TabsTrigger,
+} from "@crm/ui/components/tabs";
+import {
+	MemberAccess,
+	MemberTasks,
+	MemberTimeline,
+	type TimelineEntry,
+} from "@crm/ui/components/team-member-detail";
+import { MemberAvatar } from "@crm/ui/components/team-roster";
+import { LAYOUT } from "@crm/ui/lib/layout";
+import {
+	formatDate,
+	labelOf,
+	MESSAGE_STATUS_LABELS,
+} from "@crm/ui/lib/real-estate";
+import { useQuery } from "@tanstack/react-query";
+import Link from "next/link";
+import { LocalRelativeTime } from "@/components/local-date-time";
+import {
+	ACTIVITY_TYPE_LABELS,
+	AGENCY_ROLE_LABELS,
+	TEAM_COPY,
+	TIMELINE_KIND_LABELS,
+	WORKSPACE_ROLE_HELP,
+	WORKSPACE_ROLE_LABELS,
+} from "@/lib/team-config";
+import { roleLabelOf } from "@/lib/team-roles";
+import { useTRPC } from "@/lib/trpc/client";
+import type { RouterOutputs } from "@/lib/trpc/types";
+import { useWorkspaceUrl } from "@/lib/use-workspace-url";
+
+type Detail = RouterOutputs["team"]["member"];
+type Item = Detail["timeline"][number];
+
+function kindLabelOf(item: Item): string {
+	if (item.kind === "ACTIVITY")
+		return ACTIVITY_TYPE_LABELS[item.activityType ?? ""] ?? "Activité";
+	return TIMELINE_KIND_LABELS[item.kind];
+}
+
+function detailOf(item: Item): string | null {
+	if (item.kind === "SMS")
+		return labelOf(MESSAGE_STATUS_LABELS, item.detail ?? "");
+	return item.detail;
+}
+
+export function MemberView({ userId }: { userId: string }) {
+	const trpc = useTRPC();
+	const href = useWorkspaceUrl();
+	const query = useQuery(trpc.team.member.queryOptions({ userId }));
+	const back = (
+		<Button asChild variant="ghost" size="sm" className="-ml-2 self-start">
+			<Link href={href("/team")}>
+				<Icon icon={ArrowLeft} />
+				{TEAM_COPY.back}
+			</Link>
+		</Button>
+	);
+
+	if (query.isError)
+		return (
+			<div className={LAYOUT.stack}>
+				{back}
+				<EmptyState
+					icon={Group}
+					title={TEAM_COPY.notFound.title}
+					description={TEAM_COPY.notFound.description}
+				/>
+			</div>
+		);
+
+	const data = query.data;
+	if (!data)
+		return (
+			<div className={LAYOUT.stack}>
+				{back}
+				<div className="h-40 animate-pulse rounded-lg border bg-card" />
+			</div>
+		);
+
+	const { member, stats, windowDays } = data;
+	const windowHint = TEAM_COPY.tileHints.window(windowDays);
+	const timeline: TimelineEntry[] = data.timeline.map((item) => ({
+		id: item.id,
+		at: item.at,
+		kind: item.kind,
+		kindLabel: kindLabelOf(item),
+		title: item.title,
+		detail: detailOf(item),
+		href:
+			item.leadId && item.agencyId
+				? href(`/real-estate/leads/${item.leadId}?agencyId=${item.agencyId}`)
+				: item.kind === "SUPPORT"
+					? href("/support")
+					: null,
+	}));
+	const roleLabel = roleLabelOf(member.workspaceRole, member.agencyRoles);
+	const workspaceRoleLabel =
+		WORKSPACE_ROLE_LABELS[member.workspaceRole] ?? member.workspaceRole;
+
+	return (
+		<div className={LAYOUT.stack}>
+			{back}
+
+			<Panel title={TEAM_COPY.profile}>
+				<div className="flex items-center gap-4">
+					<MemberAvatar
+						name={member.name}
+						image={member.image}
+						online={member.online}
+						size="lg"
+					/>
+					<div className="flex min-w-0 flex-col gap-0.5">
+						<h1 translate="no" className="truncate font-medium text-lg">
+							{member.name}
+							{member.isViewer && (
+								<span className="font-normal text-muted-foreground">
+									{" "}
+									(vous)
+								</span>
+							)}
+						</h1>
+						<span className="flex flex-wrap items-center gap-x-2 text-sm text-muted-foreground">
+							<span>{roleLabel}</span>
+							<span aria-hidden="true">·</span>
+							<ContactLink
+								kind="email"
+								value={member.email}
+								className="truncate"
+							/>
+							<span aria-hidden="true">·</span>
+							<span>
+								{member.online ? (
+									TEAM_COPY.onlineLabel
+								) : member.lastSeenAt ? (
+									<LocalRelativeTime date={member.lastSeenAt} />
+								) : (
+									TEAM_COPY.neverLabel
+								)}
+							</span>
+						</span>
+					</div>
+				</div>
+			</Panel>
+
+			<MetricGrid>
+				<MetricTile
+					index={0}
+					label={TEAM_COPY.tiles.open}
+					value={stats.openTasks}
+				/>
+				<MetricTile
+					index={1}
+					label={TEAM_COPY.tiles.overdue}
+					value={stats.overdueTasks}
+				/>
+				<MetricTile
+					index={2}
+					label={TEAM_COPY.tiles.done}
+					value={stats.doneTasks}
+					hint={windowHint}
+				/>
+				<MetricTile
+					index={3}
+					label={TEAM_COPY.tiles.leads}
+					value={stats.leadsFollowed ?? "—"}
+					hint={
+						stats.leadsFollowed === null ? TEAM_COPY.unavailable : undefined
+					}
+					info={TEAM_COPY.tileHints.leads}
+				/>
+				<MetricTile
+					index={4}
+					label={TEAM_COPY.tiles.notes}
+					value={stats.notes}
+					hint={windowHint}
+				/>
+				<MetricTile
+					index={5}
+					label={TEAM_COPY.tiles.sms}
+					value={stats.sms}
+					hint={windowHint}
+				/>
+				<MetricTile
+					index={6}
+					label={TEAM_COPY.tiles.conversations}
+					value={stats.conversations}
+					hint={windowHint}
+				/>
+				<MetricTile
+					index={7}
+					label={TEAM_COPY.tiles.support}
+					value={stats.supportOpen}
+				/>
+			</MetricGrid>
+
+			<Panel index={2} title={TEAM_COPY.detail}>
+				<Tabs defaultValue="activity">
+					<TabsList variant="line" className="gap-3">
+						<TabsTrigger value="activity">
+							{TEAM_COPY.tabs.activity}
+						</TabsTrigger>
+						<TabsTrigger value="tasks">{TEAM_COPY.tabs.tasks}</TabsTrigger>
+						<TabsTrigger value="access">{TEAM_COPY.tabs.access}</TabsTrigger>
+					</TabsList>
+					<TabsContent value="activity" className="pt-2">
+						<MemberTimeline
+							items={timeline}
+							renderLink={(target, children) => (
+								<Link
+									href={target}
+									className="-mx-2 block rounded-md px-2 transition-colors hover:bg-muted/50 focus-visible:outline-2 focus-visible:outline-ring"
+								>
+									{children}
+								</Link>
+							)}
+							renderTime={(iso) => <LocalRelativeTime date={iso} />}
+							empty={TEAM_COPY.timelineEmpty}
+						/>
+					</TabsContent>
+					<TabsContent value="tasks" className="pt-2">
+						<MemberTasks
+							tasks={data.tasks}
+							renderTime={(iso) => <LocalRelativeTime date={iso} />}
+							labels={TEAM_COPY.tasks}
+						/>
+					</TabsContent>
+					<TabsContent value="access" className="pt-2">
+						<MemberAccess
+							rows={[
+								{
+									label: TEAM_COPY.access.workspaceRole,
+									value: workspaceRoleLabel,
+								},
+								{
+									label: TEAM_COPY.access.permissions,
+									value: WORKSPACE_ROLE_HELP[member.workspaceRole] ?? "",
+								},
+								{ label: TEAM_COPY.access.email, value: member.email },
+								{
+									label: TEAM_COPY.access.joined,
+									value: formatDate(member.joinedAt),
+								},
+							]}
+							agencies={member.agencyRoles.map((item) => ({
+								agencyId: item.agencyId,
+								agencyName: item.agencyName,
+								roleLabel: AGENCY_ROLE_LABELS[item.role] ?? item.role,
+								clientName: item.clientName,
+							}))}
+							agenciesTitle={TEAM_COPY.access.agencies}
+							noAgencies={TEAM_COPY.access.noAgencies}
+						/>
+					</TabsContent>
+				</Tabs>
+			</Panel>
+		</div>
