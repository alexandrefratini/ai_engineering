--- /dev/null
+++ b/apps/api/src/support/support.contracts.ts
@@ -0,0 +1,53 @@
+import { z } from "zod";
+import { SUPPORT } from "./support-config";
+
+export const supportKindEnum = z.enum(SUPPORT.kinds);
+export const supportStatusEnum = z.enum(SUPPORT.statuses);
+
+export const createSupportRequestInput = z.object({
+	kind: supportKindEnum,
+	message: z
+		.string()
+		.trim()
+		.min(SUPPORT.messageMinLength)
+		.max(SUPPORT.messageMaxLength),
+	pagePath: z
+		.string()
+		.trim()
+		.max(SUPPORT.pathMaxLength)
+		.regex(/^\//)
+		.optional(),
+	viewport: z
+		.string()
+		.trim()
+		.max(20)
+		.regex(/^\d{2,5}x\d{2,5}$/)
+		.optional(),
+});
+
+export const setSupportStatusInput = z.object({
+	id: z.string().min(1),
+	status: supportStatusEnum,
+});
+
+export const supportRequestOutput = z.object({
+	id: z.string(),
+	kind: supportKindEnum,
+	status: supportStatusEnum,
+	subject: z.string(),
+	message: z.string(),
+	pagePath: z.string().nullable(),
+	createdAt: z.string(),
+	author: z.object({ name: z.string(), email: z.string() }).nullable(),
+});
+
+export const supportListOutput = z.object({
+	rows: z.array(supportRequestOutput),
+	canTriage: z.boolean(),
+});
+
+export type CreateSupportRequestInput = z.infer<
+	typeof createSupportRequestInput
+>;
+export type SetSupportStatusInput = z.infer<typeof setSupportStatusInput>;
+export type SupportRequestRow = z.infer<typeof supportRequestOutput>;
