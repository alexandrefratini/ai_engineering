--- /dev/null
+++ b/apps/api/src/real-estate/real-estate-metrics.ts
@@ -0,0 +1,91 @@
+function zonedParts(value: Date, timeZone: string) {
+	const parts = new Intl.DateTimeFormat("en-CA", {
+		timeZone,
+		year: "numeric",
+		month: "2-digit",
+		day: "2-digit",
+		hour: "2-digit",
+		minute: "2-digit",
+		second: "2-digit",
+		hourCycle: "h23",
+	}).formatToParts(value);
+	const read = (type: Intl.DateTimeFormatPartTypes) =>
+		Number(parts.find((part) => part.type === type)?.value ?? 0);
+	return {
+		year: read("year"),
+		month: read("month"),
+		day: read("day"),
+		hour: read("hour"),
+		minute: read("minute"),
+		second: read("second"),
+	};
+}
+
+function offsetMs(value: Date, timeZone: string): number {
+	const parts = zonedParts(value, timeZone);
+	const wall = Date.UTC(
+		parts.year,
+		parts.month - 1,
+		parts.day,
+		parts.hour,
+		parts.minute,
+		parts.second,
+	);
+	return wall - Math.floor(value.getTime() / 1000) * 1000;
+}
+
+export function zonedDayKey(value: Date, timeZone: string): string {
+	const parts = zonedParts(value, timeZone);
+	return `${parts.year}-${String(parts.month).padStart(2, "0")}-${String(parts.day).padStart(2, "0")}`;
+}
+
+export function shiftDayKey(day: string, days: number): string {
+	const [year, month, date] = day.split("-").map(Number);
+	return new Date(Date.UTC(year ?? 0, (month ?? 1) - 1, (date ?? 1) + days))
+		.toISOString()
+		.slice(0, 10);
+}
+
+export function zonedMidnight(day: string, timeZone: string): Date {
+	const [year, month, date] = day.split("-").map(Number);
+	const guess = Date.UTC(year ?? 0, (month ?? 1) - 1, date ?? 1);
+	const first = guess - offsetMs(new Date(guess), timeZone);
+	return new Date(guess - offsetMs(new Date(first), timeZone));
+}
+
+export function zonedMonthStart(value: Date, timeZone: string): string {
+	return `${zonedDayKey(value, timeZone).slice(0, 7)}-01`;
+}
+
+export function dayRange(from: string, to: string): string[] {
+	const days: string[] = [];
+	for (let day = from; day <= to; day = shiftDayKey(day, 1)) days.push(day);
+	return days;
+}
+
+export function dailyCounts(
+	values: Date[],
+	days: string[],
+	timeZone: string,
+): { day: string; count: number }[] {
+	const counts = new Map(days.map((day) => [day, 0]));
+	for (const value of values) {
+		const day = zonedDayKey(value, timeZone);
+		const current = counts.get(day);
+		if (current !== undefined) counts.set(day, current + 1);
+	}
+	return days.map((day) => ({ day, count: counts.get(day) ?? 0 }));
+}
+
+export function median(values: number[]): number | null {
+	if (!values.length) return null;
+	const sorted = [...values].sort((a, b) => a - b);
+	const middle = Math.floor(sorted.length / 2);
+	return sorted.length % 2
+		? (sorted[middle] ?? null)
+		: ((sorted[middle - 1] ?? 0) + (sorted[middle] ?? 0)) / 2;
+}
+
+export function percentOf(part: number, total: number): number | null {
+	return total ? Math.round((part / total) * 1000) / 10 : null;
+}
diff --git a/apps/api/src/real-estate/real-estate-portal.ts b/apps/api/src/real-estate/real-estate-portal.ts
new file mode 100644
index 0000000..ff18c3e
--- /dev/null
+++ b/apps/api/src/real-estate/real-estate-portal.ts
@@ -0,0 +1,274 @@
+import type { Db, LeadModel } from "@crm/db";
+import type { RealtorPortalInput } from "./real-estate.contracts";
+import {
+	FUNNEL_STAGES,
+	MINUTE_MS,
+	REAL_ESTATE,
+	REAL_ESTATE_LABELS,
+	STAGE_RANK,
+	UPCOMING_APPOINTMENT_STATUSES,
+} from "./real-estate-config";
+import {
+	dailyCounts,
+	dayRange,
+	median,
+	percentOf,
+	shiftDayKey,
+	zonedDayKey,
+	zonedMidnight,
+	zonedMonthStart,
+} from "./real-estate-metrics";
+
+type PortalClient = {
+	id: string;
+	name: string;
+	email: string;
+	phone: string | null;
+	targetZones: string[];
+	brokerage: string | null;
+	timezone: string;
+};
+
+type Period = RealtorPortalInput["period"];
+
+function validZone(timeZone: string) {
+	try {
+		new Intl.DateTimeFormat("fr-CA", { timeZone });
+		return timeZone;
+	} catch {
+		return REAL_ESTATE.home.timeZone;
+	}
+}
+
+function firstDay(period: Period, todayKey: string, now: Date, zone: string) {
+	if (period === "MONTH") return zonedMonthStart(now, zone);
+	return shiftDayKey(todayKey, 1 - REAL_ESTATE.portal.periodDays[period]);
+}
+
+function reachedRank(lead: {
+	status: LeadModel["status"];
+	firstContactedAt: Date | null;
+	attributions: { eventType: string }[];
+	appointments: { status: string }[];
+}) {
+	const ranks: number[] = [
+		STAGE_RANK.status[lead.status as keyof typeof STAGE_RANK.status] ?? 0,
+		lead.firstContactedAt ? STAGE_RANK.contacted : 0,
+		...lead.attributions.map(
+			(item) =>
+				STAGE_RANK.event[item.eventType as keyof typeof STAGE_RANK.event] ?? 0,
+		),
+		...lead.appointments.map(
+			(item) =>
+				STAGE_RANK.appointment[
+					item.status as keyof typeof STAGE_RANK.appointment
+				] ?? 0,
+		),
+	];
+	return Math.max(...ranks);
+}
+
+function breakdown(values: string[], labels: Record<string, string>) {
+	const counts = new Map<string, number>();
+	for (const value of values) counts.set(value, (counts.get(value) ?? 0) + 1);
+	return [...counts.entries()]
+		.map(([id, count]) => ({ id, label: labels[id] ?? id, count }))
+		.sort(
+			(a, b) => b.count - a.count || a.label.localeCompare(b.label, "fr-CA"),
+		);
+}
+
+function leadName(lead: { firstName: string; lastName: string | null }) {
+	return [lead.firstName, lead.lastName].filter(Boolean).join(" ");
+}
+
+export async function buildPortal(
+	db: Db,
+	agencyId: string,
+	agencyName: string,
+	client: PortalClient,
+	period: Period,
+	now = new Date(),
+) {
+	const zone = validZone(client.timezone);
+	const todayKey = zonedDayKey(now, zone);
+	const startDay = firstDay(period, todayKey, now, zone);
+	const days = dayRange(startDay, todayKey);
+	const periodStart = zonedMidnight(startDay, zone);
+	const scope = { agencyId, clientId: client.id };
+	const [leads, senders, upcoming, recent, escalated] = await Promise.all([
+		db.lead.findMany({
+			where: { ...scope, createdAt: { gte: periodStart, lte: now } },
+			select: {
+				status: true,
+				createdAt: true,
+				firstContactedAt: true,
+				intent: true,
+				source: true,
+				metaLeadgenId: true,
+				metaFormId: true,
+				campaignId: true,
+				budgetMax: true,
+				attributions: { where: { agencyId }, select: { eventType: true } },
+				appointments: {
+					where: { agencyId, status: { not: "CANCELLED" } },
+					select: { status: true },
+				},
+			},
+		}),
+		db.message.groupBy({
+			by: ["sender"],
+			where: {
+				agencyId,
+				sentAt: { gte: periodStart, lte: now },
+				conversation: { lead: { clientId: client.id } },
+			},
+			_count: { id: true },
+		}),
+		db.appointment.findMany({
+			where: {
+				...scope,
+				status: { in: [...UPCOMING_APPOINTMENT_STATUSES] },
+				startTime: { gte: now },
+			},
+			orderBy: { startTime: "asc" },
+			take: REAL_ESTATE.portal.upcomingLimit,
+			select: {
+				id: true,
+				leadId: true,
+				title: true,
+				startTime: true,
+				endTime: true,
+				status: true,
+				description: true,
+				lead: { select: { firstName: true, lastName: true } },
+			},
+		}),
+		db.lead.findMany({
+			where: scope,
+			include: { client: { select: { name: true } } },
+			orderBy: [{ createdAt: "desc" }, { id: "desc" }],
+			take: REAL_ESTATE.portal.recentLimit,
+		}),
+		db.lead.findMany({
+			where: {
+				...scope,
+				automationPausedAt: { not: null },
+				escalationReason: { not: null },
+			},
+			orderBy: { automationPausedAt: "desc" },
+			take: REAL_ESTATE.portal.recentLimit,
+		}),
+	]);
+	const ranked = leads.map((lead) => ({ lead, rank: reachedRank(lead) }));
+	const funnel = FUNNEL_STAGES.map((id, index) => {
+		const count = ranked.filter((item) => item.rank >= index).length;
+		return {
+			id,
+			label: REAL_ESTATE_LABELS.funnel[id],
+			count,
+			pctOfReceived: percentOf(count, leads.length),
+		};
+	});
+	const count = (id: (typeof FUNNEL_STAGES)[number]) =>
+		funnel.find((stage) => stage.id === id)?.count ?? 0;
+	const delays = leads.flatMap((lead) =>
+		lead.firstContactedAt
+			? [
+					Math.max(
+						0,
+						(lead.firstContactedAt.getTime() - lead.createdAt.getTime()) /
+							MINUTE_MS,
+					),
+				]
+			: [],
+	);
+	const medianDelay = median(delays);
+	const budgets = ranked
+		.filter((item) => item.rank >= STAGE_RANK.qualified)
+		.flatMap((item) =>
+			item.lead.budgetMax === null ? [] : [item.lead.budgetMax],
+		);
+	const sent = new Map(senders.map((row) => [row.sender, row._count.id]));
+	return {
+		agencyName,
+		client: {
+			id: client.id,
+			name: client.name,
+			email: client.email,
+			phone: client.phone,
+			targetZones: client.targetZones,
+			brokerage: client.brokerage,
+		},
+		period,
+		periodLabel: REAL_ESTATE_LABELS.periods[period],
+		periodStart,
+		periodEnd: now,
+		funnel,
+		speed: {
+			medianMinutes:
+				medianDelay === null ? null : Math.round(medianDelay * 10) / 10,
+			fastSharePct: percentOf(
+				delays.filter((delay) => delay < REAL_ESTATE.portal.fastResponseMinutes)
+					.length,
+				delays.length,
+			),
+			fastThresholdMinutes: REAL_ESTATE.portal.fastResponseMinutes,
+			measured: delays.length,
+		},
+		trend: dailyCounts(
+			leads.map((lead) => lead.createdAt),
+			days,
+			zone,
+		),
+		intents: breakdown(
+			leads.map((lead) => lead.intent),
+			REAL_ESTATE_LABELS.intents,
+		),
+		sources: breakdown(
+			leads.map(
+				(lead) =>
+					lead.source ??
+					(lead.metaLeadgenId || lead.metaFormId || lead.campaignId
+						? "META"
+						: "UNKNOWN"),
+			),
+			REAL_ESTATE_LABELS.sources,
+		),
+		budgets: {
+			confirmed: budgets.length,
+			medianMax: median(budgets),
+			totalMax: budgets.reduce((sum, value) => sum + value, 0),
+		},
+		messages: {
+			ai: sent.get("AI_SDR") ?? 0,
+			team: sent.get("HUMAN_AGENT") ?? 0,
+			replies: sent.get("LEAD") ?? 0,
+		},
+		upcomingAppointments: upcoming.map(({ lead, ...item }) => ({
+			...item,
+			leadName: leadName(lead),
+		})),
+		beforeFratex: null,
+		afterFratex: {
+			totalLeads: leads.length,
+			qualifiedLeads: count("QUALIFIED"),
+			appointmentsBooked: count("APPOINTMENT"),
+			conversionRatePct: percentOf(count("QUALIFIED"), leads.length) ?? 0,
+			appointmentRatePct: percentOf(count("APPOINTMENT"), leads.length),
+			hoursSavedPerWeek: null,
+			projectedCommission: null,
+		},
+		pendingRequests: escalated.map((lead) => ({
+			id: lead.id,
+			type: "LEAD_REVIEW" as const,
+			title: `Reprise humaine : ${lead.firstName}`,
+			description: lead.escalationReason ?? "",
+			createdAt: lead.automationPausedAt ?? lead.updatedAt,
+		})),
+		recentLeads: recent.map((lead) => ({
+			...lead,
+			clientName: lead.client?.name ?? null,
+		})),
+	};
+}
diff --git a/apps/api/src/real-estate/real-estate-tools.ts b/apps/api/src/real-estate/real-estate-tools.ts
new file mode 100644
index 0000000..4a253ec
--- /dev/null
+++ b/apps/api/src/real-estate/real-estate-tools.ts
@@ -0,0 +1,275 @@
+import type { Db, Prisma } from "@crm/db";
+import { lockIdempotencyKey } from "@crm/db/idempotency";
+import { queueSdrTask } from "@crm/db/real-estate";
+import {
+	BadRequestException,
+	ForbiddenException,
+	NotFoundException,
+} from "@nestjs/common";
+import type {
+	AddLeadNoteInput,
+	CreateAppointmentInput,
+	CreateLeadInput,
+	ReassignLeadInput,
+	UpdateAppointmentStatusInput,
+} from "./real-estate.contracts";
+import { MINUTE_MS } from "./real-estate-config";
+
+export type ToolScope = { agencyId: string; clientId?: string | null };
+
+type Conversion = "APPOINTMENT_SCHEDULED" | "APPOINTMENT_HELD";
+
+async function recordConversion(
+	tx: Prisma.TransactionClient,
+	agencyId: string,
+	leadId: string,
+	id: string,
+	eventType: Conversion,
+) {
+	const attribution = await tx.attributionEvent.upsert({
+		where: { id },
+		update: {},
+		create: { id, agencyId, leadId, eventType },
+	});
+	await queueSdrTask(tx, {
+		agencyId,
+		leadId,
+		kind: "real-estate-capi",
+		key: `capi:${attribution.id}`,
+		payload: { agencyId, eventId: attribution.id },
+	});
+}
+
+async function scopedLead(db: Db, scope: ToolScope, leadId: string) {
+	const lead = await db.lead.findFirst({
+		where: {
+			id: leadId,
+			agencyId: scope.agencyId,
+			clientId: scope.clientId ?? undefined,
+		},
+		select: { id: true, clientId: true, status: true },
+	});
+	if (!lead) throw new NotFoundException("Lead not found.");
+	return lead;
+}
+
+export async function createLeadRecord(
+	db: Db,
+	scope: ToolScope,
+	userId: string,
+	input: CreateLeadInput,
+) {
+	const clientId = scope.clientId ?? input.clientId ?? null;
+	if (
+		clientId &&
+		!(await db.client.findFirst({
+			where: { agencyId: scope.agencyId, id: clientId },
+			select: { id: true },
+		}))
+	)
+		throw new NotFoundException("Realtor not found.");
+	return db.$transaction(async (tx) => {
+		await lockIdempotencyKey(tx, `phone:${scope.agencyId}:${input.phone}`);
+		const existing = await tx.lead.findFirst({
+			where: { agencyId: scope.agencyId, phone: input.phone },
+			select: { id: true, clientId: true },
+		});
+		if (existing)
+			return {
+				id:
+					!scope.clientId || existing.clientId === scope.clientId
+						? existing.id
+						: null,
+				duplicate: true,
+				assistantQueued: false,
+			};
+		const lead = await tx.lead.create({
+			data: {
+				agencyId: scope.agencyId,
+				clientId,
+				firstName: input.firstName,
+				lastName: input.lastName || null,
+				phone: input.phone,
+				email: input.email || null,
+				intent: input.intent,
+				source: input.source,
+				consentedAt: input.smsConsent ? new Date() : null,
+				consentSource: input.smsConsent ? `manual:${userId}` : null,
+			},
+			select: { id: true },
+		});
+		await tx.attributionEvent.create({
+			data: {
+				id: `created:${lead.id}`,
+				agencyId: scope.agencyId,
+				leadId: lead.id,
+				eventType: "LEAD_CREATED",
+			},
+		});
+		if (input.note)
+			await tx.leadNote.create({
+				data: {
+					agencyId: scope.agencyId,
+					leadId: lead.id,
+					authorId: userId,
+					body: input.note,
+				},
+			});
+		const assistantQueued = input.startAssistant && input.smsConsent;
+		if (assistantQueued)
+			await queueSdrTask(tx, {
+				agencyId: scope.agencyId,
+				leadId: lead.id,
+				kind: "real-estate-qualify",
+				key: `qualify:manual:${lead.id}`,
+				payload: { agencyId: scope.agencyId, leadId: lead.id },
+			});
+		return { id: lead.id, duplicate: false, assistantQueued };
+	});
+}
+
+export async function addLeadNoteRecord(
+	db: Db,
+	scope: ToolScope,
+	userId: string,
+	input: AddLeadNoteInput,
+) {
+	const lead = await scopedLead(db, scope, input.leadId);
+	const note = await db.leadNote.create({
+		data: {
+			agencyId: scope.agencyId,
+			leadId: lead.id,
+			authorId: userId,
+			body: input.body,
+		},
+		include: { author: { select: { name: true } } },
+	});
+	return {
+		id: note.id,
+		body: note.body,
+		createdAt: note.createdAt,
+		authorName: note.author?.name ?? null,
+	};
+}
+
+export async function createAppointmentRecord(
+	db: Db,
+	scope: ToolScope,
+	input: CreateAppointmentInput,
+) {
+	const lead = await scopedLead(db, scope, input.leadId);
+	if (!lead.clientId)
+		throw new BadRequestException(
+			"Assignez d'abord un courtier à ce prospect.",
+		);
+	const clientId = lead.clientId;
+	const startTime = new Date(input.startTime);
+	const endTime = new Date(
+		startTime.getTime() + input.durationMinutes * MINUTE_MS,
+	);
+	return db.$transaction(async (tx) => {
+		const appointment = await tx.appointment.create({
+			data: {
+				agencyId: scope.agencyId,
+				leadId: lead.id,
+				clientId,
+				title: input.title,
+				description: input.location || null,
+				startTime,
+				endTime,
+				status: "CONFIRMED",
+			},
+			select: { id: true },
+		});
+		if (lead.status !== "APPOINTMENT_HELD")
+			await tx.lead.update({
+				where: { id: lead.id, agencyId: scope.agencyId },
+				data: { status: "APPOINTMENT_BOOKED" },
+			});
+		await recordConversion(
+			tx,
+			scope.agencyId,
+			lead.id,
+			`appointment:${appointment.id}`,
+			"APPOINTMENT_SCHEDULED",
+		);
+		return appointment;
+	});
+}
+
+export async function updateAppointmentStatusRecord(
+	db: Db,
+	scope: ToolScope,
+	input: UpdateAppointmentStatusInput,
+) {
+	const appointment = await db.appointment.findFirst({
+		where: {
+			id: input.appointmentId,
+			agencyId: scope.agencyId,
+			clientId: scope.clientId ?? undefined,
+		},
+		select: { id: true, leadId: true },
+	});
+	if (!appointment) throw new NotFoundException("Appointment not found.");
+	await db.$transaction(async (tx) => {
+		await tx.appointment.update({
+			where: { id: appointment.id, agencyId: scope.agencyId },
+			data: { status: input.status },
+		});
+		const lead = await tx.lead.findFirstOrThrow({
+			where: { id: appointment.leadId, agencyId: scope.agencyId },
+			select: { status: true },
+		});
+		if (input.status === "COMPLETED") {
+			await tx.lead.update({
+				where: { id: appointment.leadId, agencyId: scope.agencyId },
+				data: { status: "APPOINTMENT_HELD" },
+			});
+			await recordConversion(
+				tx,
+				scope.agencyId,
+				appointment.leadId,
+				`held:${appointment.id}`,
+				"APPOINTMENT_HELD",
+			);
+		}
+		if (
+			(input.status === "NO_SHOW" || input.status === "CANCELLED") &&
+			lead.status === "APPOINTMENT_BOOKED" &&
+			!(await tx.appointment.count({
+				where: {
+					agencyId: scope.agencyId,
+					leadId: appointment.leadId,
+					status: { in: ["SCHEDULED", "CONFIRMED"] },
+				},
+			}))
+		)
+			await tx.lead.update({
+				where: { id: appointment.leadId, agencyId: scope.agencyId },
+				data: { status: "QUALIFIED" },
+			});
+	});
+	return { id: appointment.id };
+}
+
+export async function reassignLeadRecord(
+	db: Db,
+	scope: ToolScope,
+	input: ReassignLeadInput,
+) {
+	if (scope.clientId)
+		throw new ForbiddenException("Agency staff reassign leads.");
+	const lead = await scopedLead(db, scope, input.leadId);
+	if (
+		!(await db.client.findFirst({
+			where: { agencyId: scope.agencyId, id: input.clientId },
+			select: { id: true },
+		}))
+	)
+		throw new NotFoundException("Realtor not found.");
+	await db.lead.update({
+		where: { id: lead.id, agencyId: scope.agencyId },
+		data: { clientId: input.clientId },
+	});
+	return { id: lead.id };
+}
