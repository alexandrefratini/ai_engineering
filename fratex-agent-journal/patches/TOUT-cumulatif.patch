+++ b/packages/ui/src/components/support-request-form.tsx
@@ -0,0 +1,147 @@
+"use client";
+
+import Help from "@carbon/icons-react/es/Help";
+import Idea from "@carbon/icons-react/es/Idea";
+import Warning from "@carbon/icons-react/es/Warning";
+import { cn } from "../lib/utils";
+import { Button } from "./button";
+import { Field, FieldLabel } from "./field";
+import { type CarbonIcon, Icon } from "./icon";
+import { WorkspaceSelect } from "./real-estate-workspace";
+import { Textarea } from "./textarea";
+
+export type SupportKind = "PROBLEM" | "QUESTION" | "IDEA";
+
+export const SUPPORT_KIND_OPTIONS: {
+	id: SupportKind;
+	label: string;
+	hint: string;
+	icon: CarbonIcon;
+	question: string;
+	placeholder: string;
+}[] = [
+	{
+		id: "PROBLEM",
+		label: "Signaler un problème",
+		hint: "Quelque chose ne marche pas",
+		icon: Warning,
+		question: "Que s'est-il passé?",
+		placeholder:
+			"Ex. : j'ai cliqué sur Envoyer dans la boîte de réception et le SMS est resté en attente.",
+	},
+	{
+		id: "QUESTION",
+		label: "Poser une question",
+		hint: "Je ne sais pas comment faire",
+		icon: Help,
+		question: "Quelle est votre question?",
+		placeholder: "Ex. : comment connecter l'agenda Google d'un courtier?",
+	},
+	{
+		id: "IDEA",
+		label: "Proposer une idée",
+		hint: "Une amélioration utile",
+		icon: Idea,
+		question: "Quelle amélioration proposez-vous?",
+		placeholder:
+			"Ex. : exporter la liste des rendez-vous de la semaine en PDF pour le courtier.",
+	},
+];
+
+export function SupportRequestForm({
+	kind,
+	onKindChange,
+	page,
+	onPageChange,
+	pageOptions,
+	message,
+	onMessageChange,
+	minLength,
+	maxLength,
+	pending,
+	error,
+	onSubmit,
+}: {
+	kind: SupportKind;
+	onKindChange: (kind: SupportKind) => void;
+	page: string;
+	onPageChange: (page: string) => void;
+	pageOptions: readonly { id: string; name: string }[];
+	message: string;
+	onMessageChange: (message: string) => void;
+	minLength: number;
+	maxLength: number;
+	pending: boolean;
+	error?: string | null;
+	onSubmit: () => void;
+}) {
+	const current = SUPPORT_KIND_OPTIONS.find((option) => option.id === kind);
+	const ready = message.trim().length >= minLength;
+	return (
+		<form
+			className="flex flex-col gap-4"
+			onSubmit={(event) => {
+				event.preventDefault();
+				if (ready && !pending) onSubmit();
+			}}
+		>
+			<div role="radiogroup" aria-label="Type de demande" className="grid gap-2 sm:grid-cols-3">
+				{SUPPORT_KIND_OPTIONS.map((option) => {
+					const selected = option.id === kind;
+					return (
+						<button
+							key={option.id}
+							type="button"
+							role="radio"
+							aria-checked={selected}
+							onClick={() => onKindChange(option.id)}
+							className={cn(
+								"flex flex-col items-start gap-1 rounded-lg border bg-card p-3 text-left outline-none transition-colors hover:bg-muted focus-visible:ring-2 focus-visible:ring-ring/60",
+								selected && "border-foreground/40 bg-muted ring-1 ring-foreground/10",
+							)}
+						>
+							<span className="flex items-center gap-2 text-sm font-medium">
+								<Icon icon={option.icon} className={cn("size-4", selected ? "text-primary" : "text-muted-foreground")} />
+								{option.label}
+							</span>
+							<span className="text-xs text-muted-foreground">{option.hint}</span>
+						</button>
+					);
+				})}
+			</div>
+			<WorkspaceSelect label="Page concernée" value={page} options={pageOptions} onChange={onPageChange} />
+			<Field>
+				<FieldLabel htmlFor="support-message">{current?.question}</FieldLabel>
+				<Textarea
+					id="support-message"
+					value={message}
+					maxLength={maxLength}
+					rows={6}
+					placeholder={current?.placeholder}
+					onChange={(event) => onMessageChange(event.target.value)}
+				/>
+				<span className="flex justify-between gap-3 text-xs text-muted-foreground">
+					<span>
+						{ready ? "Prêt à envoyer." : `Encore ${Math.max(0, minLength - message.trim().length)} caractères au minimum.`}
+					</span>
+					<span className="tabular-nums">
+						{message.length} / {maxLength}
+					</span>
+				</span>
+			</Field>
+			{error && (
+				<p role="alert" className="text-sm text-destructive">
+					{error}
+				</p>
+			)}
+			<div className="flex flex-wrap items-center gap-3">
+				<Button type="submit" disabled={!ready || pending}>
+					{pending ? "Envoi…" : "Envoyer la demande"}
+				</Button>
+				<span className="text-xs text-muted-foreground">
+					La page, l'heure et la taille de votre écran sont jointes automatiquement.
+				</span>
+			</div>
+		</form>
+	);
+}
