+			className={cn(
+				"grid min-h-[32rem] min-w-0 flex-1 grid-rows-[minmax(0,1fr)] overflow-hidden rounded-lg border bg-card md:grid-cols-[20rem_minmax(0,1fr)]",
+				className,
+			)}
+		>
+			<aside
+				aria-label="Conversations"
+				className={cn("flex min-h-0 min-w-0 flex-col md:border-r", selected && "hidden md:flex")}
