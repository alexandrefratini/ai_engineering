+
+function propertyFacts(property: LeadProfileLead["property"]) {
+	if (!property) return [];
+	return [
+		property.minBedrooms !== null ? { label: "Chambres", value: `${property.minBedrooms} ou plus` } : null,
+		property.minBathrooms !== null ? { label: "Salles de bain", value: `${property.minBathrooms} ou plus` } : null,
+		property.mustHaveParking ? { label: "Stationnement", value: "Exigé" } : null,
+		property.specificNotes ? { label: "Précisions", value: property.specificNotes } : null,
+	].filter((item) => item !== null);
+}
+
+export function LeadQualification({
+	lead,
+	evidence,
+	index,
+}: {
+	lead: LeadProfileLead;
+	evidence: LeadProfileEvidence[];
+	index?: number;
+}) {
+	const criteria = QUALIFICATION_CRITERIA.map((criterion) => ({
+		...criterion,
+		value: criterionValue(lead, criterion.field),
+		quotes: evidenceFor(evidence, criterion.field),
+	}));
+	const known = criteria.filter((criterion) => criterion.value !== null).length;
+	const sourced = criteria.filter((criterion) => criterion.value !== null && criterion.quotes.length > 0).length;
+	const property = propertyFacts(lead.property);
+	return (
+		<LeadPanel
+			index={index}
+			title="Qualification"
+			description="Valeur soulignée : confirmée par le prospect. Survolez-la pour lire sa réponse."
+			action={
+				<span className="flex items-center gap-2 text-sm">
+					<SegmentMeter
+						filled={known}
+						total={criteria.length}
+						label={`${plural(known, "critère connu", "critères connus")} sur ${criteria.length}`}
+					/>
+					<span className="font-medium tabular-nums">
+						{known}/{criteria.length}
+					</span>
+				</span>
+			}
+		>
+			{lead.qualificationSummary && <p className="text-sm text-pretty">{lead.qualificationSummary}</p>}
+			<dl className="grid grid-cols-2 gap-x-6 gap-y-4 md:grid-cols-4">
+				{criteria.map((criterion, position) => (
+					<div
+						key={criterion.field}
+						className={cn("flex min-w-0 flex-col gap-1", REVEAL)}
+						style={staggerStyle(position)}
+					>
+						<dt className="flex items-center gap-1.5 text-xs text-muted-foreground">
+							<Dot
+								className={
+									criterion.value === null
+										? "bg-muted-foreground/30"
+										: criterion.quotes.length > 0
+											? "bg-primary"
+											: "bg-primary/50"
+								}
+							/>
+							{criterion.label}
+						</dt>
+						<dd className="min-w-0 text-sm break-words">
+							{criterion.value === null ? (
+								<Muted>À confirmer</Muted>
+							) : criterion.quotes.length > 0 ? (
+								<SourcedValue source={<Quotes quotes={criterion.quotes} />}>
+									<button type="button" className={cn(SOURCED_VALUE, "cursor-help text-left")}>
+										{criterion.value}
+									</button>
+								</SourcedValue>
+							) : (
+								<span>{criterion.value}</span>
+							)}
+						</dd>
+					</div>
+				))}
+			</dl>
+			{property.length > 0 && (
+				<div className="flex flex-col gap-2 border-t pt-4">
+					<span className="text-xs text-muted-foreground">Propriété recherchée</span>
+					<Facts items={property} />
+				</div>
+			)}
+			<p className="text-xs text-muted-foreground">
+				{sourced === 0
+					? "Aucun critère n'est encore appuyé par une réponse du prospect."
+					: `${plural(sourced, "critère appuyé", "critères appuyés")} par une réponse du prospect.`}
+			</p>
+		</LeadPanel>
+	);
+}
+
+export function LeadLastMessages({
+	messages,
+	conversationLink,
+	index,
+}: {
+	messages: LeadProfileMessage[];
+	conversationLink?: ReactNode;
+	index?: number;
+}) {
+	const recent = messages.slice(-3);
+	return (
+		<LeadPanel
+			index={index}
+			title="Derniers messages"
+			description={messages.length ? `${plural(messages.length, "SMS échangé", "SMS échangés")} au total` : undefined}
+			action={conversationLink}
+		>
+			{recent.length === 0 ? (
+				<Muted>Aucun message pour l'instant.</Muted>
+			) : (
+				<ul className="flex flex-col divide-y text-sm">
+					{recent.map((message) => (
+						<li key={message.id} className="flex flex-col gap-1 py-2.5 first:pt-0 last:pb-0">
+							<span className="flex flex-wrap items-center justify-between gap-x-3 gap-y-0.5 text-xs text-muted-foreground">
+								<span className="flex min-w-0 items-center gap-1.5">
+									<Dot className={SENDER_DOT[message.sender]} />
+									<span className="font-medium text-foreground">{SENDER_LABELS[message.sender]}</span>
+									<span className="tabular-nums">· {formatDateTime(message.sentAt)}</span>
+								</span>
+								<span className={cn(FAILED_MESSAGE_STATUSES.has(message.status) && "text-destructive")}>
+									{labelOf(MESSAGE_STATUS_LABELS, message.status)}
+								</span>
+							</span>
+							<p className="line-clamp-3 text-pretty whitespace-pre-wrap">{message.content}</p>
+						</li>
+					))}
+				</ul>
+			)}
+		</LeadPanel>
+	);
+}
+
+const OUTCOME_DOT: Record<string, string> = {
+	SCHEDULED: "bg-primary/50",
+	CONFIRMED: "bg-primary",
+	RESCHEDULED: "bg-primary/50",
+	COMPLETED: "bg-foreground",
+	NO_SHOW: "bg-muted-foreground/40",
+	CANCELLED: "bg-muted-foreground/40",
+};
+
+const DURATIONS = [
+	{ id: "30", name: "30 min" },
+	{ id: "45", name: "45 min" },
+	{ id: "60", name: "1 h" },
+	{ id: "90", name: "1 h 30" },
+	{ id: "120", name: "2 h" },
+];
+
+function AppointmentForm({
+	onCreate,
+	onDone,
+}: {
+	onCreate: (appointment: NewAppointment) => Promise<void>;
+	onDone: () => void;
+}) {
+	const [duration, setDuration] = useState("60");
+	const [busy, setBusy] = useState(false);
+	const [error, setError] = useState<string | null>(null);
+	async function submit(form: HTMLFormElement) {
+		const data = new FormData(form);
+		const value = (key: string) => String(data.get(key) ?? "").trim();
+		const start = new Date(`${value("date")}T${value("time")}`);
+		if (Number.isNaN(start.getTime())) {
+			setError("Choisissez une date et une heure.");
+			return;
+		}
+		setBusy(true);
+		setError(null);
+		try {
+			await onCreate({
+				title: value("title") || "Visite",
+				startTime: start.toISOString(),
+				durationMinutes: Number(duration),
+				location: value("location") || undefined,
+			});
+			onDone();
+		} catch (failure) {
+			setError(failure instanceof Error ? failure.message : "Rendez-vous non enregistré.");
+		} finally {
+			setBusy(false);
+		}
+	}
+	return (
+		<form
+			className="flex flex-col gap-3 rounded-md border bg-muted/30 p-3"
+			onSubmit={(event) => {
+				event.preventDefault();
+				void submit(event.currentTarget);
+			}}
+		>
+			<div className="grid gap-3 sm:grid-cols-[1fr_auto_auto_auto]">
+				<Field>
+					<FieldLabel htmlFor="appointment-title">Objet</FieldLabel>
+					<Input id="appointment-title" name="title" placeholder="Visite" />
+				</Field>
+				<Field>
+					<FieldLabel htmlFor="appointment-date">Date</FieldLabel>
+					<Input id="appointment-date" name="date" type="date" required />
+				</Field>
+				<Field>
+					<FieldLabel htmlFor="appointment-time">Heure</FieldLabel>
+					<Input id="appointment-time" name="time" type="time" step={900} required />
+				</Field>
+				<WorkspaceSelect label="Durée" value={duration} options={DURATIONS} onChange={setDuration} />
+			</div>
+			<Field>
+				<FieldLabel htmlFor="appointment-location">
+					Lieu <span className="font-normal text-muted-foreground">(facultatif)</span>
+				</FieldLabel>
+				<Input id="appointment-location" name="location" placeholder="Adresse de la propriété ou lien de visioconférence" />
+			</Field>
+			{error && <WorkspaceNotice title="Rendez-vous non enregistré" error={error} />}
+			<div className="flex justify-end gap-2">
+				<Button type="button" variant="ghost" size="sm" onClick={onDone}>
+					Annuler
+				</Button>
+				<Button size="sm" disabled={busy}>
+					{busy ? "Enregistrement…" : "Enregistrer le rendez-vous"}
+				</Button>
+			</div>
+		</form>
+	);
+}
+
+export function LeadAppointments({
+	appointments,
+	index,
+	canWrite = false,
+	onCreate,
+	onOutcome,
+}: {
+	appointments: LeadProfileAppointment[];
+	index?: number;
+	canWrite?: boolean;
+	onCreate?: (appointment: NewAppointment) => Promise<void>;
+	onOutcome?: (id: string, status: AppointmentOutcome) => void;
+}) {
+	const [adding, setAdding] = useState(false);
+	const now = Date.now();
+	return (
+		<LeadPanel
+			index={index}
+			title="Rendez-vous"
+			description="Rendez-vous réservés par l'assistant ou ajoutés par l'équipe. Indiquez l'issue après la visite : elle met à jour le pipeline et les conversions Meta."
+			action={
+				canWrite && onCreate && !adding ? (
+					<Button variant="outline" size="sm" onClick={() => setAdding(true)}>
+						Ajouter
+					</Button>
+				) : undefined
+			}
+		>
+			<div className="flex flex-col gap-3">
+				{adding && onCreate && <AppointmentForm onCreate={onCreate} onDone={() => setAdding(false)} />}
+				{appointments.length === 0 ? (
+					!adding && <Muted>Aucun rendez-vous planifié.</Muted>
+				) : (
+					<ul className="flex flex-col divide-y text-sm">
+						{appointments.map((appointment) => {
+							const active = UPCOMING_STATUSES.has(appointment.status);
+							const past = new Date(appointment.startTime).getTime() < now;
+							return (
+								<li
+									key={appointment.id}
+									className="flex flex-wrap items-center justify-between gap-2 py-2 first:pt-0 last:pb-0"
+								>
+									<span className="flex min-w-0 flex-col">
+										<span className="font-medium">{formatDateTime(appointment.startTime)}</span>
+										<span className="truncate text-muted-foreground">
+											{[appointment.title, appointment.clientName, appointment.description]
+												.filter(Boolean)
+												.join(" · ")}
+										</span>
+									</span>
+									<span className="flex flex-wrap items-center gap-2">
+										<span className="flex items-center gap-1.5 text-xs">
+											<span
+												aria-hidden="true"
+												className={cn("size-2 rounded-full", OUTCOME_DOT[appointment.status] ?? "bg-muted-foreground/40")}
+											/>
+											{labelOf(APPOINTMENT_STATUS_LABELS, appointment.status)}
+										</span>
+										{canWrite && onOutcome && active && (
+											<span className="flex gap-1">
+												{past ? (
+													<>
+														<Button size="sm" variant="outline" onClick={() => onOutcome(appointment.id, "COMPLETED")}>
+															Réalisé
+														</Button>
+														<Button size="sm" variant="ghost" onClick={() => onOutcome(appointment.id, "NO_SHOW")}>
+															Absent
+														</Button>
+													</>
+												) : (
+													<>
+														{appointment.status === "SCHEDULED" && (
+															<Button
+																size="sm"
+																variant="outline"
+																onClick={() => onOutcome(appointment.id, "CONFIRMED")}
+															>
+																Confirmer
+															</Button>
+														)}
+														<Button size="sm" variant="ghost" onClick={() => onOutcome(appointment.id, "CANCELLED")}>
+															Annuler
+														</Button>
+													</>
+												)}
+											</span>
+										)}
+									</span>
+								</li>
+							);
+						})}
+					</ul>
+				)}
+			</div>
+		</LeadPanel>
+	);
+}
+
+function listingDetails(listing: LeadProfileListing) {
+	return [
+		listing.askingPrice !== null ? formatCad(listing.askingPrice) : null,
+		listing.bedrooms !== null ? plural(listing.bedrooms, "chambre", "chambres") : null,
+		listing.bathrooms !== null ? plural(listing.bathrooms, "salle de bain", "salles de bain") : null,
+	]
+		.filter(Boolean)
+		.join(" · ");
+}
+
+export function LeadSuggestedListings({
+	listings,
+	index,
+}: {
+	listings: LeadProfileListing[];
+	index?: number;
+}) {
+	return (
+		<LeadPanel
+			index={index}
+			title="Propriétés suggérées"
+			description="Suggestions que le prospect n'a pas encore confirmées. Validez-les avec lui avant de planifier une visite."
+		>
+			{listings.length === 0 ? (
+				<Muted>Aucune propriété suggérée pour l'instant.</Muted>
+			) : (
+				<ul className="flex flex-col divide-y text-sm">
+					{listings.map((listing) => (
+						<li
+							key={listing.url}
+							className="flex flex-wrap items-center justify-between gap-2 py-2 first:pt-0 last:pb-0"
+						>
+							<span className="flex min-w-0 flex-col">
+								<span className="truncate font-medium">{listing.address ?? listingHost(listing.url)}</span>
+								<span className="truncate text-muted-foreground tabular-nums">
+									{listingDetails(listing) || "Prix et pièces non précisés"}
+								</span>
+							</span>
+							<span className="flex items-center gap-3">
+								<span className="flex items-center gap-1.5 text-xs text-muted-foreground">
+									<Dot className="bg-muted-foreground/40" />
+									Suggestion
+								</span>
+								<Button asChild variant="outline" size="sm">
+									<a href={listing.url} target="_blank" rel="noreferrer">
+										Voir l'annonce
+										<span className="sr-only"> (nouvel onglet)</span>
+									</a>
+								</Button>
+							</span>
+						</li>
+					))}
+				</ul>
+			)}
+		</LeadPanel>
+	);
+}
+
+export function LeadFollowUp({ lead, index }: { lead: LeadProfileLead; index?: number }) {
+	const consent = consentSourceLabel(lead.consentSource);
+	return (
+		<LeadPanel index={index} title="Suivi et consentement">
+			<div className="grid gap-x-8 gap-y-2 lg:grid-cols-2">
+				<Facts
+					items={[
+						{ label: "Reçu le", value: formatDateTime(lead.createdAt) },
+						{
+							label: "Premier contact",
+							value: lead.firstContactedAt ? (
+								`${formatDateTime(lead.firstContactedAt)} · après ${formatDuration(minutesBetween(lead.createdAt, lead.firstContactedAt))}`
+							) : (
+								<Muted>Pas encore contacté</Muted>
+							),
+						},
+						{
+							label: "Dernière activité",
+							value: lead.lastInteractedAt ? formatDateTime(lead.lastInteractedAt) : <Muted>Aucune</Muted>,
+						},
+						{
+							label: "Source",
+							value: [lead.campaignName, lead.formName, lead.source ? labelOf(LEAD_SOURCE_LABELS, lead.source) : null]
+								.filter(Boolean)
+								.join(" · ") || <Muted>Non renseignée</Muted>,
+						},
+					]}
+				/>
+				<Facts
+					items={[
+						{
+							label: "SMS",
+							value: lead.unsubscribedAt ? (
+								`Retrait reçu le ${formatDateTime(lead.unsubscribedAt)}`
+							) : lead.consentedAt ? (
+								`Consentement du ${formatDateTime(lead.consentedAt)}${consent ? ` · ${consent}` : ""}`
+							) : (
+								<Muted>Consentement absent. Envoi bloqué.</Muted>
+							),
+						},
+						{
+							label: "Assistant IA",
+							value: lead.automationPausedAt
+								? `En pause depuis le ${formatDateTime(lead.automationPausedAt)}`
+								: "Actif",
+						},
+						{ label: "Langue", value: labelOf(LANGUAGE_LABELS, lead.language) },
+						...(lead.escalationReason
+							? [{ label: "Escalade", value: labelOf(ESCALATION_LABELS, lead.escalationReason) }]
+							: []),
+					]}
+				/>
+			</div>
+		</LeadPanel>
+	);
+}
+
+export function LeadHistory({ events, index }: { events: LeadProfileEvent[]; index?: number }) {
+	const ordered = [...events].sort(
+		(left, right) => new Date(right.occurredAt).getTime() - new Date(left.occurredAt).getTime(),
+	);
+	return (
+		<LeadPanel index={index} title="Historique" description="Étapes clés du parcours, de la plus récente à la plus ancienne.">
+			{ordered.length === 0 ? (
+				<Muted>Aucun événement enregistré.</Muted>
+			) : (
+				<ol className="flex flex-col text-sm">
+					{ordered.map((event, position) => (
+						<li key={event.id} className={cn("group flex gap-3", REVEAL)} style={staggerStyle(position)}>
+							<span aria-hidden="true" className="flex flex-col items-center">
+								<span
+									className={cn(
+										"mt-1.5 size-2 shrink-0 rounded-full",
+										position === 0 ? "bg-primary" : "bg-muted-foreground/40",
+									)}
+								/>
+								<span className="mt-1 w-px flex-1 bg-border group-last:hidden" />
+							</span>
+							<span className="flex min-w-0 flex-1 flex-wrap items-baseline justify-between gap-x-3 pb-3 group-last:pb-0">
+								<span className={cn(position === 0 && "font-medium")}>{labelOf(EVENT_LABELS, event.eventType)}</span>
+								<time dateTime={event.occurredAt} className="text-xs text-muted-foreground tabular-nums">
+									{formatDateTime(event.occurredAt)}
+								</time>
+							</span>
+						</li>
+					))}
+				</ol>
+			)}
+		</LeadPanel>
+	);
+}
+
+export function LeadDisclosure({
+	title,
+	description,
+	index = 0,
+	defaultOpen = false,
+	children,
+}: {
+	title: string;
+	description?: string;
+	index?: number;
+	defaultOpen?: boolean;
+	children: ReactNode;
+}) {
+	const [open, setOpen] = useState(defaultOpen);
+	return (
+		<Collapsible open={open} onOpenChange={setOpen} asChild>
+			<Card className={REVEAL} style={staggerStyle(index)}>
+				<CardHeader>
+					<CardTitle>{title}</CardTitle>
+					{description && <CardDescription>{description}</CardDescription>}
+					<CardAction>
+						<CollapsibleTrigger asChild>
+							<Button variant="outline" size="sm">
+								{open ? "Masquer" : "Afficher"}
+							</Button>
+						</CollapsibleTrigger>
+					</CardAction>
+				</CardHeader>
+				<CollapsibleContent asChild>
+					<CardContent className="data-[state=open]:animate-in data-[state=open]:fade-in data-[state=open]:slide-in-from-top-1 data-[state=open]:duration-200 motion-reduce:animate-none">
+						{children}
+					</CardContent>
+				</CollapsibleContent>
+			</Card>
+		</Collapsible>
+	);
+}
