+import type { Db } from "@crm/db";
+import { Injectable } from "@nestjs/common";
+import { InjectDatabase } from "../database/database.constants";
+import { PRESENCE } from "./presence-config";
+
+@Injectable()
+export class PresenceService {
+	constructor(@InjectDatabase() private readonly db: Db) {}
+
+	async heartbeat(userId: string, page?: { path: string; label: string }) {
+		const lastSeenAt = new Date();
+		await this.db.user.update({
+			where: { id: userId },
+			data: {
+				lastSeenAt,
+				...(page ? { lastSeenPath: page.path, lastSeenLabel: page.label } : {}),
+			},
+			select: { id: true },
+		});
+		return { lastSeenAt };
+	}
+
+	async team(userId: string) {
+		const memberships = await this.db.member.findMany({
+			where: { userId },
+			select: { organizationId: true },
+		});
+		const rows = await this.db.user.findMany({
+			where: {
+				members: {
+					some: {
+						organizationId: {
+							in: memberships.map((item) => item.organizationId),
+						},
+					},
+				},
+			},
+			select: {
+				id: true,
+				name: true,
+				image: true,
+				lastSeenAt: true,
+				lastSeenPath: true,
+				lastSeenLabel: true,
+			},
+			orderBy: [
+				{ lastSeenAt: { sort: "desc", nulls: "last" } },
+				{ name: "asc" },
+			],
+			take: PRESENCE.teamLimit,
+		});
+		const since = Date.now() - PRESENCE.onlineWindowMs;
+		const members = rows.map(({ lastSeenPath, lastSeenLabel, ...row }) => {
+			const online =
+				row.lastSeenAt !== null && row.lastSeenAt.getTime() >= since;
+			return {
+				...row,
+				online,
+				isSelf: row.id === userId,
+				page:
+					online && lastSeenPath && lastSeenLabel
+						? { path: lastSeenPath, label: lastSeenLabel }
+						: null,
+			};
+		});
+		return {
+			members,
+			onlineCount: members.filter((member) => member.online).length,
+		};
+	}
+}
