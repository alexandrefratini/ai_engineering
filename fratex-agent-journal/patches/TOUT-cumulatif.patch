+"use client";
+
+import IdManagement from "@carbon/icons-react/es/IdManagement";
+import { Button } from "@crm/ui/components/button";
+import { EmptyState } from "@crm/ui/components/empty-state";
+import {
+	WorkspaceLoading,
+	WorkspaceNotice,
+} from "@crm/ui/components/real-estate-workspace";
+import {
+	RealtorRoster,
+	RealtorRosterSummary,
+} from "@crm/ui/components/realtor-roster";
+import { LAYOUT } from "@crm/ui/lib/layout";
+import { useQuery } from "@tanstack/react-query";
+import Link from "next/link";
+import { useTRPC } from "@/lib/trpc/client";
+import { useWorkspaceUrl } from "@/lib/use-workspace-url";
+import { AgencySlot } from "../agency-slot";
+import { useAgency } from "../use-agency";
+
+export function RealtorsView() {
+	const trpc = useTRPC();
+	const href = useWorkspaceUrl();
+	const scope = useAgency();
+	const clients = useQuery(
+		trpc.realEstate.clients.queryOptions(
+			{ agencyId: scope.agencyId },
+			{ enabled: Boolean(scope.agencyId) },
+		),
+	);
+
+	return (
+		<div className={LAYOUT.stack}>
+			<AgencySlot scope={scope} />
+			{scope.agencyId &&
+				(clients.isPending ? (
+					<WorkspaceLoading />
+				) : clients.error ? (
+					<WorkspaceNotice
+						title="Courtiers indisponibles"
+						error={clients.error.message}
+						onRetry={() => {
+							void clients.refetch();
+						}}
+					/>
+				) : clients.data.clients.length === 0 ? (
+					<EmptyState
+						icon={IdManagement}
+						title="Aucun courtier pour l'instant"
+						description="Ajoutez un courtier pour qu'il reçoive ses prospects, son portail et ses rendez-vous. Comptez environ cinq minutes."
+						action={
+							<Button asChild>
+								<Link href={href("/real-estate/realtors/new")}>
+									Ajouter un courtier
+								</Link>
+							</Button>
+						}
+					/>
+				) : (
+					<>
+						<RealtorRosterSummary realtors={clients.data.clients} />
+						<RealtorRoster
+							realtors={clients.data.clients.map((client) => ({
+								...client,
+								lastLeadAt: client.lastLeadAt
+									? new Date(client.lastLeadAt).toISOString()
+									: null,
+							}))}
+							renderActions={(realtor) => {
+								const query = `?agencyId=${scope.agencyId}&client=${realtor.id}`;
+								const next = !realtor.setup.metaForm
+									? "meta-ads"
+									: !realtor.setup.calendar
+										? "realtor-calendar"
+										: !realtor.setup.sms
+											? "twilio"
+											: null;
+								return (
+									<>
+										{next && (
+											<Button asChild variant="outline" size="sm">
+												<Link
+													href={href(`/settings/connections/${next}${query}`)}
+												>
+													Terminer la configuration
+												</Link>
+											</Button>
+										)}
+										<Button asChild variant="outline" size="sm">
+											<Link href={href(`/real-estate/portal${query}`)}>
+												Portail
+											</Link>
+										</Button>
+									</>
+								);
+							}}
+						/>
+					</>
+				))}
+		</div>
+	);
+}
