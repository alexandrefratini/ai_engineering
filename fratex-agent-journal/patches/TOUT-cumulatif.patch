+const DESCRIPTIONS = {
+	immobilier: {
+		me: "Vos prospects, vos rendez-vous et ce qui demande votre attention aujourd'hui.",
+		everyone:
+			"Les prospects, les rendez-vous et ce qui demande l'attention de l'équipe aujourd'hui.",
+	},
+	ventes: {
+		me: "Ce que vous avez conclu, ce qui est encore en jeu et ce qui a besoin de vous aujourd'hui.",
+		everyone:
+			"Ce que l'équipe a conclu, ce qui est encore en jeu et ce qui a besoin de vous aujourd'hui.",
+	},
