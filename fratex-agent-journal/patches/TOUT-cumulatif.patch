+import Search from "@carbon/icons-react/es/Search";
+import type * as React from "react";
+import { cn } from "../lib/utils";
+import { Tooltip, TooltipContent, TooltipTrigger } from "./tooltip";
+
+export const SEARCH_PLACEHOLDER = "Rechercher une page, un prospect…";
+export const SEARCH_SHORTCUT = "Ctrl K";
+
+export function SearchTrigger({
+	label = SEARCH_PLACEHOLDER,
+	shortcut = SEARCH_SHORTCUT,
+	className,
+	...props
+}: Omit<React.ComponentProps<"button">, "children"> & {
+	label?: string;
+	shortcut?: string;
+}) {
+	return (
+		<Tooltip>
+			<TooltipTrigger asChild>
+				<button
+					type="button"
+					aria-label={label}
+					aria-keyshortcuts="Control+K"
+					data-slot="search-trigger"
+					className={cn(
+						"group/search flex size-8 shrink-0 items-center justify-center rounded-md text-muted-foreground outline-none transition-colors hover:bg-muted hover:text-foreground focus-visible:ring-2 focus-visible:ring-ring",
+						"md:h-8 md:w-full md:justify-start md:gap-2 md:border md:bg-muted/40 md:px-2.5 md:text-sm md:hover:bg-muted/70",
+						className,
+					)}
+					{...props}
+				>
+					<Search aria-hidden="true" className="size-4 shrink-0" />
+					<span className="hidden min-w-0 flex-1 truncate text-left md:block">{label}</span>
+					<kbd className="hidden shrink-0 rounded border bg-background px-1.5 py-0.5 font-sans text-[11px] leading-none text-muted-foreground tabular-nums lg:block">
+						{shortcut}
+					</kbd>
+				</button>
+			</TooltipTrigger>
+			<TooltipContent className="lg:hidden">
+				{label} ({shortcut})
+			</TooltipContent>
+		</Tooltip>
+	);
+}
