+				description="Choisissez un type, décrivez en une ou deux phrases. C'est tout."
+			>
+				{form}
+			</Panel>
+			<Panel index={1} title="Mes demandes" description="Le suivi de ce que vous nous avez envoyé.">
+				{history}
+			</Panel>
+			<Panel index={2} title="Réponses rapides" description="Les situations les plus fréquentes.">
+				<Accordion type="single" collapsible>
+					{answers.map((item) => (
+						<AccordionItem key={item.question} value={item.question}>
+							<AccordionTrigger>{item.question}</AccordionTrigger>
+							<AccordionContent className="text-sm text-muted-foreground">{item.answer}</AccordionContent>
+						</AccordionItem>
+					))}
+				</Accordion>
+			</Panel>
+			{team}
+			<p className="text-sm text-muted-foreground">
+				Vous préférez le courriel? Écrivez à <ContactLink kind="email" value={email} className="text-foreground underline" />.
