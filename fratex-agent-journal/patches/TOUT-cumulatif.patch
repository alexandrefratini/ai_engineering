new file mode 100644
index 0000000..cce7b0b
--- /dev/null
+++ b/apps/app/components/agent-builder/prospect-results.tsx
@@ -0,0 +1,42 @@
+"use client";
+
+import {
+	type AppointmentListData,
+	AppointmentResultCard,
+	type PerformanceData,
+	PerformanceResultCard,
+	ProspectDetailCard,
+	type ProspectDetailData,
+	type ProspectListData,
+	ProspectResultCard,
+	type RenderResultLink,
+} from "@crm/ui/components/assistant-result-cards";
+import Link from "next/link";
+import { workspacePath } from "@/lib/agent-prospect-results";
+import { useWorkspaceSlug } from "@/lib/use-workspace-url";
+
+function useResultLink(): RenderResultLink {
+	const slug = useWorkspaceSlug();
+
+	return ({ href, className, children }) => (
+		<Link href={workspacePath(slug, href)} className={className}>
+			{children}
+		</Link>
+	);
+}
+
+export function ProspectListResult({ data }: { data: ProspectListData }) {
+	return <ProspectResultCard data={data} renderLink={useResultLink()} />;
+}
+
+export function ProspectDetailResult({ data }: { data: ProspectDetailData }) {
+	return <ProspectDetailCard data={data} renderLink={useResultLink()} />;
+}
+
+export function AppointmentListResult({ data }: { data: AppointmentListData }) {
+	return <AppointmentResultCard data={data} renderLink={useResultLink()} />;
+}
+
+export function PerformanceResult({ data }: { data: PerformanceData }) {
+	return <PerformanceResultCard data={data} />;
+}
