diff --git a/apps/app/test/real-estate-finance.spec.ts b/apps/app/test/real-estate-finance.spec.ts
new file mode 100644
index 0000000..32a32fc
--- /dev/null
+++ b/apps/app/test/real-estate-finance.spec.ts
@@ -0,0 +1,108 @@
+import { describe, expect, it } from "bun:test";
+import {
+	analyzeOffer,
+	commissionWithTaxes,
+	insurancePremiumPct,
+	minimumDownPayment,
+	monthlyPayment,
+	welcomeTax,
+} from "@crm/ui/lib/real-estate-finance";
+import { FINANCE } from "@crm/ui/lib/real-estate-finance-config";
+
+const LISTING = {
+	listingPrice: 649_000,
+	discountPct: 0,
+	downPaymentPct: 10,
+	ratePct: 4.79,
+	amortizationYears: 25,
+	municipality: "MONTREAL",
+	commissionPct: 2.5,
+} as const;
+
+describe("real estate finance", () => {
+	it("applies the tiered minimum down payment", () => {
+		expect(minimumDownPayment(400_000)).toBe(20_000);
+		expect(minimumDownPayment(500_000)).toBe(25_000);
+		expect(minimumDownPayment(800_000)).toBe(55_000);
+		expect(minimumDownPayment(1_499_999)).toBeCloseTo(124_999.9, 1);
+		expect(minimumDownPayment(1_500_000)).toBe(300_000);
+	});
+
+	it("picks the CMHC premium tier from the down payment share", () => {
+		expect(insurancePremiumPct(600_000, 5)).toBe(4);
+		expect(insurancePremiumPct(600_000, 9.99)).toBe(4);
+		expect(insurancePremiumPct(600_000, 10)).toBe(3.1);
+		expect(insurancePremiumPct(600_000, 15)).toBe(2.8);
+		expect(insurancePremiumPct(600_000, 19.99)).toBe(2.8);
+		expect(insurancePremiumPct(600_000, 20)).toBe(0);
+	});
+
+	it("adds the long amortization surcharge and refuses insurance at the cap", () => {
+		expect(insurancePremiumPct(600_000, 10, 30)).toBeCloseTo(3.3, 6);
+		expect(insurancePremiumPct(600_000, 10, 25)).toBe(3.1);
+		expect(
+			insurancePremiumPct(FINANCE.insurance.maxInsurablePrice, 10),
+		).toBeNull();
+		expect(insurancePremiumPct(FINANCE.insurance.maxInsurablePrice, 20)).toBe(
+			0,
+		);
+	});
+
+	it("computes the Canadian monthly payment with semi-annual compounding", () => {
+		expect(monthlyPayment(400_000, 5, 25)).toBeCloseTo(2_326, 0);
+		expect(Math.round(monthlyPayment(400_000, 5, 25))).toBe(2_326);
+	});
+
+	it("handles a zero rate and an empty loan", () => {
+		expect(monthlyPayment(240_000, 0, 20)).toBe(1_000);
+		expect(monthlyPayment(0, 5, 25)).toBe(0);
+	});
+
+	it("computes the Montreal welcome tax", () => {
+		expect(Math.round(welcomeTax(800_000, "MONTREAL"))).toBe(11_349);
+		expect(Math.round(welcomeTax(649_000, "MONTREAL"))).toBe(8_329);
+	});
+
+	it("computes the provincial welcome tax", () => {
+		expect(welcomeTax(62_900, "QUEBEC")).toBeCloseTo(314.5, 6);
+		expect(welcomeTax(315_000, "QUEBEC")).toBeCloseTo(2_835.5, 6);
+		expect(welcomeTax(800_000, "QUEBEC")).toBeCloseTo(10_110.5, 6);
+	});
+
+	it("adds GST and QST on the commission", () => {
+		const commission = commissionWithTaxes(500_000, 4);
+		expect(commission.base).toBe(20_000);
+		expect(commission.gst).toBeCloseTo(1_000, 6);
+		expect(commission.qst).toBeCloseTo(1_995, 6);
+		expect(Math.round(commission.total)).toBe(22_995);
+	});
+
+	it("matches the hand-checked listing at 649 000 $ in Montreal", () => {
+		const offer = analyzeOffer(LISTING);
+		expect(Math.round(offer.downPayment)).toBe(64_900);
+		expect(Math.round(offer.premium)).toBe(18_107);
+		expect(Math.round(offer.monthlyPayment)).toBe(3_431);
+		expect(Math.round(offer.welcomeTax)).toBe(8_329);
+		expect(Math.round(offer.premiumTax)).toBe(1_630);
+		expect(Math.round(offer.cashRequired)).toBe(74_859);
+		expect(offer.belowMinimum).toBe(false);
+	});
+
+	it("applies the discount to the offer price before every rule", () => {
+		const offer = analyzeOffer({ ...LISTING, discountPct: 10 });
+		expect(offer.offerPrice).toBeCloseTo(584_100, 6);
+		expect(offer.downPayment).toBeCloseTo(58_410, 6);
+		expect(offer.welcomeTax).toBeCloseTo(welcomeTax(584_100, "MONTREAL"), 6);
+		expect(offer.insuredLoan).toBeCloseTo(offer.loan + offer.premium, 6);
+	});
+
+	it("flags a down payment under the legal minimum", () => {
+		const offer = analyzeOffer({ ...LISTING, downPaymentPct: 5 });
+		expect(offer.belowMinimum).toBe(true);
+		expect(Math.round(offer.minimumDown)).toBe(39_900);
+		const uninsured = analyzeOffer({ ...LISTING, downPaymentPct: 20 });
+		expect(uninsured.premium).toBe(0);
+		expect(uninsured.premiumTax).toBe(0);
+		expect(uninsured.belowMinimum).toBe(false);
+	});
+});
