+			<ChannelIcon channel={channel} />
+			<span className="font-medium text-foreground">{label}</span>
+			<time dateTime={isoOf(at)} className="tabular-nums">
+				{formatTime(at)}
+			</time>
+			{status && (
+				<span
+					className={cn(
+						FAILED_STATUSES.has(status) && "text-destructive",
+						DELIVERED_STATUSES.has(status) && "text-primary",
+					)}
+				>
+					· {labelOf(MESSAGE_STATUS_LABELS, status)}
+				</span>
+			)}
+		</span>
+	);
+}
+
+function SmsItem({ message }: { message: InboxSmsMessage }) {
+	if (message.sender === "SYSTEM")
+		return (
+			<li className="flex justify-center px-6">
+				<p className="text-center text-xs text-pretty text-muted-foreground">
+					<span className="font-medium text-foreground">{SENDER_LABELS.SYSTEM}</span> · {message.content} ·{" "}
+					<time dateTime={isoOf(message.sentAt)} className="tabular-nums">
+						{formatTime(message.sentAt)}
+					</time>
+				</p>
+			</li>
+		);
+	const outbound = message.sender !== "LEAD";
+	const status = outbound
+		? message.failureCode
+			? `${labelOf(MESSAGE_STATUS_LABELS, message.status)} (${message.failureCode})`
+			: message.status
+		: undefined;
+	return (
+		<li className={cn("flex flex-col gap-1", outbound ? "items-end" : "items-start")}>
+			<ItemMeta channel="SMS" label={SENDER_LABELS[message.sender]} at={message.sentAt} status={status} />
+			<Bubble variant={BUBBLE_VARIANT[message.sender]} align={outbound ? "end" : "start"}>
+				<BubbleContent className="text-sm whitespace-pre-wrap">{message.content}</BubbleContent>
+			</Bubble>
+		</li>
+	);
+}
+
+function EmailItem({ email }: { email: InboxEmail }) {
+	const outbound = email.direction === "OUTBOUND";
+	const link = emailLink(email.webLink);
+	const subject = email.subject?.trim() || "(Sans objet)";
+	return (
+		<li className={cn("flex flex-col gap-1", outbound ? "items-end" : "items-start")}>
+			<ItemMeta channel="EMAIL" label={outbound ? SENDER_LABELS.HUMAN_AGENT : SENDER_LABELS.LEAD} at={email.sentAt} />
+			<article
+				aria-label={`Courriel : ${subject}`}
+				className="flex w-full max-w-sm min-w-0 flex-col gap-1 rounded-md border bg-background px-3 py-2 text-xs sm:max-w-md"
+			>
+				<p className="truncate text-sm font-medium">{subject}</p>
+				{email.snippet && <p className="line-clamp-2 text-pretty text-muted-foreground">{email.snippet}</p>}
+				<div className="flex flex-wrap items-center justify-between gap-x-3 gap-y-1 text-muted-foreground">
+					<span className="min-w-0 truncate">
+						{email.fromName ? `${email.fromName} · ${email.fromEmail}` : email.fromEmail}
+					</span>
+					{link && (
+						<a
+							href={link.href}
+							target="_blank"
+							rel="noopener noreferrer"
+							className="inline-flex items-center gap-1 font-medium whitespace-nowrap text-foreground underline-offset-2 hover:underline"
+						>
+							{link.label}
+							<Icon icon={Launch} className="size-3" />
+							<span className="sr-only">(nouvel onglet)</span>
+						</a>
+					)}
+				</div>
+			</article>
+		</li>
+	);
+}
+
+export function InboxThread({
+	messages,
+	emails,
+	leadName,
+	now,
+}: {
+	messages: InboxSmsMessage[];
+	emails: InboxEmail[];
+	leadName: string;
+	now: Date;
+}) {
+	const days = groupByDay(mergeThread(messages, emails));
+	return (
+		<MessageScrollerProvider autoScroll defaultScrollPosition="end">
+			<MessageScroller className="flex-1">
+				<MessageScrollerViewport>
+					<MessageScrollerContent className="gap-4 p-3 sm:p-4">
+						{days.length === 0 ? (
+							<p className="m-auto text-xs text-muted-foreground">Aucun échange pour l'instant.</p>
+						) : (
+							<div role="log" aria-label={`Conversation avec ${leadName}`} className="flex flex-col gap-4">
+								{days.map((day) => (
+									<section key={day.key || "sans-date"} className="flex flex-col gap-3">
+										<Marker asChild variant="separator">
+											<h3 className="justify-center font-medium">{formatDayHeading(day.at, now)}</h3>
+										</Marker>
+										<ol className="flex flex-col gap-3">
+											{day.items.map((item) =>
+												item.kind === "SMS" ? (
+													<SmsItem key={`sms:${item.id}`} message={item.message} />
+												) : (
+													<EmailItem key={`email:${item.id}`} email={item.email} />
+												),
+											)}
+										</ol>
+									</section>
+								))}
+							</div>
+						)}
+					</MessageScrollerContent>
+				</MessageScrollerViewport>
+				<MessageScrollerButton>
+					<Icon icon={ArrowDown} />
+					<span className="sr-only">Aller au dernier message</span>
+				</MessageScrollerButton>
+			</MessageScroller>
+		</MessageScrollerProvider>
+	);
+}
+
+export function InboxComposer({
+	leadName,
+	email,
+	blockedReason,
+	paused,
+	maxLength = SMS_MAX_LENGTH,
+	onSend,
+}: {
+	leadName: string;
+	email?: string | null;
+	blockedReason?: string | null;
+	paused?: boolean;
+	maxLength?: number;
+	onSend: (text: string, requestId: string) => Promise<void>;
+}) {
+	const fieldId = useId();
+	const [text, setText] = useState("");
+	const [requestId, setRequestId] = useState(() => crypto.randomUUID());
+	const [sending, setSending] = useState(false);
+	const [error, setError] = useState<string | null>(null);
+	const blocked = Boolean(blockedReason);
+	const draft = text.trim();
+	async function send() {
+		if (!draft || sending || blocked) return;
+		setSending(true);
+		setError(null);
+		try {
+			await onSend(draft, requestId);
+			setText("");
+			setRequestId(crypto.randomUUID());
+		} catch (failure) {
+			setError(failure instanceof Error ? failure.message : "Envoi impossible.");
+		} finally {
+			setSending(false);
+		}
+	}
+	return (
+		<form
+			className="flex shrink-0 flex-col gap-2 border-t p-3"
+			onSubmit={(event) => {
+				event.preventDefault();
+				void send();
+			}}
+		>
+			<label htmlFor={fieldId} className="sr-only">
+				SMS à {leadName}
+			</label>
+			<Textarea
+				id={fieldId}
+				value={text}
+				maxLength={maxLength}
+				rows={2}
+				disabled={blocked || sending}
+				placeholder={blocked ? "SMS indisponible" : "Écrire un SMS…"}
+				aria-describedby={`${fieldId}-count${blocked ? ` ${fieldId}-reason` : ""}`}
+				className="max-h-40 min-h-14 resize-none text-sm md:text-sm"
+				onChange={(event) => {
+					setText(event.target.value);
+					setRequestId(crypto.randomUUID());
+				}}
+				onKeyDown={(event) => {
+					if (event.key === "Enter" && !event.shiftKey && !event.nativeEvent.isComposing) {
+						event.preventDefault();
+						void send();
+					}
+				}}
+			/>
+			{blockedReason && (
+				<p id={`${fieldId}-reason`} className="flex items-center gap-1.5 text-xs text-muted-foreground">
+					<Dot className="bg-muted-foreground/50" />
+					{blockedReason}
+				</p>
+			)}
+			{error && (
+				<p role="alert" className="text-xs text-destructive">
+					{error}
+				</p>
+			)}
+			<div className="flex flex-wrap items-center justify-between gap-2">
+				<div className="flex min-w-0 flex-wrap items-center gap-x-3 gap-y-1 text-xs text-muted-foreground">
+					<span
+						id={`${fieldId}-count`}
+						className={cn("tabular-nums", text.length >= maxLength && "text-destructive")}
+					>
+						{text.length}/{maxLength}
+						<span className="sr-only"> caractères</span>
+					</span>
+					{!paused && !blocked && <span>Votre envoi met l'assistant en pause.</span>}
+					{email && (
+						<span className="flex items-center gap-1.5">
+							<a
+								href={`mailto:${email}`}
+								className="inline-flex items-center gap-1 font-medium text-foreground underline-offset-2 hover:underline"
+							>
+								<Icon icon={Email} className="size-3.5" />
+								Écrire un courriel
+							</a>
+							<InfoHint label="Courriel">
+								Le courriel s'ouvre dans votre messagerie. Fratex lit les courriels synchronisés, mais ne les
+								envoie pas.
+							</InfoHint>
+						</span>
+					)}
+				</div>
+				<Button type="submit" size="sm" disabled={blocked || sending || !draft}>
+					<Icon icon={SendAlt} className="size-3.5" />
+					{sending ? "Envoi…" : "Envoyer le SMS"}
+				</Button>
+			</div>
+		</form>
+	);
+}
