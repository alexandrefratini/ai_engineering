+			if ("appointment" in stage)
+				await db.appointment.create({
+					data: {
+						agencyId: portalAgency,
+						clientId: clientP,
+						leadId: leadId(stage.name),
+						title: `Rendez-vous ${stage.name}`,
+						startTime:
+							stage.appointment === "COMPLETED"
+								? ago(10)
+								: new Date(now + 3_600_000),
+						endTime:
+							stage.appointment === "COMPLETED"
+								? ago(5)
+								: new Date(now + 2 * 3_600_000),
+						status: stage.appointment,
+					},
+				});
+		}
+		await db.lead.create({
+			data: {
+				id: id("portal-other"),
+				agencyId: portalAgency,
+				clientId: clientQ,
+				firstName: "other",
+				phone: "+15145550401",
+				status: "APPOINTMENT_HELD",
+				budgetMax: 999999,
+				createdAt: ago(30),
+			},
+		});
+		await message(
+			portalAgency,
+			leadId("replied"),
+			"AI_SDR",
+			"Bonjour",
+			ago(25),
+		);
+		await message(
+			portalAgency,
+			leadId("replied"),
+			"AI_SDR",
+			"Une question",
+			ago(24),
+		);
+		await message(
+			portalAgency,
+			leadId("replied"),
+			"HUMAN_AGENT",
+			"Je prends la main",
+			ago(20),
+		);
+		await message(portalAgency, leadId("replied"), "LEAD", "D'accord", ago(15));
+	});
+
+	it("counts the stages each prospect reached, never more than the stage before", async () => {
+		const portal = await service.getPortalStats(portalOwner, {
+			agencyId: portalAgency,
+			clientId: clientP,
