+			})
+		: null;
+	const applied = client ? "me" : "everyone";
+	return {
+		client,
+		scope: {
+			requested,
+			applied: applied as "me" | "everyone",
+			label: REAL_ESTATE_LABELS.home[applied],
+			notice:
+				requested === "me" && !client
+					? REAL_ESTATE_LABELS.home.noLinkedRealtor
+					: null,
+			clientId: client?.id ?? null,
+			clientName: client?.name ?? null,
+		},
+	};
+}
+
+async function toDoItems(
+	db: Db,
+	leadWhere: Prisma.LeadWhereInput,
+	agencyId: string,
+	now: Date,
+) {
+	const limit = REAL_ESTATE.home.toDoLimit;
+	const grace = new Date(
+		now.getTime() - REAL_ESTATE.home.notContactedGraceMinutes * MINUTE_MS,
+	);
+	const [unread, human, fresh] = await Promise.all([
+		db.conversation.findMany({
+			where: { agencyId, unreadCount: { gt: 0 }, lead: leadWhere },
+			orderBy: { lastMessageAt: "desc" },
+			take: limit,
+			select: {
+				leadId: true,
+				lastMessageAt: true,
+				lead: { select: nameSelect },
+				messages: {
+					where: { sender: "LEAD" },
+					orderBy: [{ sentAt: "desc" }, { id: "desc" }],
+					take: 1,
+					select: { content: true },
+				},
+			},
+		}),
+		db.lead.findMany({
+			where: {
+				...leadWhere,
+				automationPausedAt: { not: null },
+				unsubscribedAt: null,
+			},
+			orderBy: { automationPausedAt: "desc" },
+			take: limit,
+			select: {
+				id: true,
+				...nameSelect,
+				escalationReason: true,
+				automationPausedAt: true,
+			},
+		}),
+		db.lead.findMany({
+			where: {
+				...leadWhere,
+				status: "NEW",
+				firstContactedAt: null,
+				unsubscribedAt: null,
+				automationPausedAt: null,
+				createdAt: { lte: grace },
+			},
+			orderBy: { createdAt: "desc" },
+			take: limit,
+			select: { id: true, ...nameSelect, createdAt: true },
+		}),
+	]);
+	const candidates: ToDo[] = [
+		...human.map((lead) => ({
+			leadId: lead.id,
+			name: fullName(lead),
+			phone: lead.phone,
+			reason: "HUMAN" as const,
+			detail: lead.escalationReason,
+			at: lead.automationPausedAt ?? now,
+		})),
+		...unread.map((conversation) => ({
+			leadId: conversation.leadId,
+			name: fullName(conversation.lead),
+			phone: conversation.lead.phone,
+			reason: "UNREAD" as const,
+			detail:
+				conversation.messages[0]?.content.slice(
+					0,
+					REAL_ESTATE.inbox.previewLength,
+				) ?? null,
+			at: conversation.lastMessageAt,
+		})),
+		...fresh.map((lead) => ({
+			leadId: lead.id,
+			name: fullName(lead),
+			phone: lead.phone,
+			reason: "NOT_CONTACTED" as const,
+			detail: null,
+			at: lead.createdAt,
+		})),
+	];
+	const chosen = new Map<string, ToDo>();
+	for (const item of candidates.sort(
+		(a, b) => PRIORITY[a.reason] - PRIORITY[b.reason],
+	))
+		if (!chosen.has(item.leadId)) chosen.set(item.leadId, item);
+	return [...chosen.values()]
+		.sort((a, b) => b.at.getTime() - a.at.getTime())
+		.slice(0, limit);
+}
+
+export async function buildHome(
+	db: Db,
+	scope: ReadScope,
+	userId: string,
+	requested: "me" | "everyone",
+	now = new Date(),
+) {
+	const resolved = await resolveScope(db, scope, userId, requested);
+	const clientId = resolved.scope.clientId ?? undefined;
+	const leadWhere: Prisma.LeadWhereInput = {
+		agencyId: scope.agencyId,
+		clientId,
+	};
+	const zone = REAL_ESTATE.home.timeZone;
+	const todayKey = zonedDayKey(now, zone);
+	const todayStart = zonedMidnight(todayKey, zone);
+	const tomorrowStart = zonedMidnight(shiftDayKey(todayKey, 1), zone);
+	const days = dayRange(
+		shiftDayKey(todayKey, 1 - REAL_ESTATE.home.trendDays),
+		todayKey,
+	);
+	const trendStart = zonedMidnight(days[0] ?? todayKey, zone);
+	const weekStart = zonedMidnight(
+		shiftDayKey(todayKey, 1 - REAL_ESTATE.home.weekDays),
+		zone,
+	);
+	const horizon = new Date(
+		now.getTime() + REAL_ESTATE.home.appointmentHours * HOUR_MS,
+	);
+	const appointmentWhere = {
+		agencyId: scope.agencyId,
+		clientId,
+	} satisfies Prisma.AppointmentWhereInput;
+	const [recent, stages, todayAppointments, weekAppointments, upcoming, toDo] =
+		await Promise.all([
+			db.lead.findMany({
+				where: { ...leadWhere, createdAt: { gte: trendStart } },
+				select: { createdAt: true, firstContactedAt: true, status: true },
+			}),
+			db.lead.groupBy({
+				by: ["status"],
+				where: leadWhere,
+				_count: { id: true },
+			}),
+			db.appointment.count({
+				where: {
+					...appointmentWhere,
+					status: { in: [...UPCOMING_APPOINTMENT_STATUSES] },
+					startTime: { gte: todayStart, lt: tomorrowStart },
+				},
+			}),
+			db.appointment.count({
+				where: {
+					...appointmentWhere,
+					status: { in: [...BOOKED_APPOINTMENT_STATUSES] },
+					createdAt: { gte: weekStart },
+				},
+			}),
+			db.appointment.findMany({
+				where: {
+					...appointmentWhere,
+					status: { in: [...UPCOMING_APPOINTMENT_STATUSES] },
+					startTime: { gte: now, lte: horizon },
+				},
+				orderBy: { startTime: "asc" },
+				take: REAL_ESTATE.home.appointmentLimit,
+				select: {
+					id: true,
+					leadId: true,
+					startTime: true,
+					status: true,
+					lead: { select: { firstName: true, lastName: true } },
+				},
+			}),
+			toDoItems(db, leadWhere, scope.agencyId, now),
+		]);
+	const week = recent.filter((lead) => lead.createdAt >= weekStart);
+	const delays = week.flatMap((lead) =>
+		lead.firstContactedAt
+			? [
+					Math.max(
+						0,
+						(lead.firstContactedAt.getTime() - lead.createdAt.getTime()) /
+							MINUTE_MS,
+					),
+				]
+			: [],
+	);
+	const medianDelay = median(delays);
+	const counts = new Map(stages.map((row) => [row.status, row._count.id]));
+	return {
+		scope: resolved.scope,
+		today: {
+			newLeads: recent.filter((lead) => lead.createdAt >= todayStart).length,
+			appointments: todayAppointments,
+		},
+		week: {
+			newLeads: week.length,
+			qualified: week.filter((lead) =>
+				(QUALIFIED_STATUSES as readonly string[]).includes(lead.status),
+			).length,
+			appointments: weekAppointments,
+			medianResponseMinutes:
+				medianDelay === null ? null : Math.round(medianDelay * 10) / 10,
+		},
+		toDo,
+		appointments: upcoming.map((item) => ({
+			id: item.id,
+			leadId: item.leadId,
+			leadName: fullName(item.lead),
+			startTime: item.startTime,
+			status: item.status,
+		})),
+		stages: leadStatusEnum.options.map((status) => ({
+			status,
+			count: counts.get(status) ?? 0,
+		})),
+		trend: dailyCounts(
+			recent.map((lead) => lead.createdAt),
+			days,
+			zone,
+		),
+	};
+}
diff --git a/apps/api/src/real-estate/real-estate-inbox.ts b/apps/api/src/real-estate/real-estate-inbox.ts
new file mode 100644
index 0000000..47ade13
--- /dev/null
+++ b/apps/api/src/real-estate/real-estate-inbox.ts
@@ -0,0 +1,288 @@
+import type { Db, LeadModel } from "@crm/db";
+import { BadRequestException, NotFoundException } from "@nestjs/common";
+import { z } from "zod";
+import type { InboxInput } from "./real-estate.contracts";
+import { REAL_ESTATE } from "./real-estate-config";
+import { agencyMemberIds, type ReadScope } from "./real-estate-lead";
+
+type Channel = "SMS" | "EMAIL";
+
+type Sender = "LEAD" | "AI_SDR" | "HUMAN_AGENT" | "SYSTEM";
+
+type Activity = {
+	channel: Channel;
+	sender: Sender;
+	preview: string;
+	at: Date;
+	status: string | null;
+};
+
+type InboxLead = Pick<
+	LeadModel,
+	| "id"
+	| "firstName"
+	| "lastName"
+	| "phone"
+	| "email"
+	| "status"
+	| "intent"
+	| "clientId"
+	| "automationPausedAt"
+	| "escalationReason"
+	| "unsubscribedAt"
+> & { client: { name: string } | null };
+
+type Row = {
+	lead: InboxLead;
+	conversationId: string | null;
+	unreadCount: number;
+	lastMessage: Activity | null;
+	lastActivityAt: Date;
+};
+
+const leadSelect = {
+	id: true,
+	firstName: true,
+	lastName: true,
+	phone: true,
+	email: true,
+	status: true,
+	intent: true,
+	clientId: true,
+	client: { select: { name: true } },
+	automationPausedAt: true,
+	escalationReason: true,
+	unsubscribedAt: true,
+} as const;
+
+const recipientList = z.array(z.object({ email: z.string() }));
+
+function preview(text: string) {
+	const flat = text.replace(/\s+/g, " ").trim();
+	const limit = REAL_ESTATE.inbox.previewLength;
+	return flat.length > limit ? `${flat.slice(0, limit - 1)}…` : flat;
+}
+
+function fullName(lead: Pick<InboxLead, "firstName" | "lastName">) {
+	return [lead.firstName, lead.lastName].filter(Boolean).join(" ");
+}
+
+function isHuman(lead: InboxLead) {
+	return lead.automationPausedAt !== null && lead.unsubscribedAt === null;
+}
+
+function parseCursor(cursor: string) {
+	const split = cursor.indexOf(":");
+	const at = Number(cursor.slice(0, split));
+	if (split < 1 || !Number.isFinite(at))
+		throw new BadRequestException("Invalid cursor.");
+	return { at, id: cursor.slice(split + 1) };
+}
+
+function isAfter(row: Row, cursor: { at: number; id: string }) {
+	const at = row.lastActivityAt.getTime();
+	return at < cursor.at || (at === cursor.at && row.lead.id < cursor.id);
+}
+
+function matches(row: Row, search: string) {
+	const needle = search.toLowerCase();
+	const digits = search.replace(/\D/g, "");
+	return (
+		fullName(row.lead).toLowerCase().includes(needle) ||
+		(row.lead.email ?? "").toLowerCase().includes(needle) ||
+		(digits.length > 0 && row.lead.phone.replace(/\D/g, "").includes(digits))
+	);
+}
+
+async function latestEmailByAddress(db: Db, agencyId: string) {
+	const rows = await db.emailMessage.findMany({
+		where: { syncedByUserId: { in: await agencyMemberIds(db, agencyId) } },
+		orderBy: { sentAt: "desc" },
+		take: REAL_ESTATE.inbox.emailScanLimit,
+		select: {
+			direction: true,
+			fromEmail: true,
+			recipients: true,
+			subject: true,
+			snippet: true,
+			sentAt: true,
+		},
+	});
+	const latest = new Map<string, Activity>();
+	for (const row of rows) {
+		const addresses =
+			row.direction === "INBOUND"
+				? [row.fromEmail]
+				: (recipientList.safeParse(row.recipients).data ?? []).map(
+						(item) => item.email,
+					);
+		const activity: Activity = {
+			channel: "EMAIL",
+			sender: row.direction === "INBOUND" ? "LEAD" : "HUMAN_AGENT",
+			preview: preview(row.subject ?? row.snippet ?? ""),
+			at: row.sentAt,
+			status: null,
+		};
+		for (const address of addresses) {
+			const key = address.trim().toLowerCase();
+			if (key && !latest.has(key)) latest.set(key, activity);
+		}
+	}
+	return latest;
+}
+
+async function conversationRows(db: Db, scope: ReadScope) {
+	const conversations = await db.conversation.findMany({
+		where: {
+			agencyId: scope.agencyId,
+			channel: "SMS",
+			lead: { agencyId: scope.agencyId, clientId: scope.clientId ?? undefined },
+		},
+		orderBy: [{ lastMessageAt: "desc" }, { id: "desc" }],
+		take: REAL_ESTATE.inbox.conversationScanLimit,
+		select: {
+			id: true,
+			unreadCount: true,
+			lastMessageAt: true,
+			lead: { select: leadSelect },
+			messages: {
+				orderBy: [{ sentAt: "desc" }, { id: "desc" }],
+				take: 1,
+				select: { sender: true, content: true, sentAt: true, status: true },
+			},
+		},
+	});
+	const rows = new Map<string, Row>();
+	for (const conversation of conversations) {
+		const message = conversation.messages[0];
+		const existing = rows.get(conversation.lead.id);
+		if (existing) {
+			existing.unreadCount += conversation.unreadCount;
+			continue;
+		}
+		rows.set(conversation.lead.id, {
+			lead: conversation.lead,
+			conversationId: conversation.id,
+			unreadCount: conversation.unreadCount,
+			lastMessage: message
+				? {
+						channel: "SMS",
+						sender: message.sender,
+						preview: preview(message.content),
+						at: message.sentAt,
+						status: message.status,
+					}
+				: null,
+			lastActivityAt: message?.sentAt ?? conversation.lastMessageAt,
+		});
+	}
+	return rows;
+}
+
+async function withEmails(db: Db, scope: ReadScope, rows: Map<string, Row>) {
+	const latest = await latestEmailByAddress(db, scope.agencyId);
+	if (!latest.size) return;
+	const leads = await db.lead.findMany({
+		where: {
+			agencyId: scope.agencyId,
+			clientId: scope.clientId ?? undefined,
+			OR: [...latest.keys()].map((address) => ({
+				email: { equals: address, mode: "insensitive" as const },
+			})),
+		},
+		select: leadSelect,
+	});
+	for (const lead of leads) {
+		const activity = latest.get((lead.email ?? "").trim().toLowerCase());
+		if (!activity) continue;
+		const row = rows.get(lead.id);
+		if (!row) {
+			rows.set(lead.id, {
+				lead,
+				conversationId: null,
+				unreadCount: 0,
+				lastMessage: activity,
+				lastActivityAt: activity.at,
+			});
+			continue;
+		}
+		if (activity.at > row.lastActivityAt) {
+			row.lastMessage = activity;
+			row.lastActivityAt = activity.at;
+		}
+	}
+}
+
+export async function listInbox(db: Db, scope: ReadScope, input: InboxInput) {
+	const rows = await conversationRows(db, scope);
+	await withEmails(db, scope, rows);
+	const all = [...rows.values()].sort(
+		(a, b) =>
+			b.lastActivityAt.getTime() - a.lastActivityAt.getTime() ||
+			(a.lead.id < b.lead.id ? 1 : -1),
+	);
+	const search = input.search?.trim();
+	const cursor = input.cursor ? parseCursor(input.cursor) : null;
+	const visible = all
+		.filter((row) => {
+			if (input.filter === "UNREAD" && row.unreadCount === 0) return false;
+			if (input.filter === "HUMAN" && !isHuman(row.lead)) return false;
+			return !search || matches(row, search);
+		})
+		.filter((row) => !cursor || isAfter(row, cursor));
+	const page = visible.slice(0, input.limit);
+	const last = page.at(-1);
+	return {
+		items: page.map((row) => ({
+			leadId: row.lead.id,
+			conversationId: row.conversationId,
+			name: fullName(row.lead),
+			firstName: row.lead.firstName,
+			lastName: row.lead.lastName,
+			phone: row.lead.phone,
+			email: row.lead.email,
+			status: row.lead.status,
+			intent: row.lead.intent,
+			clientId: row.lead.clientId,
+			clientName: row.lead.client?.name ?? null,
+			unreadCount: row.unreadCount,
+			humanTakeover: isHuman(row.lead),
+			escalationReason: row.lead.escalationReason,
+			unsubscribed: row.lead.unsubscribedAt !== null,
+			lastMessage: row.lastMessage,
+			lastActivityAt: row.lastActivityAt,
+		})),
+		nextCursor:
+			last && visible.length > page.length
+				? `${last.lastActivityAt.getTime()}:${last.lead.id}`
+				: null,
+		counts: {
+			all: all.length,
+			unread: all.filter((row) => row.unreadCount > 0).length,
+			human: all.filter((row) => isHuman(row.lead)).length,
+		},
+	};
+}
+
+export async function markLeadRead(db: Db, scope: ReadScope, leadId: string) {
+	return db.$transaction(async (tx) => {
+		const lead = await tx.lead.findFirst({
+			where: {
+				id: leadId,
+				agencyId: scope.agencyId,
+				clientId: scope.clientId ?? undefined,
+			},
+			select: { id: true },
+		});
+		if (!lead) throw new NotFoundException("Lead not found.");
+		const unread = await tx.conversation.aggregate({
+			where: { agencyId: scope.agencyId, leadId, unreadCount: { gt: 0 } },
+			_sum: { unreadCount: true },
+		});
+		await tx.conversation.updateMany({
+			where: { agencyId: scope.agencyId, leadId, unreadCount: { gt: 0 } },
+			data: { unreadCount: 0 },
+		});
+		return { cleared: unread._sum.unreadCount ?? 0 };
+	});
+}
diff --git a/apps/api/src/real-estate/real-estate-lead.ts b/apps/api/src/real-estate/real-estate-lead.ts
new file mode 100644
index 0000000..e8421d2
--- /dev/null
+++ b/apps/api/src/real-estate/real-estate-lead.ts
@@ -0,0 +1,183 @@
+import type { Db } from "@crm/db";
+import {
+	listingSuggestions,
+	storedQualificationEvidence,
+} from "@crm/validation/real-estate";
+import { REAL_ESTATE } from "./real-estate-config";
+
+export type ReadScope = {
+	agencyId: string;
+	clientId?: string | null;
+	role: string;
+};
+
+export async function agencyMemberIds(db: Db, agencyId: string) {
+	const members = await db.agencyUser.findMany({
+		where: { agencyId },
+		select: { userId: true },
+	});
+	return members.map((member) => member.userId);
+}
+
+export function emailWebLink(row: {
+	gmailMessageId: string | null;
+	outlookWebLink: string | null;
+}) {
+	if (row.outlookWebLink) return row.outlookWebLink;
+	if (row.gmailMessageId)
+		return `${REAL_ESTATE.email.gmailWebBase}${row.gmailMessageId}`;
+	return null;
+}
+
+export async function leadEmails(
+	db: Db,
+	agencyId: string,
+	email: string | null,
+) {
+	if (!email) return [];
+	const address = email.trim().toLowerCase();
+	const rows = await db.emailMessage.findMany({
+		where: {
+			syncedByUserId: { in: await agencyMemberIds(db, agencyId) },
+			OR: [
+				{ fromEmail: { equals: address, mode: "insensitive" } },
+				{ recipients: { array_contains: [{ email: address }] } },
+			],
+		},
+		orderBy: { sentAt: "desc" },
+		take: REAL_ESTATE.lead.emailLimit,
+		select: {
+			id: true,
+			threadId: true,
+			direction: true,
+			fromName: true,
+			fromEmail: true,
+			subject: true,
+			snippet: true,
+			sentAt: true,
+			gmailMessageId: true,
+			outlookWebLink: true,
+		},
+	});
+	return rows.reverse().map((row) => ({
+		id: row.id,
+		threadId: row.threadId,
+		direction: row.direction,
+		fromName: row.fromName,
+		fromEmail: row.fromEmail,
+		subject: row.subject,
+		snippet: row.snippet,
+		sentAt: row.sentAt,
+		webLink: emailWebLink(row),
+	}));
+}
+
+export async function leadChannels(db: Db, agencyId: string) {
+	const [sms, syncs] = await Promise.all([
+		db.smsConnection.findFirst({
+			where: { agencyId },
+			select: { phoneNumber: true },
+		}),
+		agencyMemberIds(db, agencyId).then((userIds) =>
+			db.mailboxSync.findMany({
+				where: {
+					userId: { in: userIds },
+					source: { in: [...REAL_ESTATE.email.sources] },
+				},
+				select: { source: true },
+				distinct: ["source"],
+			}),
+		),
+	]);
+	const providers = REAL_ESTATE.email.sources.filter((source) =>
+		syncs.some((sync) => sync.source === source),
+	);
+	return {
+		sms: { connected: Boolean(sms), phoneNumber: sms?.phoneNumber ?? null },
+		email: {
+			connected: providers.length > 0,
+			providers,
+			canSend: false,
+		},
+	};
+}
+
+export function parseEvidence(value: unknown) {
+	const parsed = storedQualificationEvidence.safeParse(value ?? []);
+	return parsed.success ? parsed.data : [];
+}
+
+export function parseSuggestedListings(value: unknown) {
+	const parsed = listingSuggestions.safeParse(value ?? { listings: [] });
+	return parsed.success ? parsed.data.listings : [];
+}
+
+export function leadProfile(lead: {
+	language: string;
+	budgetMin: number | null;
+	timeline: string | null;
+	financing: string | null;
+	currentSituation: string | null;
+	escalationReason: string | null;
+	consentSource: string | null;
+	campaign: { name: string } | null;
+	form: { name: string } | null;
+	propertyInterest: {
+		minBedrooms: number | null;
+		minBathrooms: number | null;
+		mustHaveParking: boolean;
+		specificNotes: string | null;
+	} | null;
+}) {
+	const property = lead.propertyInterest;
+	return {
+		language: lead.language,
+		budgetMin: lead.budgetMin,
+		timeline: lead.timeline,
+		financing: lead.financing,
+		currentSituation: lead.currentSituation,
+		escalationReason: lead.escalationReason,
+		consentSource: lead.consentSource,
+		campaignName: lead.campaign?.name ?? null,
+		formName: lead.form?.name ?? null,
+		property: property
+			? {
+					minBedrooms: property.minBedrooms,
+					minBathrooms: property.minBathrooms,
+					mustHaveParking: property.mustHaveParking,
+					specificNotes: property.specificNotes,
+				}
+			: null,
+	};
+}
+
+export function addSuggestedListing(
+	current: unknown,
+	input: {
+		url: string;
+		address?: string;
+		askingPrice?: number;
+		bedrooms?: number;
+		bathrooms?: number;
+	},
+) {
+	const listings = parseSuggestedListings(current);
+	const link = new URL(input.url).href;
+	if (listings.some((item) => new URL(item.url).href === link))
+		return { added: false, listings };
+	if (listings.length >= REAL_ESTATE.lead.suggestionLimit)
+		return { added: false, listings };
+	return {
+		added: true,
+		listings: [
+			...listings,
+			{
+				url: link,
+				address: input.address ?? null,
+				askingPrice: input.askingPrice ?? null,
+				bedrooms: input.bedrooms ?? null,
+				bathrooms: input.bathrooms ?? null,
+			},
+		],
+	};
+}
