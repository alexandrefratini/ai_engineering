+
+export default defineTool({
+	description:
+		"Lit la fiche d'un prospect immobilier : statut, critères confirmés avec la citation du prospect comme preuve, critères non confirmés (étiquetés « suggestion non confirmée »), critères restants à confirmer, 5 derniers messages, rendez-vous, notes et état du consentement SMS. À utiliser quand le courtier veut le détail ou le contexte d'un prospect précis, après search_prospects ou list_prospects_needing_attention pour obtenir l'identifiant. Ne jamais présenter une suggestion comme un fait. Lecture seule, limitée aux prospects de l'utilisateur. Donner le chemin de la fiche (fiche) en lien.",
+	inputSchema: z.object({
+		leadId: z.string().trim().min(1).describe("Identifiant du prospect."),
+		agencyId: z
+			.string()
+			.trim()
+			.min(1)
+			.optional()
+			.describe(
+				"Identifiant de l'agence. Facultatif : par défaut, toutes les agences de l'utilisateur.",
+			),
+	}),
+	async execute(input, ctx) {
+		const { scopes } = await assistantScopes(ctx, input);
+		return readProspect(scopes, input.leadId);
+	},
+});
