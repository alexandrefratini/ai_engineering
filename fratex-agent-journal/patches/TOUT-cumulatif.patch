+import type { ReactNode } from "react";
+import { cn } from "../lib/utils";
+import Logo from "./logo";
+import { Separator } from "./separator";
+
+export function TopBar({
+	leading,
+	renderHomeLink,
+	breadcrumb,
+	search,
+	actions,
+	presence,
+	userMenu,
+	className,
+}: {
+	leading?: ReactNode;
+	renderHomeLink?: (logo: ReactNode) => ReactNode;
+	breadcrumb?: ReactNode;
+	search?: ReactNode;
+	actions?: ReactNode;
+	presence?: ReactNode;
+	userMenu?: ReactNode;
+	className?: string;
+}) {
+	const logo = <Logo aria-hidden="true" className="size-5 text-primary" />;
+	return (
+		<header
+			data-slot="top-bar"
+			className={cn("flex h-12 shrink-0 items-center gap-2 border-b bg-background px-3", className)}
+		>
+			<div className="flex min-w-0 flex-1 items-center gap-1 md:basis-0">
+				{leading}
+				<span className="flex size-8 shrink-0 items-center justify-center rounded-md transition-opacity hover:opacity-80 max-md:hidden">
+					{renderHomeLink ? renderHomeLink(logo) : logo}
+				</span>
+				{breadcrumb && (
+					<>
+						<Separator orientation="vertical" className="mx-1.5 h-4 data-vertical:self-center max-md:hidden" />
+						{breadcrumb}
+					</>
+				)}
+			</div>
+			{search && <div className="flex shrink-0 justify-center md:w-[clamp(14rem,36vw,36rem)]">{search}</div>}
+			<div className="flex shrink-0 items-center justify-end gap-1.5 md:flex-1 md:basis-0">
+				{actions}
+				{presence}
+				{presence && <Separator orientation="vertical" className="mx-1.5 h-5 data-vertical:self-center" />}
+				{userMenu && <div className="flex items-center pl-1">{userMenu}</div>}
+			</div>
+		</header>
+	);
+}
