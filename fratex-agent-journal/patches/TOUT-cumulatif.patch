@@ -0,0 +1,767 @@
+import { afterAll, beforeAll, describe, expect, it } from "bun:test";
+import { randomUUID } from "node:crypto";
+import { db } from "@crm/db";
+import { localDay } from "../agent/lib/assistant-time";
+import listAppointments from "../agent/tools/list_appointments";
+import listAttention from "../agent/tools/list_prospects_needing_attention";
+import readProspect from "../agent/tools/read_prospect";
+import performance from "../agent/tools/realtor_performance";
+import policy from "../agent/tools/sdr_policy";
+import searchProspects from "../agent/tools/search_prospects";
+
+const suffix = randomUUID();
+const id = (name: string) => `asst-${name}-${suffix}`;
+const agencyA = id("agency-a"),
+	agencyB = id("agency-b");
+const staff = id("staff"),
+	marie = id("marie"),
+	outsider = id("outsider"),
+	stranger = id("stranger");
+const clientMarie = id("client-marie"),
+	clientLuc = id("client-luc"),
+	clientForeign = id("client-foreign"),
+	clientEmpty = id("client-empty");
+const lead = {
+	alice: id("alice"),
+	bob: id("bob"),
+	carl: id("carl"),
+	dana: id("dana"),
+	eve: id("eve"),
+	fred: id("fred"),
+	gina: id("gina"),
+	zed: id("zed"),
+};
+const now = Date.now();
+const MIN = 60_000,
+	HOUR = 60 * MIN,
+	DAY = 24 * HOUR;
+const ago = (ms: number) => new Date(now - ms);
+const ahead = (ms: number) => new Date(now + ms);
+
+function sessionFor(userId: string, overrides: Record<string, string> = {}) {
+	return {
+		callId: "call-1",
+		session: {
+			id: `asst-session-${suffix}`,
+			auth: {
+				current: {
+					principalType: "user",
+					principalId: userId,
+					attributes: { purpose: "builder", userId, ...overrides },
+				},
+				initiator: null,
+			},
+		},
+	};
+}
+
+const tools = [
+	[listAttention, {}],
+	[searchProspects, { query: "Alice" }],
+	[readProspect, { leadId: "x" }],
+	[listAppointments, {}],
+	[performance, {}],
+] as const;
+
+const quote = "Je veux acheter un condo à Laval. Budget 500000.";
+const messageIds = Array.from({ length: 7 }, (_, index) =>
+	id(`message-${index}`),
+);
+
+async function seedLead(
+	key: keyof typeof lead,
+	data: Record<string, unknown>,
+	conversation?: { unreadCount: number; lastMessageAt: Date },
+) {
+	await db.lead.create({
+		data: {
+			id: lead[key],
+			firstName: key[0]?.toUpperCase() + key.slice(1),
+			phone: `+1514555${String(Object.keys(lead).indexOf(key)).padStart(4, "0")}`,
+			...data,
+		} as never,
+	});
+	if (conversation)
+		await db.conversation.create({
+			data: {
+				id: id(`conv-${key}`),
+				agencyId: data.agencyId as string,
+				leadId: lead[key],
+				...conversation,
+			},
+		});
+}
+
+beforeAll(async () => {
+	await db.user.createMany({
+		data: [staff, marie, outsider, stranger].map((userId) => ({
+			id: userId,
+			name: userId,
+			email: `${userId}@test.invalid`,
+		})),
+	});
+	await db.agency.createMany({
+		data: [
+			{ id: agencyA, name: "A", slug: agencyA },
+			{ id: agencyB, name: "B", slug: agencyB },
+		],
+	});
+	await db.client.createMany({
+		data: [
+			{
+				id: clientMarie,
+				agencyId: agencyA,
+				name: "Marie",
+				email: `m-${suffix}@test.invalid`,
+			},
+			{
+				id: clientLuc,
+				agencyId: agencyA,
+				name: "Luc",
+				email: `l-${suffix}@test.invalid`,
+			},
+			{
+				id: clientForeign,
+				agencyId: agencyB,
+				name: "Foreign",
+				email: `f-${suffix}@test.invalid`,
+			},
+			{
+				id: clientEmpty,
+				agencyId: agencyA,
+				name: "Nina",
+				email: `n-${suffix}@test.invalid`,
+			},
+		],
+	});
+	await db.agencyUser.createMany({
+		data: [
+			{ agencyId: agencyA, userId: staff, role: "OWNER" },
+			{
+				agencyId: agencyA,
+				userId: marie,
+				role: "REALTOR",
+				clientId: clientMarie,
+			},
+			{ agencyId: agencyB, userId: outsider, role: "OWNER" },
+		],
+	});
+	await seedLead(
+		"alice",
+		{
+			agencyId: agencyA,
+			clientId: clientMarie,
+			lastName: "Unread",
+			status: "CONTACTED",
+			createdAt: ago(2 * DAY),
+			firstContactedAt: new Date(now - 2 * DAY + 3 * MIN),
+			intent: "BUY",
+			targetArea: "Laval",
+			budgetMax: 500000,
+			timeline: "6 mois",
+			financing: "Préapprouvé",
+			consentedAt: ago(2 * DAY),
+			consentSource: "META_FORM",
+			qualificationEvidence: [
+				{
+					messageId: messageIds[0],
+					field: "intent",
+					quote: "Je veux acheter un condo",
+				},
+				{
+					messageId: messageIds[0],
+					field: "targetArea",
+					quote: "condo à Laval",
+				},
+				{
+					messageId: messageIds[0],
+					field: "budgetMax",
+					quote: "Budget 500000",
+				},
+				{
+					messageId: messageIds[0],
+					field: "financing",
+					quote: "déjà préapprouvé par ma banque",
+				},
+			],
+			suggestions: {
+				listings: [
+					{
+						url: "https://example.test/listing/1",
+						address: "12 rue Test",
+						askingPrice: 480000,
+						bedrooms: 2,
+						bathrooms: 1,
+					},
+				],
+			},
+		},
+		{ unreadCount: 2, lastMessageAt: ago(5 * HOUR) },
+	);
+	await seedLead(
+		"bob",
+		{
+			agencyId: agencyA,
+			clientId: clientMarie,
+			status: "QUALIFYING",
+			createdAt: ago(5 * DAY),
+			firstContactedAt: new Date(now - 5 * DAY + 9 * MIN),
+			automationPausedAt: ago(HOUR),
+			escalationReason: "EXPLICIT_HUMAN_REQUEST",
+		},
+		{ unreadCount: 0, lastMessageAt: ago(2 * DAY) },
