@@ -0,0 +1,149 @@
+"use client";
+
+import Group from "@carbon/icons-react/es/Group";
+import type { ReactNode } from "react";
+import { initialsFromName } from "../lib/format";
+import { cn } from "../lib/utils";
+import { Avatar, AvatarBadge, AvatarFallback, AvatarImage } from "./avatar";
+import { EmptyState } from "./empty-state";
+
+export type TeamRosterRow = {
+	id: string;
+	name: string;
+	email: string;
+	image: string | null;
+	roleLabel: string;
+	agencies: string[];
+	online: boolean;
+	lastSeenAt: string | null;
+	isViewer: boolean;
+	openTasks: number;
+	overdueTasks: number;
+	actions: number;
+	lastActionAt: string | null;
+};
+
+export function MemberAvatar({
+	name,
+	image,
+	online,
+	size = "default",
+}: {
+	name: string;
+	image: string | null;
+	online: boolean;
+	size?: "default" | "lg";
+}) {
+	return (
+		<Avatar size={size}>
+			{image ? <AvatarImage src={image} alt="" /> : null}
+			<AvatarFallback>{initialsFromName(name)}</AvatarFallback>
+			{online && <AvatarBadge />}
+		</Avatar>
+	);
+}
+
+function Figure({
+	label,
+	value,
+	alert = false,
+}: {
+	label: string;
+	value: number;
+	alert?: boolean;
+}) {
+	return (
+		<span className="flex items-baseline gap-1.5">
+			<span
+				className={cn(
+					"font-medium tabular-nums",
+					alert && value > 0 && "text-destructive",
+				)}
+			>
+				{value}
+			</span>
+			<span className="text-xs text-muted-foreground">{label}</span>
+		</span>
+	);
+}
+
+export function TeamRoster({
+	rows,
+	renderLink,
+	renderTime,
+	onlineLabel,
+	neverLabel,
+	figures,
+	empty,
+}: {
+	rows: TeamRosterRow[];
+	renderLink: (row: TeamRosterRow, children: ReactNode) => ReactNode;
+	renderTime: (iso: string) => ReactNode;
+	onlineLabel: string;
+	neverLabel: string;
+	figures: { open: string; overdue: string; actions: string };
+	empty: { title: string; description: string };
+}) {
+	if (rows.length === 0)
+		return (
+			<EmptyState
+				compact
+				icon={Group}
+				title={empty.title}
+				description={empty.description}
+			/>
+		);
+
+	return (
+		<ul className="-my-1 flex flex-col divide-y">
+			{rows.map((row) => (
+				<li key={row.id}>
+					{renderLink(
+						row,
+						<span className="flex flex-col gap-2 py-3 sm:flex-row sm:items-center sm:gap-4">
+							<span className="flex min-w-0 flex-1 items-center gap-3">
+								<MemberAvatar
+									name={row.name}
+									image={row.image}
+									online={row.online}
+								/>
+								<span className="flex min-w-0 flex-col">
+									<span translate="no" className="truncate font-medium">
+										{row.name}
+										{row.isViewer && (
+											<span className="font-normal text-muted-foreground">
+												{" "}
+												(vous)
+											</span>
+										)}
+									</span>
+									<span className="truncate text-xs text-muted-foreground">
+										{row.roleLabel}
+										{row.agencies.length > 0 && (
+											<span translate="no">
+												{" · "}
+												{row.agencies.join(", ")}
+											</span>
+										)}
+									</span>
+								</span>
+							</span>
+							<span className="flex flex-wrap items-center gap-x-5 gap-y-1 pl-12 text-sm sm:pl-0">
+								<Figure label={figures.open} value={row.openTasks} />
+								<Figure label={figures.overdue} value={row.overdueTasks} alert />
+								<Figure label={figures.actions} value={row.actions} />
+								<span className="w-28 text-xs text-muted-foreground sm:text-right">
+									{row.online
+										? onlineLabel
+										: row.lastSeenAt
+											? renderTime(row.lastSeenAt)
+											: neverLabel}
+								</span>
+							</span>
+						</span>,
+					)}
+				</li>
+			))}
+		</ul>
+	);
+}
