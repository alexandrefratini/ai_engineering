+export function SegmentMeter({
+	filled,
+	total,
+	label,
+	size = "sm",
+}: {
+	filled: number;
+	total: number;
+	label: string;
+	size?: keyof typeof SEGMENT_SIZES;
+}) {
+	const mounted = useMounted();
+	const count = Math.max(0, Math.round(clamp(total, 0, Number.MAX_SAFE_INTEGER)));
+	const lit = Math.round(clamp(filled, 0, count));
+	if (count === 0) return null;
+	if (count > SEGMENT_LIMIT)
+		return (
+			<span
+				role="img"
+				aria-label={label}
+				className={cn("inline-block w-24 shrink-0 overflow-hidden rounded-full bg-foreground/10", SEGMENT_SIZES[size].height)}
+			>
+				<span
+					className="block h-full rounded-full bg-primary transition-[width] duration-700 ease-out motion-reduce:transition-none"
+					style={{ width: mounted ? `${(lit / count) * 100}%` : "0%" }}
+				/>
+			</span>
+		);
+	return (
+		<span role="img" aria-label={label} className="inline-flex shrink-0 items-center gap-0.5">
+			{Array.from({ length: count }, (_, index) => (
