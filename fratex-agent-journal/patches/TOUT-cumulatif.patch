diff --git a/apps/app/components/page-translation.tsx b/apps/app/components/page-translation.tsx
new file mode 100644
index 0000000..fa3b95f
--- /dev/null
+++ b/apps/app/components/page-translation.tsx
@@ -0,0 +1,128 @@
+"use client";
+
+import {
+	TranslateConsentDialog,
+	TranslateMenu,
+} from "@crm/ui/components/translate-menu";
+import { useEffect, useState } from "react";
+import {
+	activeLanguage,
+	languageLabel,
+	translationCookies,
+} from "@/lib/page-translation";
+import { TRANSLATION } from "@/lib/translation-config";
+
+declare global {
+	interface Window {
+		google?: {
+			translate: {
+				TranslateElement: new (
+					options: { pageLanguage: string; autoDisplay: boolean },
+					elementId: string,
+				) => unknown;
+			};
+		};
+		initGoogleTranslate?: () => void;
+	}
+}
+
+function installDomGuards() {
+	const removeChild = Node.prototype.removeChild;
+	Node.prototype.removeChild = function <T extends Node>(
+		this: Node,
+		child: T,
+	): T {
+		if (child.parentNode !== this) return child;
+		return removeChild.call(this, child) as T;
+	};
+	const insertBefore = Node.prototype.insertBefore;
+	Node.prototype.insertBefore = function <T extends Node>(
+		this: Node,
+		node: T,
+		reference: Node | null,
+	): T {
+		if (reference && reference.parentNode !== this) return node;
+		return insertBefore.call(this, node, reference) as T;
+	};
+}
+
+function loadGoogleTranslate() {
+	if (document.getElementById(TRANSLATION.elementId)) return;
+	installDomGuards();
+	const host = document.createElement("div");
+	host.id = TRANSLATION.elementId;
+	host.hidden = true;
+	document.body.appendChild(host);
+	window[TRANSLATION.callback] = () => {
+		if (!window.google) return;
+		new window.google.translate.TranslateElement(
+			{ pageLanguage: TRANSLATION.pageLanguage, autoDisplay: false },
+			TRANSLATION.elementId,
+		);
+	};
+	const script = document.createElement("script");
+	script.src = `${TRANSLATION.scriptSrc}?cb=${TRANSLATION.callback}`;
+	script.async = true;
+	document.body.appendChild(script);
+}
+
+function applyLanguage(code: string | null) {
+	for (const cookie of translationCookies(code, window.location.hostname))
+		document.cookie = cookie;
+	window.location.reload();
+}
+
+function hasConsent(): boolean {
+	try {
+		return window.localStorage.getItem(TRANSLATION.consentKey) === "1";
+	} catch {
+		return false;
+	}
+}
+
+function rememberConsent() {
+	try {
+		window.localStorage.setItem(TRANSLATION.consentKey, "1");
+	} catch {
+		return;
+	}
+}
+
+export function PageTranslation() {
+	const [active, setActive] = useState<string | null>(null);
+	const [pending, setPending] = useState<string | null>(null);
+
+	useEffect(() => {
+		const code = activeLanguage(document.cookie);
+		setActive(code);
+		if (code) loadGoogleTranslate();
+	}, []);
+
+	return (
+		<>
+			<TranslateMenu
+				languages={TRANSLATION.languages}
+				original={TRANSLATION.original}
+				active={active}
+				notice={TRANSLATION.notice}
+				onSelect={(code) => {
+					if (code && !hasConsent()) {
+						setPending(code);
+						return;
+					}
+					applyLanguage(code);
+				}}
+			/>
+			<TranslateConsentDialog
+				open={pending !== null}
+				languageLabel={pending ? languageLabel(pending) : ""}
+				notice={TRANSLATION.notice}
+				onCancel={() => setPending(null)}
+				onConfirm={() => {
