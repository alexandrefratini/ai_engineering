+import { afterAll, beforeAll, describe, expect, it } from "bun:test";
+import { randomUUID } from "node:crypto";
+import { WORKSPACE_ID } from "@crm/auth";
+import { db } from "@crm/db";
+import { PRESENCE } from "../src/presence/presence-config";
+import { TeamService } from "../src/team/team.service";
+
+const suffix = randomUUID();
+const DAY = 24 * 60 * 60 * 1000;
+const now = Date.now();
+const id = (name: string) => `team-${name}-${suffix}`;
+
+const boss = id("boss");
+const peer = id("peer");
+const idle = id("idle");
+const stranger = id("stranger");
+const agencyA = id("agency-a");
+const agencyB = id("agency-b");
+const leadA = id("lead-a");
+const leadB = id("lead-b");
+const service = new TeamService(db);
+
+beforeAll(async () => {
+	await db.user.createMany({
+		data: [boss, peer, idle, stranger].map((userId) => ({
+			id: userId,
+			name: `Membre ${userId.slice(5, 9)}`,
+			email: `${userId}@example.test`,
+			lastSeenAt:
+				userId === peer ? new Date(now - 30_000) : new Date(now - 3 * DAY),
+		})),
+	});
+	await db.organization.upsert({
+		where: { id: WORKSPACE_ID },
+		update: {},
+		create: {
+			id: WORKSPACE_ID,
+			name: "Équipe",
+			slug: WORKSPACE_ID,
+			createdAt: new Date(),
+		},
+	});
+	await db.member.createMany({
+		data: [
+			{ userId: boss, role: "owner" },
+			{ userId: peer, role: "member" },
+			{ userId: idle, role: "member" },
+			{ userId: stranger, role: "member" },
+		].map((item) => ({
+			...item,
+			id: `${item.userId}-member`,
+			organizationId: WORKSPACE_ID,
+			createdAt: new Date(),
+		})),
+	});
+	await db.agency.createMany({
+		data: [
+			{ id: agencyA, name: "Agence A", slug: agencyA },
+			{ id: agencyB, name: "Agence B", slug: agencyB },
+		],
+	});
+	await db.agencyUser.createMany({
+		data: [
+			{ agencyId: agencyA, userId: boss, role: "OWNER" },
+			{ agencyId: agencyA, userId: peer, role: "MARKETER" },
+			{ agencyId: agencyB, userId: stranger, role: "OWNER" },
+			{ agencyId: agencyB, userId: peer, role: "MARKETER" },
+		],
+	});
+	await db.lead.createMany({
+		data: [
+			{
+				id: leadA,
+				agencyId: agencyA,
+				firstName: "Alice",
+				phone: "+15145550101",
+			},
+			{
+				id: leadB,
+				agencyId: agencyB,
+				firstName: "Bruno",
+				phone: "+15145550102",
+			},
+		],
+	});
+	await db.leadNote.createMany({
+		data: [
+			{
+				agencyId: agencyA,
+				leadId: leadA,
+				authorId: peer,
+				body: "Rappeler jeudi",
+			},
+			{
+				agencyId: agencyB,
+				leadId: leadB,
+				authorId: peer,
+				body: "Note confidentielle B",
+			},
+		],
+	});
+	const conversationA = await db.conversation.create({
+		data: { agencyId: agencyA, leadId: leadA },
+	});
+	const conversationB = await db.conversation.create({
+		data: { agencyId: agencyB, leadId: leadB },
+	});
+	await db.message.createMany({
+		data: [
+			{
+				agencyId: agencyA,
+				conversationId: conversationA.id,
+				sender: "HUMAN_AGENT",
+				content: "Bonjour Alice",
+				status: "SENT",
+				metadata: { authorId: peer },
+			},
+			{
+				agencyId: agencyA,
+				conversationId: conversationA.id,
+				sender: "AI_SDR",
+				content: "Message de l'IA",
+				status: "SENT",
+			},
+			{
+				agencyId: agencyB,
+				conversationId: conversationB.id,
+				sender: "HUMAN_AGENT",
+				content: "Bonjour Bruno",
+				status: "SENT",
+				metadata: { authorId: peer },
+			},
+		],
+	});
+	await db.activity.createMany({
+		data: [
+			{
+				type: "TASK",
+				subject: "Appeler le notaire",
+				createdById: peer,
+				dueAt: new Date(now - DAY),
+			},
+			{
+				type: "TASK",
+				subject: "Préparer la visite",
+				createdById: peer,
+				dueAt: new Date(now + DAY),
+			},
+			{
+				type: "TASK",
+				subject: "Envoyer l'offre",
+				createdById: peer,
+				dueAt: new Date(now - 2 * DAY),
+				completedAt: new Date(now - DAY),
+			},
+			{ type: "CALL", subject: "Appel de suivi", createdById: peer },
+		],
+	});
+	await db.supportRequest.create({
+		data: {
+			userId: peer,
+			kind: "PROBLEM",
+			subject: "Le SMS ne part pas",
+			message: "Le SMS ne part pas",
+		},
+	});
+});
+
+afterAll(async () => {
+	await db.activity.deleteMany({
+		where: { createdById: { in: [boss, peer] } },
+	});
+	await db.agency.deleteMany({ where: { id: { in: [agencyA, agencyB] } } });
+	await db.member.deleteMany({
+		where: { userId: { in: [boss, peer, idle, stranger] } },
+	});
+	await db.user.deleteMany({
+		where: { id: { in: [boss, peer, idle, stranger] } },
+	});
+});
+
+describe("team page", () => {
+	it("gives the owner every member with presence, tasks and a count of actions", async () => {
+		const team = await service.list(boss, { filter: "ALL" });
+		const byId = new Map(team.rows.map((row) => [row.id, row]));
+		const row = byId.get(peer);
+
+		expect(team.canViewEveryone).toBe(true);
+		expect(byId.has(idle)).toBe(true);
+		expect(row?.online).toBe(true);
+		expect(byId.get(idle)?.online).toBe(false);
+		expect(row?.openTasks).toBe(2);
+		expect(row?.overdueTasks).toBe(1);
+		expect(row?.actions).toBeGreaterThanOrEqual(3);
+		expect(row?.lastActionAt).not.toBeNull();
+		expect(row?.agencyRoles.map((item) => item.agencyName).sort()).toEqual([
+			"Agence A",
+			"Agence B",
+		]);
+		expect(byId.get(boss)?.isViewer).toBe(true);
+		expect(team.summary.members).toBeGreaterThanOrEqual(4);
+		expect(PRESENCE.onlineWindowMs).toBeGreaterThan(30_000);
+	});
+
+	it("filters by search text and by online state", async () => {
+		const online = await service.list(boss, { filter: "ONLINE" });
+		const search = await service.list(boss, { filter: "ALL", search: peer });
+
+		expect(online.rows.some((row) => row.id === peer)).toBe(true);
+		expect(online.rows.some((row) => row.id === idle)).toBe(false);
+		expect(search.rows.map((row) => row.id)).toEqual([peer]);
+	});
+
+	it("shows a plain member only themselves", async () => {
+		const team = await service.list(peer, { filter: "ALL" });
+
+		expect(team.canViewEveryone).toBe(false);
+		expect(team.rows.map((row) => row.id)).toEqual([peer]);
+	});
+
+	it("refuses a member who asks for someone else", async () => {
+		await expect(service.member(peer, boss)).rejects.toThrow();
+		await expect(service.member(idle, peer)).rejects.toThrow();
+		expect((await service.member(peer, peer)).member.id).toBe(peer);
+	});
+
+	it("reports an unknown member as not found", async () => {
+		await expect(service.member(boss, id("ghost"))).rejects.toThrow();
+	});
+
+	it("builds the history without leaking leads from agencies the viewer cannot open", async () => {
+		const detail = await service.member(boss, peer);
+		const titles = detail.timeline.map((item) => item.title);
+		const kinds = new Set(detail.timeline.map((item) => item.kind));
+
+		expect(titles).toContain("Note sur Alice");
+		expect(titles).toContain("SMS envoyé à Alice");
+		expect(titles).not.toContain("Note sur Bruno");
+		expect(titles).not.toContain("SMS envoyé à Bruno");
+		expect(titles).toContain("Appel de suivi");
+		expect(titles).toContain("Le SMS ne part pas");
+		expect(kinds.has("LEAD_NOTE")).toBe(true);
+		expect(kinds.has("SMS")).toBe(true);
+		expect(JSON.stringify(detail)).not.toContain("Note confidentielle B");
+		expect(JSON.stringify(detail)).not.toContain("Message de l'IA");
+
+		const times = detail.timeline.map((item) => Date.parse(item.at));
+		expect(times).toEqual([...times].sort((a, b) => b - a));
+	});
+
+	it("splits tasks into open, overdue and done and counts them", async () => {
+		const detail = await service.member(boss, peer);
+		const bySubject = new Map(detail.tasks.map((task) => [task.subject, task]));
+
+		expect(bySubject.get("Appeler le notaire")?.overdue).toBe(true);
+		expect(bySubject.get("Préparer la visite")?.overdue).toBe(false);
+		expect(bySubject.get("Envoyer l'offre")?.completedAt).not.toBeNull();
+		expect(detail.stats.openTasks).toBe(2);
+		expect(detail.stats.overdueTasks).toBe(1);
+		expect(detail.stats.doneTasks).toBe(1);
+		expect(detail.stats.notes).toBe(1);
+		expect(detail.stats.sms).toBe(1);
+		expect(detail.stats.supportOpen).toBe(1);
+	});
+});
