+import { defineTool } from "eve/tools";
+import { z } from "zod";
+import { ASSISTANT_PERIODS } from "../lib/assistant-config";
+import { realtorPerformance } from "../lib/assistant-reports";
+import { assistantScopes } from "../lib/assistant-scope";
+
+export default defineTool({
+	description:
+		"Donne les chiffres de performance : prospects reçus, contactés, délai médian de première réponse en minutes, part répondue en 5 minutes, prospects qualifiés, taux de conversion (qualifiés ÷ reçus), rendez-vous pris et réalisés. Périodes : 30D (30 derniers jours), 90D, MONTH (ce mois-ci). À utiliser pour « Comment vont mes chiffres ? », « Combien de prospects ce mois-ci ? » ou « Quel est mon délai de réponse ? ». Le personnel de l'agence reçoit aussi le détail par courtier (byRealtor) et peut cibler un courtier avec clientId ; un courtier ne voit que ses propres chiffres. Une valeur null signifie « aucune donnée » : ne jamais la remplacer par un chiffre inventé. Lecture seule.",
+	inputSchema: z.object({
+		period: z.enum(ASSISTANT_PERIODS).default("30D"),
+		clientId: z
+			.string()
+			.trim()
+			.min(1)
+			.optional()
+			.describe(
+				"Identifiant du courtier (client) à isoler. Réservé au personnel de l'agence.",
+			),
+		agencyId: z
+			.string()
+			.trim()
+			.min(1)
+			.optional()
+			.describe(
+				"Identifiant de l'agence. Facultatif : par défaut, toutes les agences de l'utilisateur.",
+			),
+	}),
+	async execute(input, ctx) {
+		const { scopes } = await assistantScopes(ctx, input);
+		return realtorPerformance(scopes, input.period);
+	},
+});
