+import { describe, expect, it } from "bun:test";
+import {
+	activeLanguage,
+	languageLabel,
+	translationCookies,
+} from "./page-translation";
+
+describe("page translation cookie", () => {
+	it("reads the target language from the Google cookie", () => {
+		expect(activeLanguage("a=1; googtrans=/fr/en; b=2")).toBe("en");
+		expect(activeLanguage("googtrans=/fr/zh-CN")).toBe("zh-CN");
+	});
+
+	it("ignores other source languages and unknown targets", () => {
+		expect(activeLanguage("googtrans=/en/fr")).toBeNull();
+		expect(activeLanguage("googtrans=/fr/xx")).toBeNull();
+		expect(activeLanguage("")).toBeNull();
+	});
+
+	it("sets the cookie on the host and its domain variants", () => {
+		expect(translationCookies("es", "localhost")).toEqual([
+			"googtrans=/fr/es; path=/",
+		]);
+		const cookies = translationCookies("es", "app.fratex.ca");
+
+		expect(cookies).toHaveLength(3);
+		expect(
+			cookies.every((cookie) => cookie.startsWith("googtrans=/fr/es")),
+		).toBe(true);
+	});
+
+	it("expires the cookie when going back to the original language", () => {
+		for (const cookie of translationCookies(null, "app.fratex.ca"))
+			expect(cookie).toContain("expires=Thu, 01 Jan 1970");
+	});
+
+	it("labels a language by its code", () => {
+		expect(languageLabel("ht")).toBe("Kreyòl ayisyen");
+		expect(languageLabel("zz")).toBe("zz");
+	});
+});
