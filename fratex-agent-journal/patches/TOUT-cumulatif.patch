+import type { Db } from "@crm/db";
+
+export async function clientRoster(
+	db: Db,
+	agencyId: string,
+	clientId?: string | null,
+) {
+	const clients = await db.client.findMany({
+		where: { agencyId, id: clientId ?? undefined },
+		orderBy: { name: "asc" },
+		include: {
+			_count: { select: { leads: true, appointments: true } },
+			realtorCalendar: { select: { id: true } },
+		},
+	});
+	const ids = clients.map((client) => client.id);
+	const [latest, forms, sms] = await Promise.all([
+		db.lead.groupBy({
+			by: ["clientId"],
+			where: { agencyId, clientId: { in: ids } },
+			_max: { createdAt: true },
+		}),
+		db.metaLeadForm.groupBy({
+			by: ["clientId"],
+			where: { agencyId, clientId: { in: ids } },
+			_count: { id: true },
+		}),
+		db.smsConnection.count({ where: { agencyId } }),
+	]);
+	const lastLead = new Map(
+		latest.map((row) => [row.clientId, row._max.createdAt]),
+	);
+	const withForm = new Set(forms.map((row) => row.clientId));
+	return clients.map(({ _count, realtorCalendar, ...client }) => ({
+		...client,
+		lastLeadAt: lastLead.get(client.id) ?? null,
+		leadsCount: _count.leads,
+		appointmentsCount: _count.appointments,
+		setup: {
+			metaForm: withForm.has(client.id),
+			calendar: realtorCalendar !== null,
+			sms: sms > 0,
+		},
+	}));
+}
