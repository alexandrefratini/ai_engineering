+import type { Metadata } from "next";
+import { Suspense } from "react";
+import {
+	PageShell,
+	PageShellContent,
+	PageShellLoading,
+} from "@/components/page-shell";
+import { requireSession } from "@/lib/session";
+import { LeadDetailView } from "./lead-detail-view";
+
+export const metadata: Metadata = {
+	title: "Fiche du prospect",
+};
+
+export default function LeadPage({
+	params,
+}: {
+	params: Promise<{ slug: string; leadId: string }>;
+}) {
+	return (
+		<PageShell className="min-h-0">
+			<h1 className="sr-only">Fiche du prospect</h1>
+			<PageShellContent className="min-h-0 p-0">
+				<Suspense fallback={<PageShellLoading />}>
+					<LeadDataLoader params={params} />
+				</Suspense>
+			</PageShellContent>
+		</PageShell>
+	);
+}
+
+async function LeadDataLoader({
+	params,
+}: {
+	params: Promise<{ slug: string; leadId: string }>;
+}) {
+	await requireSession();
+	const { leadId } = await params;
+	return <LeadDetailView leadId={leadId} />;
+}
