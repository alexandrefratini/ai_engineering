+
+export function Sparkline({ values, label }: { values: number[]; label: string }) {
+	const mounted = useMounted();
+	if (values.length < 2) return null;
+	const max = Math.max(...values, 1);
+	const step = 100 / (values.length - 1);
+	const line = values
+		.map((value, index) => {
+			const x = index * step;
+			const y = 2 + (1 - Math.max(0, value) / max) * 20;
+			return `${index === 0 ? "M" : "L"}${x.toFixed(2)} ${y.toFixed(2)}`;
+		})
+		.join(" ");
+	const last = values[values.length - 1] ?? 0;
+	return (
+		<svg
+			viewBox="0 0 100 24"
+			preserveAspectRatio="none"
+			role="img"
+			aria-label={`${label}. Dernière valeur : ${last}. Maximum : ${Math.max(...values)}.`}
+			className="mt-1 h-8 w-full transition-[clip-path] duration-1000 ease-out motion-reduce:transition-none"
+			style={{ clipPath: mounted ? "inset(0 0 0 0)" : "inset(0 100% 0 0)" }}
+		>
+			<path d={`${line} L100 24 L0 24 Z`} className="fill-primary/10" />
+			<path
+				d={line}
