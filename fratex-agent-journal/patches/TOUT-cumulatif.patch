+			period: "90D",
+		});
+
+		expect(portal.period).toBe("90D");
+		expect(portal.trend).toHaveLength(90);
+		expect(portal.trend.reduce((sum, day) => sum + day.count, 0)).toBe(6);
+		expect(portal.speed).toEqual({
+			medianMinutes: 4,
+			fastSharePct: 60,
+			fastThresholdMinutes: 5,
+			measured: 5,
+		});
+		expect(portal.intents).toEqual([
+			{ id: "UNKNOWN", label: "À confirmer", count: 4 },
+			{ id: "BUY", label: "Achat", count: 2 },
+		]);
+		expect(portal.sources).toEqual([
+			{ id: "UNKNOWN", label: "Non précisée", count: 4 },
+			{ id: "REFERRAL", label: "Référence", count: 2 },
+		]);
+		expect(portal.budgets).toEqual({
+			confirmed: 3,
+			medianMax: 600000,
+			totalMax: 1800000,
+		});
+		expect(portal.messages).toEqual({ ai: 2, team: 1, replies: 1 });
+		expect(portal.upcomingAppointments.map((item) => item.leadName)).toEqual([
+			"booked",
+		]);
+		expect(portal.recentLeads).toHaveLength(6);
+		expect(portal.recentLeads.every((lead) => lead.clientId === clientP)).toBe(
+			true,
+		);
+	});
+
+	it("supports the current month and refuses another agency's realtor", async () => {
+		const month = await service.getPortalStats(portalOwner, {
+			agencyId: portalAgency,
+			clientId: clientP,
+			period: "MONTH",
+		});
+
+		expect(month.periodLabel).toBe("Ce mois-ci");
+		expect(month.trend.length).toBeGreaterThanOrEqual(1);
+		expect(month.trend.length).toBeLessThanOrEqual(31);
+		await expect(
+			service.getPortalStats(owner, {
+				agencyId: portalAgency,
+				clientId: clientP,
+				period: "30D",
+			}),
