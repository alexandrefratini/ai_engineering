+import { Inject } from "@nestjs/common";
+import { Ctx, Input, Query, Router, UseMiddlewares } from "nestjs-trpc";
+import type { z } from "zod";
+import type { AuthedTrpcContext } from "../trpc/context.types";
+import { AuthMiddleware } from "../trpc/middlewares/auth.middleware";
+import {
+	teamListInput,
+	teamListOutput,
+	teamMemberInput,
+	teamMemberOutput,
+} from "./team.contracts";
+import { TeamService } from "./team.service";
+
+@Router({ alias: "team" })
+@UseMiddlewares(AuthMiddleware)
+export class TeamRouter {
+	constructor(@Inject(TeamService) private readonly team: TeamService) {}
+
+	@Query({ input: teamListInput, output: teamListOutput })
+	async list(
+		@Ctx() ctx: AuthedTrpcContext,
+		@Input() input: z.infer<typeof teamListInput>,
+	) {
+		return this.team.list(ctx.user.id, input);
+	}
+
+	@Query({ input: teamMemberInput, output: teamMemberOutput })
+	async member(
+		@Ctx() ctx: AuthedTrpcContext,
+		@Input() input: z.infer<typeof teamMemberInput>,
+	) {
+		return this.team.member(ctx.user.id, input.userId);
+	}
+}
