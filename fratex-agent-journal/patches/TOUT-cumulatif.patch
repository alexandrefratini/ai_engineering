@@ -0,0 +1,153 @@
+"use client";
+
+import Search from "@carbon/icons-react/es/Search";
+import {
+	InputGroup,
+	InputGroupAddon,
+	InputGroupInput,
+} from "@crm/ui/components/input-group";
+import { Panel } from "@crm/ui/components/panel";
+import { MetricGrid, MetricTile } from "@crm/ui/components/real-estate-visuals";
+import { TeamRoster } from "@crm/ui/components/team-roster";
+import { ToggleGroup, ToggleGroupItem } from "@crm/ui/components/toggle-group";
+import { useSearchInput } from "@crm/ui/hooks/use-search-input";
+import { LAYOUT } from "@crm/ui/lib/layout";
+import { useQuery } from "@tanstack/react-query";
+import Link from "next/link";
+import { parseAsString, parseAsStringLiteral, useQueryState } from "nuqs";
+import { LocalRelativeTime } from "@/components/local-date-time";
+import {
+	TEAM_COPY,
+	TEAM_FILTER_LABELS,
+	TEAM_FILTERS,
+	TEAM_SEARCH_PARAM,
+	type TeamFilter,
+} from "@/lib/team-config";
+import { roleLabelOf } from "@/lib/team-roles";
+import { useTRPC } from "@/lib/trpc/client";
+import { useWorkspaceUrl } from "@/lib/use-workspace-url";
+
+function isFilter(value: string): value is TeamFilter {
+	return (TEAM_FILTERS as readonly string[]).includes(value);
+}
+
+export function TeamView() {
+	const trpc = useTRPC();
+	const href = useWorkspaceUrl();
+	const [q, setQ] = useQueryState(
+		TEAM_SEARCH_PARAM.q,
+		parseAsString.withDefault(""),
+	);
+	const [filter, setFilter] = useQueryState(
+		TEAM_SEARCH_PARAM.filter,
+		parseAsStringLiteral(TEAM_FILTERS).withDefault("ALL"),
+	);
+	const [text, setText] = useSearchInput(q, (next) => {
+		void setQ(next || null);
+	});
+	const team = useQuery(
+		trpc.team.list.queryOptions({ search: q || undefined, filter }),
+	);
+	const data = team.data;
+
+	return (
+		<div className={LAYOUT.stack}>
+			<MetricGrid>
+				<MetricTile
+					index={0}
+					label={TEAM_COPY.tiles.members}
+					value={data?.summary.members ?? "—"}
+				/>
+				<MetricTile
+					index={1}
+					label={TEAM_COPY.tiles.online}
+					value={data?.summary.online ?? "—"}
+				/>
+				<MetricTile
+					index={2}
+					label={TEAM_COPY.tiles.overdue}
+					value={data?.summary.overdueTasks ?? "—"}
+				/>
+				<MetricTile
+					index={3}
+					label={TEAM_COPY.tiles.actions}
+					value={data?.summary.actions ?? "—"}
+					hint={data ? TEAM_COPY.tileHints.window(data.windowDays) : undefined}
+				/>
+			</MetricGrid>
+
+			<Panel
+				index={1}
+				title={TEAM_COPY.rosterTitle}
+				description={
+					data && !data.canViewEveryone ? TEAM_COPY.ownOnlyNotice : undefined
+				}
+				info={TEAM_COPY.rosterInfo}
+				bodyClassName="gap-4"
+			>
+				<div className="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
+					<ToggleGroup
+						type="single"
+						variant="outline"
+						size="sm"
+						spacing={0}
+						value={filter}
+						onValueChange={(next) => {
+							if (isFilter(next)) void setFilter(next === "ALL" ? null : next);
+						}}
+						aria-label={TEAM_COPY.rosterTitle}
+						className="flex-wrap"
+					>
+						{TEAM_FILTERS.map((value) => (
+							<ToggleGroupItem key={value} value={value}>
+								{TEAM_FILTER_LABELS[value]}
+							</ToggleGroupItem>
+						))}
+					</ToggleGroup>
+					<InputGroup className="w-full sm:w-64">
+						<InputGroupAddon>
+							<Search />
+						</InputGroupAddon>
+						<InputGroupInput
+							placeholder={TEAM_COPY.searchPlaceholder}
+							value={text}
+							onChange={(event) => setText(event.target.value)}
+							autoComplete="off"
+						/>
+					</InputGroup>
+				</div>
+
+				<TeamRoster
+					rows={(data?.rows ?? []).map((row) => ({
+						id: row.id,
+						name: row.name,
+						email: row.email,
+						image: row.image,
+						roleLabel: roleLabelOf(row.workspaceRole, row.agencyRoles),
+						agencies: row.agencyRoles.map((item) => item.agencyName),
+						online: row.online,
+						lastSeenAt: row.lastSeenAt,
+						isViewer: row.isViewer,
+						openTasks: row.openTasks,
+						overdueTasks: row.overdueTasks,
+						actions: row.actions,
+						lastActionAt: row.lastActionAt,
+					}))}
+					renderLink={(row, children) => (
+						<Link
+							href={href(`/team/${row.id}`)}
+							className="-mx-2 block rounded-md px-2 transition-colors hover:bg-muted/50 focus-visible:outline-2 focus-visible:outline-ring"
+						>
+							{children}
+						</Link>
+					)}
+					renderTime={(iso) => <LocalRelativeTime date={iso} />}
+					onlineLabel={TEAM_COPY.onlineLabel}
+					neverLabel={TEAM_COPY.neverLabel}
+					figures={TEAM_COPY.figures}
+					empty={TEAM_COPY.rosterEmpty}
+				/>
+			</Panel>
+		</div>
+	);
+}
