+"use client";
+
+import Asleep from "@carbon/icons-react/es/Asleep";
+import Logout from "@carbon/icons-react/es/Logout";
+import { authClient } from "@crm/auth/client";
+import { AccountFacts, AccountSection } from "@crm/ui/components/account-panel";
+import { Avatar, AvatarFallback, AvatarImage } from "@crm/ui/components/avatar";
+import { Button } from "@crm/ui/components/button";
+import { ContactLink } from "@crm/ui/components/contact-link";
+import { EmptyState } from "@crm/ui/components/empty-state";
+import { Field, FieldLabel } from "@crm/ui/components/field";
+import { Icon } from "@crm/ui/components/icon";
+import { Input } from "@crm/ui/components/input";
+import { SessionList } from "@crm/ui/components/session-list";
+import { ToggleGroup, ToggleGroupItem } from "@crm/ui/components/toggle-group";
+import { initialsFromName } from "@crm/ui/lib/format";
+import { LAYOUT } from "@crm/ui/lib/layout";
+import { useQuery } from "@tanstack/react-query";
+import Link from "next/link";
+import { useRouter } from "next/navigation";
+import { useTheme } from "next-themes";
+import { useState } from "react";
+import { toast } from "sonner";
+import {
+	AGENCY_ROLE_HINTS,
+	AGENCY_ROLE_LABELS,
+	PROVIDER_LABELS,
+	SHORTCUTS,
+	THEME_CHOICES,
+} from "@/lib/account-config";
+import { signOutAndRedirect } from "@/lib/sign-out";
+import { useTRPC } from "@/lib/trpc/client";
+import { useAudience } from "@/lib/use-audience";
+import { useWorkspaceUrl } from "@/lib/use-workspace-url";
+import { describeDevice } from "@/lib/user-agent";
+import { workspaceLabel } from "@/lib/workspace-label";
+
+type SessionRow = {
+	id: string;
+	token: string;
+	userAgent?: string | null;
+	updatedAt: Date | string;
+};
+
+export function AccountView({
+	user,
+	providers,
+	currentSessionId,
+}: {
+	user: { name: string; email: string; image: string | null };
+	providers: string[];
+	currentSessionId: string;
+}) {
+	const trpc = useTRPC();
+	const router = useRouter();
+	const href = useWorkspaceUrl();
+	const audience = useAudience();
+	const { theme, setTheme } = useTheme();
+	const workspace = useQuery(trpc.workspace.get.queryOptions());
+	const agencies = useQuery(trpc.realEstate.agencies.queryOptions());
+	const requests = useQuery(trpc.support.mine.queryOptions());
+	const [name, setName] = useState(user.name);
+	const [saving, setSaving] = useState(false);
+	const [sessions, setSessions] = useState<SessionRow[] | null>(null);
+	const [sessionsFailed, setSessionsFailed] = useState(false);
+	const [pendingId, setPendingId] = useState<string | null>(null);
+	const [revokingOthers, setRevokingOthers] = useState(false);
+
+	const loadSessions = async () => {
+		const result = await authClient.listSessions();
+		if (result.error || !result.data) {
+			setSessionsFailed(true);
+			return;
+		}
+		setSessionsFailed(false);
+		setSessions(result.data as SessionRow[]);
+	};
+
+	const sessionsQuery = useQuery({
+		queryKey: ["account", "sessions"],
+		queryFn: async () => {
+			await loadSessions();
+			return true;
+		},
+		staleTime: 0,
+	});
+
+	const openRequests =
+		requests.data?.rows.filter((row) => row.status !== "RESOLVED").length ?? 0;
+	const dirty = name.trim() !== user.name && name.trim().length > 0;
+
+	const saveName = async () => {
+		setSaving(true);
+		const result = await authClient.updateUser({ name: name.trim() });
+		setSaving(false);
+		if (result.error) {
+			toast.error("Le nom n'a pas pu être enregistré. Réessayez.");
+			return;
+		}
+		toast.success("Nom enregistré.");
+		router.refresh();
+	};
+
+	const revoke = async (id: string) => {
+		const target = sessions?.find((session) => session.id === id);
+		if (!target) return;
+		setPendingId(id);
+		const result = await authClient.revokeSession({ token: target.token });
+		setPendingId(null);
+		if (result.error) {
+			toast.error("L'appareil n'a pas pu être déconnecté.");
+			return;
+		}
+		toast.success("Appareil déconnecté.");
+		await loadSessions();
+	};
+
+	const revokeOthers = async () => {
+		setRevokingOthers(true);
+		const result = await authClient.revokeOtherSessions();
+		setRevokingOthers(false);
+		if (result.error) {
+			toast.error("Les autres appareils n'ont pas pu être déconnectés.");
+			return;
+		}
+		toast.success("Les autres appareils sont déconnectés.");
+		await loadSessions();
+	};
+
+	const providerNames = providers
+		.map((provider) => PROVIDER_LABELS[provider] ?? provider)
+		.join(", ");
+
+	return (
+		<div className={LAYOUT.column}>
+			<AccountSection
+				title="Profil"
+				description="Votre nom apparaît dans les notes, les rendez-vous et la présence de l'équipe."
+				info="Votre courriel vient de votre compte Google ou Microsoft et ne se change pas ici. Le nom affiché se modifie."
+			>
+				<div className="flex items-center gap-3">
+					<Avatar size="lg">
+						{user.image ? <AvatarImage src={user.image} alt="" /> : null}
+						<AvatarFallback>{initialsFromName(user.name)}</AvatarFallback>
+					</Avatar>
+					<div className="flex min-w-0 flex-col">
+						<span className="truncate font-medium">{user.name}</span>
+						<ContactLink
+							kind="email"
+							value={user.email}
+							className="truncate text-sm text-muted-foreground"
+						/>
+					</div>
+				</div>
+				<form
+					className="flex flex-col gap-2 sm:flex-row sm:items-end"
+					onSubmit={(event) => {
+						event.preventDefault();
+						if (dirty && !saving) void saveName();
+					}}
+				>
+					<Field className="flex-1">
+						<FieldLabel htmlFor="account-name">Nom affiché</FieldLabel>
+						<Input
+							id="account-name"
+							value={name}
+							maxLength={120}
+							onChange={(event) => setName(event.target.value)}
+						/>
+					</Field>
+					<Button type="submit" disabled={!dirty || saving}>
+						{saving ? "Enregistrement…" : "Enregistrer"}
+					</Button>
+				</form>
+				<AccountFacts
+					rows={[
+						{
+							label: "Espace de travail",
+							value: workspaceLabel(workspace.data?.name),
+						},
+						{
+							label: "Profil",
+							value: audience === "staff" ? "Équipe Fratex" : "Courtier",
+						},
+					]}
+				/>
+			</AccountSection>
+
+			<AccountSection
+				title="Agences et rôles"
+				description="Ce que vous avez le droit de voir et de faire, agence par agence."
+				info="Un courtier ne voit que ses propres prospects. Les propriétaires et les administrateurs voient toute l'agence."
+			>
+				{agencies.data && agencies.data.agencies.length > 0 ? (
+					<ul className="-my-1 flex flex-col divide-y">
+						{agencies.data.agencies.map((agency) => (
+							<li
+								key={agency.id}
+								className="flex flex-col gap-0.5 py-3 text-sm"
+							>
+								<span className="flex items-baseline justify-between gap-2">
+									<span className="truncate font-medium">{agency.name}</span>
+									<span className="shrink-0 text-xs font-medium">
+										{AGENCY_ROLE_LABELS[agency.role] ?? agency.role}
+									</span>
+								</span>
+								<span className="text-xs text-muted-foreground">
+									{AGENCY_ROLE_HINTS[agency.role] ?? ""}
+								</span>
+							</li>
+						))}
+					</ul>
+				) : (
+					<EmptyState
+						compact
+						icon={Logout}
+						title="Aucune agence"
+						description="Votre compte n'est lié à aucune agence pour l'instant. Demandez à un administrateur de vous inviter."
+					/>
+				)}
+			</AccountSection>
+
+			<AccountSection
+				title="Connexion et courriel"
+				description="Comment vous vous connectez et ce que Fratex lit de votre boîte courriel."
+				info="Fratex a un accès en lecture seule à votre boîte courriel, pour afficher les échanges dans la fiche des prospects. Il ne peut ni envoyer ni supprimer de courriels."
+			>
+				<AccountFacts
+					rows={[
+						{
+							label: "Connexion avec",
+							value: providerNames || "Non précisé",
+						},
+						{
+							label: "Courriel synchronisé",
+							value: "Oui, en lecture seule",
+						},
+					]}
+				/>
+				<Button variant="outline" className="self-start" asChild>
+					<Link href={href("/settings/connections")}>Gérer les connexions</Link>
+				</Button>
+			</AccountSection>
+
+			<AccountSection
+				title="Appareils connectés"
+				description="Déconnectez un appareil que vous ne reconnaissez pas ou que vous avez perdu."
+				info="Chaque navigateur où vous êtes connecté est une session. Déconnecter un appareil le force à se reconnecter."
+			>
+				{sessionsQuery.isPending ? (
+					<p className="text-sm text-muted-foreground">
+						Chargement des appareils…
+					</p>
+				) : sessionsFailed || !sessions ? (
+					<EmptyState
+						compact
+						icon={Logout}
+						title="Appareils indisponibles"
+						description="La liste des appareils n'a pas pu être chargée. Rechargez la page."
+					/>
+				) : (
+					<SessionList
+						sessions={sessions.map((session) => ({
+							id: session.id,
+							device: describeDevice(session.userAgent),
+							lastActiveAt: new Date(session.updatedAt).toISOString(),
+							current: session.id === currentSessionId,
+						}))}
+						pendingId={pendingId}
+						onRevoke={(id) => {
+							void revoke(id);
+						}}
+						onRevokeOthers={() => {
+							void revokeOthers();
+						}}
+						revokingOthers={revokingOthers}
+					/>
+				)}
+			</AccountSection>
+
+			<AccountSection title="Affichage" description="Thème, langue et formats.">
+				<Field>
+					<FieldLabel>Thème</FieldLabel>
+					<ToggleGroup
+						type="single"
+						variant="outline"
+						value={theme ?? "system"}
+						onValueChange={(value) => {
+							if (value) setTheme(value);
+						}}
+						aria-label="Thème"
+					>
+						{THEME_CHOICES.map((choice) => (
+							<ToggleGroupItem key={choice.value} value={choice.value}>
+								{choice.value === "dark" && <Icon icon={Asleep} />}
+								{choice.label}
+							</ToggleGroupItem>
+						))}
+					</ToggleGroup>
+				</Field>
+				<AccountFacts
+					rows={[
+						{ label: "Langue", value: "Français (Canada)" },
+						{ label: "Fuseau horaire", value: "Heure de l'Est (Montréal)" },
+						{ label: "Devise", value: "Dollar canadien (CAD)" },
+					]}
+				/>
+			</AccountSection>
+
+			<AccountSection
+				title="Raccourcis clavier"
+				description="Gagnez du temps au quotidien."
+			>
+				<ul className="-my-1 flex flex-col divide-y">
+					{SHORTCUTS.map((shortcut) => (
+						<li
+							key={shortcut.keys}
+							className="flex items-center justify-between gap-3 py-3 text-sm"
+						>
+							<span className="text-muted-foreground">{shortcut.action}</span>
+							<kbd className="shrink-0 rounded-md border bg-muted px-1.5 py-0.5 font-mono text-xs">
+								{shortcut.keys}
+							</kbd>
+						</li>
+					))}
+				</ul>
+			</AccountSection>
+
+			<AccountSection
+				title="Aide"
+				description="Vos demandes à l'équipe Fratex."
+				action={
+					<Button variant="outline" size="sm" asChild>
+						<Link href={href("/support")}>Ouvrir le support</Link>
+					</Button>
+				}
+			>
+				<AccountFacts
+					rows={[
+						{
+							label: "Demandes ouvertes",
+							value: String(openRequests),
+						},
+						{
+							label: "Demandes envoyées",
+							value: String(requests.data?.rows.length ?? 0),
+						},
+					]}
+				/>
+			</AccountSection>
+
+			<AccountSection
+				title="Session"
+				description="Fermez votre session sur cet appareil."
+			>
+				<Button
+					variant="outline"
+					className="self-start"
+					onClick={() => {
+						signOutAndRedirect().catch(() =>
+							toast.error("Impossible de se déconnecter."),
+						);
+					}}
+				>
+					<Icon icon={Logout} />
+					Se déconnecter
+				</Button>
+			</AccountSection>
+		</div>
+	);
+}
