diff --git a/apps/app/test/inbox-thread.spec.tsx b/apps/app/test/inbox-thread.spec.tsx
new file mode 100644
index 0000000..d27e6f3
--- /dev/null
+++ b/apps/app/test/inbox-thread.spec.tsx
@@ -0,0 +1,350 @@
+import { describe, expect, it } from "bun:test";
+import {
+	conversationPreview,
+	emailLink,
+	groupByDay,
+	INBOX_FILTERS,
+	InboxComposer,
+	type InboxEmail,
+	InboxList,
+	type InboxSmsMessage,
+	InboxThread,
+	mergeThread,
+	SENDER_LABELS,
+	smsBlockedReason,
+} from "@crm/ui/components/inbox";
+import { renderToString } from "react-dom/server";
+
+const NOW = new Date("2026-10-22T18:00:00.000Z");
+
+function sms(
+	id: string,
+	sentAt: string,
+	overrides: Partial<InboxSmsMessage> = {},
+): InboxSmsMessage {
+	return {
+		id,
+		sender: "LEAD",
+		content: `Message ${id}`,
+		sentAt,
+		status: "RECEIVED",
+		failureCode: null,
+		...overrides,
+	};
+}
+
+function email(
+	id: string,
+	sentAt: string,
+	overrides: Partial<InboxEmail> = {},
+): InboxEmail {
+	return {
+		id,
+		direction: "INBOUND",
+		fromName: "Camille Roy",
+		fromEmail: "camille@example.com",
+		subject: `Objet ${id}`,
+		snippet: `Extrait ${id}`,
+		sentAt,
+		webLink: null,
+		...overrides,
+	};
+}
+
+describe("mergeThread", () => {
+	it("merges SMS and emails in chronological order", () => {
+		const items = mergeThread(
+			[
+				sms("s2", "2026-10-21T15:00:00.000Z"),
+				sms("s1", "2026-10-20T15:00:00.000Z"),
+			],
+			[
+				email("e1", "2026-10-21T12:00:00.000Z"),
+				email("e2", "2026-10-22T12:00:00.000Z"),
+			],
+		);
+		expect(items.map((item) => `${item.kind}:${item.id}`)).toEqual([
+			"SMS:s1",
+			"EMAIL:e1",
+			"SMS:s2",
+			"EMAIL:e2",
+		]);
+	});
+
+	it("accepts Date and ISO string timestamps together", () => {
+		const items = mergeThread(
+			[
+				sms("s1", "2026-10-21T15:00:00.000Z"),
+				{ ...sms("s2", ""), sentAt: new Date("2026-10-21T14:00:00.000Z") },
+			],
+			[email("e1", "2026-10-21T14:30:00.000Z")],
+		);
+		expect(items.map((item) => item.id)).toEqual(["s2", "e1", "s1"]);
+	});
+
+	it("keeps the input order for identical timestamps and does not mutate inputs", () => {
+		const messages = [
+			sms("a", "2026-10-21T15:00:00.000Z"),
+			sms("b", "2026-10-21T15:00:00.000Z"),
+		];
+		const emails = [email("c", "2026-10-21T15:00:00.000Z")];
+		const items = mergeThread(messages, emails);
+		expect(items.map((item) => item.id)).toEqual(["a", "b", "c"]);
+		expect(messages.map((message) => message.id)).toEqual(["a", "b"]);
+	});
+
+	it("returns an empty list without data", () => {
+		expect(mergeThread([], [])).toEqual([]);
+	});
+
+	it("pushes items with an invalid timestamp to the end", () => {
+		const items = mergeThread(
+			[sms("bad", "not-a-date"), sms("ok", "2026-10-21T15:00:00.000Z")],
+			[],
+		);
+		expect(items.map((item) => item.id)).toEqual(["ok", "bad"]);
+	});
+});
+
+describe("groupByDay", () => {
+	it("groups by calendar day in America/Toronto, not UTC", () => {
+		const items = mergeThread(
+			[
+				sms("late", "2026-10-22T03:30:00.000Z"),
+				sms("early", "2026-10-22T04:30:00.000Z"),
+				sms("noon", "2026-10-22T16:00:00.000Z"),
+			],
+			[],
+		);
+		const days = groupByDay(items);
+		expect(days.map((day) => day.key)).toEqual(["2026-10-21", "2026-10-22"]);
+		expect(days[0]?.items.map((item) => item.id)).toEqual(["late"]);
+		expect(days[1]?.items.map((item) => item.id)).toEqual(["early", "noon"]);
+	});
+
+	it("handles standard time (EST) around midnight", () => {
+		const days = groupByDay(
+			mergeThread(
+				[
+					sms("a", "2026-01-15T04:59:00.000Z"),
+					sms("b", "2026-01-15T05:00:00.000Z"),
+				],
+				[],
+			),
+		);
+		expect(days.map((day) => day.key)).toEqual(["2026-01-14", "2026-01-15"]);
+	});
+
+	it("puts SMS and emails of the same day under one heading", () => {
+		const days = groupByDay(
+			mergeThread(
+				[
+					sms("s1", "2026-10-21T14:00:00.000Z"),
+					sms("s2", "2026-10-21T20:00:00.000Z"),
+				],
+				[email("e1", "2026-10-21T17:00:00.000Z")],
+			),
+		);
+		expect(days).toHaveLength(1);
+		expect(days[0]?.items.map((item) => item.kind)).toEqual([
+			"SMS",
+			"EMAIL",
+			"SMS",
+		]);
+	});
+
+	it("does not merge distant days that share a key suffix", () => {
+		const days = groupByDay(
+			mergeThread(
+				[
+					sms("a", "2025-10-21T15:00:00.000Z"),
+					sms("b", "2026-10-21T15:00:00.000Z"),
+				],
+				[],
+			),
+		);
+		expect(days.map((day) => day.key)).toEqual(["2025-10-21", "2026-10-21"]);
+	});
+
+	it("returns no group for an empty list", () => {
+		expect(groupByDay([])).toEqual([]);
+	});
+});
+
+describe("smsBlockedReason", () => {
+	const consented = new Date("2026-10-01T15:00:00.000Z");
+
+	it("allows writing with consent and write access", () => {
+		expect(
+			smsBlockedReason({
+				canWrite: true,
+				consentedAt: consented,
+				unsubscribedAt: null,
+			}),
+		).toBeNull();
+	});
+
+	it("blocks when consent is missing", () => {
+		expect(
+			smsBlockedReason({
+				canWrite: true,
+				consentedAt: null,
+				unsubscribedAt: null,
+			}),
+		).toContain("Consentement");
+	});
+
+	it("blocks when the lead unsubscribed, even with consent", () => {
+		expect(
+			smsBlockedReason({
+				canWrite: true,
+				consentedAt: consented,
+				unsubscribedAt: new Date(),
+			}),
+		).toContain("ne plus recevoir de SMS");
+	});
+
+	it("blocks read-only roles", () => {
+		expect(
+			smsBlockedReason({
+				canWrite: false,
+				consentedAt: consented,
+				unsubscribedAt: null,
+			}),
+		).toContain("rôle");
+	});
+});
+
+describe("emailLink and previews", () => {
+	it("labels a Gmail link and refuses unsafe URLs", () => {
+		expect(
+			emailLink("https://mail.google.com/mail/u/0/#inbox/abc")?.label,
+		).toBe("Ouvrir dans Gmail");
+		expect(emailLink("https://outlook.office.com/mail/id/abc")?.label).toBe(
+			"Ouvrir dans Outlook",
+		);
+		expect(emailLink("javascript:alert(1)")).toBeNull();
+		expect(emailLink("http://mail.google.com/x")).toBeNull();
+		expect(emailLink("nope")).toBeNull();
+		expect(emailLink(null)).toBeNull();
+	});
+
+	it("prefixes the preview by sender and collapses whitespace", () => {
+		expect(
+			conversationPreview({ preview: "Bonjour\n  vous", lastSender: "AI_SDR" }),
+		).toBe("IA : Bonjour vous");
+		expect(conversationPreview({ preview: "Merci", lastSender: "LEAD" })).toBe(
+			"Merci",
+		);
+		expect(conversationPreview({ preview: null, lastSender: null })).toBe(
+			"Aucun message",
+		);
+	});
+
+	it("labels senders in French", () => {
+		expect(SENDER_LABELS).toEqual({
+			LEAD: "Prospect",
+			AI_SDR: "Assistant IA",
+			HUMAN_AGENT: "Courtier",
+			SYSTEM: "Système",
+		});
+		expect(INBOX_FILTERS.map((filter) => filter.label)).toEqual([
+			"Tous",
+			"Non lus",
+			"Reprise humaine",
+		]);
+	});
+});
+
+describe("inbox rendering", () => {
+	it("renders day headings, senders, delivery status and the Gmail link", () => {
+		const html = renderToString(
+			<InboxThread
+				leadName="Camille Roy"
+				now={NOW}
+				messages={[
+					sms("s1", "2026-10-21T15:00:00.000Z"),
+					sms("s2", "2026-10-22T14:00:00.000Z", {
+						sender: "AI_SDR",
+						status: "DELIVERED",
+						content: "Bonjour Camille",
+					}),
+				]}
+				emails={[
+					email("e1", "2026-10-22T15:00:00.000Z", {
+						webLink: "https://mail.google.com/mail/u/0/#inbox/abc",
+					}),
+				]}
+			/>,
+		);
+		expect(html).toContain("Hier");
+		expect(html).toContain("Aujourd&#x27;hui");
+		expect(html).toContain("Prospect");
+		expect(html).toContain("Assistant IA");
+		expect(html).toContain("Livré");
+		expect(html).toContain("Objet e1");
+		expect(html).toContain("Ouvrir dans Gmail");
+		expect(html.indexOf("Hier")).toBeLessThan(html.indexOf("Aujourd&#x27;hui"));
+	});
+
+	it("shows an empty state without messages", () => {
+		const html = renderToString(
+			<InboxThread
+				leadName="Camille Roy"
+				now={NOW}
+				messages={[]}
+				emails={[]}
+			/>,
+		);
+		expect(html).toContain("Aucun échange");
+	});
+
+	it("disables the composer and explains why", () => {
+		const html = renderToString(
+			<InboxComposer
+				leadName="Camille Roy"
+				email="camille@example.com"
