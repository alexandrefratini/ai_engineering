diff --git a/apps/app/app/(app)/[slug]/support/support-view.tsx b/apps/app/app/(app)/[slug]/support/support-view.tsx
new file mode 100644
index 0000000..00a7340
--- /dev/null
+++ b/apps/app/app/(app)/[slug]/support/support-view.tsx
@@ -0,0 +1,158 @@
+"use client";
+
+import {
+	Card,
+	CardContent,
+	CardDescription,
+	CardHeader,
+	CardTitle,
+} from "@crm/ui/components/card";
+import { SupportPanel } from "@crm/ui/components/support-panel";
+import {
+	type SupportKind,
+	SupportRequestForm,
+} from "@crm/ui/components/support-request-form";
+import {
+	SupportRequestList,
+	type SupportStatus,
+} from "@crm/ui/components/support-request-list";
+import { useMutation, useQuery, useQueryClient } from "@tanstack/react-query";
+import { parseAsString, parseAsStringLiteral, useQueryState } from "nuqs";
+import { useEffect, useState } from "react";
+import { toast } from "sonner";
+import {
+	SUPPORT_ANSWERS,
+	SUPPORT_EMAIL,
+	SUPPORT_LIMITS,
+} from "@/lib/support-config";
+import {
+	matchNavPage,
+	OTHER_PAGE,
+	pagePathOf,
+	supportPageLabel,
+	supportPageOptions,
+} from "@/lib/support-pages";
+import { useTRPC } from "@/lib/trpc/client";
+import { useAudience } from "@/lib/use-audience";
+import { useWorkspaceSlug } from "@/lib/use-workspace-url";
+
+const KINDS = ["PROBLEM", "QUESTION", "IDEA"] as const;
+
+function describe(error: unknown): string {
+	return error instanceof Error && error.message
+		? error.message
+		: "La demande n'a pas pu être envoyée. Réessayez dans un instant.";
+}
+
+export function SupportView() {
+	const trpc = useTRPC();
+	const cache = useQueryClient();
+	const slug = useWorkspaceSlug();
+	const audience = useAudience();
+	const [type, setType] = useQueryState(
+		"type",
+		parseAsStringLiteral(KINDS).withDefault("PROBLEM"),
+	);
+	const [from] = useQueryState("from", parseAsString);
+	const initialPage = from
+		? (matchNavPage(pagePathOf(from, slug), audience)?.href ?? OTHER_PAGE)
+		: OTHER_PAGE;
+	const [page, setPage] = useState(initialPage);
+	const [message, setMessage] = useState("");
+	const [error, setError] = useState<string | null>(null);
+
+	useEffect(() => {
+		setPage(initialPage);
+	}, [initialPage]);
+
+	const mine = useQuery(trpc.support.mine.queryOptions());
+	const canTriage = mine.data?.canTriage ?? false;
+	const team = useQuery(
+		trpc.support.team.queryOptions(undefined, { enabled: canTriage }),
+	);
+	const create = useMutation(
+		trpc.support.create.mutationOptions({
+			onSuccess: async () => {
+				setMessage("");
+				setError(null);
+				toast.success(
+					"Demande envoyée. L'équipe Fratex la verra dans sa liste.",
+				);
+				await cache.invalidateQueries(trpc.support.pathFilter());
+			},
+			onError: (failure) => setError(describe(failure)),
+		}),
+	);
+	const setStatus = useMutation(
+		trpc.support.setStatus.mutationOptions({
+			onSuccess: () => cache.invalidateQueries(trpc.support.pathFilter()),
+			onError: (failure) => toast.error(describe(failure)),
+		}),
+	);
+
+	const submit = () => {
+		const specific = from ? pagePathOf(from, slug) : null;
+		const matched = specific ? matchNavPage(specific, audience)?.href : null;
+		create.mutate({
+			kind: type as SupportKind,
+			message: message.trim(),
+			pagePath: specific && matched === page ? specific : page || undefined,
+			viewport: `${window.innerWidth}x${window.innerHeight}`,
+		});
+	};
+
+	return (
+		<SupportPanel
+			email={SUPPORT_EMAIL}
+			answers={SUPPORT_ANSWERS}
+			form={
+				<SupportRequestForm
+					kind={type}
+					onKindChange={(kind) => {
+						void setType(kind);
+					}}
+					page={page}
+					onPageChange={setPage}
+					pageOptions={supportPageOptions(audience)}
+					message={message}
+					onMessageChange={setMessage}
+					minLength={SUPPORT_LIMITS.messageMin}
+					maxLength={SUPPORT_LIMITS.messageMax}
+					pending={create.isPending}
+					error={error}
+					onSubmit={submit}
+				/>
+			}
+			history={
+				<SupportRequestList
+					items={mine.data?.rows ?? []}
+					empty="Vos demandes apparaîtront ici avec leur état : ouverte, en cours ou résolue."
+					pageLabel={supportPageLabel}
+				/>
+			}
+			team={
+				canTriage && (
+					<Card>
+						<CardHeader>
+							<CardTitle>Demandes de l'équipe</CardTitle>
+							<CardDescription>
+								Visible par les propriétaires et les administrateurs. Changez
+								l'état au fil du traitement.
+							</CardDescription>
+						</CardHeader>
+						<CardContent>
+							<SupportRequestList
+								items={team.data?.rows ?? []}
+								empty="Aucune demande de l'équipe pour l'instant."
+								pageLabel={supportPageLabel}
+								onStatusChange={(id: string, status: SupportStatus) =>
+									setStatus.mutate({ id, status })
+								}
+							/>
+						</CardContent>
+					</Card>
+				)
+			}
+		/>
+	);
+}
