+
+function time(value: InboxStamp): number {
+	const parsed = (value instanceof Date ? value : new Date(value)).getTime();
+	return Number.isNaN(parsed) ? Number.POSITIVE_INFINITY : parsed;
+}
+
+function isoOf(value: InboxStamp): string | undefined {
+	const parsed = time(value);
+	return Number.isFinite(parsed) ? new Date(parsed).toISOString() : undefined;
+}
+
+export function mergeThread(messages: InboxSmsMessage[], emails: InboxEmail[]): ThreadItem[] {
+	const items: ThreadItem[] = [
+		...messages.map((message) => ({ kind: "SMS" as const, id: message.id, at: message.sentAt, message })),
+		...emails.map((email) => ({ kind: "EMAIL" as const, id: email.id, at: email.sentAt, email })),
+	];
+	return items
+		.map((item, order) => ({ item, order, at: time(item.at) }))
+		.sort((a, b) => (a.at === b.at ? a.order - b.order : a.at < b.at ? -1 : 1))
+		.map((entry) => entry.item);
+}
+
+export function groupByDay<T extends { at: InboxStamp }>(items: T[]): ThreadDay<T>[] {
+	const days: ThreadDay<T>[] = [];
+	for (const item of items) {
+		const key = dayKey(item.at);
+		const last = days.at(-1);
+		if (last && last.key === key) last.items.push(item);
+		else days.push({ key, at: item.at, items: [item] });
+	}
+	return days;
+}
+
+export function smsBlockedReason({ canWrite, consentedAt, unsubscribedAt }: SmsAvailability): string | null {
+	if (unsubscribedAt) return "Le prospect a demandé de ne plus recevoir de SMS.";
+	if (!consentedAt) return "Consentement aux SMS absent : confirmez-le avant d'écrire au prospect.";
+	if (!canWrite) return "Votre rôle permet de lire cette conversation, pas d'y répondre.";
+	return null;
+}
+
+export function emailLink(webLink: string | null): { href: string; label: string } | null {
+	if (!webLink) return null;
+	let url: URL;
+	try {
+		url = new URL(webLink);
+	} catch {
+		return null;
+	}
+	if (url.protocol !== "https:") return null;
+	const host = url.hostname.toLowerCase();
+	if (host === "mail.google.com") return { href: url.href, label: "Ouvrir dans Gmail" };
+	if (host.startsWith("outlook.") || host.endsWith(".office.com") || host.endsWith(".office365.com"))
+		return { href: url.href, label: "Ouvrir dans Outlook" };
+	return { href: url.href, label: "Ouvrir le courriel" };
+}
+
+export function conversationPreview(conversation: Pick<InboxConversation, "preview" | "lastSender">): string {
+	const text = conversation.preview?.replace(/\s+/g, " ").trim();
+	if (!text) return "Aucun message";
+	const prefix = conversation.lastSender ? (PREVIEW_PREFIX[conversation.lastSender] ?? "") : "";
+	return `${prefix}${text}`;
+}
+
