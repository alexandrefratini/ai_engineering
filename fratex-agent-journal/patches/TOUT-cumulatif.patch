+	LEAD: "Prospect",
+	AI_SDR: "Assistant IA",
+	HUMAN_AGENT: "Courtier",
+	SYSTEM: "Système",
+};
+
+const CHANNEL_LABELS: Record<InboxChannel, string> = {
+	SMS: "SMS",
+	EMAIL: "Courriel",
+};
