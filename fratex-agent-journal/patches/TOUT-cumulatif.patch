+import { defineTool } from "eve/tools";
+import { z } from "zod";
+import { ASSISTANT, ASSISTANT_STATUSES } from "../lib/assistant-config";
+import { searchProspects } from "../lib/assistant-prospects";
+import { assistantScopes } from "../lib/assistant-scope";
+
+export default defineTool({
+	description:
+		"Cherche des prospects immobiliers par nom, téléphone, courriel ou secteur, avec un statut facultatif (20 résultats au maximum, du plus récent au plus ancien). À utiliser quand le courtier nomme un prospect, donne un numéro ou demande une liste par statut, par exemple « Retrouve Marie Tremblay » ou « Mes prospects qualifiés à Laval ». Plusieurs mots se combinent (tous doivent correspondre). Statuts : NEW nouveau, CONTACTED contacté, QUALIFYING en qualification, QUALIFIED qualifié, APPOINTMENT_BOOKED RDV fixé, APPOINTMENT_HELD RDV réalisé, NURTURE à relancer, LOST non intéressé, INVALID invalide. Ne renvoie que l'identité et le statut ; utiliser read_prospect pour le détail. Lecture seule, limitée aux prospects de l'utilisateur. Chaque résultat porte le chemin de sa fiche (fiche) à donner en lien.",
+	inputSchema: z.object({
+		query: z
+			.string()
+			.trim()
+			.min(1)
+			.max(ASSISTANT.searchTokenLength * ASSISTANT.searchTokenLimit)
+			.optional()
+			.describe("Nom, téléphone, courriel ou secteur."),
+		status: z.enum(ASSISTANT_STATUSES).optional(),
+		agencyId: z
+			.string()
+			.trim()
+			.min(1)
+			.optional()
+			.describe(
+				"Identifiant de l'agence. Facultatif : par défaut, toutes les agences de l'utilisateur.",
+			),
+	}),
+	async execute(input, ctx) {
+		const { scopes } = await assistantScopes(ctx, input);
+		return searchProspects(scopes, input);
+	},
+});
