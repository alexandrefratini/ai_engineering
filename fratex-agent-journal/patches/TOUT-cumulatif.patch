+"use client";
+
+import { formatDateTime } from "../lib/real-estate";
+import { cn } from "../lib/utils";
+import { EmptyState } from "./empty-state";
+import Chat from "@carbon/icons-react/es/Chat";
+import { Select, SelectContent, SelectItem, SelectTrigger, SelectValue } from "./select";
+
+export type SupportStatus = "OPEN" | "IN_PROGRESS" | "RESOLVED";
+
+export type SupportRequestItem = {
+	id: string;
+	kind: "PROBLEM" | "QUESTION" | "IDEA";
+	status: SupportStatus;
+	subject: string;
+	message: string;
+	pagePath: string | null;
+	createdAt: string;
+	author: { name: string; email: string } | null;
+};
+
+const KIND_LABELS = { PROBLEM: "Problème", QUESTION: "Question", IDEA: "Idée" } as const;
+
+export const SUPPORT_STATUS_LABELS: Record<SupportStatus, string> = {
+	OPEN: "Ouverte",
+	IN_PROGRESS: "En cours",
+	RESOLVED: "Résolue",
+};
+
+const STATUS_DOTS: Record<SupportStatus, string> = {
+	OPEN: "bg-primary",
+	IN_PROGRESS: "bg-foreground",
+	RESOLVED: "bg-success",
+};
+
+export function SupportRequestList({
+	items,
+	empty,
+	onStatusChange,
+	pageLabel,
+}: {
+	items: SupportRequestItem[];
+	empty: string;
+	onStatusChange?: (id: string, status: SupportStatus) => void;
+	pageLabel: (path: string) => string;
+}) {
+	if (items.length === 0) return <EmptyState compact icon={Chat} title="Aucune demande" description={empty} />;
+	return (
+		<ul className="-my-1 flex flex-col divide-y">
+			{items.map((item) => (
+				<li key={item.id} className="flex flex-col gap-1.5 py-3 text-sm">
+					<div className="flex flex-wrap items-center gap-x-2 gap-y-1">
+						<span aria-hidden="true" className={cn("size-2 shrink-0 rounded-full", STATUS_DOTS[item.status])} />
+						<span className="font-medium">{KIND_LABELS[item.kind]}</span>
+						<span className="text-xs text-muted-foreground">{formatDateTime(item.createdAt)}</span>
+						{item.pagePath && <span className="text-xs text-muted-foreground">· {pageLabel(item.pagePath)}</span>}
+						<span className="ml-auto">
+							{onStatusChange ? (
+								<Select value={item.status} onValueChange={(value) => onStatusChange(item.id, value as SupportStatus)}>
+									<SelectTrigger aria-label="Statut de la demande" className="h-7 w-32 text-xs">
+										<SelectValue />
+									</SelectTrigger>
+									<SelectContent>
+										{(Object.keys(SUPPORT_STATUS_LABELS) as SupportStatus[]).map((status) => (
+											<SelectItem key={status} value={status}>
+												{SUPPORT_STATUS_LABELS[status]}
+											</SelectItem>
+										))}
+									</SelectContent>
+								</Select>
+							) : (
+								<span className="text-xs text-muted-foreground">{SUPPORT_STATUS_LABELS[item.status]}</span>
+							)}
+						</span>
+					</div>
+					{item.author && (
+						<span className="text-xs text-muted-foreground">
+							{item.author.name} · {item.author.email}
+						</span>
+					)}
+					<p className="whitespace-pre-wrap text-pretty text-muted-foreground">{item.message}</p>
+				</li>
+			))}
+		</ul>
+	);
+}
