@@ -0,0 +1,99 @@
+import { ASSISTANT } from "./assistant-config";
+
+const DAY_MS = 24 * 60 * 60 * 1000;
+const MINUTE_MS = 60 * 1000;
+
+const clock = new Intl.DateTimeFormat(ASSISTANT.locale, {
+	timeZone: ASSISTANT.timeZone,
+	year: "numeric",
+	month: "2-digit",
+	day: "2-digit",
+	hour: "2-digit",
+	minute: "2-digit",
+	second: "2-digit",
+	hourCycle: "h23",
+});
+
+function parts(value: Date) {
+	const found = new Map<string, string>(
+		clock.formatToParts(value).map((part) => [part.type, part.value]),
+	);
+	const read = (type: Intl.DateTimeFormatPartTypes) => found.get(type) ?? "00";
+	return {
+		year: read("year"),
+		month: read("month"),
+		day: read("day"),
+		hour: read("hour"),
+		minute: read("minute"),
+		second: read("second"),
+	};
+}
+
+export function localDay(value: Date): string {
+	const { year, month, day } = parts(value);
+	return `${year}-${month}-${day}`;
+}
+
+export function localStamp(value: Date): string {
+	const { hour, minute } = parts(value);
+	return `${localDay(value)} ${hour}:${minute}`;
+}
+
+function offsetMs(value: Date): number {
+	const p = parts(value);
+	const wall = Date.UTC(
+		Number(p.year),
+		Number(p.month) - 1,
+		Number(p.day),
+		Number(p.hour),
+		Number(p.minute),
+		Number(p.second),
+	);
+	return wall - Math.floor(value.getTime() / 1000) * 1000;
+}
+
+export function localMidnight(day: string): Date {
+	const [year, month, date] = day.split("-").map(Number);
+	const guess = Date.UTC(year ?? 0, (month ?? 1) - 1, date ?? 1);
+	const first = guess - offsetMs(new Date(guess));
+	return new Date(guess - offsetMs(new Date(first)));
+}
+
+export type AssistantPeriod = keyof typeof ASSISTANT.periodDays | "MONTH";
+
+export function periodRange(
+	period: AssistantPeriod,
+	now: Date,
+): { from: Date; to: Date } {
+	if (period === "MONTH")
+		return {
+			from: localMidnight(`${localDay(now).slice(0, 7)}-01`),
+			to: now,
+		};
+	return {
+		from: new Date(now.getTime() - ASSISTANT.periodDays[period] * DAY_MS),
+		to: now,
+	};
+}
+
+export function median(values: number[]): number | null {
+	if (!values.length) return null;
+	const sorted = [...values].sort((a, b) => a - b);
+	const middle = Math.floor(sorted.length / 2);
+	return sorted.length % 2
+		? (sorted[middle] ?? null)
+		: ((sorted[middle - 1] ?? 0) + (sorted[middle] ?? 0)) / 2;
+}
+
+export function minutesBetween(from: Date, to: Date): number {
+	return Math.max(0, (to.getTime() - from.getTime()) / MINUTE_MS);
+}
+
+export function percentOf(part: number, total: number): number | null {
+	return total ? Math.round((part / total) * 1000) / 10 : null;
+}
+
+export function trimText(value: string, limit: number): string {
+	const text = value.replace(/\s+/g, " ").trim();
+	return text.length > limit ? `${text.slice(0, limit - 1)}…` : text;
+}
