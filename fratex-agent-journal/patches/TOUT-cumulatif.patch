+async function thread(
+	subject: string,
+	data: {
+		syncedByUserId: string;
+		direction: "INBOUND" | "OUTBOUND";
+		fromEmail: string;
+		recipient: string;
+		sentAt: Date;
+	},
+) {
+	const row = await db.emailThread.create({
+		data: {
+			rootMessageId: `<${randomUUID()}@example.test>`,
+			subject,
+			firstMessageAt: data.sentAt,
+			lastMessageAt: data.sentAt,
+			messageCount: 1,
+		},
+	});
+	await db.emailMessage.create({
+		data: {
+			threadId: row.id,
+			rfcMessageId: `<${randomUUID()}@example.test>`,
+			syncedByUserId: data.syncedByUserId,
+			direction: data.direction,
+			fromEmail: data.fromEmail,
+			recipients: [{ email: data.recipient, name: null, kind: "to" }],
+			subject,
+			sentAt: data.sentAt,
+		},
+	});
+}
+
+async function message(
+	agencyId: string,
+	leadId: string,
+	sender: "LEAD" | "AI_SDR" | "HUMAN_AGENT",
+	content: string,
+	sentAt: Date,
+	unreadCount = 0,
+) {
+	const conversation =
+		(await db.conversation.findFirst({ where: { agencyId, leadId } })) ??
+		(await db.conversation.create({
+			data: { agencyId, leadId, unreadCount, lastMessageAt: sentAt },
+		}));
+	await db.message.create({
+		data: {
+			agencyId,
+			conversationId: conversation.id,
+			sender,
+			content,
+			sentAt,
+			status: sender === "LEAD" ? "RECEIVED" : "DELIVERED",
+		},
+	});
+}
