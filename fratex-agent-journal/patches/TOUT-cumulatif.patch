+export const CONTACT_CHANNELS = {
+	whatsappBase: "https://wa.me",
+	metaInboxUrl: "https://business.facebook.com/latest/inbox/all",
+	emailSubject: "Votre projet immobilier",
+	notice:
+		"L'appel, le courriel, WhatsApp et Meta s'ouvrent dans leur application. Ces échanges ne sont pas enregistrés dans la fiche : seuls les SMS envoyés ici le sont.",
+} as const;
+
+export function phoneDigits(phone: string): string {
+	return phone.replace(/\D/g, "");
+}
+
+export function whatsappLink(phone: string, firstName: string): string {
+	const text = `Bonjour ${firstName}, c'est au sujet de votre projet immobilier.`;
+	return `${CONTACT_CHANNELS.whatsappBase}/${phoneDigits(phone)}?text=${encodeURIComponent(text)}`;
+}
+
+export function mailtoLink(email: string): string {
+	return `mailto:${email}?subject=${encodeURIComponent(CONTACT_CHANNELS.emailSubject)}`;
+}
+
+export function telLink(phone: string): string {
+	return `tel:${phone}`;
+}
