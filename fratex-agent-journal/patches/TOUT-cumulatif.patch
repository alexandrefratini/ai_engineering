+
+export type StageGroup = {
+	id: string;
+	label: string;
+	description: string;
+	tone: "progress" | "won" | "out";
+	stages: { id: string; label: string; count: number }[];
+};
+
+const STAGE_TONES: Record<StageGroup["tone"], string> = {
+	progress: "bg-muted-foreground/55",
+	won: "bg-primary",
+	out: "bg-muted-foreground/20",
+};
+
+function sumStages(group: StageGroup) {
+	return group.stages.reduce((sum, stage) => sum + stage.count, 0);
+}
+
+function prospects(count: number) {
+	return `${count} ${count > 1 ? "prospects" : "prospect"}`;
+}
+
+export function StageBreakdown({
+	groups,
+	onSelect,
+}: {
+	groups: StageGroup[];
+	onSelect: (stageId: string) => void;
+}) {
+	const mounted = useMounted();
+	const total = groups.reduce((sum, group) => sum + sumStages(group), 0);
+	const share = (count: number) => formatPercentValue(total > 0 ? count / total : 0);
+	const segments = groups.flatMap((group) =>
+		group.stages.filter((stage) => stage.count > 0).map((stage) => ({ ...stage, tone: group.tone })),
+	);
+	const summary = groups
+		.map((group) => {
+			const count = sumStages(group);
+			return `${group.label} : ${count} (${share(count)})`;
+		})
+		.join(", ");
+	return (
+		<div className="flex flex-col gap-4">
+			<div
