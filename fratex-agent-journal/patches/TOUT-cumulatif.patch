@@ -0,0 +1,95 @@
+"use client";
+
+import Chat from "@carbon/icons-react/es/Chat";
+import Email from "@carbon/icons-react/es/Email";
+import ChatLaunch from "@carbon/icons-react/es/ChatLaunch";
+import Phone from "@carbon/icons-react/es/Phone";
+import {
+	CONTACT_CHANNELS,
+	mailtoLink,
+	telLink,
+	whatsappLink,
+} from "../lib/contact-channels";
+import MetaLogo from "./brand-logos/meta";
+import { Button } from "./button";
+import { type CarbonIcon, Icon } from "./icon";
+import { InfoHint } from "./real-estate-visuals";
+
+type Channel = {
+	id: string;
+	label: string;
+	icon: CarbonIcon;
+	href?: string;
+	external?: boolean;
+	onClick?: () => void;
+};
+
+export function ContactChannels({
+	firstName,
+	phone,
+	email,
+	fromMeta,
+	onSms,
+}: {
+	firstName: string;
+	phone: string;
+	email?: string | null;
+	fromMeta?: boolean;
+	onSms?: () => void;
+}) {
+	const channels: Channel[] = [
+		{ id: "call", label: "Appeler", icon: Phone, href: telLink(phone) },
+		...(onSms ? [{ id: "sms", label: "SMS", icon: Chat, onClick: onSms }] : []),
+		...(email ? [{ id: "email", label: "Courriel", icon: Email, href: mailtoLink(email) }] : []),
+		{
+			id: "whatsapp",
+			label: "WhatsApp",
+			icon: ChatLaunch,
+			href: whatsappLink(phone, firstName),
+			external: true,
+		},
+		...(fromMeta
+			? [
+					{
+						id: "meta",
+						label: "Messenger",
+						icon: MetaLogo,
+						href: CONTACT_CHANNELS.metaInboxUrl,
+						external: true,
+					},
+				]
+			: []),
+	];
+	return (
+		<div className="flex w-full flex-wrap items-center gap-1.5" role="group" aria-label={`Contacter ${firstName}`}>
+			{channels.map((channel) => (
+				<Button
+					key={channel.id}
+					variant="outline"
+					size="sm"
+					asChild={Boolean(channel.href)}
+					onClick={channel.onClick}
+					title={channel.label}
+					translate="no"
+				>
+					{channel.href ? (
+						<a
+							href={channel.href}
+							{...(channel.external ? { target: "_blank", rel: "noopener noreferrer" } : {})}
+							aria-label={`${channel.label} ${firstName}`}
+						>
+							<Icon icon={channel.icon} className="size-3.5" />
+							<span className="max-sm:sr-only">{channel.label}</span>
+						</a>
+					) : (
+						<>
+							<Icon icon={channel.icon} className="size-3.5" />
+							<span className="max-sm:sr-only">{channel.label}</span>
+						</>
+					)}
+				</Button>
+			))}
+			<InfoHint label="Contacter par un autre canal">{CONTACT_CHANNELS.notice}</InfoHint>
+		</div>
+	);
+}
