+++ b/apps/api/src/team/team.service.ts
@@ -0,0 +1,501 @@
+import {
+	canChangeRole,
+	WORKSPACE_ID,
+	type WorkspaceRole,
+	workspaceRoleOf,
+} from "@crm/auth";
+import { type Db, Prisma } from "@crm/db";
+import {
+	ForbiddenException,
+	Injectable,
+	NotFoundException,
+} from "@nestjs/common";
+import { InjectDatabase } from "../database/database.constants";
+import { PRESENCE } from "../presence/presence-config";
+import type {
+	TeamListInput,
+	TeamMemberDetail,
+	TeamMemberRow,
+} from "./team.contracts";
+import { TEAM, TEAM_MESSAGES } from "./team-config";
+
+const DAY_MS = 24 * 60 * 60 * 1000;
+
+type Viewer = {
+	id: string;
+	manage: boolean;
+	agencyIds: string[];
+};
+
+type Counts = { notes: number; activities: number; sms: number };
+
+function iso(value: Date | null | undefined): string | null {
+	return value ? value.toISOString() : null;
+}
+
+function leadName(lead: { firstName: string; lastName: string | null }) {
+	return `${lead.firstName} ${lead.lastName ?? ""}`.trim();
+}
+
+function recordOf(activity: {
+	contact: { firstName: string; lastName: string | null } | null;
+	company: { name: string } | null;
+	deal: { name: string } | null;
+}) {
+	if (activity.deal) return { type: "deal" as const, name: activity.deal.name };
+	if (activity.contact)
+		return { type: "contact" as const, name: leadName(activity.contact) };
+	if (activity.company)
+		return { type: "company" as const, name: activity.company.name };
+	return { type: null, name: null };
+}
+
+function excerpt(text: string | null, max = 200): string | null {
+	if (!text) return null;
+	const flat = text.replace(/\s+/g, " ").trim();
+	return flat.length > max ? `${flat.slice(0, max - 1).trimEnd()}…` : flat;
+}
+
+@Injectable()
+export class TeamService {
+	constructor(@InjectDatabase() private readonly db: Db) {}
+
+	private async viewer(userId: string): Promise<Viewer> {
+		const [role, memberships] = await Promise.all([
+			workspaceRoleOf(userId),
+			this.db.agencyUser.findMany({
+				where: { userId },
+				select: { agencyId: true },
+			}),
+		]);
+
+		return {
+			id: userId,
+			manage: canChangeRole(role),
+			agencyIds: memberships.map((membership) => membership.agencyId),
+		};
+	}
+
+	private async counts(
+		userIds: string[],
+		since: Date,
+		agencyIds: string[],
+	): Promise<{ counts: Map<string, Counts>; last: Map<string, Date> }> {
+		const counts = new Map<string, Counts>();
+		const last = new Map<string, Date>();
+		const bump = (
+			userId: string,
+			key: keyof Counts,
+			n: number,
+			at: Date | null,
+		) => {
+			const row = counts.get(userId) ?? { notes: 0, activities: 0, sms: 0 };
+			row[key] += n;
+			counts.set(userId, row);
+			if (at && (!last.get(userId) || at > (last.get(userId) as Date)))
+				last.set(userId, at);
+		};
+
+		if (userIds.length === 0) return { counts, last };
+
+		const [notes, activities, sms] = await Promise.all([
+			this.db.leadNote.groupBy({
+				by: ["authorId"],
+				where: {
+					authorId: { in: userIds },
+					agencyId: { in: agencyIds },
+					createdAt: { gte: since },
+				},
+				_count: { _all: true },
+				_max: { createdAt: true },
+			}),
+			this.db.activity.groupBy({
+				by: ["createdById"],
+				where: { createdById: { in: userIds }, createdAt: { gte: since } },
+				_count: { _all: true },
+				_max: { createdAt: true },
+			}),
+			agencyIds.length === 0
+				? Promise.resolve([] as { id: string; n: number; at: Date }[])
+				: this.db.$queryRaw<{ id: string; n: number; at: Date }[]>(Prisma.sql`
+					SELECT metadata->>'authorId' AS id, count(*)::int AS n, max("sentAt") AS at
+					FROM "message"
+					WHERE sender = 'HUMAN_AGENT'
+					  AND "sentAt" >= ${since}
+					  AND "agencyId" IN (${Prisma.join(agencyIds)})
+					  AND metadata->>'authorId' IN (${Prisma.join(userIds)})
+					GROUP BY 1`),
+		]);
+
+		for (const row of notes)
+			if (row.authorId)
+				bump(row.authorId, "notes", row._count._all, row._max.createdAt);
+		for (const row of activities)
+			bump(row.createdById, "activities", row._count._all, row._max.createdAt);
+		for (const row of sms) bump(row.id, "sms", Number(row.n), row.at);
+
+		return { counts, last };
+	}
+
+	private async rows(
+		viewer: Viewer,
+		userId?: string,
+	): Promise<TeamMemberRow[]> {
+		const members = await this.db.member.findMany({
+			where: {
+				organizationId: WORKSPACE_ID,
+				...(userId ? { userId } : viewer.manage ? {} : { userId: viewer.id }),
+			},
+			select: {
+				role: true,
+				createdAt: true,
+				user: {
+					select: {
+						id: true,
+						name: true,
+						email: true,
+						image: true,
+						lastSeenAt: true,
+						lastSeenLabel: true,
+					},
+				},
+			},
+			orderBy: { createdAt: "asc" },
+		});
+		const ids = members.map((member) => member.user.id);
+		const now = new Date();
+		const since = new Date(now.getTime() - TEAM.windowDays * DAY_MS);
+		const [agencyRows, open, overdue, activity] = await Promise.all([
+			this.db.agencyUser.findMany({
+				where: { userId: { in: ids } },
+				select: {
+					userId: true,
+					role: true,
+					agency: { select: { id: true, name: true } },
+					client: { select: { name: true } },
+				},
+			}),
+			this.db.activity.groupBy({
+				by: ["createdById"],
+				where: { type: "TASK", completedAt: null, createdById: { in: ids } },
+				_count: { _all: true },
+			}),
+			this.db.activity.groupBy({
+				by: ["createdById"],
+				where: {
+					type: "TASK",
+					completedAt: null,
+					dueAt: { lt: now },
+					createdById: { in: ids },
+				},
+				_count: { _all: true },
+			}),
+			this.counts(ids, since, viewer.agencyIds),
+		]);
+		const openBy = new Map(
+			open.map((row) => [row.createdById, row._count._all]),
+		);
+		const overdueBy = new Map(
+			overdue.map((row) => [row.createdById, row._count._all]),
+		);
+
+		return members.map((member) => {
+			const counted = activity.counts.get(member.user.id);
+			const seen = member.user.lastSeenAt;
+			return {
+				id: member.user.id,
+				name: member.user.name,
+				email: member.user.email,
+				image: member.user.image,
+				workspaceRole: toRole(member.role),
+				agencyRoles: agencyRows
+					.filter((row) => row.userId === member.user.id)
+					.map((row) => ({
+						agencyId: row.agency.id,
+						agencyName: row.agency.name,
+						role: row.role,
+						clientName: row.client?.name ?? null,
+					})),
+				online: seen
+					? now.getTime() - seen.getTime() < PRESENCE.onlineWindowMs
+					: false,
+				lastSeenAt: iso(seen),
+				lastSeenLabel: member.user.lastSeenLabel,
+				joinedAt: member.createdAt.toISOString(),
+				openTasks: openBy.get(member.user.id) ?? 0,
+				overdueTasks: overdueBy.get(member.user.id) ?? 0,
+				actions: counted ? counted.notes + counted.activities + counted.sms : 0,
+				lastActionAt: iso(activity.last.get(member.user.id)),
+				isViewer: member.user.id === viewer.id,
+			};
+		});
+	}
+
+	async list(userId: string, input: TeamListInput) {
+		const viewer = await this.viewer(userId);
+		const all = await this.rows(viewer);
+		const needle = input.search?.toLowerCase();
+		const rows = all.filter((row) => {
+			if (needle && !`${row.name} ${row.email}`.toLowerCase().includes(needle))
+				return false;
+			if (input.filter === "ONLINE") return row.online;
+			const realtor = row.agencyRoles.some((role) => role.role === "REALTOR");
+			if (input.filter === "REALTORS") return realtor;
+			if (input.filter === "STAFF") return !realtor;
+			return true;
+		});
+
+		return {
+			rows,
+			canViewEveryone: viewer.manage,
+			windowDays: TEAM.windowDays,
+			summary: {
+				members: all.length,
+				online: all.filter((row) => row.online).length,
+				overdueTasks: all.reduce((sum, row) => sum + row.overdueTasks, 0),
+				actions: all.reduce((sum, row) => sum + row.actions, 0),
+			},
+		};
+	}
+
+	async member(userId: string, targetId: string): Promise<TeamMemberDetail> {
+		const viewer = await this.viewer(userId);
+
+		if (!viewer.manage && targetId !== viewer.id) {
+			throw new ForbiddenException(TEAM_MESSAGES.forbidden);
+		}
+
+		const [member] = await this.rows(viewer, targetId);
+
+		if (!member) throw new NotFoundException(TEAM_MESSAGES.notFound);
+
+		const since = new Date(Date.now() - TEAM.windowDays * DAY_MS);
+		const agencyIds = viewer.agencyIds;
+		const clientIds = await this.db.agencyUser
+			.findMany({
+				where: {
+					userId: targetId,
+					agencyId: { in: agencyIds },
+					clientId: { not: null },
+				},
+				select: { clientId: true, agencyId: true },
+			})
+			.then((rows) => rows.filter((row) => row.clientId));
+		const [
+			notes,
+			activities,
+			sms,
+			tasks,
+			doneTasks,
+			support,
+			assistant,
+			leadsFollowed,
+		] = await Promise.all([
+			this.db.leadNote.findMany({
+				where: { authorId: targetId, agencyId: { in: agencyIds } },
+				orderBy: { createdAt: "desc" },
+				take: TEAM.sourceLimit,
+				select: {
+					id: true,
+					body: true,
+					createdAt: true,
+					agencyId: true,
+					lead: { select: { id: true, firstName: true, lastName: true } },
+				},
+			}),
+			this.db.activity.findMany({
+				where: { createdById: targetId },
+				orderBy: { createdAt: "desc" },
+				take: TEAM.sourceLimit,
+				select: {
+					id: true,
+					type: true,
+					subject: true,
+					body: true,
+					createdAt: true,
+					contact: { select: { firstName: true, lastName: true } },
+					company: { select: { name: true } },
+					deal: { select: { name: true } },
+				},
+			}),
+			agencyIds.length === 0
+				? Promise.resolve([] as SmsRow[])
+				: this.db.$queryRaw<SmsRow[]>(Prisma.sql`
+						SELECT m.id, m.status, m."sentAt" AS at, m."agencyId", l.id AS "leadId",
+						       l."firstName", l."lastName"
+						FROM "message" m
+						JOIN "conversation" c ON c.id = m."conversationId" AND c."agencyId" = m."agencyId"
+						JOIN "lead" l ON l.id = c."leadId" AND l."agencyId" = c."agencyId"
+						WHERE m.sender = 'HUMAN_AGENT'
+						  AND m.metadata->>'authorId' = ${targetId}
+						  AND m."agencyId" IN (${Prisma.join(agencyIds)})
+						ORDER BY m."sentAt" DESC
+						LIMIT ${TEAM.sourceLimit}`),
+			this.db.activity.findMany({
+				where: { createdById: targetId, type: "TASK", completedAt: null },
+				orderBy: [
+					{ dueAt: { sort: "asc", nulls: "last" } },
+					{ createdAt: "desc" },
+				],
+				take: TEAM.taskLimit,
+				select: taskSelect,
+			}),
+			this.db.activity.findMany({
+				where: {
+					createdById: targetId,
+					type: "TASK",
+					completedAt: { gte: since },
+				},
+				orderBy: { completedAt: "desc" },
+				take: TEAM.taskLimit,
+				select: taskSelect,
+			}),
+			this.db.supportRequest.findMany({
+				where: { userId: targetId },
+				orderBy: { createdAt: "desc" },
+				take: TEAM.sourceLimit,
+				select: { id: true, subject: true, status: true, createdAt: true },
+			}),
+			this.db.agentConversation.findMany({
+				where: { userId: targetId },
+				orderBy: { createdAt: "desc" },
+				take: TEAM.sourceLimit,
+				select: { id: true, title: true, createdAt: true, messageCount: true },
+			}),
+			clientIds.length === 0
+				? Promise.resolve<number | null>(null)
+				: this.db.lead.count({
+						where: {
+							OR: clientIds.map((row) => ({
+								agencyId: row.agencyId,
+								clientId: row.clientId as string,
+							})),
+						},
+					}),
+		]);
+		const now = new Date();
+		const toTask = (row: TaskRow) => {
+			const record = recordOf(row);
+			return {
+				id: row.id,
+				subject: row.subject ?? "Tâche sans titre",
+				dueAt: iso(row.dueAt),
+				completedAt: iso(row.completedAt),
+				overdue: !row.completedAt && row.dueAt !== null && row.dueAt < now,
+				recordType: record.type,
+				recordName: record.name,
+			};
+		};
+		const timeline = [
+			...notes.map((note) => ({
+				id: `note:${note.id}`,
+				at: note.createdAt,
+				kind: "LEAD_NOTE" as const,
+				activityType: null,
+				title: `Note sur ${leadName(note.lead)}`,
+				detail: excerpt(note.body),
+				leadId: note.lead.id,
+				agencyId: note.agencyId,
+				targetId: null,
+			})),
+			...activities.map((activity) => {
+				const record = recordOf(activity);
+				return {
+					id: `activity:${activity.id}`,
+					at: activity.createdAt,
+					kind: "ACTIVITY" as const,
+					activityType: activity.type,
+					title: activity.subject ?? record.name ?? "Activité",
+					detail: excerpt(activity.body),
+					leadId: null,
+					agencyId: null,
+					targetId: null,
+				};
+			}),
+			...sms.map((row) => ({
+				id: `sms:${row.id}`,
+				at: new Date(row.at),
+				kind: "SMS" as const,
+				activityType: null,
+				title: `SMS envoyé à ${leadName(row)}`,
+				detail: row.status,
+				leadId: row.leadId,
+				agencyId: row.agencyId,
+				targetId: null,
+			})),
+			...support.map((request) => ({
+				id: `support:${request.id}`,
+				at: request.createdAt,
+				kind: "SUPPORT" as const,
+				activityType: null,
+				title: request.subject,
+				detail: request.status,
+				leadId: null,
+				agencyId: null,
+				targetId: request.id,
+			})),
+			...assistant.map((chat) => ({
+				id: `chat:${chat.id}`,
+				at: chat.createdAt,
+				kind: "ASSISTANT" as const,
+				activityType: null,
+				title: chat.title ?? "Conversation sans titre",
+				detail: `${chat.messageCount} ${chat.messageCount > 1 ? "messages" : "message"}`,
+				leadId: null,
+				agencyId: null,
+				targetId: chat.id,
+			})),
+		]
+			.sort((a, b) => b.at.getTime() - a.at.getTime())
+			.slice(0, TEAM.timelineLimit)
+			.map((item) => ({ ...item, at: item.at.toISOString() }));
+		const recent = (date: Date) => date >= since;
+
+		return {
+			member,
+			canViewEveryone: viewer.manage,
+			windowDays: TEAM.windowDays,
+			stats: {
+				leadsFollowed,
+				notes: notes.filter((note) => recent(note.createdAt)).length,
+				activities: activities.filter((a) => recent(a.createdAt)).length,
+				sms: sms.filter((row) => recent(new Date(row.at))).length,
+				openTasks: member.openTasks,
+				overdueTasks: member.overdueTasks,
+				doneTasks: doneTasks.length,
+				supportOpen: support.filter((request) => request.status !== "RESOLVED")
+					.length,
+				conversations: assistant.filter((chat) => recent(chat.createdAt))
+					.length,
+			},
+			tasks: [...tasks, ...doneTasks].map(toTask),
+			timeline,
+		};
+	}
+}
+
+type SmsRow = {
+	id: string;
+	status: string;
+	at: Date;
+	agencyId: string;
+	leadId: string;
+	firstName: string;
+	lastName: string | null;
+};
+
+const taskSelect = {
+	id: true,
+	subject: true,
+	dueAt: true,
+	completedAt: true,
+	contact: { select: { firstName: true, lastName: true } },
+	company: { select: { name: true } },
+	deal: { select: { name: true } },
+} as const;
+
+type TaskRow = Prisma.ActivityGetPayload<{ select: typeof taskSelect }>;
+
+function toRole(value: string): WorkspaceRole {
+	return value === "owner" || value === "admin" ? value : "member";
+}
