+import type { ReactNode } from "react";
+import { LAYOUT } from "../lib/layout";
+import { REVEAL, staggerStyle } from "../lib/motion";
+import { cn } from "../lib/utils";
+import {
+	Card,
+	CardAction,
+	CardContent,
+	CardDescription,
+	CardHeader,
+	CardTitle,
+} from "./card";
+import { InfoHint } from "./real-estate-visuals";
+
+export function Panel({
+	title,
+	description,
+	info,
+	action,
+	index = 0,
+	fill = false,
+	className,
+	bodyClassName,
+	children,
+}: {
+	title: string;
+	description?: string;
+	info?: ReactNode;
+	action?: ReactNode;
+	index?: number;
+	fill?: boolean;
+	className?: string;
+	bodyClassName?: string;
+	children: ReactNode;
+}) {
+	return (
+		<Card
+			className={cn(fill && "h-full", REVEAL, className)}
+			style={staggerStyle(index)}
+		>
+			<CardHeader className={LAYOUT.headerMinHeight}>
+				<CardTitle className="flex items-center gap-1.5">
+					{title}
+					{info && <InfoHint label={title}>{info}</InfoHint>}
+				</CardTitle>
+				{description && <CardDescription>{description}</CardDescription>}
+				{action && <CardAction>{action}</CardAction>}
+			</CardHeader>
+			<CardContent
+				className={cn(LAYOUT.panelBody, fill && "flex-1", bodyClassName)}
+			>
+				{children}
+			</CardContent>
+		</Card>
+	);
+}
