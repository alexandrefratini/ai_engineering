+export const REAL_ESTATE_FORMAT = {
+	locale: "fr-CA",
+	timeZone: "America/Toronto",
+	currency: "CAD",
+} as const;
+
+const { locale, timeZone, currency } = REAL_ESTATE_FORMAT;
+
+const cadFormat = new Intl.NumberFormat(locale, {
+	style: "currency",
+	currency,
+	maximumFractionDigits: 0,
+});
+const dateTimeFormat = new Intl.DateTimeFormat(locale, {
+	day: "numeric",
+	month: "short",
+	year: "numeric",
+	hour: "numeric",
+	minute: "2-digit",
+	timeZone,
+});
+const dateFormat = new Intl.DateTimeFormat(locale, {
+	day: "numeric",
+	month: "short",
+	year: "numeric",
+	timeZone,
+});
+const timeFormat = new Intl.DateTimeFormat(locale, {
+	hour: "numeric",
+	minute: "2-digit",
+	timeZone,
+});
+const dayPartsFormat = new Intl.DateTimeFormat(locale, {
+	year: "numeric",
+	month: "2-digit",
+	day: "2-digit",
+	timeZone,
+});
+const headingFormat = new Intl.DateTimeFormat(locale, {
+	weekday: "long",
+	day: "numeric",
+	month: "long",
+	timeZone,
+});
+const headingYearFormat = new Intl.DateTimeFormat(locale, {
+	weekday: "long",
+	day: "numeric",
+	month: "long",
+	year: "numeric",
+	timeZone,
+});
+const shortDayFormat = new Intl.DateTimeFormat(locale, {
+	day: "numeric",
+	month: "short",
+	timeZone,
+});
+const hoursFormat = new Intl.NumberFormat(locale, { maximumFractionDigits: 1 });
+const ratioFormat = new Intl.NumberFormat(locale, {
+	style: "percent",
+	maximumFractionDigits: 0,
+});
+const rateFormat = new Intl.NumberFormat(locale, {
+	style: "percent",
+	maximumFractionDigits: 2,
+});
+
+const NORTH_AMERICAN_PHONE = /^\+1(\d{3})(\d{3})(\d{4})$/;
+
+function toDate(value: Date | string): Date {
+	return value instanceof Date ? value : new Date(value);
+}
+
+function isValid(date: Date): boolean {
+	return !Number.isNaN(date.getTime());
+}
+
+function formatWith(format: Intl.DateTimeFormat, value: Date | string): string {
+	const date = toDate(value);
+	return isValid(date) ? format.format(date) : "—";
+}
+
+export function formatCad(value: number): string {
+	return cadFormat.format(value);
+}
+
+export function formatBudget(
+	min: number | null | undefined,
+	max: number | null | undefined,
+): string | null {
+	const hasMin = typeof min === "number";
+	const hasMax = typeof max === "number";
+	if (hasMin && hasMax) {
+		if (min === max) return formatCad(min);
+		return `${formatCad(min)} – ${formatCad(max)}`;
+	}
+	if (hasMax) return `Jusqu'à ${formatCad(max)}`;
+	if (hasMin) return `À partir de ${formatCad(min)}`;
+	return null;
+}
+
+export function formatDateTime(value: Date | string): string {
+	return formatWith(dateTimeFormat, value);
+}
+
+export function formatDate(value: Date | string): string {
+	return formatWith(dateFormat, value);
+}
+
+export function formatTime(value: Date | string): string {
+	return formatWith(timeFormat, value);
+}
+
+export function dayKey(value: Date | string): string {
+	const date = toDate(value);
+	if (!isValid(date)) return "";
+	const parts = dayPartsFormat.formatToParts(date);
+	const part = (type: Intl.DateTimeFormatPartTypes) =>
+		parts.find((item) => item.type === type)?.value ?? "";
+	return `${part("year")}-${part("month")}-${part("day")}`;
+}
+
+function shiftDayKey(key: string, days: number): string {
+	const date = new Date(`${key}T12:00:00Z`);
+	date.setUTCDate(date.getUTCDate() + days);
+	return date.toISOString().slice(0, 10);
+}
+
+function sameYear(value: Date | string, now: Date): boolean {
+	return dayKey(value).slice(0, 4) === dayKey(now).slice(0, 4);
+}
+
+export function formatDayHeading(value: Date | string, now: Date): string {
+	const key = dayKey(value);
+	if (!key) return "—";
+	const today = dayKey(now);
+	if (key === today) return "Aujourd'hui";
+	if (key === shiftDayKey(today, -1)) return "Hier";
+	const date = toDate(value);
+	return sameYear(date, now)
+		? headingFormat.format(date)
+		: headingYearFormat.format(date);
+}
+
+export function formatShortStamp(value: Date | string, now: Date): string {
+	const key = dayKey(value);
+	if (!key) return "—";
+	const today = dayKey(now);
+	if (key === today) return formatTime(value);
+	if (key === shiftDayKey(today, -1)) return "Hier";
+	const date = toDate(value);
+	return sameYear(date, now) ? shortDayFormat.format(date) : formatDate(date);
+}
+
+export function formatPhone(value: string): string {
+	const match = NORTH_AMERICAN_PHONE.exec(value);
+	if (!match) return value;
+	return `(${match[1]}) ${match[2]}-${match[3]}`;
+}
+
+export function formatDuration(minutes: number): string {
+	const rounded = Math.round(minutes);
+	if (rounded < 60) return `${Math.max(1, rounded)} min`;
+	if (minutes < 48 * 60) return `${hoursFormat.format(minutes / 60)} h`;
+	return `${Math.round(minutes / (24 * 60))} j`;
+}
+
+export function formatPercentValue(ratio: number): string {
+	return ratioFormat.format(Number.isFinite(ratio) ? ratio : 0);
+}
+
+export function formatRate(percent: number): string {
+	return rateFormat.format(Number.isFinite(percent) ? percent / 100 : 0);
+}
