+++ b/packages/ui/src/components/real-estate-visuals.tsx
@@ -0,0 +1,511 @@
+"use client";
+
+import {
+	type CSSProperties,
+	type ReactElement,
+	type ReactNode,
+	useEffect,
+	useState,
+} from "react";
+import { LAYOUT } from "../lib/layout";
+import { REVEAL, staggerStyle } from "../lib/motion";
+import { formatPercentValue } from "../lib/real-estate";
+import { cn } from "../lib/utils";
+import { Tooltip, TooltipContent, TooltipProvider, TooltipTrigger } from "./tooltip";
+
+function useMounted() {
+	const [mounted, setMounted] = useState(false);
+	useEffect(() => {
+		setMounted(true);
+	}, []);
+	return mounted;
+}
+
+function clamp(value: number, min: number, max: number) {
+	if (!Number.isFinite(value)) return min;
+	return Math.min(max, Math.max(min, value));
+}
+
+function Hint({ content, children }: { content: ReactNode; children: ReactElement }) {
+	return (
+		<TooltipProvider>
+			<Tooltip>
+				<TooltipTrigger asChild>{children}</TooltipTrigger>
+				<TooltipContent side="top" sideOffset={4} className="max-w-xs text-pretty">
+					{content}
+				</TooltipContent>
+			</Tooltip>
+		</TooltipProvider>
+	);
+}
+
+const RING_RADIUS = 20;
+const RING_CIRCUMFERENCE = 2 * Math.PI * RING_RADIUS;
+
+function scoreTone(score: number) {
+	if (score >= 70) return "stroke-success";
+	if (score >= 40) return "stroke-primary";
+	return "stroke-muted-foreground/50";
+}
+
+export function ScoreRing({ value, label }: { value: number; label: string }) {
+	const mounted = useMounted();
+	const score = Math.round(clamp(value, 0, 100));
+	const shown = mounted ? score : 0;
+	return (
+		<Hint content={`${label} : ${score} sur 100`}>
+			<span
+				role="img"
+				aria-label={`${label} : ${score} sur 100`}
+				className="relative inline-grid size-12 shrink-0 place-items-center"
+			>
+				<svg viewBox="0 0 48 48" aria-hidden="true" className="absolute inset-0 size-full -rotate-90">
+					<circle cx="24" cy="24" r={RING_RADIUS} fill="none" strokeWidth="4" className="stroke-foreground/10" />
+					<circle
+						cx="24"
+						cy="24"
+						r={RING_RADIUS}
+						fill="none"
+						strokeWidth="4"
+						strokeLinecap="round"
+						strokeDasharray={RING_CIRCUMFERENCE}
+						strokeDashoffset={RING_CIRCUMFERENCE * (1 - shown / 100)}
+						className={cn(
+							"transition-[stroke-dashoffset,opacity] duration-700 ease-out motion-reduce:transition-none",
+							scoreTone(score),
+							shown === 0 && "opacity-0",
+						)}
+					/>
+				</svg>
+				<span className="relative text-sm leading-none font-medium tabular-nums">{score}</span>
+			</span>
+		</Hint>
+	);
+}
+
+export type JourneyStep = { id: string; label: string };
+
+export function LeadJourney({
+	steps,
+	current,
+	aside,
+}: {
+	steps: readonly JourneyStep[];
+	current: string;
+	aside?: ReactNode;
+}) {
+	const mounted = useMounted();
+	const currentIndex = steps.findIndex((step) => step.id === current);
+	const active = steps[currentIndex];
+	return (
+		<div className="flex flex-col gap-1.5">
+			<ol
+				aria-label="Parcours du prospect"
+				className="grid gap-1"
+				style={{ gridTemplateColumns: `repeat(${Math.max(steps.length, 1)}, minmax(0, 1fr))` }}
+			>
+				{steps.map((step, index) => {
+					const reached = index <= currentIndex;
+					const isCurrent = index === currentIndex;
+					return (
+						<li key={step.id} aria-current={isCurrent ? "step" : undefined} className="flex min-w-0 flex-col gap-1.5">
+							<span aria-hidden="true" className="h-1.5 overflow-hidden rounded-full bg-foreground/10">
+								<span
+									className={cn(
+										"block h-full origin-left rounded-full bg-primary transition-transform duration-500 ease-out motion-reduce:transition-none",
+										mounted && reached ? "scale-x-100" : "scale-x-0",
+									)}
+									style={{ transitionDelay: `${index * 70}ms` }}
+								/>
+							</span>
+							<span className="sr-only sm:not-sr-only">
+								<span
+									className={cn(
+										"block truncate text-xs",
+										isCurrent ? "font-medium text-foreground" : reached ? "text-foreground/70" : "text-muted-foreground",
+									)}
+									title={step.label}
+								>
+									{step.label}
+									{reached && !isCurrent && <span className="sr-only"> (étape franchie)</span>}
+								</span>
+							</span>
+						</li>
+					);
+				})}
+			</ol>
+			<div className={cn("flex items-center justify-between gap-3 text-xs", !aside && "sm:hidden")}>
+				<span aria-hidden="true" className="truncate text-muted-foreground sm:invisible">
+					{active ? (
+						<>
+							Étape {currentIndex + 1} sur {steps.length} ·{" "}
+							<span className="font-medium text-foreground">{active.label}</span>
+						</>
+					) : (
+						"Hors parcours"
+					)}
+				</span>
+				{aside && (
+					<span className="flex shrink-0 items-center gap-1.5">
+						<span aria-hidden="true" className="size-2 rounded-full bg-muted-foreground/50" />
+						<span className="sr-only">Hors parcours : </span>
+						<span className="font-medium">{aside}</span>
+					</span>
+				)}
+			</div>
+		</div>
+	);
+}
+
+const SEGMENT_SIZES = {
+	sm: { height: "h-1.5", width: "w-2.5" },
+	md: { height: "h-2", width: "w-4" },
+} as const;
+
+const SEGMENT_LIMIT = 24;
+
+export function SegmentMeter({
+	filled,
+	total,
+	label,
+	size = "sm",
+}: {
+	filled: number;
+	total: number;
+	label: string;
+	size?: keyof typeof SEGMENT_SIZES;
+}) {
+	const mounted = useMounted();
+	const count = Math.max(0, Math.round(clamp(total, 0, Number.MAX_SAFE_INTEGER)));
+	const lit = Math.round(clamp(filled, 0, count));
+	if (count === 0) return null;
+	const tone = lit === count ? "bg-success" : "bg-primary";
+	if (count > SEGMENT_LIMIT)
+		return (
+			<span
+				role="img"
+				aria-label={label}
+				className={cn("inline-block w-24 shrink-0 overflow-hidden rounded-full bg-foreground/10", SEGMENT_SIZES[size].height)}
+			>
+				<span
+					className={cn("block h-full rounded-full transition-[width] duration-700 ease-out motion-reduce:transition-none", tone)}
+					style={{ width: mounted ? `${(lit / count) * 100}%` : "0%" }}
+				/>
+			</span>
+		);
+	return (
+		<span role="img" aria-label={label} className="inline-flex shrink-0 items-center gap-0.5">
+			{Array.from({ length: count }, (_, index) => (
+				<span
+					key={index}
+					className={cn(
+						"rounded-full transition-colors duration-300 motion-reduce:transition-none",
+						SEGMENT_SIZES[size].height,
+						SEGMENT_SIZES[size].width,
+						mounted && index < lit ? tone : "bg-foreground/10",
+					)}
+					style={{ transitionDelay: `${index * 40}ms` }}
+				/>
+			))}
+		</span>
+	);
+}
+
+export type FunnelRow = {
+	id: string;
+	label: string;
+	count: number;
+	tone?: "neutral" | "won";
+};
+
+export function FunnelBars({ rows, total }: { rows: FunnelRow[]; total?: number }) {
+	const mounted = useMounted();
+	const base = total ?? rows[0]?.count ?? 0;
+	const scale = Math.max(base, ...rows.map((row) => row.count), 1);
+	return (
+		<ul className="flex flex-col gap-2">
+			{rows.map((row, index) => (
+				<li
+					key={row.id}
+					className={cn(
+						"grid grid-cols-[minmax(0,1fr)_auto_3rem] items-center gap-x-3 gap-y-1 text-sm sm:grid-cols-[minmax(0,11rem)_minmax(0,1fr)_3rem_3.5rem]",
+						REVEAL,
+					)}
+					style={staggerStyle(index)}
+				>
+					<span className="truncate text-muted-foreground" title={row.label}>
+						{row.label}
+					</span>
+					<span
+						aria-hidden="true"
+						className="col-span-3 row-start-2 h-2 overflow-hidden rounded-full bg-muted sm:col-span-1 sm:col-start-2 sm:row-start-1"
+					>
+						<span
+							className={cn(
+								"block h-full rounded-full transition-[width] duration-700 ease-out motion-reduce:transition-none",
+								row.tone === "won" ? "bg-primary" : "bg-muted-foreground/45",
+							)}
+							style={{
+								width: mounted ? `${(Math.max(0, row.count) / scale) * 100}%` : "0%",
+								transitionDelay: `${index * 60}ms`,
+							}}
+						/>
+					</span>
+					<span className="col-start-2 row-start-1 text-right font-medium tabular-nums sm:col-start-3">{row.count}</span>
+					<span className="col-start-3 row-start-1 text-right text-xs text-muted-foreground tabular-nums sm:col-start-4">
+						{base > 0 ? formatPercentValue(row.count / base) : "—"}
+					</span>
+				</li>
+			))}
+		</ul>
+	);
+}
+
+export function Sparkline({ values, label }: { values: number[]; label: string }) {
+	const mounted = useMounted();
+	if (values.length < 2) return null;
+	const max = Math.max(...values, 1);
+	const step = 100 / (values.length - 1);
+	const line = values
+		.map((value, index) => {
+			const x = index * step;
+			const y = 2 + (1 - Math.max(0, value) / max) * 20;
+			return `${index === 0 ? "M" : "L"}${x.toFixed(2)} ${y.toFixed(2)}`;
+		})
+		.join(" ");
+	const last = values[values.length - 1] ?? 0;
+	return (
+		<svg
+			viewBox="0 0 100 24"
+			preserveAspectRatio="none"
+			role="img"
+			aria-label={`${label}. Dernière valeur : ${last}. Maximum : ${Math.max(...values)}.`}
+			className="mt-1 h-8 w-full transition-[clip-path] duration-1000 ease-out motion-reduce:transition-none"
+			style={{ clipPath: mounted ? "inset(0 0 0 0)" : "inset(0 100% 0 0)" }}
+		>
+			<path d={`${line} L100 24 L0 24 Z`} className="fill-foreground/5" />
+			<path
+				d={line}
+				fill="none"
+				strokeWidth={1.5}
+				strokeLinecap="round"
+				strokeLinejoin="round"
+				vectorEffect="non-scaling-stroke"
+				className="stroke-foreground/70"
+			/>
+		</svg>
+	);
+}
+
+export function InfoHint({ label, children }: { label: string; children: ReactNode }) {
+	const [open, setOpen] = useState(false);
+	return (
+		<TooltipProvider>
+			<Tooltip open={open} onOpenChange={setOpen}>
+				<TooltipTrigger asChild>
+					<button
+						type="button"
+						aria-label={`En savoir plus : ${label}`}
+						onClick={(event) => {
+							event.preventDefault();
+							setOpen(true);
+						}}
+						className="relative inline-grid size-4 shrink-0 place-items-center rounded-full border border-border text-[10px] leading-none font-medium text-muted-foreground transition-colors after:absolute after:-inset-2 after:content-[''] hover:border-foreground/30 hover:text-foreground focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring data-[state=delayed-open]:border-foreground/30 data-[state=delayed-open]:text-foreground data-[state=instant-open]:border-foreground/30 data-[state=instant-open]:text-foreground"
+					>
+						?
+					</button>
+				</TooltipTrigger>
+				<TooltipContent side="top" sideOffset={4} className="max-w-xs text-pretty">
+					{children}
+				</TooltipContent>
+			</Tooltip>
+		</TooltipProvider>
+	);
+}
+
+export function MetricTile({
+	label,
+	value,
+	hint,
+	info,
+	index = 0,
+	children,
+}: {
+	label: string;
+	value: ReactNode;
+	hint?: ReactNode;
+	info?: ReactNode;
+	index?: number;
+	children?: ReactNode;
+}) {
+	return (
+		<div
+			className={cn("flex min-w-0 flex-col gap-1 rounded-lg border bg-card p-3", LAYOUT.tileMinHeight, REVEAL)}
+			style={staggerStyle(index)}
+		>
+			<span className="flex items-center justify-between gap-2">
+				<span className="line-clamp-2 text-xs text-muted-foreground">{label}</span>
+				{info && <InfoHint label={label}>{info}</InfoHint>}
+			</span>
+			<span className="text-lg leading-tight font-medium tracking-tight break-words tabular-nums md:text-xl">{value}</span>
+			{hint && <span className="text-pretty text-xs text-muted-foreground">{hint}</span>}
+			{children}
+		</div>
+	);
+}
+
+export function MetricGrid({ children }: { children: ReactNode }) {
+	return <div className={LAYOUT.tiles}>{children}</div>;
+}
+
+export function StageIndicator({
+	position,
+	total,
+	label,
+}: {
+	position: number;
+	total: number;
+	label: string;
+}) {
+	const mounted = useMounted();
+	const count = Math.max(0, Math.round(clamp(total, 0, SEGMENT_LIMIT)));
+	const reached = Math.round(clamp(position, 0, count));
+	return (
+		<span className="inline-flex min-w-0 items-center gap-2 text-sm">
+			<span aria-hidden="true" className="flex shrink-0 items-center gap-0.5">
+				{Array.from({ length: count }, (_, index) => (
+					<span
+						key={index}
+						className={cn(
+							"h-1.5 w-2 rounded-full transition-colors duration-300 motion-reduce:transition-none",
+							mounted && index < reached ? "bg-primary" : "bg-foreground/10",
+						)}
+						style={{ transitionDelay: `${index * 40}ms` }}
+					/>
+				))}
+			</span>
+			<span className="truncate">{label}</span>
+			{reached > 0 && (
+				<span className="sr-only">
+					, étape {reached} sur {count}
+				</span>
+			)}
+		</span>
+	);
+}
+
+export type StageGroup = {
+	id: string;
+	label: string;
+	description: string;
+	tone: "progress" | "won" | "out";
+	stages: { id: string; label: string; count: number }[];
+};
+
+const STAGE_TONES: Record<StageGroup["tone"], string> = {
+	progress: "bg-muted-foreground/55",
+	won: "bg-primary",
+	out: "bg-muted-foreground/20",
+};
+
+function sumStages(group: StageGroup) {
+	return group.stages.reduce((sum, stage) => sum + stage.count, 0);
+}
+
+function prospects(count: number) {
+	return `${count} ${count > 1 ? "prospects" : "prospect"}`;
+}
+
+export function StageBreakdown({
+	groups,
+	onSelect,
+}: {
+	groups: StageGroup[];
+	onSelect: (stageId: string) => void;
+}) {
+	const mounted = useMounted();
+	const total = groups.reduce((sum, group) => sum + sumStages(group), 0);
+	const share = (count: number) => formatPercentValue(total > 0 ? count / total : 0);
+	const segments = groups.flatMap((group) =>
+		group.stages.filter((stage) => stage.count > 0).map((stage) => ({ ...stage, tone: group.tone })),
+	);
+	const summary = groups
+		.map((group) => {
+			const count = sumStages(group);
+			return `${group.label} : ${count} (${share(count)})`;
+		})
+		.join(", ");
+	return (
+		<div className="flex flex-col gap-4">
+			<div
+				role="img"
+				aria-label={`Répartition de ${prospects(total)}. ${summary}.`}
+				className="flex h-2.5 w-full gap-0.5 overflow-hidden rounded-full bg-muted"
+			>
+				{segments.map((segment, index) => (
+					<Hint key={segment.id} content={`${segment.label} · ${prospects(segment.count)} · ${share(segment.count)}`}>
+						<span
+							className={cn(
+								"h-full min-w-1 basis-0 transition-[flex-grow] duration-700 ease-out motion-reduce:transition-none",
+								STAGE_TONES[segment.tone],
+							)}
+							style={{ flexGrow: mounted ? segment.count : 0, transitionDelay: `${index * 50}ms` }}
+						/>
+					</Hint>
+				))}
+			</div>
+			<div
+				className="grid gap-x-6 gap-y-2 sm:grid-cols-[repeat(var(--stage-columns),minmax(0,1fr))]"
+				style={{ "--stage-columns": Math.max(groups.length, 1) } as CSSProperties}
+			>
+				{groups.map((group, groupIndex) => {
+					const count = sumStages(group);
+					return (
+						<div
+							key={group.id}
+							role="group"
+							aria-label={group.label}
+							className={cn(
+								"row-span-3 grid grid-rows-subgrid border-t pt-3 first:border-t-0 first:pt-0 sm:border-t-0 sm:pt-0",
+								REVEAL,
+							)}
+							style={staggerStyle(groupIndex)}
+						>
+							<div className="flex min-w-0 items-center gap-2 text-sm">
+								<span aria-hidden="true" className={cn("size-2 shrink-0 rounded-full", STAGE_TONES[group.tone])} />
+								<span className="truncate font-medium">{group.label}</span>
+								<span className="ml-auto shrink-0 text-muted-foreground tabular-nums">
+									{count} · {share(count)}
+								</span>
+							</div>
+							<p className="text-pretty text-xs text-muted-foreground">{group.description}</p>
+							<ul className="flex flex-col">
+								{group.stages.map((stage) => (
+									<li key={stage.id}>
+										<button
+											type="button"
+											onClick={() => onSelect(stage.id)}
+											aria-label={`${stage.label} : ${prospects(stage.count)}, ${share(stage.count)}. Ouvrir la liste filtrée.`}
+											className="-mx-2 grid w-[calc(100%+1rem)] grid-cols-[minmax(0,1fr)_auto_3rem] items-center gap-3 rounded-md px-2 py-1.5 text-left text-sm transition-colors hover:bg-muted/60 focus-visible:outline-2 focus-visible:outline-ring"
+										>
+											<span className={cn("truncate", stage.count === 0 && "text-muted-foreground")}>{stage.label}</span>
+											<span
+												className={cn(
+													"tabular-nums",
+													stage.count === 0 ? "text-muted-foreground" : "font-medium",
+												)}
+											>
+												{stage.count}
+											</span>
+											<span className="text-right text-xs text-muted-foreground tabular-nums">{share(stage.count)}</span>
+										</button>
+									</li>
+								))}
+							</ul>
+						</div>
+					);
+				})}
+			</div>
+		</div>
+	);
+}
