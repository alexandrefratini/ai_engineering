diff --git a/packages/ui/src/lib/real-estate-finance.ts b/packages/ui/src/lib/real-estate-finance.ts
new file mode 100644
index 0000000..6d06b7d
--- /dev/null
+++ b/packages/ui/src/lib/real-estate-finance.ts
@@ -0,0 +1,176 @@
+import { FINANCE, type Municipality } from "./real-estate-finance-config";
+
+export type OfferInput = {
+	listingPrice: number;
+	discountPct: number;
+	downPaymentPct: number;
+	ratePct: number;
+	amortizationYears: number;
+	municipality: Municipality;
+	commissionPct: number;
+};
+
+export type OfferAnalysis = {
+	offerPrice: number;
+	discountPct: number;
+	downPayment: number;
+	downPaymentPct: number;
+	minimumDown: number;
+	belowMinimum: boolean;
+	insurable: boolean;
+	loan: number;
+	premiumPct: number;
+	premium: number;
+	insuredLoan: number;
+	monthlyPayment: number;
+	welcomeTax: number;
+	premiumTax: number;
+	cashRequired: number;
+	commission: CommissionBreakdown;
+};
+
+export type CommissionBreakdown = {
+	base: number;
+	gst: number;
+	qst: number;
+	total: number;
+};
+
+const EPSILON = 1e-9;
+
+function finite(value: number, fallback = 0): number {
+	return Number.isFinite(value) ? value : fallback;
+}
+
+function clamp(value: number, min: number, max: number): number {
+	return Math.min(max, Math.max(min, value));
+}
+
+export function minimumDownPayment(price: number): number {
+	const safe = Math.max(0, finite(price));
+	const { firstTierCeiling, firstTierPct, secondTierPct } = FINANCE.downPayment;
+	if (safe >= FINANCE.downPayment.fullDownPaymentFrom) {
+		return (safe * FINANCE.downPayment.fullDownPaymentPct) / 100;
+	}
+	if (safe <= firstTierCeiling) return (safe * firstTierPct) / 100;
+	return (
+		(firstTierCeiling * firstTierPct) / 100 +
+		((safe - firstTierCeiling) * secondTierPct) / 100
+	);
+}
+
+export function insurancePremiumPct(
+	price: number,
+	downPaymentPct: number,
+	amortizationYears: number = FINANCE.mortgage.defaultAmortizationYears,
+): number | null {
+	const downPct = finite(downPaymentPct);
+	if (downPct + EPSILON >= FINANCE.downPayment.uninsuredFromPct) return 0;
+	if (finite(price) >= FINANCE.insurance.maxInsurablePrice) return null;
+	const tier =
+		FINANCE.insurance.premiumTiers.find(
+			(candidate) => downPct + EPSILON >= candidate.minDownPct,
+		) ??
+		FINANCE.insurance.premiumTiers[FINANCE.insurance.premiumTiers.length - 1];
+	if (!tier) return null;
+	const surcharge =
+		amortizationYears > FINANCE.insurance.longAmortizationAboveYears
+			? FINANCE.insurance.longAmortizationSurchargePct
+			: 0;
+	return Math.round((tier.premiumPct + surcharge) * 1000) / 1000;
+}
+
+export function monthlyPayment(
+	principal: number,
+	ratePct: number,
+	amortizationYears: number,
+): number {
+	const amount = Math.max(0, finite(principal));
+	const months = Math.max(
+		1,
+		Math.round(finite(amortizationYears, 1) * FINANCE.mortgage.paymentsPerYear),
+	);
+	if (amount === 0) return 0;
+	const annual = Math.max(0, finite(ratePct)) / 100;
+	if (annual === 0) return amount / months;
+	const monthlyRate =
+		(1 + annual / FINANCE.mortgage.compoundingsPerYear) **
+			(FINANCE.mortgage.compoundingsPerYear /
+				FINANCE.mortgage.paymentsPerYear) -
+		1;
+	return (amount * monthlyRate) / (1 - (1 + monthlyRate) ** -months);
+}
+
+export function welcomeTax(price: number, municipality: Municipality): number {
+	const safe = Math.max(0, finite(price));
+	let floor = 0;
+	let total = 0;
+	for (const bracket of FINANCE.welcomeTax.brackets[municipality]) {
+		const ceiling = bracket.upTo ?? Number.POSITIVE_INFINITY;
+		if (safe > floor) {
+			total += ((Math.min(safe, ceiling) - floor) * bracket.ratePct) / 100;
+		}
+		if (safe <= ceiling) break;
+		floor = ceiling;
+	}
+	return total;
+}
+
+export function commissionWithTaxes(
+	price: number,
+	commissionPct: number,
+): CommissionBreakdown {
+	const base =
+		(Math.max(0, finite(price)) * Math.max(0, finite(commissionPct))) / 100;
+	const gst = (base * FINANCE.commission.gstPct) / 100;
+	const qst = (base * FINANCE.commission.qstPct) / 100;
+	return { base, gst, qst, total: base + gst + qst };
+}
+
+export function analyzeOffer(input: OfferInput): OfferAnalysis {
+	const listingPrice = Math.max(0, finite(input.listingPrice));
+	const discountPct = clamp(
+		finite(input.discountPct),
+		0,
+		FINANCE.offers.maxDiscountPct,
+	);
+	const offerPrice = listingPrice * (1 - discountPct / 100);
+	const downPaymentPct = clamp(finite(input.downPaymentPct), 0, 100);
+	const downPayment = (offerPrice * downPaymentPct) / 100;
+	const minimumDown = minimumDownPayment(offerPrice);
+	const belowMinimum = downPayment + EPSILON < minimumDown;
+	const loan = Math.max(0, offerPrice - downPayment);
+	const premiumPctOrNull = insurancePremiumPct(
+		offerPrice,
+		downPaymentPct,
+		input.amortizationYears,
+	);
+	const insurable = premiumPctOrNull !== null;
+	const premiumPct = premiumPctOrNull ?? 0;
+	const premium = (loan * premiumPct) / 100;
+	const insuredLoan = loan + premium;
+	const premiumTax = (premium * FINANCE.insurance.quebecPremiumTaxPct) / 100;
+	const welcome = welcomeTax(offerPrice, input.municipality);
+	return {
+		offerPrice,
+		discountPct,
+		downPayment,
+		downPaymentPct,
+		minimumDown,
+		belowMinimum,
+		insurable,
+		loan,
+		premiumPct,
+		premium,
+		insuredLoan,
+		monthlyPayment: monthlyPayment(
+			insuredLoan,
+			input.ratePct,
+			input.amortizationYears,
+		),
+		welcomeTax: welcome,
+		premiumTax,
+		cashRequired: downPayment + welcome + premiumTax,
+		commission: commissionWithTaxes(offerPrice, input.commissionPct),
+	};
+}
