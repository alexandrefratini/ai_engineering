@@ -0,0 +1,76 @@
+import { describe, expect, it } from "bun:test";
+import {
+	matchPages,
+	NAV_PAGES,
+	pagesFor,
+	presenceLabel,
+	SEGMENT_LABELS,
+} from "../lib/navigation";
+
+describe("page search in the switcher", () => {
+	it("lists every page before anything is typed", () => {
+		expect(matchPages("")).toEqual(NAV_PAGES);
+	});
+
+	it("ignores accents and case", () => {
+		expect(matchPages("BOITE").map((page) => page.label)).toContain(
+			"Boîte de réception",
+		);
+		expect(matchPages("estimateur").map((page) => page.label)).toContain(
+			"Estimateur et offres",
+		);
+	});
+
+	it("finds a page by one of its keywords", () => {
+		expect(matchPages("réglages").map((page) => page.label)).toContain(
+			"Paramètres généraux",
+		);
+		expect(matchPages("twilio").map((page) => page.label)).toContain(
+			"Connexions",
+		);
+	});
+
+	it("finds the team page by a colleague-related word", () => {
+		expect(matchPages("collegues").map((page) => page.label)).toContain(
+			"Équipe",
+		);
+		expect(SEGMENT_LABELS.team).toBe("Équipe");
+	});
+
+	it("returns nothing for an unknown word", () => {
+		expect(matchPages("zzzz")).toEqual([]);
+	});
+
+	it("keeps staff-only pages away from realtors", () => {
+		const realtorLabels = pagesFor("realtor").map((page) => page.label);
+		expect(realtorLabels).toContain("Prospects");
+		expect(realtorLabels).toContain("Boîte de réception");
+		expect(realtorLabels).not.toContain("Courtiers");
+		expect(realtorLabels).not.toContain("Contacts");
+		expect(realtorLabels).not.toContain("Membres");
+		expect(realtorLabels).not.toContain("Équipe");
+		expect(matchPages("contacts", "realtor")).toEqual([]);
+	});
+
+	it("gives every page a French label in the breadcrumb", () => {
+		expect(SEGMENT_LABELS.realtors).toBe("Courtiers");
+		expect(SEGMENT_LABELS.new).toBe("Nouveau");
+		expect(SEGMENT_LABELS.tracking).toBe("Suivi et analyses");
+		expect(SEGMENT_LABELS["realtor-calendar"]).toBe("Google Agenda");
+	});
+});
+
+describe("what teammates see about the page you are on", () => {
+	it("names the page without exposing a prospect", () => {
+		expect(presenceLabel([])).toBe("Accueil");
+		expect(presenceLabel(["real-estate", "inbox"])).toBe("Boîte de réception");
+		expect(presenceLabel(["real-estate", "leads", "cmabc123"])).toBe(
+			"Fiche d'un prospect",
+		);
+		expect(presenceLabel(["real-estate", "leads"])).toBe("Prospects");
+		expect(presenceLabel(["settings", "connections", "twilio"])).toBe(
+			"SMS Twilio",
+		);
+		expect(presenceLabel(["something-unknown"])).toBe("Fratex");
+	});
+});
