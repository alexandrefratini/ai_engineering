+		expect(model?.metrics[0]?.hint).toBe("38 contactés");
+		expect(plain(model?.metrics[1]?.hint ?? null)).toBe(
+			"92,5 % en 5 min ou moins",
+		);
+		expect(model?.metrics[2]?.hint).toBe("4 réalisés");
+		expect(model?.metrics[3]?.hint).toBe("12 qualifiés sur 40");
+		expect(model?.realtors).toEqual([]);
+		expect(plain(model?.range ?? null)).toBe("22 sept. – 22 oct.");
+	});
+
+	it("shows a dash for each null figure", () => {
+		const model = performanceResultOf({
+			...output,
+			leadsReceived: 0,
+			contacted: 0,
+			medianFirstResponseMinutes: null,
+			respondedWithinFiveMinutesPct: null,
+			qualified: 0,
+			conversionPct: null,
+			appointmentsBooked: 0,
+			appointmentsHeld: 1,
+		});
+		const response = model?.metrics.find((metric) => metric.id === "response");
+		const conversion = model?.metrics.find(
+			(metric) => metric.id === "conversion",
+		);
+		expect(response?.value).toBe("—");
+		expect(response?.hint).toBeNull();
+		expect(conversion?.value).toBe("—");
+		expect(conversion?.hint).toBe("0 qualifié sur 0");
+		expect(model?.metrics[2]?.hint).toBe("1 réalisé");
+	});
+
+	it("lists the figures of each realtor", () => {
+		const model = performanceResultOf({
+			...output,
+			byRealtor: [
+				{ clientId: "client-1", realtor: "Marie Côté", ...figures },
+				{
+					clientId: null,
+					realtor: "Non assigné",
+					...figures,
+					medianFirstResponseMinutes: null,
+					conversionPct: null,
+				},
+			],
+		});
+		expect(model?.realtors).toHaveLength(2);
+		expect(model?.realtors[0]).toMatchObject({
+			id: "client-1",
+			name: "Marie Côté",
+			leads: "40",
+			appointments: "7",
+		});
+		expect(model?.realtors[1]).toMatchObject({
+			firstResponse: "—",
+			conversion: "—",
+		});
+	});
+
+	it("rejects an output without figures", () => {
+		expect(performanceResultOf(null)).toBeNull();
+		expect(performanceResultOf({ period: {} })).toBeNull();
+	});
+});
+
+describe("workspace links", () => {
+	it("prefixes a fiche path with the workspace slug", () => {
+		expect(workspacePath("crm", fiche("lead-1"))).toBe(
+			"/crm/real-estate/leads/lead-1?agencyId=agency-1",
+		);
+	});
+
+	it("keeps a path that already has the slug or is external", () => {
+		expect(workspacePath("crm", "/crm/real-estate/leads/x")).toBe(
+			"/crm/real-estate/leads/x",
+		);
+		expect(workspacePath("crm", "https://example.com/a")).toBe(
+			"https://example.com/a",
+		);
+		expect(workspacePath("crm", "//example.com/a")).toBe("//example.com/a");
+	});
+
+	it("prefixes markdown links to the real estate area only", () => {
+		const markdown = [
+			`[Marie](${fiche("lead-1")}) et [Luc](</real-estate/leads/lead-2>)`,
+			"[Déjà](/crm/real-estate/leads/x) [Externe](https://example.com/real-estate/y)",
+			"[Autre](/chat) /real-estate/leads/z",
+		].join("\n");
+		expect(workspaceMarkdown(markdown, "crm")).toBe(
+			[
+				"[Marie](/crm/real-estate/leads/lead-1?agencyId=agency-1) et [Luc](</crm/real-estate/leads/lead-2>)",
+				"[Déjà](/crm/real-estate/leads/x) [Externe](https://example.com/real-estate/y)",
+				"[Autre](/chat) /real-estate/leads/z",
+			].join("\n"),
+		);
+	});
+
+	it("does not touch a route that only starts with the same letters", () => {
+		expect(workspaceMarkdown("[a](/real-estates/x)", "crm")).toBe(
+			"[a](/real-estates/x)",
+		);
+	});
+});
+
+describe("stamps", () => {
+	it("formats a local stamp", () => {
+		expect(plain(stampDateTime("2026-10-22 09:05"))).toBe("22 oct., 9 h 05");
+		expect(stampDateTime("not a date")).toBeNull();
+		expect(stampDateTime(null)).toBeNull();
+	});
+});
diff --git a/apps/app/lib/agent-prospect-results.ts b/apps/app/lib/agent-prospect-results.ts
new file mode 100644
index 0000000..045263d
--- /dev/null
+++ b/apps/app/lib/agent-prospect-results.ts
@@ -0,0 +1,501 @@
+import type {
+	AppointmentListData,
+	AppointmentRowData,
+	PerformanceData,
+	ProspectDetailData,
+	ProspectListData,
+	ResultStatus,
+} from "@crm/ui/components/assistant-result-cards";
+import { LEAD_STATUS_OPTIONS } from "@crm/ui/components/lead-status-badge";
+import { APP_LOCALE } from "@crm/ui/lib/format";
+import {
+	APPOINTMENT_STATUS_LABELS,
+	formatDuration,
+	formatPhone,
+	formatRate,
+} from "@crm/ui/lib/real-estate";
+import type { EveToolOutput } from "@crm/validation/eve-tool";
+import { z } from "zod";
+import {
+	ATTENTION_COUNTS,
+	CONFIRMED_CRITERION,
+	EMPTY_FIGURE,
+	UNASSIGNED_REALTOR,
+	UPCOMING_RANGE,
+	WORKSPACE_LINK_ROUTES,
+} from "./agent-prospect-config";
+import { workspaceUrl } from "./workspace-url";
+
+const text = z.string().min(1);
+
+const optionalText = z.string().min(1).nullable().catch(null);
+
+const count = z.number().int().nonnegative().catch(0);
+
+const figure = z
+	.number()
+	.refine((value) => Number.isFinite(value))
+	.nullable()
+	.catch(null);
+
+const attentionRow = z.object({
+	id: text,
+	name: z.string().catch(""),
+	status: z.string().catch(""),
+	reasons: z.array(z.string()).catch([]),
+	since: optionalText,
+	lastReply: optionalText,
+	realtor: optionalText,
+	fiche: text,
+});
+
+const attentionOutput = z.object({
+	total: count,
+	counts: z
+		.object({
+			unread: count,
+			humanTakeover: count,
+			neverContacted: count,
+		})
+		.catch({ unread: 0, humanTakeover: 0, neverContacted: 0 }),
+	prospects: z.array(attentionRow),
+});
+
+const searchRow = z.object({
+	id: text,
+	name: z.string().catch(""),
+	phone: optionalText,
+	email: optionalText,
+	status: z.string().catch(""),
+	realtor: optionalText,
+	received: optionalText,
+	lastActivity: optionalText,
+	fiche: text,
+});
+
+const searchOutput = z.object({
+	total: count,
+	prospects: z.array(searchRow),
+});
+
+const appointmentRow = z.object({
+	id: text,
+	prospect: z.string().catch(""),
+	start: optionalText,
+	end: optionalText,
+	status: z.string().catch(""),
+	title: optionalText,
+	realtor: optionalText,
+	fiche: text,
+});
+
+const appointmentsOutput = z.object({
+	range: z.string().catch(""),
+	days: count,
+	total: count,
+	appointments: z.array(appointmentRow),
+});
+
+const detailAppointment = z.object({
+	id: text,
+	title: optionalText,
+	start: optionalText,
+	end: optionalText,
+	status: z.string().catch(""),
+	realtor: optionalText,
+});
+
+const detailCriterion = z.object({
+	criterion: text,
+	value: text,
+	status: z.string().catch(""),
+	quote: optionalText,
+});
+
+const detailOutput = z.object({
+	id: text,
+	name: z.string().catch(""),
+	phone: optionalText,
+	email: optionalText,
+	status: z.string().catch(""),
+	realtor: optionalText,
+	received: optionalText,
+	lastActivity: optionalText,
+	score: figure,
+	criteria: z.array(detailCriterion).catch([]),
+	toConfirm: z.array(z.string()).catch([]),
+	appointments: z.array(detailAppointment).catch([]),
+	consent: z.object({ sms: z.string().catch("") }).catch({ sms: "" }),
+	fiche: text,
+});
+
+const metrics = {
+	leadsReceived: z.number().int().nonnegative(),
+	contacted: count,
+	medianFirstResponseMinutes: figure,
+	respondedWithinFiveMinutesPct: figure,
+	qualified: count,
+	conversionPct: figure,
+	appointmentsBooked: count,
+	appointmentsHeld: count,
+};
+
+const performanceOutput = z.object({
+	period: z
+		.object({
+			label: z.string().catch(""),
+			from: optionalText,
+			to: optionalText,
+		})
+		.catch({ label: "", from: null, to: null }),
+	...metrics,
+	byRealtor: z
+		.array(
+			z.object({
+				clientId: z.string().nullable().catch(null),
+				realtor: z.string().catch(UNASSIGNED_REALTOR),
+				...metrics,
+			}),
+		)
+		.nullish()
+		.catch(null),
+});
+
+const STATUS_IDS = new Map<string, string>(
+	LEAD_STATUS_OPTIONS.flatMap((option) => [
+		[option.id, option.id] as const,
+		[option.name, option.id] as const,
+	]),
+);
+
+const APPOINTMENT_STATUS_IDS = new Map<string, string>(
+	Object.entries(APPOINTMENT_STATUS_LABELS).flatMap(([id, label]) => [
+		[id, id] as const,
+		[label, id] as const,
+	]),
+);
+
+const dayFormat = new Intl.DateTimeFormat(APP_LOCALE, {
+	timeZone: "UTC",
+	weekday: "short",
+	day: "numeric",
+	month: "short",
+});
+
+const dateFormat = new Intl.DateTimeFormat(APP_LOCALE, {
+	timeZone: "UTC",
+	day: "numeric",
+	month: "short",
+});
+
+const STAMP = /^(\d{4})-(\d{2})-(\d{2})(?: (\d{2}):(\d{2}))?$/;
+
+type Stamp = { date: Date; time: string | null };
+
+function parseStamp(value: string | null): Stamp | null {
+	const match = value ? STAMP.exec(value) : null;
+	if (!match) return null;
+	const [, year, month, day, hour, minute] = match;
+	const date = new Date(Date.UTC(Number(year), Number(month) - 1, Number(day)));
+	if (Number.isNaN(date.getTime())) return null;
+	return {
+		date,
+		time: hour && minute ? `${Number(hour)}\u00a0h\u00a0${minute}` : null,
+	};
+}
+
+export function stampDate(value: string | null): string | null {
+	const stamp = parseStamp(value);
+	return stamp ? dateFormat.format(stamp.date) : null;
+}
+
+export function stampDateTime(value: string | null): string | null {
+	const stamp = parseStamp(value);
+	if (!stamp) return null;
+	const date = dateFormat.format(stamp.date);
+	return stamp.time ? `${date}, ${stamp.time}` : date;
+}
+
+function stampDay(value: string | null): string | null {
+	const stamp = parseStamp(value);
+	return stamp ? dayFormat.format(stamp.date) : null;
+}
+
+function stampTime(value: string | null): string | null {
+	return parseStamp(value)?.time ?? null;
+}
+
+function timeRange(start: string | null, end: string | null): string {
+	const from = stampTime(start);
+	const to = stampTime(end);
+	if (from && to) return `${from} – ${to}`;
+	return from ?? EMPTY_FIGURE;
+}
+
+function plural(value: number, one: string, many: string = `${one}s`): string {
+	return value > 1 ? many : one;
+}
+
+function labelled(prefix: string, value: string | null): string | null {
+	return value ? `${prefix} ${value}` : null;
+}
+
+function prospectStatus(value: string): ResultStatus {
+	return { id: STATUS_IDS.get(value) ?? null, label: value || EMPTY_FIGURE };
+}
+
+function appointmentStatus(value: string): ResultStatus {
+	return {
+		id: APPOINTMENT_STATUS_IDS.get(value) ?? null,
+		label: value || EMPTY_FIGURE,
+	};
+}
+
+function joined(parts: (string | null | false)[]): string | null {
+	const kept = parts.filter((part): part is string => Boolean(part));
+	return kept.length > 0 ? kept.join(" · ") : null;
+}
+
+function nameOf(value: string): string {
+	return value.trim() || "Prospect sans nom";
+}
+
+export function attentionResultOf(
+	output: EveToolOutput,
+): ProspectListData | null {
+	const parsed = attentionOutput.safeParse(output);
+	if (!parsed.success) return null;
+	const { total, counts, prospects } = parsed.data;
+	const summary = joined(
+		ATTENTION_COUNTS.flatMap(({ key, label, plural: many }) =>
+			counts[key] > 0
+				? [`${counts[key]} ${plural(counts[key], label, many)}`]
+				: [],
+		),
+	);
+
+	return {
+		title:
+			total === 0
+				? "Aucun prospect n'attend d'action"
+				: `${total} ${plural(total, "prospect attend", "prospects attendent")} une action`,
+		counts: summary,
+		more: Math.max(0, total - prospects.length),
+		rows: prospects.map((row) => ({
+			id: row.id,
+			name: nameOf(row.name),
+			status: prospectStatus(row.status),
+			realtor: row.realtor ?? UNASSIGNED_REALTOR,
+			contact: null,
+			detail: joined([
+				row.reasons.join(", "),
+				labelled("depuis le", stampDateTime(row.since)),
+			]),
+			quote: row.lastReply,
+			fiche: row.fiche,
+		})),
+	};
+}
+
+export function searchResultOf(output: EveToolOutput): ProspectListData | null {
+	const parsed = searchOutput.safeParse(output);
+	if (!parsed.success) return null;
+	const { total, prospects } = parsed.data;
+
+	return {
+		title:
+			total === 0
+				? "Aucun prospect trouvé"
+				: `${total} ${plural(total, "prospect trouvé", "prospects trouvés")}`,
+		counts: null,
+		more: Math.max(0, total - prospects.length),
+		rows: prospects.map((row) => ({
+			id: row.id,
+			name: nameOf(row.name),
+			status: prospectStatus(row.status),
+			realtor: row.realtor ?? UNASSIGNED_REALTOR,
+			contact: joined([row.phone ? formatPhone(row.phone) : null, row.email]),
+			detail: joined([
+				labelled("reçu le", stampDate(row.received)),
+				labelled("activité le", stampDate(row.lastActivity)),
+			]),
+			quote: null,
+			fiche: row.fiche,
+		})),
+	};
+}
+
+function appointmentRowOf(
+	row: z.infer<typeof appointmentRow>,
+): AppointmentRowData {
+	return {
+		id: row.id,
+		prospect: nameOf(row.prospect),
+		day: stampDay(row.start) ?? EMPTY_FIGURE,
+		time: timeRange(row.start, row.end),
+		status: appointmentStatus(row.status),
+		realtor: row.realtor ?? UNASSIGNED_REALTOR,
+		title: row.title,
+		fiche: row.fiche,
+	};
+}
+
+export function appointmentsResultOf(
+	output: EveToolOutput,
+): AppointmentListData | null {
+	const parsed = appointmentsOutput.safeParse(output);
+	if (!parsed.success) return null;
+	const { range, days, total, appointments } = parsed.data;
+	const upcoming = range === UPCOMING_RANGE;
+	const when = upcoming ? "à venir" : plural(total, "passé");
+
+	return {
+		title:
+			total === 0
+				? `Aucun rendez-vous ${upcoming ? "à venir" : "passé"}`
+				: `${total} rendez-vous ${when}`,
+		scope: `${days} ${upcoming ? plural(days, "prochain jour", "prochains jours") : plural(days, "dernier jour", "derniers jours")}`,
+		more: Math.max(0, total - appointments.length),
+		rows: appointments.map(appointmentRowOf),
+	};
+}
+
+export function prospectDetailOf(
+	output: EveToolOutput,
+): ProspectDetailData | null {
+	const parsed = detailOutput.safeParse(output);
+	if (!parsed.success) return null;
+	const lead = parsed.data;
+
+	return {
+		id: lead.id,
+		name: nameOf(lead.name),
+		status: prospectStatus(lead.status),
+		realtor: lead.realtor ?? UNASSIGNED_REALTOR,
+		facts: [
+			{
+				label: "Téléphone",
+				value: lead.phone ? formatPhone(lead.phone) : EMPTY_FIGURE,
+			},
+			{ label: "Courriel", value: lead.email ?? EMPTY_FIGURE },
+			{
+				label: "Reçu",
+				value: stampDateTime(lead.received) ?? EMPTY_FIGURE,
+			},
+			{
+				label: "Dernière activité",
+				value: stampDateTime(lead.lastActivity) ?? EMPTY_FIGURE,
+			},
+			{
+				label: "Score",
+				value: lead.score === null ? EMPTY_FIGURE : String(lead.score),
+			},
+		],
+		criteria: lead.criteria.map((item) => ({
+			label: item.criterion,
+			value: item.value,
+			confirmed: item.status === CONFIRMED_CRITERION,
+			quote: item.quote,
+		})),
+		toConfirm: lead.toConfirm,
+		appointments: lead.appointments.map((item) =>
+			appointmentRowOf({ ...item, prospect: lead.name, fiche: lead.fiche }),
+		),
+		consent: lead.consent.sms || EMPTY_FIGURE,
+		fiche: lead.fiche,
+	};
+}
+
+function minutesText(value: number | null): string {
+	return value === null ? EMPTY_FIGURE : formatDuration(value);
+}
+
+function rateText(value: number | null): string {
+	return value === null ? EMPTY_FIGURE : formatRate(value);
+}
+
+function performanceMetrics(
+	data: z.infer<typeof performanceOutput>,
+): PerformanceData["metrics"] {
+	return [
+		{
+			id: "leads",
+			label: "Prospects reçus",
+			value: String(data.leadsReceived),
+			hint: `${data.contacted} ${plural(data.contacted, "contacté")}`,
+		},
+		{
+			id: "response",
+			label: "Première réponse (médiane)",
+			value: minutesText(data.medianFirstResponseMinutes),
+			hint:
+				data.respondedWithinFiveMinutesPct === null
+					? null
+					: `${rateText(data.respondedWithinFiveMinutesPct)} en 5 min ou moins`,
+		},
+		{
+			id: "appointments",
+			label: "Rendez-vous",
+			value: String(data.appointmentsBooked),
+			hint: `${data.appointmentsHeld} ${plural(data.appointmentsHeld, "réalisé")}`,
+		},
+		{
+			id: "conversion",
+			label: "Conversion",
+			value: rateText(data.conversionPct),
+			hint: `${data.qualified} ${plural(data.qualified, "qualifié")} sur ${data.leadsReceived}`,
+		},
+	];
+}
+
+export function performanceResultOf(
+	output: EveToolOutput,
+): PerformanceData | null {
+	const parsed = performanceOutput.safeParse(output);
+	if (!parsed.success) return null;
+	const data = parsed.data;
+	const from = stampDate(data.period.from);
+	const to = stampDate(data.period.to);
+
+	return {
+		title: data.period.label
+			? `Performance · ${data.period.label.toLowerCase()}`
+			: "Performance",
+		range: from && to ? `${from} – ${to}` : EMPTY_FIGURE,
+		metrics: performanceMetrics(data),
+		realtors: (data.byRealtor ?? []).map((row, index) => ({
+			id: row.clientId ?? `unassigned-${index}`,
+			name: row.realtor,
+			leads: String(row.leadsReceived),
+			firstResponse: minutesText(row.medianFirstResponseMinutes),
+			appointments: String(row.appointmentsBooked),
+			conversion: rateText(row.conversionPct),
+		})),
+	};
+}
+
+export function workspacePath(slug: string, path: string): string {
+	if (!path.startsWith("/") || path.startsWith("//")) return path;
+	const prefix = `/${slug}`;
+	if (
+		path === prefix ||
+		path.startsWith(`${prefix}/`) ||
+		path.startsWith(`${prefix}?`)
+	) {
+		return path;
+	}
+	return workspaceUrl(slug, path);
+}
+
+const MARKDOWN_LINK = new RegExp(
+	`\\]\\((<?)(${WORKSPACE_LINK_ROUTES.map((route) => route.replace(/\//g, "\\/")).join("|")}(?=[/?#)>\\s])[^)\\s>]*)`,
+	"g",
+);
+
+export function workspaceMarkdown(markdown: string, slug: string): string {
+	return markdown.replace(
+		MARKDOWN_LINK,
+		(_match, bracket: string, target: string) =>
+			`](${bracket}${workspacePath(slug, target)}`,
+	);
+}
