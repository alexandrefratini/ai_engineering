+import { describe, expect, it } from "bun:test";
+import {
+	mailtoLink,
+	phoneDigits,
+	telLink,
+	whatsappLink,
+} from "@crm/ui/lib/contact-channels";
+
+describe("contact channel links", () => {
+	it("keeps only the digits of a phone number for WhatsApp", () => {
+		expect(phoneDigits("+1 (514) 555-0301")).toBe("15145550301");
+	});
+
+	it("builds a WhatsApp link with an encoded greeting", () => {
+		const link = whatsappLink("+15145550301", "Karim");
+
+		expect(link.startsWith("https://wa.me/15145550301?text=")).toBe(true);
+		expect(decodeURIComponent(link.split("text=")[1] ?? "")).toContain(
+			"Bonjour Karim",
+		);
+	});
+
+	it("builds call and email links", () => {
+		expect(telLink("+15145550301")).toBe("tel:+15145550301");
+		expect(mailtoLink("karim@example.ca")).toBe(
+			"mailto:karim@example.ca?subject=Votre%20projet%20immobilier",
+		);
+	});
+});
