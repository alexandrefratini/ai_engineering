@@ -0,0 +1,61 @@
+"use client";
+
+import { TeamPresence } from "@crm/ui/components/team-presence";
+import { useMutation, useQuery, useQueryClient } from "@tanstack/react-query";
+import Link from "next/link";
+import { usePathname } from "next/navigation";
+import { useEffect } from "react";
+import { presenceLabel } from "@/lib/navigation";
+import { PRESENCE } from "@/lib/presence-config";
+import { useTRPC } from "@/lib/trpc/client";
+import { useWorkspaceUrl } from "@/lib/use-workspace-url";
+
+export function TeamPresenceControl() {
+	const trpc = useTRPC();
+	const cache = useQueryClient();
+	const href = useWorkspaceUrl();
+	const pathname = usePathname();
+	const segments = pathname.split("/").filter(Boolean).slice(1);
+	const path = `/${segments.join("/")}`;
+	const label = presenceLabel(segments);
+	const team = useQuery(
+		trpc.presence.team.queryOptions(undefined, {
+			refetchInterval: PRESENCE.refreshMs,
+		}),
+	);
+	const { mutate } = useMutation(
+		trpc.presence.heartbeat.mutationOptions({
+			onSuccess: () => cache.invalidateQueries(trpc.presence.team.pathFilter()),
+		}),
+	);
+
+	useEffect(() => {
+		const beat = () => {
+			if (document.visibilityState === "visible") mutate({ path, label });
+		};
+		beat();
+		const timer = window.setInterval(beat, PRESENCE.heartbeatMs);
+		document.addEventListener("visibilitychange", beat);
+		return () => {
+			window.clearInterval(timer);
+			document.removeEventListener("visibilitychange", beat);
+		};
+	}, [mutate, path, label]);
+
+	if (!team.data) return null;
+
+	return (
+		<TeamPresence
+			onlineCount={team.data.onlineCount}
+			members={team.data.members.map((member) => ({
+				...member,
+				lastSeenAt: member.lastSeenAt
+					? new Date(member.lastSeenAt).toISOString()
+					: null,
+			}))}
+			renderPageLink={(page) => (
+				<Link href={href(page.path)}>{page.label}</Link>
+			)}
+		/>
+	);
+}
