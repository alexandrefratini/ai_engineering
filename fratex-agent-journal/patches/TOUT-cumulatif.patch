+"use client";
+
+import { formatDateTime } from "../lib/real-estate";
+import { Button } from "./button";
+
+export type SessionItem = {
+	id: string;
+	device: string;
+	lastActiveAt: string;
+	current: boolean;
+};
+
+export function SessionList({
+	sessions,
+	pendingId,
+	onRevoke,
+	onRevokeOthers,
+	revokingOthers,
+}: {
+	sessions: SessionItem[];
+	pendingId: string | null;
+	onRevoke: (id: string) => void;
+	onRevokeOthers: () => void;
+	revokingOthers: boolean;
+}) {
+	const others = sessions.filter((session) => !session.current).length;
+	return (
+		<div className="flex flex-col gap-3">
+			<ul className="-my-1 flex flex-col divide-y">
+				{sessions.map((session) => (
+					<li key={session.id} className="flex items-center gap-3 py-3 text-sm">
+						<span
+							aria-hidden="true"
+							className={session.current ? "size-2 shrink-0 rounded-full bg-success" : "size-2 shrink-0 rounded-full bg-muted-foreground/40"}
+						/>
+						<span className="flex min-w-0 flex-1 flex-col">
+							<span className="truncate font-medium">
+								{session.device}
+								{session.current && <span className="font-normal text-muted-foreground"> · cet appareil</span>}
+							</span>
+							<span className="text-xs text-muted-foreground">Dernière activité : {formatDateTime(session.lastActiveAt)}</span>
+						</span>
+						{!session.current && (
+							<Button variant="outline" size="sm" disabled={pendingId === session.id} onClick={() => onRevoke(session.id)}>
+								Déconnecter
+							</Button>
+						)}
+					</li>
+				))}
+			</ul>
+			{others > 0 && (
+				<Button variant="outline" className="self-start" disabled={revokingOthers} onClick={onRevokeOthers}>
+					Déconnecter les {others} autres appareils
+				</Button>
+			)}
+		</div>
+	);
+}
