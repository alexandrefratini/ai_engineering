+"use client";
+
+import { type ReactNode, useState } from "react";
+import { REVEAL, staggerStyle } from "../lib/motion";
+import {
+	APPOINTMENT_STATUS_LABELS,
+	consentSourceLabel,
+	ESCALATION_LABELS,
+	EVENT_LABELS,
+	INTENT_LABELS,
+	LANGUAGE_LABELS,
+	LEAD_JOURNEY,
+	LEAD_SOURCE_LABELS,
+	MESSAGE_STATUS_LABELS,
+	OFF_JOURNEY_LABELS,
+	QUALIFICATION_CRITERIA,
+	formatBudget,
+	formatCad,
+	formatDateTime,
+	formatDuration,
+	formatDate,
+	formatPhone,
+	formatTime,
+	labelOf,
+} from "../lib/real-estate";
+import { cn } from "../lib/utils";
+import { Badge } from "./badge";
+import { Button } from "./button";
+import { Card, CardAction, CardContent, CardDescription, CardHeader, CardTitle } from "./card";
+import { Collapsible, CollapsibleContent, CollapsibleTrigger } from "./collapsible";
+import { Field, FieldLabel } from "./field";
+import { Input } from "./input";
+import { LeadStatusBadge } from "./lead-status-badge";
+import { LeadJourney, MetricGrid, MetricTile, ScoreRing, SegmentMeter, InfoHint } from "./real-estate-visuals";
+import { WorkspaceNotice, WorkspaceSelect } from "./real-estate-workspace";
+import { SourcedValue, SOURCED_VALUE } from "./sourced-value";
+import { ContactLink } from "./contact-link";
+import { Panel as LeadPanel } from "./panel";
+import { LAYOUT } from "../lib/layout";
+
+export type LeadProfileLead = {
+	firstName: string;
+	lastName: string | null;
+	phone: string;
+	email: string | null;
+	status: string;
+	score: number;
+	intent: string;
+	propertyType: string | null;
+	budgetMin: number | null;
+	budgetMax: number | null;
+	targetArea: string | null;
+	timeline: string | null;
+	financing: string | null;
+	currentSituation: string | null;
+	qualificationSummary: string | null;
+	language: string;
+	clientName: string | null;
+	consentedAt: string | null;
+	consentSource: string | null;
+	unsubscribedAt: string | null;
+	automationPausedAt: string | null;
+	escalationReason: string | null;
+	firstContactedAt: string | null;
+	lastInteractedAt: string | null;
+	createdAt: string;
+	campaignName: string | null;
+	formName: string | null;
+	source: string | null;
+	property: {
+		minBedrooms: number | null;
+		minBathrooms: number | null;
+		mustHaveParking: boolean;
+		specificNotes: string | null;
+	} | null;
+};
+
+export type LeadProfileEvidence = { field: string; quote: string };
+
+export type LeadProfileListing = {
+	url: string;
+	address: string | null;
+	askingPrice: number | null;
+	bedrooms: number | null;
+	bathrooms: number | null;
+};
+
+export type LeadProfileEvent = {
+	id: string;
+	eventType: string;
+	occurredAt: string;
+};
+
+export type LeadProfileAppointment = {
+	id: string;
+	title: string;
+	startTime: string;
+	status: string;
+	clientName: string;
+	description?: string | null;
+};
+
+export type AppointmentOutcome = "CONFIRMED" | "COMPLETED" | "NO_SHOW" | "CANCELLED";
+
+export type NewAppointment = {
+	title: string;
+	startTime: string;
+	durationMinutes: number;
+	location?: string;
+};
+
+export type LeadProfileMessage = {
+	id: string;
+	sender: "LEAD" | "AI_SDR" | "HUMAN_AGENT" | "SYSTEM";
+	content: string;
+	sentAt: string;
+	status: string;
+};
+
+const SENDER_LABELS: Record<LeadProfileMessage["sender"], string> = {
+	LEAD: "Prospect",
+	AI_SDR: "Assistant IA",
+	HUMAN_AGENT: "Courtier",
+	SYSTEM: "Système",
+};
+
+const SENDER_DOT: Record<LeadProfileMessage["sender"], string> = {
+	LEAD: "bg-foreground",
+	AI_SDR: "bg-primary",
+	HUMAN_AGENT: "bg-primary/50",
+	SYSTEM: "bg-muted-foreground/40",
+};
+
+const FAILED_MESSAGE_STATUSES = new Set(["FAILED", "REFUSED", "CANCELLED"]);
+
+const UPCOMING_STATUSES = new Set(["SCHEDULED", "CONFIRMED", "RESCHEDULED"]);
+
+type CriterionField = (typeof QUALIFICATION_CRITERIA)[number]["field"];
+
+function criterionValue(lead: LeadProfileLead, field: CriterionField): string | null {
+	if (field === "intent") return lead.intent === "UNKNOWN" ? null : labelOf(INTENT_LABELS, lead.intent);
+	if (field === "budget") return formatBudget(lead.budgetMin, lead.budgetMax);
+	return lead[field];
+}
+
+function evidenceFor(evidence: LeadProfileEvidence[], field: CriterionField) {
+	const matches = evidence.filter((item) =>
+		field === "budget" ? item.field === "budgetMin" || item.field === "budgetMax" : item.field === field,
+	);
+	return [...new Set(matches.map((item) => item.quote))];
+}
+
+function minutesBetween(start: string, end: string) {
+	return (new Date(end).getTime() - new Date(start).getTime()) / 60000;
+}
+
+function plural(count: number, one: string, many: string) {
+	return `${count} ${count > 1 ? many : one}`;
+}
+
+function listingHost(url: string) {
+	try {
+		return new URL(url).hostname.replace(/^www\./, "");
+	} catch {
+		return url;
+	}
+}
+
+function Muted({ children }: { children: ReactNode }) {
+	return <span className="text-sm text-muted-foreground">{children}</span>;
+}
+
+function PanelEmpty({ title, children }: { title: string; children: ReactNode }) {
+	return (
+		<div className="flex flex-col items-center justify-center gap-0.5 rounded-lg border border-dashed px-4 py-6 text-center">
+			<span className="text-sm font-medium">{title}</span>
+			<span className="max-w-sm text-pretty text-xs text-muted-foreground">{children}</span>
+		</div>
+	);
+}
+
+function Dot({ className }: { className: string }) {
+	return <span aria-hidden="true" className={cn("size-2 shrink-0 rounded-full", className)} />;
+}
+
+function Facts({ items }: { items: { label: string; value: ReactNode }[] }) {
+	return (
+		<dl className="grid grid-cols-[8rem_minmax(0,1fr)] gap-x-4 gap-y-2 text-sm">
+			{items.map((item) => (
+				<div key={item.label} className="contents">
+					<dt className="text-muted-foreground">{item.label}</dt>
+					<dd className="min-w-0 break-words">{item.value}</dd>
+				</div>
+			))}
+		</dl>
+	);
+}
+
+export function LeadProfileHeader({ lead, actions }: { lead: LeadProfileLead; actions: ReactNode }) {
+	const offJourney = OFF_JOURNEY_LABELS[lead.status];
+	return (
+		<header className={cn("flex flex-col gap-4 rounded-lg border bg-card p-4", REVEAL)}>
+			<div className="flex flex-col gap-3 md:flex-row md:items-center md:justify-between">
+				<div className="flex min-w-0 items-center gap-3">
+					<ScoreRing value={lead.score} label="Score de qualification" />
+					<div className="flex min-w-0 flex-col gap-1">
+						<div className="flex min-w-0 flex-wrap items-center gap-2">
+							<h2 translate="no" className="truncate text-lg font-medium tracking-tight">
+								{lead.firstName} {lead.lastName ?? ""}
+							</h2>
+							<LeadStatusBadge status={lead.status} />
+							<Badge variant="outline">{labelOf(INTENT_LABELS, lead.intent)}</Badge>
+							{lead.automationPausedAt && (
+								<span className="flex items-center gap-1.5 text-xs text-muted-foreground">
