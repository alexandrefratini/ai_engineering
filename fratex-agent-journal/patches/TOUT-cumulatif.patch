@@ -0,0 +1,91 @@
+function zonedParts(value: Date, timeZone: string) {
+	const parts = new Intl.DateTimeFormat("en-CA", {
+		timeZone,
+		year: "numeric",
+		month: "2-digit",
+		day: "2-digit",
+		hour: "2-digit",
+		minute: "2-digit",
+		second: "2-digit",
+		hourCycle: "h23",
+	}).formatToParts(value);
+	const read = (type: Intl.DateTimeFormatPartTypes) =>
+		Number(parts.find((part) => part.type === type)?.value ?? 0);
+	return {
+		year: read("year"),
+		month: read("month"),
+		day: read("day"),
+		hour: read("hour"),
+		minute: read("minute"),
+		second: read("second"),
+	};
+}
+
+function offsetMs(value: Date, timeZone: string): number {
+	const parts = zonedParts(value, timeZone);
+	const wall = Date.UTC(
+		parts.year,
+		parts.month - 1,
+		parts.day,
+		parts.hour,
+		parts.minute,
+		parts.second,
+	);
+	return wall - Math.floor(value.getTime() / 1000) * 1000;
+}
+
+export function zonedDayKey(value: Date, timeZone: string): string {
+	const parts = zonedParts(value, timeZone);
+	return `${parts.year}-${String(parts.month).padStart(2, "0")}-${String(parts.day).padStart(2, "0")}`;
+}
+
+export function shiftDayKey(day: string, days: number): string {
+	const [year, month, date] = day.split("-").map(Number);
+	return new Date(Date.UTC(year ?? 0, (month ?? 1) - 1, (date ?? 1) + days))
+		.toISOString()
+		.slice(0, 10);
+}
+
+export function zonedMidnight(day: string, timeZone: string): Date {
+	const [year, month, date] = day.split("-").map(Number);
+	const guess = Date.UTC(year ?? 0, (month ?? 1) - 1, date ?? 1);
+	const first = guess - offsetMs(new Date(guess), timeZone);
+	return new Date(guess - offsetMs(new Date(first), timeZone));
+}
+
+export function zonedMonthStart(value: Date, timeZone: string): string {
+	return `${zonedDayKey(value, timeZone).slice(0, 7)}-01`;
+}
+
+export function dayRange(from: string, to: string): string[] {
+	const days: string[] = [];
+	for (let day = from; day <= to; day = shiftDayKey(day, 1)) days.push(day);
+	return days;
+}
+
+export function dailyCounts(
+	values: Date[],
+	days: string[],
+	timeZone: string,
+): { day: string; count: number }[] {
+	const counts = new Map(days.map((day) => [day, 0]));
+	for (const value of values) {
+		const day = zonedDayKey(value, timeZone);
+		const current = counts.get(day);
+		if (current !== undefined) counts.set(day, current + 1);
+	}
+	return days.map((day) => ({ day, count: counts.get(day) ?? 0 }));
+}
+
+export function median(values: number[]): number | null {
+	if (!values.length) return null;
+	const sorted = [...values].sort((a, b) => a - b);
+	const middle = Math.floor(sorted.length / 2);
+	return sorted.length % 2
+		? (sorted[middle] ?? null)
+		: ((sorted[middle - 1] ?? 0) + (sorted[middle] ?? 0)) / 2;
+}
+
+export function percentOf(part: number, total: number): number | null {
+	return total ? Math.round((part / total) * 1000) / 10 : null;
+}
