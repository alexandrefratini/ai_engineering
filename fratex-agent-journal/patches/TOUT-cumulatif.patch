+"use client";
+
+import ArrowDown from "@carbon/icons-react/es/ArrowDown";
+import ArrowLeft from "@carbon/icons-react/es/ArrowLeft";
+import Chat from "@carbon/icons-react/es/Chat";
+import Email from "@carbon/icons-react/es/Email";
+import Forum from "@carbon/icons-react/es/Forum";
+import Launch from "@carbon/icons-react/es/Launch";
+import Search from "@carbon/icons-react/es/Search";
+import SendAlt from "@carbon/icons-react/es/SendAlt";
+import { type ReactNode, useId, useState } from "react";
+import { REVEAL, staggerStyle } from "../lib/motion";
+import {
+	MESSAGE_STATUS_LABELS,
+	dayKey,
+	formatDayHeading,
+	formatPhone,
+	formatShortStamp,
+	formatTime,
+	labelOf,
+} from "../lib/real-estate";
+import { cn } from "../lib/utils";
+import { Bubble, BubbleContent } from "./bubble";
+import { Button } from "./button";
+import { EmptyState } from "./empty-state";
+import { Icon } from "./icon";
+import { InputGroup, InputGroupAddon, InputGroupInput } from "./input-group";
+import { Marker } from "./marker";
+import {
+	MessageScroller,
+	MessageScrollerButton,
+	MessageScrollerContent,
+	MessageScrollerProvider,
+	MessageScrollerViewport,
+} from "./message-scroller";
+import { WorkspaceLoading } from "./real-estate-workspace";
+import { InfoHint } from "./real-estate-visuals";
+import { Tabs, TabsContent, TabsList, TabsTrigger } from "./tabs";
+import { Textarea } from "./textarea";
+import { ContactLink } from "./contact-link";
+
+export const SMS_MAX_LENGTH = 160;
+
+export type InboxStamp = Date | string;
+
+export type InboxFilter = "ALL" | "UNREAD" | "HUMAN";
+
+export type InboxChannel = "SMS" | "EMAIL";
+
+export type InboxSender = "LEAD" | "AI_SDR" | "HUMAN_AGENT" | "SYSTEM";
+
+export type InboxCounts = Record<InboxFilter, number>;
+
+export type InboxConversation = {
+	leadId: string;
+	name: string;
+	phone: string;
+	channel: InboxChannel;
+	preview: string | null;
+	lastSender: InboxSender | null;
+	lastMessageAt: InboxStamp | null;
+	unreadCount: number;
+	humanTakeover: boolean;
+};
+
+export type InboxSmsMessage = {
+	id: string;
+	sender: InboxSender;
+	content: string;
+	sentAt: InboxStamp;
+	status: string;
+	failureCode: string | null;
+};
+
+export type InboxEmail = {
+	id: string;
+	direction: "INBOUND" | "OUTBOUND";
+	fromName: string | null;
+	fromEmail: string;
+	subject: string | null;
+	snippet: string | null;
+	sentAt: InboxStamp;
+	webLink: string | null;
+};
+
+export type ThreadItem =
+	| { kind: "SMS"; id: string; at: InboxStamp; message: InboxSmsMessage }
+	| { kind: "EMAIL"; id: string; at: InboxStamp; email: InboxEmail };
+
+export type ThreadDay<T extends { at: InboxStamp }> = { key: string; at: InboxStamp; items: T[] };
+
+export type SmsAvailability = {
+	canWrite: boolean;
+	consentedAt: InboxStamp | null;
+	unsubscribedAt: InboxStamp | null;
+};
+
+export const INBOX_FILTERS: readonly { id: InboxFilter; label: string }[] = [
+	{ id: "ALL", label: "Tous" },
+	{ id: "UNREAD", label: "Non lus" },
+	{ id: "HUMAN", label: "Reprise humaine" },
+];
+
+export const SENDER_LABELS: Record<InboxSender, string> = {
+	LEAD: "Prospect",
+	AI_SDR: "Assistant IA",
+	HUMAN_AGENT: "Courtier",
+	SYSTEM: "Système",
+};
+
+const CHANNEL_LABELS: Record<InboxChannel, string> = {
+	SMS: "SMS",
+	EMAIL: "Courriel",
+};
+
+const PREVIEW_PREFIX: Partial<Record<InboxSender, string>> = {
+	AI_SDR: "IA : ",
+	HUMAN_AGENT: "Équipe : ",
+};
+
+const BUBBLE_VARIANT = {
+	LEAD: "muted",
+	AI_SDR: "tinted",
+	HUMAN_AGENT: "outline",
+} as const;
+
+const FAILED_STATUSES = new Set(["FAILED", "REFUSED", "CANCELLED"]);
+
+const DELIVERED_STATUSES = new Set(["DELIVERED"]);
+
+const EMPTY_LIST: Record<InboxFilter, { title: string; description: string }> = {
+	ALL: {
+		title: "Aucune conversation",
+		description: "Les échanges avec vos prospects apparaîtront ici dès le premier SMS ou courriel.",
+	},
+	UNREAD: {
+		title: "Tout est lu",
+		description: "Aucun message ne vous attend. Les nouvelles réponses des prospects s'afficheront ici.",
+	},
+	HUMAN: {
+		title: "Aucune reprise humaine",
+		description: "Quand vous prenez la main sur une conversation, elle s'affiche ici. L'assistant reste en pause pour ce prospect.",
+	},
+};
+
+function time(value: InboxStamp): number {
+	const parsed = (value instanceof Date ? value : new Date(value)).getTime();
+	return Number.isNaN(parsed) ? Number.POSITIVE_INFINITY : parsed;
+}
+
+function isoOf(value: InboxStamp): string | undefined {
+	const parsed = time(value);
+	return Number.isFinite(parsed) ? new Date(parsed).toISOString() : undefined;
+}
+
+export function mergeThread(messages: InboxSmsMessage[], emails: InboxEmail[]): ThreadItem[] {
+	const items: ThreadItem[] = [
+		...messages.map((message) => ({ kind: "SMS" as const, id: message.id, at: message.sentAt, message })),
+		...emails.map((email) => ({ kind: "EMAIL" as const, id: email.id, at: email.sentAt, email })),
+	];
+	return items
+		.map((item, order) => ({ item, order, at: time(item.at) }))
+		.sort((a, b) => (a.at === b.at ? a.order - b.order : a.at < b.at ? -1 : 1))
+		.map((entry) => entry.item);
+}
+
+export function groupByDay<T extends { at: InboxStamp }>(items: T[]): ThreadDay<T>[] {
+	const days: ThreadDay<T>[] = [];
+	for (const item of items) {
+		const key = dayKey(item.at);
+		const last = days.at(-1);
+		if (last && last.key === key) last.items.push(item);
+		else days.push({ key, at: item.at, items: [item] });
+	}
+	return days;
+}
+
+export function smsBlockedReason({ canWrite, consentedAt, unsubscribedAt }: SmsAvailability): string | null {
+	if (unsubscribedAt) return "Le prospect a demandé de ne plus recevoir de SMS.";
+	if (!consentedAt) return "Consentement aux SMS absent : confirmez-le avant d'écrire au prospect.";
+	if (!canWrite) return "Votre rôle permet de lire cette conversation, pas d'y répondre.";
+	return null;
+}
+
+export function emailLink(webLink: string | null): { href: string; label: string } | null {
+	if (!webLink) return null;
+	let url: URL;
+	try {
+		url = new URL(webLink);
+	} catch {
+		return null;
+	}
+	if (url.protocol !== "https:") return null;
+	const host = url.hostname.toLowerCase();
+	if (host === "mail.google.com") return { href: url.href, label: "Ouvrir dans Gmail" };
+	if (host.startsWith("outlook.") || host.endsWith(".office.com") || host.endsWith(".office365.com"))
+		return { href: url.href, label: "Ouvrir dans Outlook" };
+	return { href: url.href, label: "Ouvrir le courriel" };
+}
+
+export function conversationPreview(conversation: Pick<InboxConversation, "preview" | "lastSender">): string {
+	const text = conversation.preview?.replace(/\s+/g, " ").trim();
+	if (!text) return "Aucun message";
+	const prefix = conversation.lastSender ? (PREVIEW_PREFIX[conversation.lastSender] ?? "") : "";
+	return `${prefix}${text}`;
+}
+
+function Dot({ className }: { className: string }) {
+	return <span aria-hidden="true" className={cn("size-2 shrink-0 rounded-full", className)} />;
+}
+
+function ChannelIcon({ channel }: { channel: InboxChannel }) {
+	return (
+		<span role="img" aria-label={CHANNEL_LABELS[channel]} title={CHANNEL_LABELS[channel]} className="inline-flex">
+			<Icon icon={channel === "SMS" ? Chat : Email} className="size-3.5" />
+		</span>
+	);
+}
+
+export function InboxShell({
+	list,
+	children,
+	selected,
+	className,
+}: {
+	list: ReactNode;
+	children: ReactNode;
+	selected: boolean;
+	className?: string;
+}) {
+	return (
+		<div
+			className={cn(
+				"grid min-h-[32rem] min-w-0 flex-1 grid-rows-[minmax(0,1fr)] overflow-hidden rounded-lg border bg-card md:grid-cols-[20rem_minmax(0,1fr)]",
+				className,
+			)}
+		>
+			<aside
+				aria-label="Conversations"
+				className={cn("flex min-h-0 min-w-0 flex-col md:border-r", selected && "hidden md:flex")}
+			>
+				{list}
+			</aside>
+			<section
+				aria-label="Conversation"
+				className={cn("flex min-h-0 min-w-0 flex-col", !selected && "hidden md:flex")}
+			>
+				{children}
+			</section>
+		</div>
+	);
+}
+
+export function InboxPlaceholder({ title, description }: { title: string; description?: string }) {
+	return (
+		<div className={cn("flex flex-1 flex-col items-center justify-center gap-1 p-6 text-center", REVEAL)}>
+			<Icon icon={Chat} className="mb-1 size-5 text-muted-foreground" />
+			<p className="text-sm font-medium">{title}</p>
+			{description && <p className="max-w-xs text-xs text-pretty text-muted-foreground">{description}</p>}
+		</div>
+	);
+}
+
+function ConversationRow({
+	conversation,
+	selected,
+	now,
+	index,
+	onSelect,
+}: {
+	conversation: InboxConversation;
+	selected: boolean;
+	now: Date;
+	index: number;
+	onSelect: (leadId: string) => void;
+}) {
+	const unread = conversation.unreadCount > 0;
+	return (
+		<li className={REVEAL} style={staggerStyle(index)}>
+			<button
+				type="button"
+				aria-current={selected ? "true" : undefined}
+				onClick={() => onSelect(conversation.leadId)}
+				className="grid w-full grid-cols-[0.5rem_minmax(0,1fr)_auto] items-center gap-x-2 gap-y-0.5 px-3 py-2.5 text-left transition-colors hover:bg-muted/60 focus-visible:outline-2 focus-visible:-outline-offset-2 focus-visible:outline-ring aria-[current=true]:bg-accent"
+			>
+				<span className="flex justify-center">
+					{unread && (
+						<>
+							<Dot className="bg-primary" />
+							<span className="sr-only">
+								{conversation.unreadCount > 1 ? `${conversation.unreadCount} non lus` : "Non lu"}
+							</span>
+						</>
+					)}
+				</span>
+				<span translate="no" className={cn("truncate text-sm", unread ? "font-semibold" : "font-medium")}>{conversation.name}</span>
+				<span className="flex items-center gap-1.5 text-xs text-muted-foreground">
+					<ChannelIcon channel={conversation.channel} />
+					{conversation.lastMessageAt && (
+						<time dateTime={isoOf(conversation.lastMessageAt)} className="tabular-nums">
+							{formatShortStamp(conversation.lastMessageAt, now)}
+						</time>
+					)}
+				</span>
+				<span aria-hidden="true" />
+				<span className={cn("truncate text-xs", unread ? "text-foreground" : "text-muted-foreground")}>
+					{conversationPreview(conversation)}
+				</span>
+				<span className="flex justify-end">
+					{conversation.humanTakeover && (
+						<span className="flex items-center gap-1 text-[11px] whitespace-nowrap text-foreground">
+							<Dot className="size-1.5 bg-foreground" />
+							Reprise humaine
+						</span>
+					)}
+				</span>
+			</button>
+		</li>
+	);
+}
+
+export function InboxList({
+	conversations,
+	counts,
+	filter,
+	onFilterChange,
+	search,
+	onSearchChange,
+	selectedId,
+	onSelect,
+	now,
+	loading,
+	notice,
+	footer,
+}: {
+	conversations: InboxConversation[];
+	counts: InboxCounts;
+	filter: InboxFilter;
+	onFilterChange: (filter: InboxFilter) => void;
+	search: string;
+	onSearchChange: (value: string) => void;
+	selectedId: string | null;
+	onSelect: (leadId: string) => void;
+	now: Date;
+	loading?: boolean;
+	notice?: ReactNode;
+	footer?: ReactNode;
+}) {
+	const searchId = useId();
+	const query = search.trim();
+	return (
+		<Tabs
+			value={filter}
+			onValueChange={(value) => {
+				const next = INBOX_FILTERS.find((option) => option.id === value);
+				if (next) onFilterChange(next.id);
+			}}
+			className="flex min-h-0 flex-1 flex-col gap-0"
+		>
+			<div className="flex shrink-0 flex-col gap-2 border-b p-3">
+				<label htmlFor={searchId} className="sr-only">
+					Rechercher une conversation
+				</label>
+				<InputGroup>
+					<InputGroupAddon>
+						<Icon icon={Search} className="size-3.5" />
+					</InputGroupAddon>
+					<InputGroupInput
+						id={searchId}
+						type="search"
+						value={search}
+						onChange={(event) => onSearchChange(event.target.value)}
+						placeholder="Nom, téléphone ou message"
+						autoComplete="off"
+					/>
+				</InputGroup>
+				<TabsList className="w-full">
+					{INBOX_FILTERS.map((option) => (
+						<TabsTrigger key={option.id} value={option.id}>
+							{option.label}
+							<span className="tabular-nums text-muted-foreground">{counts[option.id]}</span>
+						</TabsTrigger>
+					))}
+				</TabsList>
+			</div>
+			<TabsContent value={filter} className="flex min-h-0 flex-1 flex-col overflow-y-auto">
+				{notice && <div className="p-3">{notice}</div>}
+				{loading ? (
+					<div className="p-3">
+						<WorkspaceLoading rows={6} />
+					</div>
+				) : conversations.length === 0 ? (
+					!notice && (
+						<EmptyState
+							compact
+							icon={query ? Search : Forum}
+							title={query ? "Aucun résultat" : EMPTY_LIST[filter].title}
+							description={query ? `Aucune conversation pour « ${query} ».` : EMPTY_LIST[filter].description}
+							className="m-3 w-auto border-dashed bg-transparent"
+						/>
+					)
+				) : (
+					<ul className="flex flex-col divide-y">
+						{conversations.map((conversation, index) => (
+							<ConversationRow
+								key={conversation.leadId}
+								conversation={conversation}
+								selected={conversation.leadId === selectedId}
+								now={now}
+								index={index}
+								onSelect={onSelect}
+							/>
+						))}
+					</ul>
+				)}
+				{footer && <div className="flex justify-center p-3">{footer}</div>}
+			</TabsContent>
+		</Tabs>
+	);
+}
+
+export function InboxThreadHeader({
+	name,
+	phone,
+	email,
+	humanTakeover,
+	profileLink,
+	takeoverAction,
+	channels,
+	onBack,
+}: {
+	name: string;
+	phone: string;
+	email?: string | null;
+	humanTakeover: boolean;
+	profileLink?: ReactNode;
+	takeoverAction?: ReactNode;
+	channels?: ReactNode;
+	onBack?: () => void;
+}) {
+	return (
+		<header className="flex shrink-0 flex-wrap items-center justify-between gap-x-3 gap-y-2 border-b px-3 py-2.5">
+			<div className="flex min-w-0 items-center gap-2">
+				{onBack && (
+					<Button variant="ghost" size="icon-sm" className="md:hidden" aria-label="Retour aux conversations" onClick={onBack}>
+						<Icon icon={ArrowLeft} />
+					</Button>
+				)}
+				<div className="flex min-w-0 flex-col gap-0.5">
+					<h2 translate="no" className="truncate text-sm font-medium">{name}</h2>
+					<div className="flex min-w-0 flex-wrap items-center gap-x-3 gap-y-0.5 text-xs text-muted-foreground">
+						<ContactLink kind="phone" value={phone} />
+						{email && <ContactLink kind="email" value={email} className="max-w-56 truncate" />}
+						<span className="flex items-center gap-1.5">
+							<Dot className={humanTakeover ? "bg-foreground" : "bg-primary"} />
+							{humanTakeover ? "Reprise humaine" : "Assistant IA actif"}
+							<InfoHint label="Mode de la conversation">
+								{humanTakeover
+									? "L'assistant IA ne répond plus à ce prospect. Vous menez l'échange jusqu'à ce que vous le rendiez à l'assistant."
+									: "L'assistant IA répond au prospect et le qualifie. Reprenez la main pour écrire vous-même."}
+							</InfoHint>
+						</span>
+					</div>
+				</div>
+			</div>
+			{(profileLink || takeoverAction) && (
+				<div className="flex flex-wrap items-center gap-2">
+					{profileLink}
+					{takeoverAction}
+				</div>
+			)}
+			{channels}
+		</header>
+	);
+}
+
+export function InboxTakeoverButton({
+	paused,
+	disabled,
+	onToggle,
+}: {
+	paused: boolean;
+	disabled?: boolean;
+	onToggle: () => Promise<void>;
+}) {
+	const [busy, setBusy] = useState(false);
+	const [error, setError] = useState<string | null>(null);
+	async function toggle() {
+		setBusy(true);
+		setError(null);
+		try {
+			await onToggle();
+		} catch (failure) {
+			setError(failure instanceof Error ? failure.message : "Modification impossible.");
+		} finally {
+			setBusy(false);
+		}
+	}
+	return (
+		<span className="flex items-center gap-2">
+			{error && (
+				<span role="alert" className="text-xs text-destructive">
+					{error}
+				</span>
+			)}
+			<Button
+				size="sm"
+				variant={paused ? "default" : "outline"}
+				disabled={disabled || busy}
+				onClick={() => {
+					void toggle();
+				}}
+			>
+				{paused ? "Rendre à l'assistant" : "Reprendre la main"}
+			</Button>
+		</span>
+	);
+}
+
+function ItemMeta({
+	channel,
+	label,
+	at,
+	status,
+}: {
+	channel: InboxChannel;
+	label: string;
+	at: InboxStamp;
+	status?: string;
+}) {
+	return (
+		<span className="flex items-center gap-1.5 px-1 text-xs text-muted-foreground">
+			<ChannelIcon channel={channel} />
+			<span className="font-medium text-foreground">{label}</span>
+			<time dateTime={isoOf(at)} className="tabular-nums">
+				{formatTime(at)}
+			</time>
+			{status && (
+				<span
+					className={cn(
+						FAILED_STATUSES.has(status) && "text-destructive",
+						DELIVERED_STATUSES.has(status) && "text-success",
+					)}
+				>
+					· {labelOf(MESSAGE_STATUS_LABELS, status)}
+				</span>
+			)}
+		</span>
+	);
+}
+
+function SmsItem({ message }: { message: InboxSmsMessage }) {
+	if (message.sender === "SYSTEM")
+		return (
+			<li className="flex justify-center px-6">
+				<p className="text-center text-xs text-pretty text-muted-foreground">
+					<span className="font-medium text-foreground">{SENDER_LABELS.SYSTEM}</span> · {message.content} ·{" "}
+					<time dateTime={isoOf(message.sentAt)} className="tabular-nums">
+						{formatTime(message.sentAt)}
+					</time>
+				</p>
+			</li>
+		);
+	const outbound = message.sender !== "LEAD";
+	const status = outbound
+		? message.failureCode
+			? `${labelOf(MESSAGE_STATUS_LABELS, message.status)} (${message.failureCode})`
+			: message.status
+		: undefined;
+	return (
+		<li className={cn("flex flex-col gap-1", outbound ? "items-end" : "items-start")}>
+			<ItemMeta channel="SMS" label={SENDER_LABELS[message.sender]} at={message.sentAt} status={status} />
+			<Bubble variant={BUBBLE_VARIANT[message.sender]} align={outbound ? "end" : "start"}>
+				<BubbleContent className="text-sm whitespace-pre-wrap">{message.content}</BubbleContent>
+			</Bubble>
+		</li>
+	);
+}
+
+function EmailItem({ email }: { email: InboxEmail }) {
+	const outbound = email.direction === "OUTBOUND";
+	const link = emailLink(email.webLink);
+	const subject = email.subject?.trim() || "(Sans objet)";
+	return (
+		<li className={cn("flex flex-col gap-1", outbound ? "items-end" : "items-start")}>
+			<ItemMeta channel="EMAIL" label={outbound ? SENDER_LABELS.HUMAN_AGENT : SENDER_LABELS.LEAD} at={email.sentAt} />
+			<article
+				aria-label={`Courriel : ${subject}`}
+				className="flex w-full max-w-sm min-w-0 flex-col gap-1 rounded-md border bg-background px-3 py-2 text-xs sm:max-w-md"
+			>
+				<p className="truncate text-sm font-medium">{subject}</p>
+				{email.snippet && <p className="line-clamp-2 text-pretty text-muted-foreground">{email.snippet}</p>}
+				<div className="flex flex-wrap items-center justify-between gap-x-3 gap-y-1 text-muted-foreground">
+					<span className="min-w-0 truncate">
+						{email.fromName ? `${email.fromName} · ${email.fromEmail}` : email.fromEmail}
+					</span>
+					{link && (
+						<a
+							href={link.href}
+							target="_blank"
+							rel="noopener noreferrer"
+							className="inline-flex items-center gap-1 font-medium whitespace-nowrap text-foreground underline-offset-2 hover:underline"
+						>
+							{link.label}
+							<Icon icon={Launch} className="size-3" />
+							<span className="sr-only">(nouvel onglet)</span>
+						</a>
+					)}
+				</div>
+			</article>
+		</li>
+	);
+}
+
+export function InboxThread({
+	messages,
+	emails,
+	leadName,
+	now,
+}: {
+	messages: InboxSmsMessage[];
+	emails: InboxEmail[];
+	leadName: string;
+	now: Date;
+}) {
+	const days = groupByDay(mergeThread(messages, emails));
+	return (
+		<MessageScrollerProvider autoScroll defaultScrollPosition="end">
+			<MessageScroller className="flex-1">
+				<MessageScrollerViewport>
+					<MessageScrollerContent className="gap-4 p-3 sm:p-4">
+						{days.length === 0 ? (
+							<EmptyState
+								compact
+								icon={Chat}
+								title="Aucun échange"
+								description="Écrivez au prospect depuis la barre ci-dessous ou laissez l'assistant faire le premier contact."
+								className="m-auto max-w-sm border-dashed bg-transparent"
+							/>
+						) : (
+							<div role="log" aria-label={`Conversation avec ${leadName}`} className="flex flex-col gap-4">
+								{days.map((day) => (
+									<section key={day.key || "sans-date"} className="flex flex-col gap-3">
+										<Marker asChild variant="separator">
+											<h3 className="justify-center font-medium">{formatDayHeading(day.at, now)}</h3>
+										</Marker>
+										<ol className="flex flex-col gap-3">
+											{day.items.map((item) =>
+												item.kind === "SMS" ? (
+													<SmsItem key={`sms:${item.id}`} message={item.message} />
+												) : (
+													<EmailItem key={`email:${item.id}`} email={item.email} />
+												),
+											)}
+										</ol>
+									</section>
+								))}
+							</div>
+						)}
+					</MessageScrollerContent>
+				</MessageScrollerViewport>
+				<MessageScrollerButton>
+					<Icon icon={ArrowDown} />
+					<span className="sr-only">Aller au dernier message</span>
+				</MessageScrollerButton>
+			</MessageScroller>
+		</MessageScrollerProvider>
+	);
+}
+
+export function InboxComposer({
+	leadName,
+	email,
+	blockedReason,
+	paused,
+	maxLength = SMS_MAX_LENGTH,
+	onSend,
+}: {
+	leadName: string;
+	email?: string | null;
+	blockedReason?: string | null;
+	paused?: boolean;
+	maxLength?: number;
+	onSend: (text: string, requestId: string) => Promise<void>;
+}) {
+	const fieldId = useId();
+	const [text, setText] = useState("");
+	const [requestId, setRequestId] = useState(() => crypto.randomUUID());
+	const [sending, setSending] = useState(false);
+	const [error, setError] = useState<string | null>(null);
+	const blocked = Boolean(blockedReason);
+	const draft = text.trim();
+	async function send() {
+		if (!draft || sending || blocked) return;
+		setSending(true);
+		setError(null);
+		try {
+			await onSend(draft, requestId);
+			setText("");
+			setRequestId(crypto.randomUUID());
+		} catch (failure) {
+			setError(failure instanceof Error ? failure.message : "Envoi impossible.");
+		} finally {
+			setSending(false);
+		}
+	}
+	return (
+		<form
+			className="flex shrink-0 flex-col gap-2 border-t p-3"
+			onSubmit={(event) => {
+				event.preventDefault();
+				void send();
+			}}
+		>
+			<label htmlFor={fieldId} className="sr-only">
+				SMS à {leadName}
+			</label>
+			<Textarea
+				id={fieldId}
+				data-slot="sms-composer"
+				value={text}
+				maxLength={maxLength}
+				rows={2}
+				disabled={blocked || sending}
+				placeholder={blocked ? "SMS indisponible" : "Écrire un SMS…"}
+				aria-describedby={`${fieldId}-count${blocked ? ` ${fieldId}-reason` : ""}`}
+				className="max-h-40 min-h-14 resize-none text-sm md:text-sm"
+				onChange={(event) => {
+					setText(event.target.value);
+					setRequestId(crypto.randomUUID());
+				}}
+				onKeyDown={(event) => {
+					if (event.key === "Enter" && !event.shiftKey && !event.nativeEvent.isComposing) {
+						event.preventDefault();
+						void send();
+					}
+				}}
+			/>
+			{blockedReason && (
+				<p id={`${fieldId}-reason`} className="flex items-center gap-1.5 text-xs text-muted-foreground">
+					<Dot className="bg-muted-foreground/50" />
+					{blockedReason}
+				</p>
+			)}
+			{error && (
+				<p role="alert" className="text-xs text-destructive">
+					{error}
+				</p>
+			)}
+			<div className="flex flex-wrap items-center justify-between gap-2">
+				<div className="flex min-w-0 flex-wrap items-center gap-x-3 gap-y-1 text-xs text-muted-foreground">
+					<span
+						id={`${fieldId}-count`}
+						className={cn("tabular-nums", text.length >= maxLength && "text-destructive")}
+					>
+						{`${text.length}/${maxLength}`}
+						<span className="sr-only"> caractères</span>
+					</span>
+					{!paused && !blocked && <span>Votre envoi met l'assistant en pause.</span>}
+					{email && (
+						<span className="flex items-center gap-1.5">
+							<a
+								href={`mailto:${email}`}
+								className="inline-flex items-center gap-1 font-medium text-foreground underline-offset-2 hover:underline"
+							>
+								<Icon icon={Email} className="size-3.5" />
+								Écrire un courriel
+							</a>
+							<InfoHint label="Courriel">
+								Le courriel s'ouvre dans votre messagerie. Fratex lit les courriels synchronisés, mais ne les
+								envoie pas.
+							</InfoHint>
+						</span>
+					)}
+				</div>
+				<Button type="submit" size="sm" disabled={blocked || sending || !draft}>
+					<Icon icon={SendAlt} className="size-3.5" />
+					{sending ? "Envoi…" : "Envoyer le SMS"}
+				</Button>
+			</div>
+		</form>
+	);
+}
