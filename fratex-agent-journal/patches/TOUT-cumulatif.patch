--- /dev/null
+++ b/apps/agent/agent/tools/list_appointments.ts
@@ -0,0 +1,35 @@
+import { defineTool } from "eve/tools";
+import { z } from "zod";
+import {
+	ASSISTANT,
+	ASSISTANT_APPOINTMENT_STATUSES,
+} from "../lib/assistant-config";
+import { listAppointments } from "../lib/assistant-reports";
+import { assistantScopes } from "../lib/assistant-scope";
+
+export default defineTool({
+	description:
+		"Liste les rendez-vous immobiliers avec le nom du prospect, l'heure (fuseau America/Toronto), le statut et le courtier. À utiliser pour « Quels sont mes rendez-vous cette semaine ? », « Qui ai-je rencontré le mois dernier ? » ou « Quels rendez-vous ont été annulés ? ». range=upcoming donne les rendez-vous des N prochains jours (les annulés et reportés sont exclus sauf si un statut est demandé) ; range=past donne ceux des N derniers jours. Statuts : SCHEDULED planifié, CONFIRMED confirmé, COMPLETED réalisé, NO_SHOW absent, CANCELLED annulé, RESCHEDULED reporté. Lecture seule, limitée aux rendez-vous de l'utilisateur. Chaque rendez-vous porte le chemin de la fiche du prospect (fiche) à donner en lien.",
+	inputSchema: z.object({
+		range: z.enum(["upcoming", "past"]).default("upcoming"),
+		days: z
+			.number()
+			.int()
+			.min(1)
+			.max(ASSISTANT.appointmentDays.max)
+			.default(ASSISTANT.appointmentDays.default),
+		status: z.enum(ASSISTANT_APPOINTMENT_STATUSES).optional(),
+		agencyId: z
+			.string()
+			.trim()
+			.min(1)
+			.optional()
+			.describe(
+				"Identifiant de l'agence. Facultatif : par défaut, toutes les agences de l'utilisateur.",
+			),
+	}),
+	async execute(input, ctx) {
+		const { scopes } = await assistantScopes(ctx, input);
+		return listAppointments(scopes, input);
+	},
+});
