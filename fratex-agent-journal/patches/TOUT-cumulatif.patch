+function fullName(lead: { firstName: string; lastName: string | null }) {
+	return [lead.firstName, lead.lastName].filter(Boolean).join(" ");
+}
+
+async function resolveScope(
+	db: Db,
+	scope: ReadScope,
+	userId: string,
+	requested: "me" | "everyone",
+) {
+	const member = await db.agencyUser.findFirst({
+		where: { agencyId: scope.agencyId, userId },
+		select: { clientId: true },
+	});
+	const clientId =
+		scope.clientId ?? (requested === "me" ? (member?.clientId ?? null) : null);
