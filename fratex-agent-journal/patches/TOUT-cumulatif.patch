+"use client";
+
+import type { ReactNode } from "react";
+import { Panel } from "./panel";
+
+export type AccountRow = { label: string; value: ReactNode };
+
+export function AccountSection({
+	title,
+	description,
+	info,
+	action,
+	children,
+}: {
+	title: string;
+	description?: string;
+	info?: string;
+	action?: ReactNode;
+	children: ReactNode;
+}) {
+	return (
+		<Panel title={title} description={description} info={info} action={action}>
+			{children}
+		</Panel>
+	);
+}
+
+export function AccountFacts({ rows }: { rows: AccountRow[] }) {
+	return (
+		<dl className="grid gap-x-6 gap-y-3 text-sm sm:grid-cols-2">
+			{rows.map((row) => (
+				<div key={row.label} className="flex min-w-0 flex-col gap-0.5">
+					<dt className="text-xs text-muted-foreground">{row.label}</dt>
+					<dd className="truncate font-medium">{row.value}</dd>
+				</div>
+			))}
+		</dl>
+	);
+}
diff --git a/packages/ui/src/components/assistant-result-cards.tsx b/packages/ui/src/components/assistant-result-cards.tsx
new file mode 100644
index 0000000..89464de
--- /dev/null
+++ b/packages/ui/src/components/assistant-result-cards.tsx
@@ -0,0 +1,487 @@
+"use client";
+
+import ArrowRight from "@carbon/icons-react/es/ArrowRight";
+import { Icon } from "@crm/ui/components/icon";
+import { REVEAL } from "@crm/ui/lib/motion";
+import { cn } from "@crm/ui/lib/utils";
+import type * as React from "react";
+
+export type ResultLinkProps = {
+	href: string;
+	className: string;
+	children: React.ReactNode;
+};
+
+export type RenderResultLink = (props: ResultLinkProps) => React.ReactNode;
+
+export type ResultStatus = { id: string | null; label: string };
+
+export type ProspectRowData = {
+	id: string;
+	name: string;
+	status: ResultStatus;
+	realtor: string;
+	contact: string | null;
+	detail: string | null;
+	quote: string | null;
+	fiche: string;
+};
+
+export type ProspectListData = {
+	title: string;
+	counts: string | null;
+	rows: ProspectRowData[];
+	more: number;
+};
+
+export type AppointmentRowData = {
+	id: string;
+	prospect: string;
+	day: string;
+	time: string;
+	status: ResultStatus;
+	realtor: string;
+	title: string | null;
+	fiche: string;
+};
+
+export type AppointmentListData = {
+	title: string;
+	scope: string;
+	rows: AppointmentRowData[];
+	more: number;
+};
+
+export type ProspectDetailData = {
+	id: string;
+	name: string;
+	status: ResultStatus;
+	realtor: string;
+	facts: { label: string; value: string }[];
+	criteria: {
+		label: string;
+		value: string;
+		confirmed: boolean;
+		quote: string | null;
+	}[];
+	toConfirm: string[];
+	appointments: AppointmentRowData[];
+	consent: string;
+	fiche: string;
+};
+
+export type PerformanceData = {
+	title: string;
+	range: string;
+	metrics: { id: string; label: string; value: string; hint: string | null }[];
+	realtors: {
+		id: string;
+		name: string;
+		leads: string;
+		firstResponse: string;
+		appointments: string;
+		conversion: string;
+	}[];
+};
+
+const LEAD_DOTS: Record<string, string> = {
+	NEW: "bg-foreground",
+	CONTACTED: "bg-primary/50",
+	QUALIFYING: "bg-primary/50",
+	QUALIFIED: "bg-primary",
+	APPOINTMENT_BOOKED: "bg-primary",
+	APPOINTMENT_HELD: "bg-primary",
+	NURTURE: "bg-muted-foreground/50",
+	LOST: "bg-muted-foreground/30",
+	INVALID: "bg-destructive",
+};
+
+const APPOINTMENT_DOTS: Record<string, string> = {
+	SCHEDULED: "bg-foreground",
+	CONFIRMED: "bg-primary",
+	COMPLETED: "bg-primary/50",
+	NO_SHOW: "bg-destructive",
+	CANCELLED: "bg-muted-foreground/30",
+	RESCHEDULED: "bg-warning",
+};
+
+const ROW_LINK =
+	"group/row flex min-w-0 items-start gap-3 px-3 py-2.5 outline-none transition-colors hover:bg-muted/50 focus-visible:bg-muted/50";
+
+function StatusLabel({
+	status,
+	dots,
+}: {
+	status: ResultStatus;
+	dots: Record<string, string>;
+}) {
+	return (
+		<span className="inline-flex min-w-0 items-center gap-1.5 whitespace-nowrap text-xs">
+			<span
+				aria-hidden="true"
+				className={cn(
+					"size-2 shrink-0 rounded-full",
+					(status.id && dots[status.id]) || "bg-muted-foreground/40",
+				)}
+			/>
+			<span className="truncate text-muted-foreground">{status.label}</span>
+		</span>
+	);
+}
+
+function RowArrow() {
+	return (
+		<Icon
+			icon={ArrowRight}
+			className="mt-0.5 size-4 shrink-0 text-muted-foreground transition-transform group-hover/row:translate-x-0.5 motion-reduce:transition-none"
+		/>
+	);
+}
+
+function ResultCard({
+	title,
+	meta,
+	subtitle,
+	footer,
+	children,
+	className,
+}: {
+	title: string;
+	meta?: React.ReactNode;
+	subtitle?: React.ReactNode;
+	footer?: React.ReactNode;
+	children: React.ReactNode;
+	className?: string;
+}) {
+	return (
+		<section
+			data-slot="assistant-result"
+			aria-label={title}
+			className={cn(
+				"w-full min-w-0 overflow-hidden rounded-lg border bg-card",
+				REVEAL,
+				className,
+			)}
+		>
+			<header className="flex flex-col gap-0.5 border-b px-3 py-2">
+				<div className="flex min-w-0 items-baseline justify-between gap-3">
+					<h3 className="min-w-0 truncate font-medium text-sm">{title}</h3>
+					{meta ? (
+						<span className="shrink-0 text-muted-foreground text-xs tabular-nums">
+							{meta}
+						</span>
+					) : null}
+				</div>
+				{subtitle ? (
+					<p className="text-pretty text-muted-foreground text-xs">
+						{subtitle}
+					</p>
+				) : null}
+			</header>
+			{children}
+			{footer ? (
+				<footer className="border-t px-3 py-1.5 text-muted-foreground text-xs">
+					{footer}
+				</footer>
+			) : null}
+		</section>
+	);
+}
+
+function EmptyRows() {
+	return <p className="px-3 py-3 text-muted-foreground text-xs">Aucun résultat.</p>;
+}
+
+function shownFooter(shown: number, more: number): string | null {
+	return more > 0 ? `${shown} sur ${shown + more} affichés` : null;
+}
+
+function ProspectRow({
+	row,
+	renderLink,
+}: {
+	row: ProspectRowData;
+	renderLink: RenderResultLink;
+}) {
+	return (
+		<li>
+			{renderLink({
+				href: row.fiche,
+				className: ROW_LINK,
+				children: (
+					<>
+						<span className="flex min-w-0 flex-1 flex-col gap-0.5">
+							<span className="flex min-w-0 flex-wrap items-center gap-x-2.5 gap-y-0.5">
+								<span className="truncate font-medium text-sm">{row.name}</span>
+								<StatusLabel status={row.status} dots={LEAD_DOTS} />
+							</span>
+							{row.detail ? (
+								<span className="text-pretty text-xs">{row.detail}</span>
+							) : null}
+							{row.contact ? (
+								<span className="truncate text-muted-foreground text-xs tabular-nums">
+									{row.contact}
+								</span>
+							) : null}
+							{row.quote ? (
+								<span className="line-clamp-2 text-muted-foreground text-xs italic">
+									« {row.quote} »
+								</span>
+							) : null}
+						</span>
+						<span className="max-w-[40%] shrink-0 truncate pt-0.5 text-muted-foreground text-xs">
+							{row.realtor}
+						</span>
+						<RowArrow />
+					</>
+				),
+			})}
+		</li>
+	);
+}
+
+function ProspectResultCard({
+	data,
+	renderLink,
+	className,
+}: {
+	data: ProspectListData;
+	renderLink: RenderResultLink;
+	className?: string;
+}) {
+	return (
+		<ResultCard
+			title={data.title}
+			subtitle={data.counts}
+			footer={shownFooter(data.rows.length, data.more)}
+			className={className}
+		>
+			{data.rows.length === 0 ? (
+				<EmptyRows />
+			) : (
+				<ul className="divide-y">
+					{data.rows.map((row) => (
+						<ProspectRow key={row.id} row={row} renderLink={renderLink} />
+					))}
+				</ul>
+			)}
+		</ResultCard>
+	);
+}
+
+function AppointmentRow({
+	row,
+	renderLink,
+}: {
+	row: AppointmentRowData;
+	renderLink: RenderResultLink;
+}) {
+	const secondary = [row.title, row.realtor].filter(Boolean).join(" · ");
+
+	return (
+		<li>
+			{renderLink({
+				href: row.fiche,
+				className: ROW_LINK,
+				children: (
+					<>
+						<span className="flex w-28 shrink-0 flex-col whitespace-nowrap text-xs tabular-nums">
+							<span className="font-medium">{row.day}</span>
+							<span className="text-muted-foreground">{row.time}</span>
+						</span>
+						<span className="flex min-w-0 flex-1 flex-col gap-0.5">
+							<span className="flex min-w-0 flex-wrap items-center gap-x-2.5 gap-y-0.5">
+								<span className="truncate font-medium text-sm">
+									{row.prospect}
+								</span>
+								<StatusLabel status={row.status} dots={APPOINTMENT_DOTS} />
+							</span>
+							{secondary ? (
+								<span className="truncate text-muted-foreground text-xs">
+									{secondary}
+								</span>
+							) : null}
+						</span>
+						<RowArrow />
+					</>
+				),
+			})}
+		</li>
+	);
+}
+
+function AppointmentResultCard({
+	data,
+	renderLink,
+	className,
+}: {
+	data: AppointmentListData;
+	renderLink: RenderResultLink;
+	className?: string;
+}) {
+	return (
+		<ResultCard
+			title={data.title}
+			meta={data.scope}
+			footer={shownFooter(data.rows.length, data.more)}
+			className={className}
+		>
+			{data.rows.length === 0 ? (
+				<EmptyRows />
+			) : (
+				<ul className="divide-y">
+					{data.rows.map((row) => (
+						<AppointmentRow key={row.id} row={row} renderLink={renderLink} />
+					))}
+				</ul>
+			)}
+		</ResultCard>
+	);
+}
+
+function ProspectDetailCard({
+	data,
+	renderLink,
+	className,
+}: {
+	data: ProspectDetailData;
+	renderLink: RenderResultLink;
+	className?: string;
+}) {
+	return (
+		<ResultCard
+			title={data.name}
+			meta={data.realtor}
+			subtitle={<StatusLabel status={data.status} dots={LEAD_DOTS} />}
+			footer={renderLink({
+				href: data.fiche,
+				className:
+					"inline-flex items-center gap-1 text-foreground outline-none hover:underline focus-visible:underline",
+				children: (
+					<>
+						Ouvrir la fiche
+						<Icon icon={ArrowRight} className="size-3.5" />
+					</>
+				),
+			})}
+			className={className}
+		>
+			<div className="flex flex-col divide-y">
+				<dl className="grid grid-cols-1 gap-x-4 gap-y-1 px-3 py-2.5 text-xs sm:grid-cols-2">
+					{data.facts.map((fact) => (
+						<div key={fact.label} className="flex min-w-0 gap-2">
+							<dt className="w-28 shrink-0 text-muted-foreground">
+								{fact.label}
+							</dt>
+							<dd className="min-w-0 truncate tabular-nums">{fact.value}</dd>
+						</div>
+					))}
+				</dl>
+				{data.criteria.length > 0 || data.toConfirm.length > 0 ? (
+					<div className="flex flex-col gap-1.5 px-3 py-2.5 text-xs">
+						{data.criteria.map((item) => (
+							<div key={item.label} className="flex min-w-0 gap-2">
+								<span className="w-28 shrink-0 text-muted-foreground">
+									{item.label}
+								</span>
+								<span className="flex min-w-0 flex-1 flex-col">
+									<span className="text-pretty">
+										{item.value}
+										{item.confirmed ? null : (
+											<span className="ml-1.5 text-muted-foreground italic">
+												suggestion non confirmée
+											</span>
+										)}
+									</span>
+									{item.quote ? (
+										<span className="text-pretty text-muted-foreground italic">
+											« {item.quote} »
+										</span>
+									) : null}
+								</span>
+							</div>
+						))}
+						{data.toConfirm.length > 0 ? (
+							<p className="text-pretty text-muted-foreground">
+								À confirmer : {data.toConfirm.join(", ")}
+							</p>
+						) : null}
+					</div>
+				) : null}
+				{data.appointments.length > 0 ? (
+					<ul className="divide-y">
+						{data.appointments.map((row) => (
+							<AppointmentRow key={row.id} row={row} renderLink={renderLink} />
+						))}
+					</ul>
+				) : null}
+				<p className="px-3 py-2 text-muted-foreground text-xs">
+					{data.consent}
+				</p>
+			</div>
+		</ResultCard>
+	);
+}
+
+function PerformanceResultCard({
+	data,
+	className,
+}: {
+	data: PerformanceData;
+	className?: string;
+}) {
+	return (
+		<ResultCard title={data.title} meta={data.range} className={className}>
+			<dl className="grid grid-cols-2 gap-px bg-border sm:grid-cols-4">
+				{data.metrics.map((metric) => (
+					<div
+						key={metric.id}
+						className="flex min-w-0 flex-col gap-0.5 bg-card px-3 py-2.5"
+					>
+						<dt className="text-muted-foreground text-xs">{metric.label}</dt>
+						<dd className="font-medium text-lg tabular-nums leading-tight tracking-tight">
+							{metric.value}
+						</dd>
+						{metric.hint ? (
+							<dd className="text-pretty text-muted-foreground text-xs">
+								{metric.hint}
+							</dd>
+						) : null}
+					</div>
+				))}
+			</dl>
+			{data.realtors.length > 0 ? (
+				<table className="w-full border-t text-xs tabular-nums">
+					<thead className="text-muted-foreground">
+						<tr className="border-b">
+							<th className="px-3 py-1.5 text-left font-normal">Courtier</th>
+							<th className="px-2 py-1.5 text-right font-normal">Prospects</th>
+							<th className="px-2 py-1.5 text-right font-normal">Réponse</th>
+							<th className="px-2 py-1.5 text-right font-normal">RDV</th>
+							<th className="px-3 py-1.5 text-right font-normal">Conversion</th>
+						</tr>
+					</thead>
+					<tbody className="divide-y">
+						{data.realtors.map((row) => (
+							<tr key={row.id}>
+								<td className="max-w-40 truncate px-3 py-1.5">{row.name}</td>
+								<td className="px-2 py-1.5 text-right">{row.leads}</td>
+								<td className="px-2 py-1.5 text-right">{row.firstResponse}</td>
+								<td className="px-2 py-1.5 text-right">{row.appointments}</td>
+								<td className="px-3 py-1.5 text-right">{row.conversion}</td>
+							</tr>
+						))}
+					</tbody>
+				</table>
+			) : null}
+		</ResultCard>
+	);
+}
+
+export {
+	AppointmentResultCard,
+	PerformanceResultCard,
+	ProspectDetailCard,
+	ProspectResultCard,
+	ResultCard,
+};
