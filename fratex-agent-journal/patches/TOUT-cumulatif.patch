+++ b/apps/api/src/support/support.service.ts
@@ -0,0 +1,148 @@
+import { canChangeRole, workspaceRoleOf } from "@crm/auth";
+import type { Db, Prisma } from "@crm/db";
+import {
+	ForbiddenException,
+	HttpException,
+	HttpStatus,
+	Injectable,
+	NotFoundException,
+} from "@nestjs/common";
+import { InjectDatabase } from "../database/database.constants";
+import type {
+	CreateSupportRequestInput,
+	SetSupportStatusInput,
+	SupportRequestRow,
+} from "./support.contracts";
+import { SUPPORT, SUPPORT_MESSAGES } from "./support-config";
+
+const HOUR_MS = 60 * 60 * 1000;
+
+const SELECT = {
+	id: true,
+	kind: true,
+	status: true,
+	subject: true,
+	message: true,
+	pagePath: true,
+	createdAt: true,
+	user: { select: { name: true, email: true } },
+} as const;
+
+type Row = Prisma.SupportRequestGetPayload<{ select: typeof SELECT }>;
+
+function toRow(row: Row, withAuthor: boolean): SupportRequestRow {
+	return {
+		id: row.id,
+		kind: row.kind,
+		status: row.status,
+		subject: row.subject,
+		message: row.message,
+		pagePath: row.pagePath,
+		createdAt: row.createdAt.toISOString(),
+		author: withAuthor ? row.user : null,
+	};
+}
+
+function subjectOf(message: string): string {
+	const firstLine = message.split("\n")[0]?.trim() ?? message;
+	return firstLine.length > SUPPORT.subjectMaxLength
+		? `${firstLine.slice(0, SUPPORT.subjectMaxLength - 1).trimEnd()}…`
+		: firstLine;
+}
+
+@Injectable()
+export class SupportService {
+	constructor(@InjectDatabase() private readonly db: Db) {}
+
+	async create(
+		userId: string,
+		input: CreateSupportRequestInput,
+	): Promise<SupportRequestRow> {
+		const recent = await this.db.supportRequest.count({
+			where: {
+				userId,
+				createdAt: { gte: new Date(Date.now() - HOUR_MS) },
+			},
+		});
+
+		if (recent >= SUPPORT.hourlyLimit) {
+			throw new HttpException(
+				SUPPORT_MESSAGES.tooMany,
+				HttpStatus.TOO_MANY_REQUESTS,
+			);
+		}
+
+		const row = await this.db.supportRequest.create({
+			data: {
+				userId,
+				kind: input.kind,
+				subject: subjectOf(input.message),
+				message: input.message,
+				pagePath: input.pagePath ?? null,
+				context: input.viewport ? { viewport: input.viewport } : undefined,
+			},
+			select: SELECT,
+		});
+
+		return toRow(row, false);
+	}
+
+	async mine(userId: string) {
+		const [rows, role] = await Promise.all([
+			this.db.supportRequest.findMany({
+				where: { userId },
+				orderBy: { createdAt: "desc" },
+				take: SUPPORT.listLimit,
+				select: SELECT,
+			}),
+			workspaceRoleOf(userId),
+		]);
+
+		return {
+			rows: rows.map((row) => toRow(row, false)),
+			canTriage: canChangeRole(role),
+		};
+	}
+
+	async team(userId: string) {
+		const role = await workspaceRoleOf(userId);
+
+		if (!canChangeRole(role)) {
+			throw new ForbiddenException(SUPPORT_MESSAGES.forbidden);
+		}
+
+		const rows = await this.db.supportRequest.findMany({
+			orderBy: [{ status: "asc" }, { createdAt: "desc" }],
+			take: SUPPORT.listLimit,
+			select: SELECT,
+		});
+
+		return { rows: rows.map((row) => toRow(row, true)), canTriage: true };
+	}
+
+	async setStatus(
+		userId: string,
+		input: SetSupportStatusInput,
+	): Promise<SupportRequestRow> {
+		const role = await workspaceRoleOf(userId);
+
+		if (!canChangeRole(role)) {
+			throw new ForbiddenException(SUPPORT_MESSAGES.forbidden);
+		}
+
+		const existing = await this.db.supportRequest.findUnique({
+			where: { id: input.id },
+			select: { id: true },
+		});
+
+		if (!existing) throw new NotFoundException(SUPPORT_MESSAGES.notFound);
+
+		const row = await this.db.supportRequest.update({
+			where: { id: input.id },
+			data: { status: input.status },
+			select: SELECT,
+		});
+
+		return toRow(row, true);
+	}
+}
