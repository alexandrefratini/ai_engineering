+			{
+				agencyId: agencyA,
+				leadId: lead.alice,
+				body: "Veut un stationnement",
+				createdAt: ago(HOUR),
+			},
+		],
+	});
+	await db.appointment.createMany({
+		data: [
+			{
+				id: id("a1"),
+				agencyId: agencyA,
+				leadId: lead.alice,
+				clientId: clientMarie,
+				title: "Visite condo",
+				startTime: ahead(DAY + 2 * HOUR),
+				endTime: ahead(DAY + 3 * HOUR),
+				status: "SCHEDULED",
+				createdAt: ago(DAY),
+			},
+			{
+				id: id("a2"),
+				agencyId: agencyA,
+				leadId: lead.dana,
+				clientId: clientLuc,
+				title: "Rencontre",
+				startTime: ahead(3 * DAY),
+				endTime: ahead(3 * DAY + HOUR),
+				status: "CONFIRMED",
+				createdAt: ago(2 * DAY),
+			},
+			{
+				id: id("a3"),
+				agencyId: agencyA,
+				leadId: lead.bob,
+				clientId: clientMarie,
+				title: "Annulé",
+				startTime: ahead(2 * DAY),
+				endTime: ahead(2 * DAY + HOUR),
+				status: "CANCELLED",
+				createdAt: ago(3 * DAY),
+			},
+			{
+				id: id("a4"),
+				agencyId: agencyA,
+				leadId: lead.alice,
+				clientId: clientMarie,
+				title: "Première visite",
+				startTime: ago(2 * DAY),
+				endTime: ago(2 * DAY - HOUR),
+				status: "COMPLETED",
+				createdAt: ago(10 * DAY),
+			},
+			{
+				id: id("a5"),
+				agencyId: agencyA,
+				leadId: lead.eve,
+				clientId: clientLuc,
+				title: "Ancienne visite",
+				startTime: ago(35 * DAY),
+				endTime: ago(35 * DAY - HOUR),
+				status: "COMPLETED",
+				createdAt: ago(40 * DAY),
+			},
+			{
+				id: id("a6"),
+				agencyId: agencyB,
+				leadId: lead.zed,
+				clientId: clientForeign,
+				title: "Étranger",
+				startTime: ahead(DAY),
+				endTime: ahead(DAY + HOUR),
+				status: "SCHEDULED",
+			},
+		],
+	});
+});
+
+afterAll(async () => {
+	await db.agencyUser.deleteMany({
+		where: { agencyId: { in: [agencyA, agencyB] } },
+	});
+	await db.agency.deleteMany({ where: { id: { in: [agencyA, agencyB] } } });
+	await db.user.deleteMany({
+		where: { id: { in: [staff, marie, outsider, stranger] } },
+	});
+});
+
+describe("assistant purpose guard", () => {
+	it("refuses every tool outside a signed-in user chat with a French message", async () => {
+		const refused = [
