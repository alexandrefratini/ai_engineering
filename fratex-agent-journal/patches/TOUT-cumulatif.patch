+});
+
+describe("realtor roster", () => {
+	it("reports setup progress, activity and onboarding details per realtor", async () => {
+		const { clients } = await service.listClients(owner, agency);
+		const byId = new Map(clients.map((client) => [client.id, client]));
+		const x = byId.get(clientX);
+		const y = byId.get(clientY);
+
+		expect(x?.setup).toEqual({ metaForm: true, calendar: true, sms: true });
+		expect(y?.setup).toEqual({ metaForm: false, calendar: false, sms: true });
+		expect(x?.brokerage).toBe("Courtage X");
+		expect(x?.licenseNumber).toBe("X-123");
+		expect(x?.propertyTypes).toEqual(["Condo", "Maison"]);
+		expect(x?.crmChoice).toBe("HUBSPOT");
+		expect(x?.timezone).toBe("America/Montreal");
+		expect(x?.leadsCount).toBe(2);
+		expect(x?.appointmentsCount).toBe(3);
+		expect(x?.lastLeadAt?.getTime()).toBe(ago(40).getTime());
+		expect(y?.lastLeadAt?.getTime()).toBe(ago(50).getTime());
+		expect(y?.appointmentsCount).toBe(0);
+	});
+
+	it("shows a realtor only their own card", async () => {
+		const { clients } = await service.listClients(realtor, agency);
+
+		expect(clients.map((client) => client.id)).toEqual([clientX]);
+	});
+});
+
+describe("portal funnel", () => {
+	const stages = [
+		{ name: "received", status: "NEW" },
+		{ name: "contacted", status: "CONTACTED", delay: 2 },
+		{
+			name: "replied",
+			status: "QUALIFYING",
+			delay: 4,
+			events: ["LEAD_REPLIED"],
+		},
+		{
+			name: "qualified",
+			status: "QUALIFIED",
+			delay: 10,
+			budget: 600000,
+			events: ["LEAD_REPLIED", "LEAD_QUALIFIED"],
+		},
+		{
+			name: "booked",
+			status: "APPOINTMENT_BOOKED",
+			delay: 20,
+			budget: 800000,
+			appointment: "CONFIRMED",
+		},
+		{
+			name: "held",
+			status: "APPOINTMENT_HELD",
+			delay: 1,
+			budget: 400000,
