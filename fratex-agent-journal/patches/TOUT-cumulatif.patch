@@ -0,0 +1,439 @@
+import { db, type LeadStatus, type Prisma } from "@crm/db";
+import {
+	listingSuggestions,
+	type RealEstateQualificationInput,
+	storedQualificationEvidence,
+} from "@crm/validation/real-estate";
+import {
+	ASSISTANT,
+	ASSISTANT_ERRORS,
+	ASSISTANT_LABELS,
+	fichePath,
+	labelOf,
+} from "./assistant-config";
+import {
+	type AgencyFilter,
+	type AssistantScope,
+	agencyFilter,
+} from "./assistant-scope";
+import { localStamp, trimText } from "./assistant-time";
+import { validateQualification } from "./qualification";
+
+const MINUTE_MS = 60 * 1000;
+
+const money = new Intl.NumberFormat(ASSISTANT.locale, {
+	style: "currency",
+	currency: "CAD",
+	maximumFractionDigits: 0,
+});
+
+function fullName(lead: { firstName: string; lastName: string | null }) {
+	return [lead.firstName, lead.lastName].filter(Boolean).join(" ");
+}
+
+function budgetText(min: number | null, max: number | null): string | null {
+	if (min !== null && max !== null)
+		return `${money.format(min)} – ${money.format(max)}`;
+	if (max !== null) return `Jusqu'à ${money.format(max)}`;
+	if (min !== null) return `À partir de ${money.format(min)}`;
+	return null;
+}
+
+function within(base: AgencyFilter, ...conditions: Prisma.LeadWhereInput[]) {
+	return { AND: [base, ...conditions] } satisfies Prisma.LeadWhereInput;
+}
+
+function unreadWhere(): Prisma.LeadWhereInput {
+	return {
+		unsubscribedAt: null,
+		conversations: { some: { unreadCount: { gt: 0 } } },
+	};
+}
+
+function humanWhere(): Prisma.LeadWhereInput {
+	return { unsubscribedAt: null, automationPausedAt: { not: null } };
+}
+
+function notContactedWhere(now: Date): Prisma.LeadWhereInput {
+	return {
+		unsubscribedAt: null,
+		status: "NEW",
+		firstContactedAt: null,
+		createdAt: {
+			lte: new Date(
+				now.getTime() - ASSISTANT.notContactedGraceMinutes * MINUTE_MS,
+			),
+		},
+	};
+}
+
+export async function prospectsNeedingAttention(
+	scopes: AssistantScope[],
+	now = new Date(),
+	limit: number = ASSISTANT.listLimit,
+) {
+	const base = agencyFilter(scopes);
+	const [unread, human, never, total, unreadCount, humanCount, neverCount] =
+		await Promise.all([
+			db.conversation.findMany({
+				where: {
+					unreadCount: { gt: 0 },
+					lead: within(base, unreadWhere()),
+				},
+				orderBy: { lastMessageAt: "desc" },
+				take: limit * 4,
+				select: { leadId: true, lastMessageAt: true },
+			}),
+			db.lead.findMany({
+				where: within(base, humanWhere()),
+				orderBy: { automationPausedAt: "desc" },
+				take: limit,
+				select: { id: true, automationPausedAt: true },
+			}),
+			db.lead.findMany({
+				where: within(base, notContactedWhere(now)),
+				orderBy: { createdAt: "desc" },
+				take: limit,
+				select: { id: true, createdAt: true },
+			}),
+			db.lead.count({
+				where: within(base, {
+					OR: [unreadWhere(), humanWhere(), notContactedWhere(now)],
+				}),
+			}),
+			db.lead.count({ where: within(base, unreadWhere()) }),
+			db.lead.count({ where: within(base, humanWhere()) }),
+			db.lead.count({ where: within(base, notContactedWhere(now)) }),
+		]);
+	const since = new Map<string, Date>();
+	const note = (id: string, at: Date | null) => {
+		if (at && (since.get(id)?.getTime() ?? 0) < at.getTime()) since.set(id, at);
+	};
+	for (const row of unread) note(row.leadId, row.lastMessageAt);
+	for (const row of human) note(row.id, row.automationPausedAt);
+	for (const row of never) note(row.id, row.createdAt);
+	const ids = [...since.entries()]
+		.sort((a, b) => b[1].getTime() - a[1].getTime())
+		.slice(0, limit)
+		.map(([id]) => id);
+	const rows = await db.lead.findMany({
+		where: within(base, { id: { in: ids } }),
+		select: {
+			id: true,
+			agencyId: true,
+			firstName: true,
+			lastName: true,
+			phone: true,
+			status: true,
+			automationPausedAt: true,
+			escalationReason: true,
+			client: { select: { name: true } },
+			conversations: {
+				select: {
+					unreadCount: true,
+					messages: {
+						where: { sender: "LEAD" },
+						orderBy: { sentAt: "desc" },
+						take: 1,
+						select: { content: true },
+					},
+				},
+			},
+		},
+	});
+	const byId = new Map(rows.map((row) => [row.id, row]));
+	const prospects = ids.flatMap((id) => {
+		const row = byId.get(id);
+		const at = since.get(id);
+		if (!row || !at) return [];
+		const reasons: string[] = [];
+		if (row.conversations.some((item) => item.unreadCount > 0))
+			reasons.push(ASSISTANT_LABELS.reason.UNREAD);
+		if (row.automationPausedAt)
+			reasons.push(
+				row.escalationReason
+					? `${ASSISTANT_LABELS.reason.HUMAN} (${labelOf(ASSISTANT_LABELS.escalation, row.escalationReason)})`
+					: ASSISTANT_LABELS.reason.HUMAN,
+			);
+		if (row.status === "NEW" && !row.automationPausedAt)
+			reasons.push(ASSISTANT_LABELS.reason.NOT_CONTACTED);
+		const lastReply =
+			row.conversations.flatMap((item) => item.messages)[0]?.content ?? null;
+		return [
+			{
+				id: row.id,
+				name: fullName(row),
+				phone: row.phone,
+				status: labelOf(ASSISTANT_LABELS.status, row.status),
+				reasons,
+				since: localStamp(at),
+				lastReply: lastReply
+					? trimText(lastReply, ASSISTANT.snippetLimit)
+					: null,
+				realtor: row.client?.name ?? null,
+				fiche: fichePath(row.id, row.agencyId),
+			},
+		];
+	});
+	return {
+		timeZone: ASSISTANT.timeZone,
+		total,
+		counts: {
+			unread: unreadCount,
+			humanTakeover: humanCount,
+			neverContacted: neverCount,
+		},
+		returned: prospects.length,
+		prospects,
+	};
+}
+
+export async function searchProspects(
+	scopes: AssistantScope[],
+	input: { query?: string; status?: LeadStatus },
+	limit: number = ASSISTANT.listLimit,
+) {
+	const tokens = (input.query ?? "")
+		.split(/\s+/)
+		.map((token) => token.trim())
+		.filter(Boolean)
+		.slice(0, ASSISTANT.searchTokenLimit);
+	if (!tokens.length && !input.status)
+		throw new Error(ASSISTANT_ERRORS.emptySearch);
+	const conditions: Prisma.LeadWhereInput[] = tokens.map((token) => {
+		const digits = token.replace(/\D/g, "");
+		return {
+			OR: [
+				{ firstName: { contains: token, mode: "insensitive" } },
+				{ lastName: { contains: token, mode: "insensitive" } },
+				{ email: { contains: token, mode: "insensitive" } },
+				{ targetArea: { contains: token, mode: "insensitive" } },
+				...(digits.length >= 3 ? [{ phone: { contains: digits } }] : []),
+			],
+		};
+	});
+	if (input.status) conditions.push({ status: input.status });
+	const where = within(agencyFilter(scopes), ...conditions);
+	const [total, rows] = await Promise.all([
+		db.lead.count({ where }),
+		db.lead.findMany({
+			where,
+			orderBy: [{ createdAt: "desc" }, { id: "desc" }],
+			take: limit,
+			select: {
+				id: true,
+				agencyId: true,
+				firstName: true,
+				lastName: true,
+				phone: true,
+				email: true,
+				status: true,
+				createdAt: true,
+				lastInteractedAt: true,
+				client: { select: { name: true } },
+			},
+		}),
+	]);
+	return {
+		timeZone: ASSISTANT.timeZone,
+		total,
+		returned: rows.length,
+		prospects: rows.map((row) => ({
+			id: row.id,
+			name: fullName(row),
+			phone: row.phone,
+			email: row.email,
+			status: labelOf(ASSISTANT_LABELS.status, row.status),
+			realtor: row.client?.name ?? null,
+			received: localStamp(row.createdAt),
+			lastActivity: row.lastInteractedAt
+				? localStamp(row.lastInteractedAt)
+				: null,
+			fiche: fichePath(row.id, row.agencyId),
+		})),
+	};
+}
+
+type CriterionField =
+	| "intent"
+	| "propertyType"
+	| "budgetMin"
+	| "budgetMax"
+	| "timeline"
+	| "financing"
+	| "targetArea"
+	| "currentSituation";
+
+type Criterion = {
+	criterion: string;
+	value: string;
+	status: string;
+	quote: string | null;
+};
+
+export async function readProspect(scopes: AssistantScope[], leadId: string) {
+	const lead = await db.lead.findFirst({
+		where: within(agencyFilter(scopes), { id: leadId }),
+		include: { client: { select: { name: true } } },
+	});
+	if (!lead) throw new Error(ASSISTANT_ERRORS.notFound);
+	const evidence = storedQualificationEvidence.safeParse(
+		lead.qualificationEvidence ?? [],
+	);
+	const stored = evidence.success ? evidence.data : [];
+	const [recent, anchors, appointments, notes] = await Promise.all([
+		db.message.findMany({
+			where: { agencyId: lead.agencyId, conversation: { leadId: lead.id } },
+			orderBy: [{ sentAt: "desc" }, { id: "desc" }],
+			take: ASSISTANT.messageLimit,
+			select: { sender: true, content: true, sentAt: true, status: true },
+		}),
+		db.message.findMany({
+			where: {
+				agencyId: lead.agencyId,
+				id: { in: stored.map((item) => item.messageId) },
+				sender: "LEAD",
+				conversation: { leadId: lead.id },
+			},
+			select: { id: true, content: true, sender: true },
+		}),
+		db.appointment.findMany({
+			where: { agencyId: lead.agencyId, leadId: lead.id },
+			orderBy: { startTime: "desc" },
+			take: ASSISTANT.appointmentReadLimit,
+			select: {
+				id: true,
+				title: true,
+				startTime: true,
+				endTime: true,
+				status: true,
+				client: { select: { name: true } },
+			},
+		}),
+		db.leadNote.findMany({
+			where: { agencyId: lead.agencyId, leadId: lead.id },
+			orderBy: { createdAt: "desc" },
+			take: ASSISTANT.noteLimit,
+			select: { body: true, createdAt: true },
+		}),
+	]);
+	const confirmation = (field: CriterionField): string | null => {
+		const value = lead[field];
+		const item = stored.find((entry) => entry.field === field);
+		if (value === null || value === undefined || !item) return null;
+		try {
+			validateQualification(
+				{
+					leadId: lead.id,
+					[field]: value,
+					evidence: [item],
+				} as RealEstateQualificationInput,
+				anchors,
+			);
+			return item.quote;
+		} catch {
+			return null;
+		}
+	};
+	const criterion = (
+		label: string,
+		value: string | null,
+		fields: CriterionField[],
+	): Criterion[] => {
+		if (!value) return [];
+		const quotes = fields.map(confirmation);
+		const proven = quotes.every(Boolean);
+		return [
+			{
+				criterion: label,
+				value,
+				status: proven
+					? ASSISTANT_LABELS.confirmed
+					: ASSISTANT_LABELS.suggestion,
+				quote: proven ? [...new Set(quotes)].join(" / ") : null,
+			},
+		];
+	};
+	const labels = ASSISTANT_LABELS.criteria;
+	const budget = budgetText(lead.budgetMin, lead.budgetMax);
+	const criteria = [
+		...criterion(
+			labels.intent,
+			lead.intent === "UNKNOWN"
+				? null
+				: labelOf(ASSISTANT_LABELS.intent, lead.intent),
+			["intent"],
+		),
+		...criterion(labels.propertyType, lead.propertyType, ["propertyType"]),
+		...criterion(labels.budget, budget, [
+			...(lead.budgetMin === null ? [] : (["budgetMin"] as const)),
+			...(lead.budgetMax === null ? [] : (["budgetMax"] as const)),
+		]),
+		...criterion(labels.targetArea, lead.targetArea, ["targetArea"]),
+		...criterion(labels.timeline, lead.timeline, ["timeline"]),
+		...criterion(labels.financing, lead.financing, ["financing"]),
+		...criterion(labels.currentSituation, lead.currentSituation, [
+			"currentSituation",
+		]),
+	];
+	const known = new Set(criteria.map((item) => item.criterion));
+	const listings = listingSuggestions.safeParse(
+		lead.suggestions ?? { listings: [] },
+	);
+	return {
+		timeZone: ASSISTANT.timeZone,
+		id: lead.id,
+		name: fullName(lead),
+		phone: lead.phone,
+		email: lead.email,
+		language: lead.language,
+		status: labelOf(ASSISTANT_LABELS.status, lead.status),
+		realtor: lead.client?.name ?? null,
+		source: lead.source,
+		received: localStamp(lead.createdAt),
+		firstContacted: lead.firstContactedAt
+			? localStamp(lead.firstContactedAt)
+			: null,
+		lastActivity: lead.lastInteractedAt
+			? localStamp(lead.lastInteractedAt)
+			: null,
+		score: lead.score,
+		criteria,
+		toConfirm: Object.values(labels).filter((label) => !known.has(label)),
+		suggestedListings: (listings.success ? listings.data.listings : [])
+			.slice(0, ASSISTANT.suggestionLimit)
+			.map((item) => ({ ...item, status: ASSISTANT_LABELS.suggestion })),
+		consent: {
+			sms: lead.unsubscribedAt
+				? "Désabonné (STOP)"
+				: lead.consentedAt
+					? "Consentement SMS confirmé"
+					: "Aucun consentement SMS confirmé",
+			since: lead.consentedAt ? localStamp(lead.consentedAt) : null,
+			source: lead.consentSource,
+			automationPaused: Boolean(lead.automationPausedAt),
+			escalation: lead.escalationReason
+				? labelOf(ASSISTANT_LABELS.escalation, lead.escalationReason)
+				: null,
+		},
+		lastMessages: recent.reverse().map((item) => ({
+			at: localStamp(item.sentAt),
+			from: labelOf(ASSISTANT_LABELS.sender, item.sender),
+			text: trimText(item.content, ASSISTANT.textLimit),
+			delivery: item.status,
+		})),
+		appointments: appointments.map((item) => ({
+			id: item.id,
+			title: item.title,
+			start: localStamp(item.startTime),
+			end: localStamp(item.endTime),
+			status: labelOf(ASSISTANT_LABELS.appointment, item.status),
+			realtor: item.client.name,
+		})),
+		notes: notes.map((item) => ({
+			at: localStamp(item.createdAt),
+			text: trimText(item.body, ASSISTANT.textLimit),
+		})),
+		fiche: fichePath(lead.id, lead.agencyId),
+	};
+}
diff --git a/apps/agent/agent/lib/assistant-reports.ts b/apps/agent/agent/lib/assistant-reports.ts
new file mode 100644
index 0000000..6ba8dcc
--- /dev/null
+++ b/apps/agent/agent/lib/assistant-reports.ts
@@ -0,0 +1,237 @@
+import { type AppointmentStatus, db, type Prisma } from "@crm/db";
+import {
+	ASSISTANT,
+	ASSISTANT_LABELS,
+	fichePath,
+	INACTIVE_APPOINTMENT_STATUSES,
+	labelOf,
+	QUALIFIED_STATUSES,
+} from "./assistant-config";
+import { type AssistantScope, agencyFilter, isStaff } from "./assistant-scope";
+import {
+	type AssistantPeriod,
+	localDay,
+	localStamp,
+	median,
+	minutesBetween,
+	percentOf,
+	periodRange,
+} from "./assistant-time";
+
+const DAY_MS = 24 * 60 * 60 * 1000;
+
+export async function listAppointments(
+	scopes: AssistantScope[],
+	input: {
+		range: "upcoming" | "past";
+		days: number;
+		status?: AppointmentStatus;
+	},
+	limit: number = ASSISTANT.appointmentLimit,
+	now = new Date(),
+) {
+	const upcoming = input.range === "upcoming";
+	const horizon = input.days * DAY_MS;
+	const where = {
+		AND: [
+			agencyFilter(scopes),
+			upcoming
+				? {
+						startTime: {
+							gte: now,
+							lte: new Date(now.getTime() + horizon),
+						},
+					}
+				: {
+						startTime: {
+							gte: new Date(now.getTime() - horizon),
+							lt: now,
+						},
+					},
+			input.status
+				? { status: input.status }
+				: upcoming
+					? { status: { notIn: [...INACTIVE_APPOINTMENT_STATUSES] } }
+					: {},
+		],
+	} satisfies Prisma.AppointmentWhereInput;
+	const [total, rows] = await Promise.all([
+		db.appointment.count({ where }),
+		db.appointment.findMany({
+			where,
+			orderBy: { startTime: upcoming ? "asc" : "desc" },
+			take: limit,
+			select: {
+				id: true,
+				agencyId: true,
+				leadId: true,
+				title: true,
+				startTime: true,
+				endTime: true,
+				status: true,
+				lead: { select: { firstName: true, lastName: true } },
+				client: { select: { name: true } },
+			},
+		}),
+	]);
+	return {
+		timeZone: ASSISTANT.timeZone,
+		range: upcoming ? "À venir" : "Passés",
+		days: input.days,
+		total,
+		returned: rows.length,
+		appointments: rows.map((row) => ({
+			id: row.id,
+			prospect: [row.lead.firstName, row.lead.lastName]
+				.filter(Boolean)
+				.join(" "),
+			start: localStamp(row.startTime),
+			end: localStamp(row.endTime),
+			status: labelOf(ASSISTANT_LABELS.appointment, row.status),
+			title: row.title,
+			realtor: row.client.name,
+			fiche: fichePath(row.leadId, row.agencyId),
+		})),
+	};
+}
+
+type LeadRow = {
+	clientId: string | null;
+	createdAt: Date;
+	firstContactedAt: Date | null;
+	status: string;
+};
+
+type AppointmentRow = {
+	clientId: string;
+	createdAt: Date;
+	startTime: Date;
+	status: string;
+};
+
+function metrics(
+	leads: LeadRow[],
+	appointments: AppointmentRow[],
+	range: { from: Date; to: Date },
+) {
+	const delays = leads.flatMap((lead) =>
+		lead.firstContactedAt
+			? [minutesBetween(lead.createdAt, lead.firstContactedAt)]
+			: [],
+	);
+	const middle = median(delays);
+	const qualified = leads.filter((lead) =>
+		(QUALIFIED_STATUSES as readonly string[]).includes(lead.status),
+	).length;
+	const inRange = (value: Date) => value >= range.from && value <= range.to;
+	return {
+		leadsReceived: leads.length,
+		contacted: delays.length,
+		medianFirstResponseMinutes:
+			middle === null ? null : Math.round(middle * 10) / 10,
+		respondedWithinFiveMinutesPct: percentOf(
+			delays.filter((delay) => delay <= ASSISTANT.fastResponseMinutes).length,
+			delays.length,
+		),
+		qualified,
+		conversionPct: percentOf(qualified, leads.length),
+		appointmentsBooked: appointments.filter(
+			(item) =>
+				inRange(item.createdAt) &&
+				!(INACTIVE_APPOINTMENT_STATUSES as readonly string[]).includes(
+					item.status,
+				),
+		).length,
+		appointmentsHeld: appointments.filter(
+			(item) => item.status === "COMPLETED" && inRange(item.startTime),
+		).length,
+	};
+}
+
+export async function realtorPerformance(
+	scopes: AssistantScope[],
+	period: AssistantPeriod,
+	now = new Date(),
+) {
+	const range = periodRange(period, now);
+	const base = agencyFilter(scopes);
+	const [leads, appointments] = await Promise.all([
+		db.lead.findMany({
+			where: {
+				AND: [base, { createdAt: { gte: range.from, lte: range.to } }],
+			},
+			select: {
+				clientId: true,
+				createdAt: true,
+				firstContactedAt: true,
+				status: true,
+			},
+		}),
+		db.appointment.findMany({
+			where: {
+				AND: [
+					base,
+					{
+						OR: [
+							{ createdAt: { gte: range.from, lte: range.to } },
+							{ startTime: { gte: range.from, lte: range.to } },
+						],
+					},
+				],
+			},
+			select: {
+				clientId: true,
+				createdAt: true,
+				startTime: true,
+				status: true,
+			},
+		}),
+	]);
+	const breakdown = isStaff(scopes) && scopes.every((scope) => !scope.clientId);
+	const ids = breakdown
+		? [
+				...new Set([
+					...leads.map((lead) => lead.clientId),
+					...appointments.map((item) => item.clientId),
+				]),
+			]
+		: [];
+	const names = new Map(
+		(
+			await db.client.findMany({
+				where: {
+					id: { in: ids.filter((id): id is string => Boolean(id)) },
+					OR: scopes.map((scope) => ({ agencyId: scope.agencyId })),
+				},
+				select: { id: true, name: true },
+			})
+		).map((client) => [client.id, client.name]),
+	);
+	return {
+		timeZone: ASSISTANT.timeZone,
+		period: {
+			code: period,
+			label: ASSISTANT_LABELS.period[period],
+			from: localDay(range.from),
+			to: localDay(range.to),
+		},
+		conversionBasis:
+			"Prospects qualifiés ÷ prospects reçus pendant la période.",
+		...metrics(leads, appointments, range),
+		byRealtor: breakdown
+			? ids
+					.map((id) => ({
+						clientId: id,
+						realtor: id
+							? (names.get(id) ?? ASSISTANT_LABELS.unassigned)
+							: ASSISTANT_LABELS.unassigned,
+						...metrics(
+							leads.filter((lead) => lead.clientId === id),
+							appointments.filter((item) => item.clientId === id),
+							range,
+						),
+					}))
+					.sort((a, b) => b.leadsReceived - a.leadsReceived)
+			: undefined,
+	};
+}
diff --git a/apps/agent/agent/lib/assistant-scope.ts b/apps/agent/agent/lib/assistant-scope.ts
new file mode 100644
index 0000000..7f14fdc
--- /dev/null
+++ b/apps/agent/agent/lib/assistant-scope.ts
@@ -0,0 +1,108 @@
+import { db } from "@crm/db";
+import { agencyAccess } from "@crm/db/agency-access";
+import { ASSISTANT, ASSISTANT_ERRORS } from "./assistant-config";
+import { attribute, type PurposeContext, purposeOf } from "./session-purpose";
+
+export type AssistantContext = PurposeContext & {
+	readonly session: {
+		readonly auth: {
+			readonly current: {
+				readonly principalType?: string;
+				readonly principalId?: string;
+			} | null;
+		};
+	};
+};
+
+export type AssistantScope = {
+	agencyId: string;
+	clientId: string | undefined;
+	role: string;
+};
+
+export type AgencyFilter =
+	| { agencyId: string; clientId?: string }
+	| { OR: { agencyId: string; clientId?: string }[] };
+
+export function assistantUser(ctx: AssistantContext): string {
+	const userId = attribute(ctx, "userId");
+	const current = ctx.session.auth.current;
+	if (
+		purposeOf(ctx) !== "builder" ||
+		current?.principalType !== "user" ||
+		!userId ||
+		current.principalId !== userId ||
+		attribute(ctx, "taskKind")?.startsWith(ASSISTANT.blockedTaskPrefix)
+	)
+		throw new Error(ASSISTANT_ERRORS.session);
+	return userId;
+}
+
+function refusal(error: unknown): string {
+	const message = error instanceof Error ? error.message : "";
+	if (message.includes("no assigned client")) return ASSISTANT_ERRORS.noClient;
+	if (message.includes("outside your access"))
+		return ASSISTANT_ERRORS.clientOutside;
+	return ASSISTANT_ERRORS.membership;
+}
+
+export async function assistantScopes(
+	ctx: AssistantContext,
+	input: { agencyId?: string; clientId?: string } = {},
+): Promise<{ userId: string; scopes: AssistantScope[] }> {
+	const userId = assistantUser(ctx);
+	const agencyIds = input.agencyId
+		? [input.agencyId]
+		: (
+				await db.agencyUser.findMany({
+					where: { userId },
+					select: { agencyId: true },
+					orderBy: { createdAt: "asc" },
+				})
+			).map((member) => member.agencyId);
+	if (!agencyIds.length) throw new Error(ASSISTANT_ERRORS.membership);
+	const settled = await Promise.allSettled(
+		agencyIds.map((agencyId) =>
+			agencyAccess(db, userId, agencyId, input.clientId),
+		),
+	);
+	const granted = settled.flatMap((result) =>
+		result.status === "fulfilled" ? [result.value] : [],
+	);
+	if (!granted.length) {
+		const failure = settled.find((result) => result.status === "rejected");
+		throw new Error(
+			refusal(failure?.status === "rejected" ? failure.reason : null),
+		);
+	}
+	const scopes: AssistantScope[] = [];
+	for (const access of granted) {
+		if (
+			input.clientId &&
+			!(await db.client.count({
+				where: { id: input.clientId, agencyId: access.agencyId },
+			}))
+		)
+			continue;
+		scopes.push({
+			agencyId: access.agencyId,
+			clientId: access.clientId,
+			role: access.role,
+		});
+	}
+	if (!scopes.length) throw new Error(ASSISTANT_ERRORS.clientOutside);
+	return { userId, scopes };
+}
+
+export function agencyFilter(scopes: AssistantScope[]): AgencyFilter {
+	const parts = scopes.map((scope) =>
+		scope.clientId
+			? { agencyId: scope.agencyId, clientId: scope.clientId }
+			: { agencyId: scope.agencyId },
+	);
+	return parts.length === 1 && parts[0] ? parts[0] : { OR: parts };
+}
+
+export function isStaff(scopes: AssistantScope[]): boolean {
+	return scopes.every((scope) => scope.role !== "REALTOR");
+}
