+import { type NavAudience, pagesFor, presenceLabel } from "@/lib/navigation";
+
+export const OTHER_PAGE = "";
+
+export function pagePathOf(pathname: string, slug: string): string {
+	const withoutQuery = pathname.split("?")[0] ?? pathname;
+	const prefix = `/${slug}`;
+	const path = withoutQuery.startsWith(prefix)
+		? withoutQuery.slice(prefix.length)
+		: withoutQuery;
+	return path === "" ? "/" : path;
+}
+
+export function matchNavPage(path: string, audience: NavAudience) {
+	return pagesFor(audience)
+		.filter((page) =>
+			page.href === "/" ? path === "/" : path.startsWith(page.href),
+		)
+		.sort((a, b) => b.href.length - a.href.length)[0];
+}
+
+export function supportPageOptions(audience: NavAudience) {
+	return [
+		{ id: OTHER_PAGE, name: "Autre ou je ne sais pas" },
+		...pagesFor(audience).map((page) => ({ id: page.href, name: page.label })),
+	];
+}
+
+export function supportPageLabel(path: string): string {
+	return presenceLabel(path.split("/").filter(Boolean));
+}
