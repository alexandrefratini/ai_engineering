+}
+
+function ConversationRow({
+	conversation,
+	selected,
+	now,
+	index,
+	onSelect,
+}: {
+	conversation: InboxConversation;
+	selected: boolean;
+	now: Date;
+	index: number;
+	onSelect: (leadId: string) => void;
+}) {
+	const unread = conversation.unreadCount > 0;
+	return (
+		<li className={REVEAL} style={staggerStyle(index)}>
+			<button
+				type="button"
+				aria-current={selected ? "true" : undefined}
+				onClick={() => onSelect(conversation.leadId)}
+				className="grid w-full grid-cols-[0.5rem_minmax(0,1fr)_auto] items-center gap-x-2 gap-y-0.5 px-3 py-2.5 text-left transition-colors hover:bg-muted/60 focus-visible:outline-2 focus-visible:-outline-offset-2 focus-visible:outline-ring aria-[current=true]:bg-accent"
+			>
+				<span className="flex justify-center">
+					{unread && (
+						<>
+							<Dot className="bg-primary" />
+							<span className="sr-only">
+								{conversation.unreadCount > 1 ? `${conversation.unreadCount} non lus` : "Non lu"}
+							</span>
+						</>
+					)}
+				</span>
+				<span className={cn("truncate text-sm", unread ? "font-semibold" : "font-medium")}>{conversation.name}</span>
+				<span className="flex items-center gap-1.5 text-xs text-muted-foreground">
+					<ChannelIcon channel={conversation.channel} />
+					{conversation.lastMessageAt && (
+						<time dateTime={isoOf(conversation.lastMessageAt)} className="tabular-nums">
+							{formatShortStamp(conversation.lastMessageAt, now)}
+						</time>
+					)}
+				</span>
+				<span aria-hidden="true" />
+				<span className={cn("truncate text-xs", unread ? "text-foreground" : "text-muted-foreground")}>
+					{conversationPreview(conversation)}
+				</span>
+				<span className="flex justify-end">
+					{conversation.humanTakeover && (
+						<span className="flex items-center gap-1 text-[11px] whitespace-nowrap text-foreground">
+							<Dot className="size-1.5 bg-foreground" />
+							Reprise humaine
+						</span>
+					)}
+				</span>
+			</button>
+		</li>
+	);
+}
+
+export function InboxList({
+	conversations,
+	counts,
+	filter,
+	onFilterChange,
+	search,
+	onSearchChange,
+	selectedId,
+	onSelect,
+	now,
+	loading,
+	notice,
+	footer,
+}: {
+	conversations: InboxConversation[];
+	counts: InboxCounts;
+	filter: InboxFilter;
+	onFilterChange: (filter: InboxFilter) => void;
+	search: string;
+	onSearchChange: (value: string) => void;
+	selectedId: string | null;
+	onSelect: (leadId: string) => void;
+	now: Date;
+	loading?: boolean;
+	notice?: ReactNode;
+	footer?: ReactNode;
+}) {
+	const searchId = useId();
+	const query = search.trim();
+	return (
+		<Tabs
+			value={filter}
+			onValueChange={(value) => {
+				const next = INBOX_FILTERS.find((option) => option.id === value);
+				if (next) onFilterChange(next.id);
+			}}
+			className="flex min-h-0 flex-1 flex-col gap-0"
+		>
+			<div className="flex shrink-0 flex-col gap-2 border-b p-3">
+				<label htmlFor={searchId} className="sr-only">
+					Rechercher une conversation
+				</label>
+				<InputGroup>
+					<InputGroupAddon>
+						<Icon icon={Search} className="size-3.5" />
+					</InputGroupAddon>
+					<InputGroupInput
+						id={searchId}
+						type="search"
+						value={search}
+						onChange={(event) => onSearchChange(event.target.value)}
+						placeholder="Nom, téléphone ou message"
+						autoComplete="off"
+					/>
+				</InputGroup>
+				<TabsList className="w-full">
+					{INBOX_FILTERS.map((option) => (
+						<TabsTrigger key={option.id} value={option.id}>
+							{option.label}
+							<span className="tabular-nums text-muted-foreground">{counts[option.id]}</span>
+						</TabsTrigger>
+					))}
+				</TabsList>
+			</div>
+			<TabsContent value={filter} className="flex min-h-0 flex-1 flex-col overflow-y-auto">
+				{notice && <div className="p-3">{notice}</div>}
+				{loading ? (
+					<div className="p-3">
+						<WorkspaceLoading rows={6} />
+					</div>
+				) : conversations.length === 0 ? (
+					!notice && (
+						<p className="p-6 text-center text-xs text-muted-foreground">
+							{query ? `Aucune conversation pour « ${query} ».` : EMPTY_LIST[filter]}
+						</p>
+					)
+				) : (
+					<ul className="flex flex-col divide-y">
+						{conversations.map((conversation, index) => (
+							<ConversationRow
+								key={conversation.leadId}
+								conversation={conversation}
+								selected={conversation.leadId === selectedId}
+								now={now}
+								index={index}
+								onSelect={onSelect}
+							/>
+						))}
+					</ul>
+				)}
+				{footer && <div className="flex justify-center p-3">{footer}</div>}
+			</TabsContent>
+		</Tabs>
+	);
+}
