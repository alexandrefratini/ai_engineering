+										<button
+											type="button"
+											onClick={() => onSelect(stage.id)}
+											aria-label={`${stage.label} : ${prospects(stage.count)}, ${share(stage.count)}. Ouvrir la liste filtrée.`}
+											className="-mx-2 grid w-[calc(100%+1rem)] grid-cols-[minmax(0,1fr)_auto_3rem] items-center gap-3 rounded-md px-2 py-1.5 text-left text-sm transition-colors hover:bg-muted/60 focus-visible:outline-2 focus-visible:outline-ring"
+										>
+											<span className={cn("truncate", stage.count === 0 && "text-muted-foreground")}>{stage.label}</span>
+											<span
+												className={cn(
+													"tabular-nums",
+													stage.count === 0 ? "text-muted-foreground" : "font-medium",
+												)}
+											>
+												{stage.count}
+											</span>
+											<span className="text-right text-xs text-muted-foreground tabular-nums">{share(stage.count)}</span>
+										</button>
+									</li>
+								))}
+							</ul>
+						</div>
+					);
+				})}
+			</div>
+		</div>
+	);
+}
