"use client";
import { useState } from "react";
import { Button } from "./button";
import {
	Card,
	CardHeader,
	CardTitle,
	CardDescription,
	CardContent,
} from "./card";
import { Field, FieldLabel, FieldGroup } from "./field";
import { Input } from "./input";
import { WorkspaceNotice } from "./real-estate-workspace";
export function ConnectionSetup({
	title,
	description,
	fields,
	enabled,
	onSubmit,
	children,
}: {
	title: string;
	description: string;
	fields: {
		name: string;
		label: string;
		type?: string;
		optional?: boolean;
		defaultValue?: string;
	}[];
	enabled: boolean;
	onSubmit: (data: FormData) => Promise<void>;
	children?: React.ReactNode;
}) {
	const [busy, setBusy] = useState(false);
	const [error, setError] = useState<string | null>(null);
	const [saved, setSaved] = useState(false);
	async function submit(form: HTMLFormElement) {
		setBusy(true);
		setError(null);
		setSaved(false);
		try {
			await onSubmit(new FormData(form));
			form.reset();
			setSaved(true);
		} catch (failure) {
			setError(
				failure instanceof Error
					? failure.message
					: "Enregistrement impossible.",
			);
		} finally {
			setBusy(false);
		}
	}
	return (
		<Card>
			<CardHeader>
				<CardTitle>{title}</CardTitle>
				<CardDescription>{description}</CardDescription>
			</CardHeader>
			<CardContent>
				<div className="flex flex-col gap-4">
					{children}
					{enabled ? (
						<form
							onSubmit={(event) => {
								event.preventDefault();
								void submit(event.currentTarget);
							}}
						>
							<FieldGroup>
								{fields.map((field) => (
									<Field key={field.name}>
										<FieldLabel htmlFor={`setup-${field.name}`}>
											{field.label}
										</FieldLabel>
										<Input
											id={`setup-${field.name}`}
											name={field.name}
											type={field.type ?? "text"}
											required={!field.optional}
											defaultValue={field.defaultValue}
											autoComplete={
												field.type === "password" ? "new-password" : "off"
											}
										/>
									</Field>
								))}
								<Button disabled={busy}>Enregistrer la configuration</Button>
							</FieldGroup>
						</form>
					) : (
						<WorkspaceNotice title="La configuration nécessite un rôle propriétaire ou administrateur" />
					)}
					{error && (
						<WorkspaceNotice title="Configuration refusée" error={error} />
					)}
					{saved && (
						<WorkspaceNotice title="Configuration enregistrée. La réception des événements confirme le fonctionnement." />
					)}
				</div>
			</CardContent>
		</Card>
	);
}
export function WebhookAddress({ url, label }: { url: string; label: string }) {
	const [copied, setCopied] = useState(false);
	const [failed, setFailed] = useState(false);
	async function copy() {
		setCopied(false);
		setFailed(false);
		try {
			await navigator.clipboard.writeText(url);
			setCopied(true);
		} catch {
			setFailed(true);
		}
	}
	return (
		<Field>
			<FieldLabel>{label}</FieldLabel>
			<Input readOnly value={url} aria-label={label} />
			<Button
				variant="outline"
				onClick={() => {
					void copy();
				}}
			>
				{copied ? "Copié" : "Copier"}
			</Button>
			{failed && (
				<WorkspaceNotice title="Copie impossible. Sélectionnez l’adresse." />
			)}
		</Field>
	);
}
