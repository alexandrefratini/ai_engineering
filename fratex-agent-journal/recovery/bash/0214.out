import type { Metadata } from "next";
import { Suspense } from "react";
import {
	PageShell,
	PageShellContent,
	PageShellDescription,
	PageShellHeader,
	PageShellHeading,
	PageShellLoading,
	PageShellTitle,
} from "@/components/page-shell";
import { requireSession } from "@/lib/session";
import { HydrateClient } from "@/lib/trpc/hydrate";
import { getServerQueryClient, getServerTrpc } from "@/lib/trpc/server";
import { LeadsView } from "./leads-view";

export const metadata: Metadata = {
	title: "Prospects Immobiliers",
};

export default function LeadsPage() {
	return (
		<PageShell className="min-h-0">
			<PageShellHeader>
				<PageShellHeading>
					<PageShellTitle>Prospects Immobiliers</PageShellTitle>
					<PageShellDescription>
						Tous les leads capturés depuis Meta Ads avec qualification SDR et
						routage courtier.
					</PageShellDescription>
				</PageShellHeading>
			</PageShellHeader>

			<PageShellContent className="min-h-0 p-0">
				<Suspense fallback={<PageShellLoading />}>
					<LeadsDataLoader />
				</Suspense>
			</PageShellContent>
		</PageShell>
	);
}

async function LeadsDataLoader() {
	await requireSession();
	const trpc = getServerTrpc();
	const queryClient = getServerQueryClient();

	await queryClient.prefetchQuery(
		trpc.realEstate.list.queryOptions({ limit: 50 }),
	);

	return (
		<HydrateClient>
			<LeadsView />
		</HydrateClient>
	);
}
