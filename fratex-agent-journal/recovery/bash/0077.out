	async getConnectionsStatus(userId: string, requestedAgencyId?: string) {
		const scope = await this.access(userId, requestedAgencyId);
		const [accounts, formCount, sms, receipt, model, calendar] =
			await Promise.all([
				this.db.metaAdAccount.findMany({
					where: { agencyId: scope.agencyId },
					select: { accessToken: true, pixelId: true },
				}),
				this.db.metaLeadForm.count({ where: { agencyId: scope.agencyId } }),
				this.db.smsConnection.findFirst({
					where: { agencyId: scope.agencyId },
					select: { phoneNumber: true },
				}),
				this.db.metaWebhookEvent.findFirst({
					where: { agencyId: scope.agencyId },
					select: { id: true },
				}),
				readAgentModel(this.db),
				this.db.realtorCalendar.count({
					where: { agencyId: scope.agencyId, clientId: scope.clientId },
				}),
			]);
		const origin = process.env.API_URL ?? "http://localhost:3001";
		const local = process.env.LLM_PROVIDER === "openai-compatible";
		return {
			agencyId: scope.agencyId,
			canManage: canManageAgency(scope.role),
			metaWebhookUrl: `${origin}/api/meta/webhook`,
			meta: {
				connected: accounts.some((account) => Boolean(account.accessToken)),
				webhookActive: Boolean(receipt),
				adAccountCount: accounts.length,
				formCount,
				capiEnabled: accounts.some((account) =>
					Boolean(account.accessToken && account.pixelId),
				),
			},
			twilio: {
				connected: Boolean(sms),
				phoneNumber: sms?.phoneNumber ?? null,
				inboundWebhookUrl: `${origin}/api/messaging/sms/webhook`,
			},
			ai: {
				configured: local
					? Boolean(process.env.LLM_BASE_URL && process.env.LLM_MODEL)
					: Boolean(
							process.env.AI_GATEWAY_API_KEY || process.env.VERCEL_OIDC_TOKEN,
						),
				model: local ? (process.env.LLM_MODEL ?? "Non configuré") : model.id,
				isFallback: false,
				provider: local ? "openai-compatible" : "AI Gateway",
			},
			posthog: { configured: false, host: null },
			google: { connected: calendar > 0 },
			microsoft: { connected: false },
		};
	}
}
