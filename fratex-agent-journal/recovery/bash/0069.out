"use client";
import { ConnectionSetup } from "@crm/ui/components/connection-setup";
import {
	RealEstateWorkspace,
	WorkspaceLoading,
	WorkspaceNotice,
	WorkspaceSelect,
} from "@crm/ui/components/real-estate-workspace";
import { useMutation } from "@tanstack/react-query";
import { useState } from "react";
import { useTRPC } from "@/lib/trpc/client";
import { AgencyControl } from "../../../real-estate/use-agency";
import { useSdrConnections } from "../use-sdr-connections";
export function RealtorCalendarConnection() {
	const trpc = useTRPC();
	const { scope, query, clients } = useSdrConnections();
	const [clientId, setClientId] = useState("");
	const mutation = useMutation(
		trpc.realEstate.configureCalendar.mutationOptions(),
	);
	return (
		<RealEstateWorkspace>
			<AgencyControl scope={scope} />
			{scope.agencyId &&
				(query.isPending ? (
					<WorkspaceLoading />
				) : query.error ? (
					<WorkspaceNotice
						title="Configuration indisponible"
						error={query.error.message}
					/>
				) : (
					<ConnectionSetup
						title="Google Calendar du courtier"
						description="Les réservations utilisent cet agenda et ces horaires. Le lien d’onboarding ne connecte pas cet agenda."
						enabled={
							query.data.canManage && Boolean(clients.data?.clients.length)
						}
						fields={[
							{ name: "calendarId", label: "Identifiant Google Calendar" },
							{
								name: "accessToken",
								label: "Jeton d’accès OAuth",
								type: "password",
							},
							{
								name: "refreshToken",
								label: "Jeton de renouvellement OAuth",
								type: "password",
							},
							{
								name: "tokenExpiry",
								label: "Expiration ISO, exemple 2026-12-01T12:00:00Z",
							},
							{
								name: "timezone",
								label: "Fuseau horaire",
								defaultValue: "America/Toronto",
							},
							{
								name: "days",
								label: "Jours : 0 dimanche, 1 lundi, jusqu’à 6 samedi",
								defaultValue: "1,2,3,4,5",
							},
							{
								name: "startHour",
								label: "Heure de début",
								type: "number",
								defaultValue: "9",
							},
							{
								name: "endHour",
								label: "Heure de fin",
								type: "number",
								defaultValue: "17",
							},
							{
								name: "slotDuration",
								label: "Durée en minutes",
								type: "number",
								defaultValue: "30",
							},
						]}
						onSubmit={async (data) => {
							if (!clientId) throw new Error("Sélectionnez un courtier.");
							await mutation.mutateAsync({
								agencyId: scope.agencyId,
								clientId,
								calendarId: String(data.get("calendarId")),
								accessToken: String(data.get("accessToken")),
								refreshToken: String(data.get("refreshToken")),
								tokenExpiry: String(data.get("tokenExpiry")),
								timezone: String(data.get("timezone")),
								days: String(data.get("days")).split(",").map(Number),
								startHour: Number(data.get("startHour")),
								endHour: Number(data.get("endHour")),
								slotDuration: Number(data.get("slotDuration")),
							});
							await query.refetch();
						}}
					>
						{clients.data && (
							<WorkspaceSelect
								label="Courtier"
								value={clientId}
								options={clients.data.clients}
								onChange={setClientId}
							/>
						)}
						{clients.error && (
							<WorkspaceNotice
								title="Courtiers indisponibles"
								error={clients.error.message}
							/>
						)}
					</ConnectionSetup>
				))}
		</RealEstateWorkspace>
	);
}
import { Button } from "@crm/ui/components/button";
import Link from "next/link";
import { Suspense } from "react";
import { requireSession } from "@/lib/session";
import { ConnectionPage, ConnectionPageLoading } from "../connection-page";

export default function IntakeConnectionPage(
	props: PageProps<"/[slug]/settings/connections/intake">,
) {
	return (
		<Suspense fallback={<ConnectionPageLoading />}>
			<IntakeConnectionPageContent {...props} />
		</Suspense>
	);
}

async function IntakeConnectionPageContent({
	params,
}: PageProps<"/[slug]/settings/connections/intake">) {
	await requireSession();
	const { slug } = await params;

	return (
		<ConnectionPage centered className="max-w-(--container-narrow) text-center">
			<header className="flex flex-col gap-3 px-(--spacing-block-inline)">
				<h1 className="font-medium text-2xl tracking-tight">Intake endpoint</h1>
				<p className="text-muted-foreground text-sm leading-relaxed">
					This connection is not available yet. No endpoint, API key, or intake
					activity has been created for this workspace.
				</p>
			</header>
			<div>
				<Button asChild variant="outline">
					<Link href={`/${slug}/settings/connections`}>
						Back to connections
					</Link>
				</Button>
			</div>
		</ConnectionPage>
	);
}
