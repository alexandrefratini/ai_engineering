		}
		await db.$transaction(async (tx) => {
			await tx.appointment.update({
				where: { id: appointment.id, agencyId: lead.agencyId },
				data: {
					status: "CONFIRMED",
					googleEventId: event.id,
					meetingLink: event.htmlLink,
				},
			});
			await tx.lead.update({
				where: { id: lead.id, agencyId: lead.agencyId },
				data: { status: "APPOINTMENT_BOOKED", clientId },
			});
			const attribution = await tx.attributionEvent.upsert({
				where: { id: `appointment:${appointment.id}` },
				update: {},
				create: {
					id: `appointment:${appointment.id}`,
					agencyId: lead.agencyId,
					leadId: lead.id,
					eventType: "APPOINTMENT_SCHEDULED",
				},
			});
			await queueSdrTask(tx, {
				agencyId: lead.agencyId,
				leadId: lead.id,
				kind: "real-estate-capi",
				key: `capi:${attribution.id}`,
				payload: { agencyId: lead.agencyId, eventId: attribution.id },
			});
		});
		return {
			booked: true,
			appointmentId: appointment.id,
			startTime: start.toISOString(),
			endTime: end.toISOString(),
		};
	},
});
