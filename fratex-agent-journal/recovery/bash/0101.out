import type { Metadata } from "next";
import { Suspense } from "react";
import { ConnectionPage, ConnectionPageLoading } from "../connection-page";
import { TwilioConnection } from "../twilio-connection";

export const metadata: Metadata = { title: "Twilio SMS & Téléphonie" };

export default function TwilioConnectionPage(props: {
	params: Promise<{ slug: string }>;
}) {
	return (
		<Suspense fallback={<ConnectionPageLoading />}>
			<TwilioConnectionPageContent {...props} />
		</Suspense>
	);
}

async function TwilioConnectionPageContent(props: {
	params: Promise<{ slug: string }>;
}) {
	const { slug } = await props.params;

	return (
		<ConnectionPage>
			<TwilioConnection slug={slug} />
		</ConnectionPage>
	);
}
