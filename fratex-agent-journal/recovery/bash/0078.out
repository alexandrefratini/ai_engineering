export const MINUTE_MS = 60_000;
export const HOUR_MS = 60 * MINUTE_MS;
export const DAY_MS = 24 * HOUR_MS;

export const REAL_ESTATE = {
	export: { timeoutMs: 5000 },
	lead: { eventLimit: 20, emailLimit: 20 },
	portal: {
		recentLimit: 10,
		upcomingLimit: 5,
		fastResponseMinutes: 5,
		periodDays: { "30D": 30, "90D": 90 },
	},
	home: {
		timeZone: "America/Toronto",
		trendDays: 14,
		weekDays: 7,
		appointmentHours: 48,
		toDoLimit: 8,
	},
	messages: { maxLength: 160 },
	email: { gmailWebBase: "https://mail.google.com/mail/u/0/#all/" },
} as const;
