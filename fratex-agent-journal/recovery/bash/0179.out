	async getLead(userId: string, input: GetLeadInput) {
		const scope = await this.access(userId, input.agencyId);
		const lead = await this.db.lead.findFirst({
			where: {
				id: input.id,
				agencyId: scope.agencyId,
				clientId: scope.clientId,
			},
			include: {
				client: { select: { name: true } },
				campaign: { select: { name: true } },
				form: { select: { name: true } },
				propertyInterest: true,
				attributions: {
					where: { agencyId: scope.agencyId },
					orderBy: { occurredAt: "desc" },
					take: REAL_ESTATE.lead.eventLimit,
					select: { id: true, eventType: true, occurredAt: true },
				},
				appointments: {
					where: { agencyId: scope.agencyId },
					include: { client: { select: { name: true } } },
					orderBy: { startTime: "asc" },
				},
			},
		});
		if (!lead) throw new NotFoundException("Lead not found.");
		const [messages, deliveries, emails, channels] = await Promise.all([
			this.db.message.findMany({
				where: { agencyId: scope.agencyId, conversation: { leadId: lead.id } },
				orderBy: [{ sentAt: "asc" }, { id: "asc" }],
				select: {
					id: true,
					sender: true,
					content: true,
					sentAt: true,
					status: true,
					failureCode: true,
				},
			}),
			this.db.crmDelivery.findMany({
				where: { agencyId: scope.agencyId, leadId: lead.id },
				orderBy: { createdAt: "desc" },
				take: REAL_ESTATE.portal.recentLimit,
				select: {
					id: true,
					crmType: true,
					status: true,
					errorCode: true,
					createdAt: true,
				},
			}),
			this.leadEmails(scope.agencyId, lead.email),
			this.leadChannels(scope.agencyId),
		]);
		return {
			lead: leadItem(lead),
			profile: {
				language: lead.language,
				budgetMin: lead.budgetMin,
				timeline: lead.timeline,
				financing: lead.financing,
				currentSituation: lead.currentSituation,
				escalationReason: lead.escalationReason,
				consentSource: lead.consentSource,
				campaignName: lead.campaign?.name ?? null,
				formName: lead.form?.name ?? null,
				property: lead.propertyInterest,
			},
			evidence:
				lead.qualificationEvidence === null
					? []
					: storedQualificationEvidence.parse(lead.qualificationEvidence),
			suggestedListings:
				lead.suggestions === null
