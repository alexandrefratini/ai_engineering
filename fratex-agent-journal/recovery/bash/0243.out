			name: z.string(),
			image: z.string().nullable(),
			lastSeenAt: z.date().nullable(),
			online: z.boolean(),
			isSelf: z.boolean(),
		}),
	),
	onlineCount: z.number(),
});

export const heartbeatOutput = z.object({ lastSeenAt: z.date() });
