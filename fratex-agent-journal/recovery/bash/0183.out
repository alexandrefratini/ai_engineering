					metaFormId: form.id,
					metaLeadgenId: data.id,
					firstName: mapped.firstName,
					lastName: mapped.lastName,
					phone: mapped.phone,
					email: mapped.email,
					intent: mapped.intent,
					budgetMin: mapped.budgetMin,
					budgetMax: mapped.budgetMax,
					targetArea: mapped.targetArea,
					propertyType: mapped.propertyType,
				},
			});
		const consent = mapped.fields.get("sms_consent")?.toLowerCase();
		if (
			["yes", "oui", "true", "1"].includes(consent ?? "") &&
			!lead.unsubscribedAt
		)
			await tx.lead.update({
				where: { id: lead.id, agencyId },
				data: {
					consentedAt: receipt.receivedAt,
					consentSource: `meta:${form.metaFormId}:sms_consent`,
				},
			});
		await tx.attributionEvent.upsert({
			where: { id: `created:${lead.id}` },
			update: {},
			create: {
				id: `created:${lead.id}`,
				agencyId,
				leadId: lead.id,
				eventType: "LEAD_CREATED",
			},
		});
		await queueSdrTask(tx, {
			agencyId,
			leadId: lead.id,
			kind: "real-estate-qualify",
			key: `qualify:${receipt.id}`,
			payload: { agencyId, leadId: lead.id },
		});
		await tx.metaWebhookEvent.update({
			where: { id: receipt.id, agencyId },
			data: { processedAt: new Date(), error: null },
		});
	});
}

