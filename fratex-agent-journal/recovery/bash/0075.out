import { db } from "@crm/db";
import {
	googleEventResponse,
	googleFreeBusyResponse,
	googleRefreshResponse,
	workingHours,
} from "@crm/validation/real-estate";
import { SDR } from "./sdr-config";
import { providerResponse } from "./sdr-http";

const MINUTE_MS = 60_000;
const DAY_MS = 24 * 60 * MINUTE_MS;
const WEEKDAYS = ["Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat"];

export async function realtorCalendar(agencyId: string, clientId: string) {
	const calendar = await db.realtorCalendar.findFirst({
		where: { agencyId, clientId },
	});
	if (!calendar || calendar.provider !== "google") return null;
	const hours = workingHours.parse(calendar.workingHours);
	new Intl.DateTimeFormat("fr-CA", { timeZone: hours.timezone }).format(
		new Date(),
	);
	let token = calendar.accessToken;
	if (calendar.tokenExpiry.getTime() <= Date.now()) {
		if (!process.env.GOOGLE_CLIENT_ID || !process.env.GOOGLE_CLIENT_SECRET)
			return null;
		const response = await fetch("https://oauth2.googleapis.com/token", {
			method: "POST",
			body: new URLSearchParams({
				client_id: process.env.GOOGLE_CLIENT_ID,
				client_secret: process.env.GOOGLE_CLIENT_SECRET,
				refresh_token: calendar.refreshToken,
				grant_type: "refresh_token",
			}),
			signal: AbortSignal.timeout(SDR.transport.timeoutMs),
		});
		if (!response.ok) throw new Error("CALENDAR_AUTH_UNAVAILABLE");
		const refreshed = await providerResponse(response, googleRefreshResponse);
		token = refreshed.access_token;
		await db.realtorCalendar.update({
			where: { id: calendar.id, agencyId },
			data: {
				accessToken: token,
				tokenExpiry: new Date(Date.now() + refreshed.expires_in * 1000),
			},
		});
	}
	return { ...calendar, token, hours };
}

export async function calendarBusy(
	calendar: NonNullable<Awaited<ReturnType<typeof realtorCalendar>>>,
	start: Date,
	end: Date,
) {
	const response = await fetch(
		"https://www.googleapis.com/calendar/v3/freeBusy",
		{
			method: "POST",
			headers: {
				Authorization: `Bearer ${calendar.token}`,
				"Content-Type": "application/json",
			},
			body: JSON.stringify({
				timeMin: start.toISOString(),
				timeMax: end.toISOString(),
				timeZone: calendar.hours.timezone,
				items: [{ id: calendar.calendarId }],
			}),
			signal: AbortSignal.timeout(SDR.transport.timeoutMs),
		},
	);
	if (!response.ok) throw new Error("CALENDAR_AVAILABILITY_UNAVAILABLE");
	const result = (await providerResponse(response, googleFreeBusyResponse))
		.calendars[calendar.calendarId];
	if (!result || result.errors?.length)
		throw new Error("CALENDAR_AVAILABILITY_UNAVAILABLE");
	return result.busy.map((item) => ({
		startTime: new Date(item.start),
		endTime: new Date(item.end),
	}));
}

export function overlaps(aStart: Date, aEnd: Date, bStart: Date, bEnd: Date) {
	return aStart < bEnd && aEnd > bStart;
}

export function withinHours(
	start: Date,
	end: Date,
	hours: ReturnType<typeof workingHours.parse>,
) {
	const format = new Intl.DateTimeFormat("en-US", {
		timeZone: hours.timezone,
		weekday: "short",
		hour: "numeric",
		minute: "numeric",
		hourCycle: "h23",
		year: "numeric",
		month: "2-digit",
		day: "2-digit",
	});
	const parts = (date: Date) =>
		Object.fromEntries(
			format.formatToParts(date).map((item) => [item.type, item.value]),
		);
	const a = parts(start),
		b = parts(end);
	return (
		hours.days.includes(WEEKDAYS.indexOf(a.weekday!)) &&
		a.day === b.day &&
		a.month === b.month &&
		a.year === b.year &&
		Number(a.hour) * 60 + Number(a.minute) >= hours.startHour * 60 &&
		Number(b.hour) * 60 + Number(b.minute) <= hours.endHour * 60
	);
}

